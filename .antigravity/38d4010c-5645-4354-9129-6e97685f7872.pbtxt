    command_line: "mkdir -p .playwright-cli && playwright-cli open http://localhost:3000 && playwright-cli resize 1280 860 && playwright-cli run-code \"async page => {\n  await page.waitForSelector(\'aside nav\');\n\n  // Ensure clean starting state\n  await page.evaluate(() => {\n    localStorage.removeItem(\'lifeos_local_tasks_v1\');\n    localStorage.removeItem(\'lifeos_local_notes_v1\');\n    localStorage.removeItem(\'lifeos_local_note_folders_v1\');\n    localStorage.removeItem(\'lifeos_local_note_versions_v1\');\n    localStorage.removeItem(\'lifeos_profile_v1\');\n  });\n  await page.reload();\n  await page.waitForSelector(\'aside nav\');\n\n  // 1. Navigate to Planner\n  await page.getByRole(\'button\', { name: \'Planner\' }).first().click();\n  await page.waitForSelector(\'h1:has-text(\\\"Planner & Calendar\\\")\');\n\n  const todayYmd = new Date().toISOString().slice(0, 10);\n\n  // Create Task 1 (P1 Urgent, due today, 2 subtasks)\n  await page.getByRole(\'button\', { name: \'Add Task\' }).first().click();\n  const dlg1 = page.getByRole(\'dialog\');\n  await dlg1.getByPlaceholder(\'Prepare passport renewal documents\').fill(\'Renew Iraqi Passport\');\n  await dlg1.locator(\'input[type=\\\"date\\\"]\').fill(todayYmd);\n  await dlg1.locator(\'select\').nth(1).selectOption(\'1\');\n  await dlg1.getByPlaceholder(\'Add a subtask step...\').fill(\'Gather birth certificate\');\n  await dlg1.getByRole(\'button\', { name: \'Add\', exact: true }).click();\n  await dlg1.getByPlaceholder(\'Add a subtask step...\').fill(\'Book Baghdad appointment\');\n  await dlg1.getByRole(\'button\', { name: \'Add\', exact: true }).click();\n  await dlg1.getByRole(\'button\', { name: \'Save Task\' }).click();\n  await page.waitForSelector(\'text=Renew Iraqi Passport\');\n\n  // Create Task 2 (P2 High)\n  await page.getByRole(\'button\', { name: \'Add Task\' }).first().click();\n  const dlg2 = page.getByRole(\'dialog\');\n  await dlg2.getByPlaceholder(\'Prepare passport renewal documents\').fill(\'Review Monthly Budget\');\n  await dlg2.locator(\'select\').nth(1).selectOption(\'2\');\n  await dlg2.getByRole(\'button\', { name: \'Save Task\' }).click();\n  await page.waitForSelector(\'text=Review Monthly Budget\');\n\n  // Expand subtasks on Task 1 and check 1 subtask off\n  await page.getByText(\'0/2 subtasks\').click();\n  await page.getByText(\'Gather birth certificate\').click();\n  await page.waitForSelector(\'text=1/2 subtasks\');\n\n  // Reorder Task 2 up via fractional index single-write button\n  const moveUpButtons = page.getByRole(\'button\', { name: \'Move task up\' });\n  await moveUpButtons.nth(1).click();\n  await page.waitForTimeout(250);\n\n  await page.screenshot({ path: \'.playwright-cli/p4_planner_tasks.png\' });\n\n  // Switch to Unified Calendar tab\n  await page.getByRole(\'tab\', { name: \'Unified Calendar\' }).click();\n  await page.waitForSelector(\'text=Renew Iraqi Passport\');\n  await page.screenshot({ path: \'.playwright-cli/p4_planner_calendar.png\' });\n\n  // 2. Navigate to Notes\n  await page.getByRole(\'button\', { name: \'Notes\' }).first().click();\n  await page.waitForSelector(\'h1:has-text(\\\"Rich Markdown Notes\\\")\');\n\n  // Create nested folder: Projects -> LifeOS Q4\n  await page.getByRole(\'button\', { name: \'New folder\' }).click();\n  await page.getByPlaceholder(\'Folder name\').fill(\'Projects\');\n  await page.getByRole(\'button\', { name: \'Add\', exact: true }).click();\n  await page.waitForSelector(\'text=Projects\');\n\n  await page.getByRole(\'button\', { name: \'New folder\' }).click();\n  await page.getByPlaceholder(\'Folder name\').fill(\'LifeOS Q4\');\n  await page.getByLabel(\'Parent folder\').selectOption({ label: \'Projects\' });\n  await page.getByRole(\'button\', { name: \'Add\', exact: true }).click();\n  await page.waitForSelector(\'text=LifeOS Q4\');\n\n  // Create Markdown note\n  await page.getByRole(\'button\', { name: \'New Note\' }).first().click();\n  await page.getByPlaceholder(\'Note title...\').fill(\'Architecture Notes\');\n  await page.getByLabel(\'Markdown editor\').fill(\'# Launch Plan\\n\\nShip **offline-first** sync and [docs](https://firebase.google.com).\\n\\n- [ ] Verify E2E encryption\\n- [x] Deploy Firestore rules\');\n  await page.getByRole(\'button\', { name: \'Save\', exact: true }).click();\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: \'.playwright-cli/p4_notes_editor.png\' });\n\n  // Edit & save again to create Version History v1 snapshot\n  await page.getByLabel(\'Markdown editor\').fill(\'# Launch Plan v2\\n\\nShip **offline-first** sync with **AES-256-GCM** locked notes.\\n\\n- [x] Verify E2E encryption\\n- [x] Deploy Firestore rules\');\n  await page.getByRole(\'button\', { name: \'Save\', exact: true }).click();\n  await page.waitForTimeout(300);\n\n  // Open Version History drawer\n  await page.getByRole(\'button\', { name: \'Version history\' }).click();\n  await page.waitForSelector(\'text=Version History\');\n  await page.waitForSelector(\'text=v1\');\n  await page.screenshot({ path: \'.playwright-cli/p4_notes_versions.png\' });\n  await page.getByRole(\'button\', { name: \'Close version history\' }).click();\n\n  // Lock note with opt-in AES-256-GCM E2E encryption\n  await page.getByRole(\'button\', { name: \'Encrypt and lock note\' }).click();\n  await page.waitForSelector(\'text=Set Up Opt-In E2E Encryption\');\n  await page.getByPlaceholder(\'At least 8 characters\').fill(\'LifeOSStrongPass2026!\');\n  await page.getByPlaceholder(\'Re-enter passphrase\').fill(\'LifeOSStrongPass2026!\');\n  await page.getByRole(\'button\', { name: \'Enable AES-256-GCM\' }).click();\n  await page.waitForSelector(\'text=Save Your Recovery Key\');\n  await page.getByRole(\'button\', { name: /I Saved My Recovery Key/i }).click();\n  await page.waitForTimeout(400);\n\n  // Click Lock Session to seal the encrypted note and verify sealed AES-256-GCM gate\n  await page.getByRole(\'button\', { name: \'Lock Session\' }).click();\n  await page.waitForSelector(\'text=Unlock with Passphrase\');\n  await page.screenshot({ path: \'.playwright-cli/p4_notes_locked.png\' });\n\n  // Verify HomeView reflects active Phase 4 modules and live counts\n  await page.getByRole(\'button\', { name: \'Home\' }).first().click();\n  await page.waitForSelector(\'text=Phase 4\');\n  await page.screenshot({ path: \'.playwright-cli/p4_home_active.png\' });\n\n  // Clean up all synthetic localStorage test records before closing\n  await page.evaluate(() => {\n    localStorage.removeItem(\'lifeos_local_tasks_v1\');\n    localStorage.removeItem(\'lifeos_local_notes_v1\');\n    localStorage.removeItem(\'lifeos_local_note_folders_v1\');\n    localStorage.removeItem(\'lifeos_local_note_versions_v1\');\n    localStorage.removeItem(\'lifeos_profile_v1\');\n  });\n  return \'PHASE4_E2E_ALL_PASSED\';\n}\" && playwright-cli console && playwright-cli close"
