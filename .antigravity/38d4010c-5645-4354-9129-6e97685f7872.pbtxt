  planner_response {
    thinking: "**Constructing UI Components**\n\nI\'m now focused on building the Vault UI components. I\'m following our `frontend-design` guidelines to create two production-ready components. I\'m focusing on \"Calm Slate\" and \"Emerald\" palettes, with metadata separated by `\302\267` and tabular figures. Hairline 1px borders, logical RTL spacing, and no thick accent borders are key.\n\n\n**Designing Document Scanner**\n\nI\'ve been working on the UI for the document scanner, and it now supports file picking for images and PDFs, a live camera snapshot using `getUserMedia`, and a multi-page scan pipeline. For images, I\'ve implemented a live canvas preview with rotation, edge crop adjustment, and scan enhancement presets. Users can add multiple pages and save a single JPEG or bundle them into a multi-page PDF. PDF uploads read the bytes directly. I\'ve also integrated metadata fields, including an AES-256-GCM encryption toggle.\n\n\n**Refining Vault UI Layout**\n\nI\'m now implementing the three-pane desktop layout within `/src/features/vault/ui/VaultView.tsx`, ensuring responsiveness for mobile. The page header, \"Scan/Upload Document\" and \"Lock Session\" buttons are in place, with the 4-column KPI strip ready. I\'m focusing on Pane 1 with Folders & Smart Views, and am now working on the search functionality for Pane 2, the document list, including the unboxed metadata display and doc type filtering. Pane 3 will have either a secure lock screen or the live binary preview.\n\n\n"
    message_id: "X2kFa-n_K9aZ3boP2YXw0Ag"
    tool_calls {
      id: "call_15043429554146135170"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  Camera,\\n  Check,\\n  Crop,\\n  FileText,\\n  FileUp,\\n  Lock,\\n  Plus,\\n  RotateCw,\\n  ShieldCheck,\\n  SlidersHorizontal,\\n  Trash2,\\n  X,\\n} from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport {\\n  enhanceScannedImage,\\n  type EnhancedScanResult,\\n  type ScanFilterPreset,\\n} from \'../../../core/vault/imageEnhancer\';\\nimport { buildMultiPagePdfFromJpegs } from \'../../../core/vault/pdfGenerator\';\\nimport {\\n  formatBytes,\\n  VAULT_DOC_TYPE_META,\\n  VAULT_DOC_TYPES,\\n  type CreateVaultDocumentInput,\\n  type VaultDocType,\\n  type VaultFolder,\\n} from \'../../../core/vault/vaultSchemas\';\\n\\ninterface ScannedPage {\\n  id: string;\\n  rawDataUrl: string;\\n  rotationDeg: 0 | 90 | 180 | 270;\\n  cropInsetPct: number;\\n  filter: ScanFilterPreset;\\n  enhanced: EnhancedScanResult | null;\\n}\\n\\ninterface DocumentScannerModalProps {\\n  open: boolean;\\n  flatFolders: Array<{ folder: VaultFolder; depth: number }>;\\n  defaultFolderId?: string;\\n  vaultUnlocked: boolean;\\n  e2eConfigured: boolean;\\n  onRequestUnlockE2E: (onSuccess: () => void) => void;\\n  onClose: () => void;\\n  onSave: (\\n    input: Omit<CreateVaultDocumentInput, \'localFileKey\' | \'sizeBytes\'>,\\n    plainBytes: Uint8Array\\n  ) => Promise<void>;\\n}\\n\\nfunction readFileAsDataUrl(file: File): Promise<string> {\\n  return new Promise((resolve, reject) => {\\n    const reader = new FileReader();\\n    reader.onload = () => resolve(String(reader.result));\\n    reader.onerror = () => reject(new Error(\'Could not read file.\'));\\n    reader.readAsDataURL(file);\\n  });\\n}\\n\\nfunction readFileAsBytes(file: File): Promise<Uint8Array> {\\n  return new Promise((resolve, reject) => {\\n    const reader = new FileReader();\\n    reader.onload = () => resolve(new Uint8Array(reader.result as ArrayBuffer));\\n    reader.onerror = () => reject(new Error(\'Could not read file bytes.\'));\\n    reader.readAsArrayBuffer(file);\\n  });\\n}\\n\\nexport const DocumentScannerModal: React.FC<DocumentScannerModalProps> = ({\\n  open,\\n  flatFolders,\\n  defaultFolderId,\\n  vaultUnlocked,\\n  onRequestUnlockE2E,\\n  onClose,\\n  onSave,\\n}) => {\\n  const { t } = useTranslation();\\n\\n  // Captured PDF or multi-page image scans\\n  const [uploadedPdf, setUploadedPdf] = useState<{\\n    name: string;\\n    bytes: Uint8Array;\\n  } | null>(null);\\n  const [pages, setPages] = useState<ScannedPage[]>([]);\\n  const [activePageIdx, setActivePageIdx] = useState(0);\\n  const [bundleAsPdf, setBundleAsPdf] = useState(true);\\n\\n  // Camera capture state\\n  const [cameraActive, setCameraActive] = useState(false);\\n  const [cameraError, setCameraError] = useState<string | null>(null);\\n  const videoRef = useRef<HTMLVideoElement | null>(null);\\n  const streamRef = useRef<MediaStream | null>(null);\\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\\n\\n  // Metadata fields\\n  const [title, setTitle] = useState(\'\');\\n  const [docType, setDocType] = useState<VaultDocType>(\'passport\');\\n  const [folderId, setFolderId] = useState(defaultFolderId ?? \'\');\\n  const [expiryDate, setExpiryDate] = useState(\'\');\\n  const [issuer, setIssuer] = useState(\'\');\\n  const [last4, setLast4] = useState(\'\');\\n  const [notes, setNotes] = useState(\'\');\\n  const [ocrText, setOcrText] = useState(\'\');\\n  const [encryptE2E, setEncryptE2E] = useState(false);\\n\\n  const [processing, setProcessing] = useState(false);\\n  const [saving, setSaving] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const stopCamera = () => {\\n    if (streamRef.current) {\\n      streamRef.current.getTracks().forEach((tr) => tr.stop());\\n      streamRef.current = null;\\n    }\\n    setCameraActive(false);\\n  };\\n\\n  useEffect(() => {\\n    if (!open) {\\n      stopCamera();\\n      return;\\n    }\\n    setFolderId(defaultFolderId ?? \'\');\\n    setError(null);\\n  }, [open, defaultFolderId]);\\n\\n  useEffect(() => {\\n    return () => stopCamera();\\n  }, []);\\n\\n  if (!open) return null;\\n\\n  const resetAndClose = () => {\\n    stopCamera();\\n    setUploadedPdf(null);\\n    setPages([]);\\n    setActivePageIdx(0);\\n    setTitle(\'\');\\n    setDocType(\'passport\');\\n    setExpiryDate(\'\');\\n    setIssuer(\'\');\\n    setLast4(\'\');\\n    setNotes(\'\');\\n    setOcrText(\'\');\\n    setEncryptE2E(false);\\n    setError(null);\\n    onClose();\\n  };\\n\\n  const addImagePage = async (rawDataUrl: string, suggestedTitle?: string) => {\\n    setProcessing(true);\\n    setError(null);\\n    try {\\n      const enhanced = await enhanceScannedImage(rawDataUrl, {\\n        rotationDeg: 0,\\n        cropInsetPct: 0,\\n        filter: \'original\',\\n      });\\n      const newPage: ScannedPage = {\\n        id: `pg_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,\\n        rawDataUrl,\\n        rotationDeg: 0,\\n        cropInsetPct: 0,\\n        filter: \'original\',\\n        enhanced,\\n      };\\n      setUploadedPdf(null);\\n      setPages((prev) => {\\n        const next = [...prev, newPage];\\n        setActivePageIdx(next.length - 1);\\n        return next;\\n      });\\n      if (suggestedTitle && !title.trim()) {\\n        setTitle(suggestedTitle.replace(/\\\\.[^.]+$/, \'\').slice(0, 120));\\n      }\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Failed to process scanned image.\');\\n    } finally {\\n      setProcessing(false);\\n    }\\n  };\\n\\n  const handleFilePicked = async (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const files = e.target.files;\\n    if (!files || files.length === 0) return;\\n    setError(null);\\n\\n    for (let i = 0; i < files.length; i++) {\\n      const file = files[i];\\n      if (file.size > 50 * 1024 * 1024) {\\n        setError(\'Files must be under 50 MB.\');\\n        continue;\\n      }\\n      if (file.type === \'application/pdf\') {\\n        const bytes = await readFileAsBytes(file);\\n        setPages([]);\\n        setUploadedPdf({ name: file.name, bytes });\\n        if (!title.trim()) {\\n          setTitle(file.name.replace(/\\\\.pdf$/i, \'\').slice(0, 120));\\n        }\\n        break;\\n      }\\n      if (file.type.startsWith(\'image/\')) {\\n        const dataUrl = await readFileAsDataUrl(file);\\n        await addImagePage(dataUrl, file.name);\\n      } else {\\n        setError(\'Please select a JPEG, PNG, WebP image, or PDF document.\');\\n      }\\n    }\\n    e.target.value = \'\';\\n  };\\n\\n  const startCamera = async () => {\\n    setCameraError(null);\\n    if (!navigator.mediaDevices?.getUserMedia) {\\n      setCameraError(\'Camera API is unavailable in this browser. Use File Upload instead.\');\\n      return;\\n    }\\n    try {\\n      const stream = await navigator.mediaDevices.getUserMedia({\\n        video: { facingMode: \'environment\' },\\n        audio: false,\\n      });\\n      streamRef.current = stream;\\n      setCameraActive(true);\\n      requestAnimationFrame(() => {\\n        if (videoRef.current) {\\n          videoRef.current.srcObject = stream;\\n          void videoRef.current.play();\\n        }\\n      });\\n    } catch {\\n      setCameraError(\'Camera permission denied or unavailable. Use File Upload instead.\');\\n    }\\n  };\\n\\n  const captureFromCamera = async () => {\\n    const video = videoRef.current;\\n    if (!video || video.videoWidth === 0) return;\\n    const canvas = document.createElement(\'canvas\');\\n    canvas.width = video.videoWidth;\\n    canvas.height = video.videoHeight;\\n    const ctx = canvas.getContext(\'2d\');\\n    if (!ctx) return;\\n    ctx.drawImage(video, 0, 0);\\n    const dataUrl = canvas.toDataURL(\'image/jpeg\', 0.92);\\n    stopCamera();\\n    await addImagePage(dataUrl, `Scanned Document ${new Date().toISOString().slice(0, 10)}`);\\n  };\\n\\n  const updateActivePageTransform = async (\\n    patch: Partial<Pick<ScannedPage, \'rotationDeg\' | \'cropInsetPct\' | \'filter\'>>\\n  ) => {\\n    const target = pages[activePageIdx];\\n    if (!target) return;\\n    const nextPage: ScannedPage = { ...target, ...patch };\\n    setProcessing(true);\\n    try {\\n      const enhanced = await enhanceScannedImage(nextPage.rawDataUrl, {\\n        rotationDeg: nextPage.rotationDeg,\\n        cropInsetPct: nextPage.cropInsetPct,\\n        filter: nextPage.filter,\\n      });\\n      setPages((prev) =>\\n        prev.map((p, idx) => (idx === activePageIdx ? { ...nextPage, enhanced } : p))\\n      );\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Transform failed.\');\\n    } finally {\\n      setProcessing(false);\\n    }\\n  };\\n\\n  const removePage = (idx: number) => {\\n    setPages((prev) => {\\n      const next = prev.filter((_, i) => i !== idx);\\n      setActivePageIdx((curr) => Math.max(0, Math.min(curr, next.length - 1)));\\n      return next;\\n    });\\n  };\\n\\n  const performSave = async () => {\\n    if (!title.trim()) {\\n      setError(\'Document title is required.\');\\n      return;\\n    }\\n\\n    let payloadBytes: Uint8Array;\\n    let mimeType = \'application/pdf\';\\n    let pageCount = 1;\\n\\n    if (uploadedPdf) {\\n      payloadBytes = uploadedPdf.bytes;\\n      mimeType = \'application/pdf\';\\n      pageCount = 1;\\n    } else if (pages.length > 0) {\\n      const enhancedPages = pages.map((p) => p.enhanced).filter((e): e is EnhancedScanResult => Boolean(e));\\n      if (enhancedPages.length === 0) {\\n        setError(\'Wait for scan enhancement to finish.\');\\n        return;\\n      }\\n      pageCount = enhancedPages.length;\\n      if (bundleAsPdf || enhancedPages.length > 1) {\\n        payloadBytes = buildMultiPagePdfFromJpegs(\\n          enhancedPages.map((ep) => ({\\n            jpegBytes: ep.jpegBytes,\\n            width: ep.width,\\n            height: ep.height,\\n          }))\\n        );\\n        mimeType = \'application/pdf\';\\n      } else {\\n        payloadBytes = enhancedPages[0].jpegBytes;\\n        mimeType = \'image/jpeg\';\\n      }\\n    } else {\\n      // Allow metadata-only document record (e.g. tracking expiry date before scanning physical copy)\\n      payloadBytes = new TextEncoder().encode(\\n        `LifeOS Vault Metadata Record\\\\nTitle: ${title.trim()}\\\\nType: ${docType}\\\\nExpiry: ${expiryDate || \'None\'}\\\\n`\\n      );\\n      mimeType = \'text/plain\';\\n      pageCount = 1;\\n    }\\n\\n    setSaving(true);\\n    setError(null);\\n    try {\\n      await onSave(\\n        {\\n          folderId: folderId || undefined,\\n          title: title.trim(),\\n          docType,\\n          storageMode: \'local_only\',\\n          mimeType,\\n          pageCount,\\n          expiryDate: expiryDate || undefined,\\n          issuer: issuer.trim() || undefined,\\n          documentNumberLast4: last4.trim() || undefined,\\n          tags: [],\\n          notes: notes.trim() || undefined,\\n          ocrText: ocrText.trim() || undefined,\\n          isEncrypted: encryptE2E,\\n          isLocked: encryptE2E,\\n        },\\n        payloadBytes\\n      );\\n      resetAndClose();\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Failed to save document.\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (encryptE2E && !vaultUnlocked) {\\n      onRequestUnlockE2E(() => {\\n        void performSave();\\n      });\\n      return;\\n    }\\n    await performSave();\\n  };\\n\\n  const activePage = pages[activePageIdx];\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={t(\'vault.addDocument\')}\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4 overflow-y-auto\\\"\\n      onClick={resetAndClose}\\n    >\\n      <div\\n        className=\\\"w-full max-w-3xl rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] shadow-xl overflow-hidden my-auto\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"flex items-center justify-between px-5 py-4 border-b border-[var(--border-hairline)]\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n              {t(\'vault.addDocument\')}\\n            </h2>\\n            <p className=\\\"text-xs text-[var(--text-muted)]\\\">\\n              Local-Only Vault \302\267 Raw files stay on-device (Zero Blaze storage billing)\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={t(\'common.close\')}\\n            onClick={resetAndClose}\\n            className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]\\\"\\n          >\\n            <X className=\\\"h-4 w-4\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={(e) => void handleSubmit(e)} className=\\\"p-5 space-y-5 max-h-[82dvh] overflow-y-auto\\\">\\n          {/* Capture / Upload Zone */}\\n          <div className=\\\"rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-4 space-y-3\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n              <span className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n                Scan, Crop, Enhance &amp; Multi-Page PDF\\n              </span>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <input\\n                  ref={fileInputRef}\\n                  type=\\\"file\\\"\\n                  accept=\\\"image/*,application/pdf\\\"\\n                  multiple\\n                  onChange={(e) => void handleFilePicked(e)}\\n                  className=\\\"hidden\\\"\\n                  aria-label=\\\"Upload document files\\\"\\n                />\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => fileInputRef.current?.click()}\\n                  className=\\\"inline-flex min-h-[36px] items-center gap-1.5 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n                >\\n                  <FileUp className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" />\\n                  <span>Upload Image / PDF</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => (cameraActive ? stopCamera() : void startCamera())}\\n                  className=\\\"inline-flex min-h-[36px] items-center gap-1.5 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n                >\\n                  <Camera className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" />\\n                  <span>{cameraActive ? \'Stop Camera\' : \'Camera Scan\'}</span>\\n                </button>\\n              </div>\\n            </div>\\n\\n            {cameraError && (\\n              <p className=\\\"text-xs text-amber-700 dark:text-amber-400\\\">{cameraError}</p>\\n            )}\\n\\n            {cameraActive && (\\n              <div className=\\\"space-y-2.5\\\">\\n                <div className=\\\"relative overflow-hidden rounded-xl border border-[var(--border-hairline)] bg-black aspect-video\\\">\\n                  <video ref={videoRef} playsInline muted className=\\\"h-full w-full object-contain\\\" />\\n                </div>\\n                <div className=\\\"flex justify-end\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => void captureFromCamera()}\\n                    className=\\\"inline-flex min-h-[38px] items-center gap-1.5 rounded-lg bg-[var(--accent)] px-4 py-1.5 text-xs font-medium text-white hover:bg-[var(--accent-hover)]\\\"\\n                  >\\n                    <Camera className=\\\"h-3.5 w-3.5\\\" />\\n                    <span>Capture Page</span>\\n                  </button>\\n                </div>\\n              </div>\\n            )}\\n\\n            {uploadedPdf && (\\n              <div className=\\\"flex items-center justify-between rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3.5 py-2.5\\\">\\n                <div className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n                  <FileText className=\\\"h-4 w-4 text-[var(--accent)] shrink-0\\\" />\\n                  <div className=\\\"min-w-0\\\">\\n                    <div className=\\\"text-xs font-semibold text-[var(--text-primary)] truncate\\\">\\n                      {uploadedPdf.name}\\n                    </div>\\n                    <div className=\\\"font-numeric text-[11px] text-[var(--text-muted)]\\\">\\n                      PDF \302\267 {formatBytes(uploadedPdf.bytes.byteLength)}\\n                    </div>\\n                  </div>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  aria-label=\\\"Remove PDF\\\"\\n                  onClick={() => setUploadedPdf(null)}\\n                  className=\\\"inline-flex h-8 w-8 items-center justify-center rounded-lg text-[var(--text-muted)] hover:text-red-600\\\"\\n                >\\n                  <Trash2 className=\\\"h-3.5 w-3.5\\\" />\\n                </button>\\n              </div>\\n            )}\\n\\n            {activePage && (\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-1\\\">\\n                <div className=\\\"rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-2 flex items-center justify-center min-h-[200px] max-h-[260px] overflow-hidden\\\">\\n                  {activePage.enhanced ? (\\n                    <img\\n                      src={activePage.enhanced.dataUrl}\\n                      alt={`Scanned page ${activePageIdx + 1}`}\\n                      className=\\\"max-h-[240px] w-auto object-contain rounded-lg\\\"\\n                    />\\n                  ) : (\\n                    <span className=\\\"text-xs text-[var(--text-muted)]\\\">Enhancing scan...</span>\\n                  )}\\n                </div>\\n\\n                <div className=\\\"space-y-3\\\">\\n                  {/* Page strip */}\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"font-numeric text-xs font-medium text-[var(--text-secondary)]\\\">\\n                      Page {activePageIdx + 1} of {pages.length}\\n                      {activePage.enhanced ? ` \302\267 ${formatBytes(activePage.enhanced.sizeBytes)}` : \'\'}\\n                    </span>\\n                    <div className=\\\"flex items-center gap-1\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => fileInputRef.current?.click()}\\n                        className=\\\"inline-flex h-7 items-center gap-1 rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-2 text-[11px] font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]\\\"\\n                      >\\n                        <Plus className=\\\"h-3 w-3\\\" />\\n                        <span>Add Page</span>\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        aria-label=\\\"Remove current page\\\"\\n                        onClick={() => removePage(activePageIdx)}\\n                        className=\\\"inline-flex h-7 w-7 items-center justify-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-red-600\\\"\\n                      >\\n                        <Trash2 className=\\\"h-3 w-3\\\" />\\n                      </button>\\n                    </div>\\n                  </div>\\n\\n                  {pages.length > 1 && (\\n                    <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                      {pages.map((p, idx) => (\\n                        <button\\n                          key={p.id}\\n                          type=\\\"button\\\"\\n                          onClick={() => setActivePageIdx(idx)}\\n                          className={`font-numeric px-2.5 py-1 rounded-md text-[11px] font-medium border transition-colors ${\\n                            idx === activePageIdx\\n                              ? \'border-[var(--accent)] bg-[var(--accent-soft)] text-[var(--accent)]\'\\n                              : \'border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)]\'\\n                          }`}\\n                        >\\n                          P{idx + 1}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  )}\\n\\n                  {/* Enhance Filter Presets */}\\n                  <div className=\\\"space-y-1.5\\\">\\n                    <div className=\\\"flex items-center gap-1.5 text-[11px] font-medium text-[var(--text-muted)]\\\">\\n                      <SlidersHorizontal className=\\\"h-3 w-3\\\" />\\n                      <span>Enhance Filter</span>\\n                    </div>\\n                    <div className=\\\"grid grid-cols-3 gap-1 p-1 rounded-lg bg-[var(--bg-subtle)]\\\">\\n                      {(\\n                        [\\n                          { id: \'original\', label: \'Original\' },\\n                          { id: \'document_bw\', label: \'Doc B&W\' },\\n                          { id: \'vivid_color\', label: \'Vivid\' },\\n                        ] as const\\n                      ).map((preset) => (\\n                        <button\\n                          key={preset.id}\\n                          type=\\\"button\\\"\\n                          disabled={processing}\\n                          onClick={() => void updateActivePageTransform({ filter: preset.id })}\\n                          className={`py-1.5 rounded-md text-[11px] font-medium transition-colors whitespace-nowrap ${\\n                            activePage.filter === preset.id\\n                              ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                              : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                          }`}\\n                        >\\n                          {preset.label}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  </div>\\n\\n                  {/* Rotate + Edge Crop */}\\n                  <div className=\\\"flex items-center gap-3\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={processing}\\n                      onClick={() =>\\n                        void updateActivePageTransform({\\n                          rotationDeg: (((activePage.rotationDeg + 90) % 360) as 0 | 90 | 180 | 270),\\n                        })\\n                      }\\n                      className=\\\"inline-flex min-h-[34px] items-center gap-1.5 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n                    >\\n                      <RotateCw className=\\\"h-3.5 w-3.5\\\" />\\n                      <span>Rotate 90\302\260</span>\\n                    </button>\\n\\n                    <label className=\\\"flex-1 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\\\">\\n                      <Crop className=\\\"h-3.5 w-3.5 shrink-0 text-[var(--text-muted)]\\\" />\\n                      <span className=\\\"whitespace-nowrap\\\">Crop {activePage.cropInsetPct}%</span>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={0}\\n                        max={20}\\n                        step={2}\\n                        value={activePage.cropInsetPct}\\n                        onChange={(e) =>\\n                          void updateActivePageTransform({ cropInsetPct: Number(e.target.value) })\\n                        }\\n                        className=\\\"w-full accent-[var(--accent)]\\\"\\n                      />\\n                    </label>\\n                  </div>\\n\\n                  <label className=\\\"flex items-center gap-2 text-xs text-[var(--text-secondary)] pt-1\\\">\\n                    <input\\n                      type=\\\"checkbox\\\"\\n                      checked={bundleAsPdf || pages.length > 1}\\n                      disabled={pages.length > 1}\\n                      onChange={(e) => setBundleAsPdf(e.target.checked)}\\n                      className=\\\"rounded accent-[var(--accent)]\\\"\\n                    />\\n                    <span>Export scanned pages as multi-page PDF</span>\\n                  </label>\\n                </div>\\n              </div>\\n            )}\\n\\n            {!uploadedPdf && pages.length === 0 && !cameraActive && (\\n              <p className=\\\"text-xs text-[var(--text-muted)]\\\">\\n                Upload a photo/PDF or capture pages with your camera. You can also save a metadata-only record to track expiry dates now and attach scans later.\\n              </p>\\n            )}\\n          </div>\\n\\n          {/* Document Metadata Grid */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div className=\\\"sm:col-span-2\\\">\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'vault.docTitleLabel\')}\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                maxLength={200}\\n                value={title}\\n                onChange={(e) => setTitle(e.target.value)}\\n                placeholder=\\\"e.g. Iraqi Passport \342\200\224 Main Holder\\\"\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'vault.docTypeLabel\')}\\n              </label>\\n              <select\\n                value={docType}\\n                onChange={(e) => setDocType(e.target.value as VaultDocType)}\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              >\\n                {VAULT_DOC_TYPES.map((dt) => (\\n                  <option key={dt} value={dt}>\\n                    {t(VAULT_DOC_TYPE_META[dt].labelKey, VAULT_DOC_TYPE_META[dt].fallbackLabel)}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'vault.folderLabel\')}\\n              </label>\\n              <select\\n                value={folderId}\\n                onChange={(e) => setFolderId(e.target.value)}\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              >\\n                <option value=\\\"\\\">No folder (Root)</option>\\n                {flatFolders.map(({ folder, depth }) => (\\n                  <option key={folder.id} value={folder.id}>\\n                    {\'\342\200\224 \'.repeat(depth)}\\n                    {folder.name}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'vault.expiryDateLabel\')}\\n              </label>\\n              <input\\n                type=\\\"date\\\"\\n                value={expiryDate}\\n                onChange={(e) => setExpiryDate(e.target.value)}\\n                className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'vault.issuerLabel\')}\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                maxLength={120}\\n                value={issuer}\\n                onChange={(e) => setIssuer(e.target.value)}\\n                placeholder=\\\"e.g. Directorate of Passports\\\"\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                Reference Last 4 Digits (never full ID)\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                maxLength={16}\\n                value={last4}\\n                onChange={(e) => setLast4(e.target.value)}\\n                placeholder=\\\"e.g. 4821\\\"\\n                className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"flex items-end\\\">\\n              <label className=\\\"w-full min-h-[42px] flex items-center justify-between gap-3 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 cursor-pointer\\\">\\n                <span className=\\\"flex items-center gap-2 text-xs font-medium text-[var(--text-primary)]\\\">\\n                  <Lock className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" />\\n                  <span>Encrypt file (AES-256-GCM)</span>\\n                </span>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={encryptE2E}\\n                  onChange={(e) => setEncryptE2E(e.target.checked)}\\n                  className=\\\"rounded accent-[var(--accent)]\\\"\\n                />\\n              </label>\\n            </div>\\n\\n            <div className=\\\"sm:col-span-2\\\">\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                On-Device Searchable OCR / Notes (optional)\\n              </label>\\n              <textarea\\n                rows={2}\\n                maxLength={2000}\\n                value={ocrText}\\n                onChange={(e) => setOcrText(e.target.value)}\\n                placeholder=\\\"Paste extracted text or key details for offline search (never sent to free-tier AI)...\\\"\\n                className=\\\"w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-start gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2.5 text-[11px] text-[var(--text-secondary)]\\\">\\n            <ShieldCheck className=\\\"h-4 w-4 shrink-0 text-[var(--accent)] mt-0.5\\\" />\\n            <span>\\n              <strong>Free-Tier Privacy Gate Active:</strong> Vault scans, passports, and IDs are stored strictly in local IndexedDB (Spark Free Tier) and are blocked from leaving your device for cloud AI processing.\\n            </span>\\n          </div>\\n\\n          {error && <p className=\\\"text-xs font-medium text-red-600 dark:text-red-400\\\">{error}</p>}\\n\\n          <div className=\\\"flex items-center justify-end gap-2 pt-3 border-t border-[var(--border-hairline)]\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={resetAndClose}\\n              className=\\\"min-h-[40px] rounded-xl border border-[var(--border-hairline)] px-4 py-2 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]\\\"\\n            >\\n              {t(\'common.cancel\')}\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={saving || processing}\\n              className=\\\"inline-flex min-h-[40px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-4 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50\\\"\\n            >\\n              <Check className=\\\"h-3.5 w-3.5\\\" />\\n              <span>{saving ? \'Saving...\' : t(\'vault.saveDocument\')}</span>\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DocumentScannerModal with file/camera capture, crop/rotate/enhance canvas pipeline, multi-page PDF generation, and opt-in AES-256-GCM encryption\", \"Overwrite\":true, \"TargetFile\":\"/src/features/vault/ui/DocumentScannerModal.tsx\", \"toolAction\":\"Creating DocumentScannerModal.tsx\", \"toolSummary\":\"Create DocumentScannerModal.tsx\"}"
      thinking_signature: "\022\203\034\n\200\034\001i\024}\023a\302\224\255\244\270\022\370\257\237N/\334$te\255\216\225\000\247\370\321\2276\371\326\376\301K\243m\252a\2635\303\244\330\fgjW\300!\177m18-\330\224\025l\214\016\356m\252\362kZ\000\343\315&_\352\310L\325\367T+\240\324Kv\021\362(\006\231V\315j\327\020\367Ea\216\305\352\021\n^\371\323CQ\375|&\376+E\354\nv\372\203\212\317\204\210d\252\266\2030Zb\341\220O\314\376\372\aE\354X;=G\216\020\365\352\006\237\247\321\247E}|\340\207\2716\271^Q\271%\204\367\335\245\375s\213\260\203\323\255W\215\365\242\001y)\2543V\267\036\274R\000\306\037\f>\215\246\346\2470Z\034)z,\241_\205\fN\357\233}\203\022\020f\214DV\360\232Y\2154\351\n\223C\371\"2\273\027d\233\263\203]\332\367\337\374\227\315R\277\031j\305\b\245\035(\202B\365\264\237\331@\016[\317\300\312\341<M\253\\1z\272\020%\324p\226J\372#OOn@N/8\346#\217\006O\307A\335\025\253\267^J\235l\263\323]Z|\026\270\325\227H~r\207\326+\307\310\\!.\331\216\232G\202\267\354?.\257D\353[\260\330\364\0323\364\363\215\217\031\273\273\322sbD\222,;+9_\364\245\363V\345Fhu\227\204\255 \312\265f\024\373\220d\202\022^\"\356i\245\332\no#\001w5\005\254\323\001\244\226}\b\223\234\335:\261o\027(\026\241\316\364\az \226\372N\220^~X\364C|\337\367i\006?\244\205\212\377W\362s\"\2569\252\250VM\263[v\004\254\025\255\333\177\333N\254\335\256\352\307\247\2074\t\262\0325\313mS~2C\321\036\361\334\301KI\206y\004\3650\264\277\241\r\314=$d\371%\354\303\222i\355>\005\032\230z\035\207\235\270\3479\211z\t\223\352SH\357\206H\177F)\216\367\242\224\355_\021\310\005\002fGh$y\375\364\242\3320\260\274\246\337\2173(9\033\241\026J5\370\260\2669;n\221\025\203/\300\264\0329=5\360-\317S\366\334k\267\200\227\025\264/5X\272\214\372\350\2044\216\032w+\360v\301f\266q\250\363D\342\306a_-\334\036C\276\005\335\3743\321/\332\201L~EF\244\030\241\344W\206\277\321\252\303-e\361\005\321\230l\215\f\n>Z\033\273\023\312^e\357C\371\363\035\313\'\305\2074W\221\333\223}\342\003a\3356:O\241|\036 \027\207\333\216\200\322\233\335\334\361\021\220\306\326\227\370\317G\2656`\206\310\027\025*0\357\336\234\230+\316\217\266 \224\273\202\"\210\275\230\n\300\256\177\336\236;\323T\355C\036\231\001\026/\301\217\326/\305\315\212\374\337\024\323\354g\361;\335\321\314G\240\032\353\266=\201`t\263}KT\251.\224\312\223YV\213\246\016\364\274]\300\217\220\253\302\335*f\354,\313\017?\370\217\f\271\242Rq6\023\317\371\025-\033Zi-0lM\341\021y\\\236\323,\321E\264\v\275.\347h\202\360\226\377q\357\233\351\316\017\375t7\367\336\001\030K7\226\277rC\r>\r\376>\266\b\336W:\213~I\220\271\236\250\337{Abk\360\301c\351\365\02227n\235\211\331\327\273\237\035b\"q/\236\003\3571\326\367\f\235\346\311\266\3540\325\202h\326\034\020\371\201\374\251\247!\374\020\331\227^\366\346\025\256nI\023=\242\245 \205\347\333}{\377t\335\2438*=j\333X\310\353c\006P\364\255\302\334_\357\265\224\223C\372\347 V\245~\255\030\270LR0I\314~n\223z\272!\354\025\272-\272i\374\310\244\330z9tA\3107+\237\306\202`2Z{\315\2227P\366vE\036\020W\210fYk\251\262e`\377\257\231\243N\275\"{\217\024o\355-GEH\332[(\223\f\031o[R\034\035\214p\231,\372+\236\207a\225\234\255\323\220\323F\216\033vp\330~\377R\360\033\201\344*#\234\363\033\240\347n\221S\274\272k\360\247Mv\2373\026>\227\006\215\f\217\245\253z\230*O\276IOda\023\016\364\331G\'\235\a\321\351\371\276Q\001T\036\322\276.\\\f;\227\313\3667L\200\345\325\300\036\021\254\312\300\224Bo\a\003R\227\305\004\315;,\246\"C\031\000\362\242>r\241T\207\332~BT,sJF\023\020\346\345\0323\346\233\tXY\244\240(9\350$\'\031\313\362\310(\201[\310T\034\251;\267S\320o\364\371\371e\006\321 \234:x\212^\362\260\366\001f\357\352\362\270\023\214\301;\206\307\br|x\321\v\016>(\261\\\027)\323\372\005<PP7\352*\016\211\253\312+\265\250\313\354\250\244X?\331\201}\254l\323I\324\017\340v\016\237B\355\364\221I\312\363\251T@@\303\204r\035\'!\313\327\240Cz\3242\343\2711\363\265\005\370\307F\332\276\202_r2\301\312S\243D\020\247\364\235\231\274C\313\240\330W,YS\037=a\0249\033\2755\036T\001\030K\275m\031D\362\335Z)Ka\240\272.F\003\250\251+\261\246sEJ\212tj\240\232[\036\372]\266\