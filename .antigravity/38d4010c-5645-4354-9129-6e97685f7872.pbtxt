  planner_response {
    thinking: "**Constructing UI Views**\n\nI\'m now diving into the implementation phase. I\'ll begin building the Phase 1 feature views, starting with `HomeView.tsx`. The goal is to create a calm daily command center, incorporating a greeting, a workspace subtitle, and a subtle metadata line indicating the app\'s status (e.g., local offline mode, syncing status, and tier information). The metadata will display in an unboxed style.\n\n\n**Designing Metric Strip**\n\nI\'ve shifted focus to the 4-column structured metric strip for `HomeView.tsx`. I\'m working on the dual-currency reference, the AI quota, the document vault, and security posture indicators, implementing the flat hairline grid with tabular figures. I\'m leveraging `formatMoney` for precise IQD/USD formatting and also ensuring a live currency settings link.\n\n\n**Implementing Settings Features**\n\nI\'m now implementing the user settings. This includes language and RTL selectors with segmented buttons, instantly mirroring the UI. I\'m also building dual-currency and quiet hours selectors, AI privacy gates and quotas with global and per-module switches, and the PIN app lock functionality. Finally, I\'m working on opt-in AES-256-GCM E2E encryption and implementing the passphrase setup, recovery key display, and secure persistence of encryption keys.\n\n\n**Verifying Security Features**\n\nI\'ve just validated in-browser zero-knowledge AES-256-GCM encryption and decryption. Now, I\'m integrating Google and Apple Sign-In features with feature flag controls. Also, I\'m adding an analytics consent checkbox, and a workspace JSON export. Finally, I\'m building a ModuleReadinessView for the upcoming phases, clearly outlining deliverables, and direct actions.\n\n\n"
    message_id: "6ZsEa77bK-vwjrEPhMa2yAg"
    tool_calls {
      id: "call_15667460001490778302"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  ArrowUpRight,\\n  Bell,\\n  BookText,\\n  CheckSquare,\\n  Flame,\\n  FolderLock,\\n  Scale,\\n  ShieldCheck,\\n  Sparkles,\\n  Wallet,\\n} from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { formatMoney } from \'../../../core/currency/currency\';\\nimport { evaluateDailyAiQuota, getTodayDayKey } from \'../../../core/entitlements/entitlements\';\\nimport { defaultLLMProvider, type AIResult } from \'../../../core/ai/llmProvider\';\\nimport { aiUsageRepository } from \'../../../data/repositories/firebaseWebAdapter\';\\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\\n\\ninterface ModuleCardSpec {\\n  id: NavRoute;\\n  titleKey: string;\\n  phase: number;\\n  icon: React.ComponentType<{ className?: string }>;\\n  collection: string;\\n  summary: string;\\n}\\n\\nconst MODULE_SPECS: ModuleCardSpec[] = [\\n  {\\n    id: \'debts\',\\n    titleKey: \'nav.debts\',\\n    phase: 2,\\n    icon: Scale,\\n    collection: \'users/{uid}/debts + debtLedgers\',\\n    summary: \'Multi-currency IQD/USD ledgers, deterministic repayment probability, snowball/avalanche plans, and EN/AR/KU reminder drafts.\',\\n  },\\n  {\\n    id: \'reminders\',\\n    titleKey: \'nav.reminders\',\\n    phase: 3,\\n    icon: Bell,\\n    collection: \'users/{uid}/reminders\',\\n    summary: \'RRULE recurrence engine, 8 channels, quiet hours, and unit-tested rolling 64-notification scheduler.\',\\n  },\\n  {\\n    id: \'planner\',\\n    titleKey: \'nav.planner\',\\n    phase: 4,\\n    icon: CheckSquare,\\n    collection: \'users/{uid}/tasks\',\\n    summary: \'Single-write fractional-index task ordering, subtasks, unified calendar, and AI goal breakdown.\',\\n  },\\n  {\\n    id: \'notes\',\\n    titleKey: \'nav.notes\',\\n    phase: 4,\\n    icon: BookText,\\n    collection: \'users/{uid}/notes\',\\n    summary: \'Markdown notes, nested folders, version history, and opt-in AES-256-GCM locked notes.\',\\n  },\\n  {\\n    id: \'vault\',\\n    titleKey: \'nav.vault\',\\n    phase: 5,\\n    icon: FolderLock,\\n    collection: \'Local-Only Vault + users/{uid}/documents\',\\n    summary: \'Zero-billing local document storage, expiry alerts, opt-in E2E encryption, and privacy-gated OCR.\',\\n  },\\n  {\\n    id: \'habits\',\\n    titleKey: \'nav.habits\',\\n    phase: 6,\\n    icon: Flame,\\n    collection: \'users/{uid}/habits + habitLogs\',\\n    summary: \'Monthly-bucketed streak heatmaps, haptics, and break-pattern insights.\',\\n  },\\n  {\\n    id: \'finance\',\\n    titleKey: \'nav.finance\',\\n    phase: 6,\\n    icon: Wallet,\\n    collection: \'users/{uid}/transactions\',\\n    summary: \'Income/expense ledger in integer minor units, budgets, subscriptions, and CSV import/export.\',\\n  },\\n];\\n\\nexport const HomeView: React.FC = () => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const authUser = useUIStore((s) => s.authUser);\\n  const entitlements = useUIStore((s) => s.entitlements);\\n  const todayAiUsage = useUIStore((s) => s.todayAiUsage);\\n  const pinEnabled = useUIStore((s) => s.pinEnabled);\\n  const setActiveRoute = useUIStore((s) => s.setActiveRoute);\\n  const setCommandPaletteOpen = useUIStore((s) => s.setCommandPaletteOpen);\\n  const incrementLocalAiUsage = useUIStore((s) => s.incrementLocalAiUsage);\\n\\n  const [briefingLoading, setBriefingLoading] = useState(false);\\n  const [briefingResult, setBriefingResult] = useState<AIResult | null>(null);\\n\\n  const dayKey = getTodayDayKey();\\n  const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\\n  const quota = evaluateDailyAiQuota(usedToday, entitlements);\\n  const quotaPercent = Math.min(100, Math.round((quota.usedToday / Math.max(1, quota.dailyLimit)) * 100));\\n\\n  const handleGenerateBriefing = async () => {\\n    if (!profile.aiGlobalEnabled) {\\n      setBriefingResult({\\n        ok: false,\\n        code: \'AI_DISABLED\',\\n        error: t(\'assistant.disabledNotice\'),\\n      });\\n      return;\\n    }\\n    if (!quota.allowed) {\\n      setBriefingResult({\\n        ok: false,\\n        code: \'DAILY_QUOTA_REACHED\',\\n        error: `Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}).`,\\n      });\\n      return;\\n    }\\n\\n    setBriefingLoading(true);\\n    const prompt = `Provide a calm 2-sentence daily briefing for a fresh LifeOS Stage 0 workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Active debts: 0, reminders today: 0, expiring vault docs: 0. Suggest one quick first step (adding a debt or setting up E2E vault encryption).`;\\n    const res = await defaultLLMProvider.complete(\\n      {\\n        module: \'assistant\',\\n        taskType: \'briefing\',\\n        text: prompt,\\n        locale: profile.locale,\\n        tier: \'lite\',\\n      },\\n      true\\n    );\\n    setBriefingResult(res);\\n    setBriefingLoading(false);\\n\\n    if (res.ok && !res.meta.cached) {\\n      incrementLocalAiUsage(dayKey, res.meta.inputTokensEst, res.meta.outputTokensEst);\\n      if (authUser) {\\n        void aiUsageRepository.recordUsage(\\n          authUser.uid,\\n          dayKey,\\n          todayAiUsage.dayKey === dayKey ? todayAiUsage : null,\\n          res.meta.inputTokensEst,\\n          res.meta.outputTokensEst\\n        );\\n      }\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-8\\\">\\n      {/* Page Header */}\\n      <section className=\\\"flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between\\\">\\n        <div>\\n          <p className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            <span>{authUser ? t(\'common.syncedCloudMode\') : t(\'common.offlineLocalMode\')}</span>\\n            <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n            <span>{t(\'common.phaseReady\')}</span>\\n            <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n            <span className=\\\"font-numeric\\\">{dayKey}</span>\\n          </p>\\n          <h1 className=\\\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]\\\">\\n            {t(\'home.greeting\')}, {authUser?.displayName || profile.displayName}\\n          </h1>\\n          <p className=\\\"mt-1.5 max-w-2xl text-sm text-[var(--text-secondary)]\\\">\\n            {t(\'home.subtitle\')}\\n          </p>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setActiveRoute(\'settings\')}\\n          className=\\\"self-start sm:self-auto inline-flex min-h-[42px] items-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors whitespace-nowrap\\\"\\n        >\\n          <ShieldCheck className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n          <span>{t(\'nav.settings\')}</span>\\n        </button>\\n      </section>\\n\\n      {/* 4-Column Flat KPI / Posture Strip (Single Elevation, Hairline Dividers, Tabular Figures) */}\\n      <section\\n        aria-label=\\\"Workspace overview metrics\\\"\\n        className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:gap-px rounded-2xl border border-[var(--border-hairline)] bg-[var(--border-hairline)] overflow-hidden\\\"\\n      >\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            {t(\'home.primaryCurrency\')} / {t(\'home.secondaryCurrency\')}\\n          </div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n            {formatMoney(0, profile.primaryCurrency, profile.locale)}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            {formatMoney(0, profile.secondaryCurrency, profile.locale)} \302\267 Integer minor units\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            {t(\'home.aiQuotaTitle\')}\\n          </div>\\n          <div className=\\\"mt-2 flex items-baseline gap-2\\\">\\n            <span className=\\\"font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n              {quota.usedToday} / {quota.dailyLimit}\\n            </span>\\n            <span className=\\\"text-xs text-[var(--text-muted)]\\\">({entitlements.plan})</span>\\n          </div>\\n          <div className=\\\"mt-2.5 h-1.5 w-full rounded-full bg-[var(--bg-subtle)] overflow-hidden\\\">\\n            <div\\n              className=\\\"h-full rounded-full bg-[var(--accent)] transition-all duration-200\\\"\\n              style={{ width: `${quotaPercent}%` }}\\n            />\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            {t(\'home.vaultPosture\')}\\n          </div>\\n          <div className=\\\"mt-2 text-base font-semibold text-[var(--text-primary)]\\\">\\n            {profile.vaultStorageMode === \'local_only\' ? \'Local-Only Vault\' : \'Private Cloud Vault\'}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">\\n            {profile.e2eConfigured ? \'AES-256-GCM E2E Ready\' : \'Opt-in E2E unconfigured\'}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            Security & Privacy Gate\\n          </div>\\n          <div className=\\\"mt-2 text-base font-semibold text-[var(--text-primary)]\\\">\\n            {t(\'home.aiPrivacyGateActive\')}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">\\n            PIN Lock: {pinEnabled ? \'Active\' : \'Off\'} \302\267 Firestore Rules Deployed\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Daily Briefing Surface */}\\n      <section className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-6\\\">\\n        <div className=\\\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n              {t(\'home.briefingTitle\')}\\n            </h2>\\n            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              Deterministic totals stay on-device \302\267 AI summarizes only minimal non-sensitive counts\\n            </p>\\n          </div>\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <button\\n              type=\\\"button\\\"\\n              disabled={briefingLoading}\\n              onClick={() => void handleGenerateBriefing()}\\n              className=\\\"inline-flex min-h-[40px] items-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] disabled:opacity-50 transition-colors whitespace-nowrap\\\"\\n            >\\n              <Sparkles className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" />\\n              <span>{briefingLoading ? \'Generating...\' : t(\'home.runBriefingBtn\')}</span>\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setCommandPaletteOpen(true)}\\n              className=\\\"inline-flex min-h-[40px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-3.5 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)] transition-colors whitespace-nowrap\\\"\\n            >\\n              <span>{t(\'common.quickAction\')}</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"mt-4 pt-4 border-t border-[var(--border-hairline)]\\\">\\n          {!briefingResult ? (\\n            <p className=\\\"text-sm leading-relaxed text-[var(--text-secondary)]\\\">\\n              {t(\'home.briefingEmpty\')}\\n            </p>\\n          ) : briefingResult.ok ? (\\n            <div>\\n              <p className=\\\"text-sm leading-relaxed text-[var(--text-primary)]\\\">\\n                {briefingResult.data.summary}\\n              </p>\\n              <div className=\\\"mt-2 font-numeric text-xs text-[var(--text-muted)]\\\">\\n                {briefingResult.meta.modelUsed} \302\267{\' \'}\\n                {briefingResult.meta.cached ? \'Cached\' : `${briefingResult.meta.latencyMs}ms`}\\n              </div>\\n            </div>\\n          ) : (\\n            <p className=\\\"text-sm text-amber-700 dark:text-amber-300\\\">{briefingResult.error}</p>\\n          )}\\n        </div>\\n      </section>\\n\\n      {/* Module Architecture List (Clean Hairline Rows, Zero Card-in-Card Nesting) */}\\n      <section>\\n        <div className=\\\"flex items-baseline justify-between mb-3\\\">\\n          <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n            {t(\'home.foundationModulesTitle\')}\\n          </h2>\\n          <span className=\\\"text-xs text-[var(--text-muted)]\\\">\\n            Firestore rules &amp; repository contracts active\\n          </span>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)] overflow-hidden\\\">\\n          {MODULE_SPECS.map((mod) => {\\n            const Icon = mod.icon;\\n            return (\\n              <button\\n                key={mod.id}\\n                type=\\\"button\\\"\\n                onClick={() => setActiveRoute(mod.id)}\\n                className=\\\"w-full min-h-[64px] px-5 py-4 text-start flex items-center justify-between gap-4 hover:bg-[var(--bg-subtle)]/60 transition-colors\\\"\\n              >\\n                <div className=\\\"flex items-start gap-3.5 min-w-0\\\">\\n                  <div className=\\\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[var(--bg-subtle)] text-[var(--accent)]\\\">\\n                    <Icon className=\\\"h-4 w-4\\\" />\\n                  </div>\\n                  <div className=\\\"min-w-0\\\">\\n                    <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                      <span className=\\\"text-sm font-semibold text-[var(--text-primary)]\\\">\\n                        {t(mod.titleKey)}\\n                      </span>\\n                      <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\\n                        \302\267\\n                      </span>\\n                      <span className=\\\"font-numeric text-xs text-[var(--text-muted)]\\\">\\n                        Phase {mod.phase}\\n                      </span>\\n                      <span aria-hidden=\\\"true\\\" className=\\\"hidden sm:inline text-xs text-[var(--text-muted)]\\\">\\n                        \302\267\\n                      </span>\\n                      <span className=\\\"hidden sm:inline font-numeric text-xs text-[var(--text-muted)]\\\">\\n                        {mod.collection}\\n                      </span>\\n                    </div>\\n                    <p className=\\\"mt-0.5 text-xs text-[var(--text-secondary)] line-clamp-2\\\">\\n                      {mod.summary}\\n                    </p>\\n                  </div>\\n                </div>\\n                <ArrowUpRight className=\\\"h-4 w-4 shrink-0 text-[var(--text-muted)]\\\" />\\n              </button>\\n            );\\n          })}\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create HomeView dashboard displaying real dual-currency posture, AI daily quota, Privacy Gate status, Daily Briefing preview, and module rollout navigation.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/home/ui/HomeView.tsx\", \"toolAction\":\"Creating HomeView component\", \"toolSummary\":\"Create HomeView\"}"
      thinking_signature: "\022\236\"\n\233\"\001i\024}\023\202%\033R\204\bY\323\302\374\376\251MP\360A\\\0236E\0314Q\201\005PI\205\205\232\033\275\262\337\222\3327\351\351)\310\321hF\033\273\362\2304\222\313,\212\277\200\v\016z\r\n\253(\227!!-\203\363\301\vS\326\345\367+kX\'Y(\372o\351q\272\363\255\376\252S\341?a\023\315\002v\025[>\235O\273\200\325\361C\346f\235ZG\v\2236\244\245M`H/{in\225 u6\341H\370\203yW\330\245Yp\336\316\241\002\256\371\021\372\336\332\267\307\211\257\bU\342\203\267\303\363\177K3\372\254-\304T$\016\230\243\334i|\026\262\311\200\304\331KS|\375\361|\n\003i\365( \341\226\274]\214\257k\366*\362\a\261T|\215\306\356\265\221\270\025\225\251S\357\347\022W\215c\027\273\264{K\320\022$\352q\f-P\305\363\333\335\374\375\217\377.\362\353\v\257\356\377\361\3310x\"\224\243Y\006\242f\320^\314\276\353\237\216\316J\223\2447\263RiD\304\331\023In\233\224\230\356\301\275\3276\233\207\256\264\212\207\205;\247/\317Y\222\266\032\214\364\017\207=M\301/\354^\232T\3343\257\220k\305\217L\230TRi\364P\b\204\n\267\202\327\177\354`\2176\263W\023\374\357\b\205\262w\2148\277\037\033\003l\261\t?r=@U\024s,\372\222:\365\ve\022\206x8X\275\017\271t\371$2\305\r)\363\216\276\275W?\2577;\336\372\3241\300\004*A[a\017\356+ \032iR\375\360%\200\027p\210 \v\331\025\215\214\035\256\224\227*r2\220\222\344\037\275\aTsK\305\261\0241\352\214\376\333\351\356^\250:IxK\343\356\324\272\032\247f\236Q\177\031NHSG\333\230\340F_5xq[\275X\253\022\016\355\230z\315C\3345^)\340\261\304b\222\256\366A|\217.SlD\033O\224\315\374\244\242\026\234\321+\200\036\244t68\320B\3013\343ZCs;\004\343\267\376:*\207-\375\242SG\365)\vCW\241\304f\025\r\222\211\003a\035\227\257\025.*\tF\022`\217\260\177\363\004\334\0245|\033E)\212M\356\236y\212I\360\r\"\370\027\310B*\037\361O\355\221>\323\370M\261\201_\255\265\325v\322\032B&\2169\364\261\344\232\234\247\022\256\222J/\303SV\r\252\271\247\a6\'$\031\201\271\v\260s],\323\000\303\326\216\023R\n\331\244\b\305emmU,\242\270\371\024\017\366g\027U\003``fb#\b\3031\211\376t\241\212\032\024\351\372\232b=\230\"Q\265\370uR\241\220\226\260\372\305\315y\232\334\316\251\006\326\210\277\274q\032y\354S\221\227\036\326\220t\376\005\274\003r\247\312p\231_\r\0231\217I\272^\203\370\355\267T\'+[\374i\245\265\323v,\233:H\246\376\243Z0f\207\t\240\310\326\206\327\316\217\n\0004\251\224y\\\337\307b\252?\\\a#\246\321\312\tg\250\372^u&t\262i\036=\210 %\215\033I{\306\246q\023px\"g\272hX\234\026\345\227;p\363A@\256\304\234Ncv\"\030\371\250\022\247\016\331\221\351\366,\343C\372MxRIo\270-\314\313\267\221\371\035Y\030\a\016j]\vI\020Q\277\250\2366\220\366k\327\334\245|\3144\036\311\361\357\326\304-(\263riW\252\203ql\262\301\200\020\"V\254W\214,\321\334\021\324\241\376\216\023~\272\327\364i>\265\300\360j\004\373\265\270\231\313N\257\305Q\337B\365\"y\210\035\366\254\356\023\r\021\270f\372\221\364\\\267\341\023\335\261v\020x\331\2612\371\204\225\245z\377\375\357\t\276\'4\255p\275\271d\230\t\360#\2030\v\237\213\361\267\352\206\224\r:y)\303\246n\335\370w\262\a{J\203\216\376\244\203\033,H\203\\`(\\\242\315e\221\024;\022\216\005\226b\353\246\231;\031\237Q/\230\264w\332PQ\025p%>\256\234@\037vh\026\317\256\220\252\025\020\334\276\237#\a^\224\324#FZ\321\232y\222\342\a\315\215\256u8\260\350\341\374\275>}\350 \202d\"\231\207\f\005\222\226\233\314\346\256\2248K\037\r\333\207(\344\217\310_\361D\211\327e\321\362\222\205\022K\215$o\260T\275\006\236\351\005\"\237\b\333v&\036\300tcH\203\302]N\376\340qH\252\347\212`S\242\227b}\324\200\bD-\272\347\300{\243\302\304Y\321\242\233\025S\267\354\360u\303\021\377\374\026\227(\236b\327\027>\2055e5\342\017\367\335\342\215\337\275\320\341\246.7.\267%\r\264\201\304r\036\231\341(\355\020O\0202`\037\244\201\342K;\312\233\344X\303\246&xAk\204N\006\002\030-\352\201\032\341\325E\224k[\021V\320\027\332\271YL\016\207\311\367h\214j\376ZC\307B\343**$k\354x\033\r\032K+\027\354\214=324\333\220\220\023\206do\241^aX\306]+\360\352\003\253\a:q$\231%\355\242xS\300\305\273\362x \2105M\031>\305|\255ge\332H\035\233\322\244\334\031\340\273~YB6\2142\245\237z\275\254C\276t\234\211O\227\302\304\201!\363\030\340\232n\257Q_/\177\324Y\310\r\271\337\210\221~u\236B!\225\272A\222|,\326\033\016O\0172\t\226i~\354\302\031xy\242\251\312\216\254W8vPH\324_e\367\354\001\335\362F\333\036\aU\216l\265q\326\336\341\246\334\001L\252\224*\260\v\355W4\375:\322Q\246r\234g?!\336\370#\246\362\005\332<\237\354\237Ze\a\252\322=Y}\026\323W9\330\022\331;\210\370\204\031+\272<i[\026LB\023\310\306>\270)\322\350\274E\'0\310\344\330\0039\255\\\225\216\350\202\354\220\223\232J\224E\024\364\"\311yp\211Cv\r\275\364\362*=b\263\377E\205\322\033\036\254\2575\334\326\202\255\244\2001V\254\243\360\2439#\f\344\223@\242\342Qi\226\017u\276 \270\020\343akaY\"\0000\201K<\307\315\341\321\305\243I\355\\\256\016\360\333^\00043=\233\234s\201\324\376\375D{\225\217U\353\266$\022o`\271\336\336\322\207\354\364\257\372\247}\233\253\316\325\203\240\304\200\221-\206\232\336\326\370\262\247d\310\246)\212,\262rw\210\311\342j\2076\310)~\333\177\bY\3119\227s\206\030v\034\033\352\350\221e\310\375\020\307\335,\017\003<y-0+/\304\260e\2452w\204\270\022\017\212\226\246\233N\310\255\205\f\235}\373\343x\236\256\305S}\354\261\262\277\217\233\211c\021\030\205a\272S\336\233nu\346\234Q9\203\'\001\'\277^\v\033\035~\261\b8\246i(\241H\022\266\367Yn\027?&=@l\335\006\361An\201u\3455\262qC\326\233\312\304MRMVz\311r\234%&\240\370\030-\210\223)d\023\266\237\370\264\206\327ul\"0\227V$YV\251\235\251.\215\236\202,Er\006\030\363Q&:f\351\365\207\005<\017<ae=U\205y2\307BU\356\033\016,\001a`\327\027\375\366y\371\211\313M\231\216@\244{\2762\017[\320u\221|\261o\002\355*4^\236\240a\277\365?\314-\341N\213\212\365\347\266\252=I\343\by\276\321\"\"\254\003\016uYG\"F?C\215\274\006`<\271\230\303\213\377\030\206b7\033\257r\216\030\364\023-\305\344M\002\316\306\370\\84\336?F\205\377\'<\350\032\271\277\210I\277sz\361\000\373\237\211w\253 I\361\361xs\177\351\303\260\260?\371\271OC\256w8?\2209\362D\2533\004\006o\331\377\r\340\354\314\242\317\305s\336%\017\363\271\177\343s\346\373$\216\314\201\262\'\035P\365\031Z\303\345\214\227\273\226