257\331\206\333\225\331\210\333\225\333\214 \332\225\333\225\330\264\331\206\331\210\331\210\330\263\',\n        aiDraftNotice: \'\332\225\333\225\330\264\331\206\331\210\331\210\330\263\333\225\332\251\333\225 \330\250\333\225 AI \330\246\330\247\331\205\330\247\330\257\333\225 \332\251\330\261\330\247 \342\200\224 \331\276\333\216\330\264 \331\276\330\247\330\264\333\225\332\251\333\225\331\210\330\252\332\251\330\261\330\257\331\206 \331\276\333\216\330\257\330\247\332\206\331\210\331\210\331\206\333\225\331\210\333\225 \330\250\332\251\333\225.\',\n        payFullBtn: \'\330\257\330\247\331\206\333\225\331\210\333\225\333\214 \331\207\333\225\331\205\331\210\331\210 \331\205\330\247\331\210\333\225\332\251\333\225\',\n        paymentMethod: \'\330\264\333\216\331\210\330\247\330\262\333\214 \331\276\330\247\330\261\333\225\330\257\330\247\331\206\',\n        paymentDate: \'\330\250\333\225\330\261\331\210\330\247\330\261\333\214 \331\276\330\247\330\261\333\225\330\257\330\247\331\206\',\n        confirmPayment: \'\330\252\333\206\331\205\330\247\330\261\332\251\330\261\330\257\331\206\333\214 \331\276\330\247\330\261\333\225\330\257\330\247\331\206\',\n        reminderTitle: \'\330\246\330\247\331\205\330\247\330\257\333\225\332\251\330\261\330\257\331\206\333\214 \331\206\330\247\331\205\333\225\333\214 \330\250\333\214\330\261\330\256\333\225\330\261\333\225\331\210\333\225\',\n        toneGentle: \'\331\206\333\225\330\261\331\205 \331\210 \330\257\333\206\330\263\330\252\330\247\331\206\333\225\',\n        toneFirm: \'\330\254\330\257\333\214\',\n        toneFormal: \'\331\201\333\225\330\261\331\205\333\214\',\n        generateDraft: \'\330\246\330\247\331\205\330\247\330\257\333\225\332\251\330\261\330\257\331\206\333\214 \331\206\330\247\331\205\333\225\',\n        copyMessage: \'\332\251\333\206\331\276\333\214\332\251\330\261\330\257\331\206\333\214 \331\206\330\247\331\205\333\225\',\n        openWhatsApp: \'\331\210\330\247\330\252\330\263\330\246\333\225\331\276\',\n        snowball: \'\330\252\333\206\331\276\333\214 \330\250\333\225\331\201\330\261 (\330\250\332\206\331\210\331\210\332\251\330\252\330\261\333\214\331\206 \333\214\333\225\332\251\333\225\331\205)\',\n        avalanche: \'\331\207\333\225\330\261\333\225\330\263 (\330\262\333\206\330\261\330\252\330\261\333\214\331\206 \330\263\331\210\331\210\330\257 \333\214\333\225\332\251\333\225\331\205)\',\n        monthlyBudget: \'\330\250\331\210\330\257\330\254\333\225\333\214 \331\205\330\247\331\206\332\257\330\247\331\206\333\225\333\214 \330\257\330\247\331\206\333\225\331\210\333\225\',\n        monthsToFree: \'\331\205\330\247\331\206\332\257 \330\252\330\247 \330\252\333\225\331\210\330\247\331\210\330\250\331\210\331\210\331\206\333\214 \331\202\333\225\330\261\330\262\',\n        estInterest: \'\330\263\331\210\331\210\330\257\333\214 \330\256\333\225\331\205\332\265\333\216\331\206\330\261\330\247\331\210\',\n        interestSaved: \'\331\207\333\225\330\261\333\225\330\263 \331\276\330\247\330\264\333\225\332\251\333\225\331\210\330\252 \330\257\333\225\332\251\330\247\330\252\',\n        inflow: \'\331\207\330\247\330\252\331\210\331\210\333\214 \332\206\330\247\331\210\333\225\332\225\331\210\330\247\331\206\332\251\330\261\330\247\331\210\',\n        outflow: \'\330\257\330\247\331\206\333\225\331\210\333\225\333\214 \330\257\333\214\330\247\330\261\333\214\332\251\330\261\330\247\331\210\',\n        netCash: \'\331\276\331\210\330\256\330\252\333\225\333\214 \331\206\333\225\330\256\330\252\333\214\331\206\333\225\',\n        paymentHistory: \'\330\252\333\206\331\205\330\247\330\261\333\214 \331\276\330\247\330\261\333\225\330\257\330\247\331\206\333\225\332\251\330\247\331\206\',\n        noPaymentsYet: \'\331\207\333\216\330\264\330\252\330\247 \331\207\333\214\332\206 \331\276\330\247\330\261\333\225\330\257\330\247\331\206\333\216\332\251 \330\252\333\206\331\205\330\247\330\261 \331\206\333\225\332\251\330\261\330\247\331\210\333\225.\',\n        deleteDebt: \'\330\263\332\225\333\214\331\206\333\225\331\210\333\225\333\214 \331\202\333\225\330\261\330\262\',\n        statusActive: \'\332\206\330\247\331\204\330\247\332\251\',\n        statusPartial: \'\330\250\333\225\330\264\333\216\332\251 \330\257\330\261\330\247\331\210\333\225\',\n        statusOverdue: \'\330\257\331\210\330\247\332\251\333\225\331\210\330\252\331\210\331\210\',\n        statusSettled: \'\330\252\333\225\331\210\330\247\331\210 \330\250\331\210\331\210\333\225\',\n      },\n    },\n  },"
