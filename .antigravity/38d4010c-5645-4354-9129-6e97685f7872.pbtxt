    tool_calls {
      id: "call_1984215917586747968"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Extend Firestore rules test suite to verify Phase 2 DebtPayment subcollection and debt action-split invariants.\", \"EndLine\":45, \"Instruction\":\"Assert payments subcollection immutability and debt remainingMinor/status synchronization invariant.\", \"ReplacementContent\":\"  assert.match(rules, /existing\\\\(\\\\)\\\\.status != \'settled\'/);\\n  assert.match(rules, /match \\\\/payments\\\\/\\\\{paymentId\\\\}[\\\\s\\\\S]*allow update: if false;/);\\n  assert.match(rules, /isValidDebtPayment/);\\n});\\n\\ntest(\'firebase-blueprint.json paths are all covered in firestore.rules\', () => {\\n  const rules = fs.readFileSync(path.resolve(process.cwd(), \'firestore.rules\'), \'utf8\');\\n  const blueprint = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), \'firebase-blueprint.json\'), \'utf8\'));\\n  const expectedCollections = [\\n    \'entitlements\',\\n    \'aiUsage\',\\n    \'debtLedgers\',\\n    \'debts\',\\n    \'payments\',\\n    \'reminders\',\\n    \'tasks\',\\n    \'notes\',\\n    \'documents\',\\n    \'habits\',\\n    \'transactions\',\\n  ];\\n  assert.ok(blueprint.firestore[\'/users/{userId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/debts/{debtId}/payments/{paymentId}\']);\\n  for (const col of expectedCollections) {\\n    assert.ok(rules.includes(`match /${col}/`), `Missing security rule match block for collection: ${col}`);\\n  }\\n});\", \"StartLine\":22, \"TargetContent\":\"  assert.match(rules, /existing\\\\(\\\\)\\\\.status != \'settled\'/);\\n});\\n\\ntest(\'firebase-blueprint.json paths are all covered in firestore.rules\', () => {\\n  const rules = fs.readFileSync(path.resolve(process.cwd(), \'firestore.rules\'), \'utf8\');\\n  const blueprint = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), \'firebase-blueprint.json\'), \'utf8\'));\\n  const expectedCollections = [\\n    \'entitlements\',\\n    \'aiUsage\',\\n    \'debtLedgers\',\\n    \'debts\',\\n    \'reminders\',\\n    \'tasks\',\\n    \'notes\',\\n    \'documents\',\\n    \'habits\',\\n    \'transactions\',\\n  ];\\n  assert.ok(blueprint.firestore[\'/users/{userId}\']);\\n  for (const col of expectedCollections) {\\n    assert.ok(rules.includes(`match /${col}/`), `Missing security rule match block for collection: ${col}`);\\n  }\\n});\", \"TargetFile\":\"/firestore.rules.test.ts\", \"toolAction\":\"Updating Firestore rules test assertions\", \"toolSummary\":\"Update firestore.rules.test.ts\"}"
      original_name: "replace_file_content"
    }
