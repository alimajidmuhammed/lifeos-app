      thinking_signature: "\022\254\003\n\251\003\001i\024}\023\363\224\363\222\355\206\321M\206\037\340\361\342#>\354\241c\tw\025\265\342\362\re!}x\304G/\254\263_\265\036o]^\345j\027\3009\352\327~\270\274M[\342]\324\360\237Eb\261\341\375\2507\000\202\025\362d\343\260\253\025\204l\005\200\327\r\353\364\220}\335\210\343\221\344V`\334H\361\235,\375\210\262\3043\326\304\003\351\036%-\0237\270\337\3663\300U\257\335\3165\335\035g\277\026-&\022\210\302\300\332C~7\366*\270\244m\313j\rtE\210\237\304\245#u\022\244}?O\200f\215\303\352\273\b\336^\213m\303\231\230Y\211tF\372\307\264X\246\311\t\233%9\304Z\347\\\334\206\244\247&\214\3565\222\372PQ\365\361V\262\310\360R\211x\035\306z\b.>\336F;\244A\365\ak0\336\ad\266\225\au\3242\001\212\313\252\213\237\307l\254\337\247\323 \370\027o\266\311[\177\313\270\352\300\024\220]\336.\357\tAr\016kJ\001\364SvG.\204\222\215\326\035)\366\336\354\0225\\\331\267\214\372\262\324oF\2304\212+\2079\360\340!\021h\230\263|\246c2\t\312\217\221\257\2752\022\vm\026C\033n\366\3143\363\347,\036\343\362\213\306ik\261T\331\026\211\237\361\313hB\325/E\203\210\203G\252[\373\230\361\353\301:\'{\347\247y\263\212\231@\"\275U\234\377?bV\264\2047\263\221\344\223Pt$\274\362\241\n\227%\334\314`\361\316\252S\370\221\306\026\253\034\304\300\316\200\027\236\221\265\367\300#"
