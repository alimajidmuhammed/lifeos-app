        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "sortKey", "isLockedFolder", "version", "createdAt", "updatedAt"]
    },
    "NoteItem": {
      "title": "NoteItem",
      "description": "Markdown or opt-in AES-256-GCM E2E encrypted note with optional nested folder and tags.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
