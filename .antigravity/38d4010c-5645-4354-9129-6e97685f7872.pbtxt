  code_action {
    action_spec {
      command {
        instruction: "Import useHabits and useFinance, mark Habits & Finance active in MODULE_SPECS, and include them in the Home Daily Briefing summary"
        is_edit: true
        file {
          absolute_uri: "file:///src/features/home/ui/HomeView.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "import { useVault } from \'../../../hooks/useVault\';\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';"
          replacement_content: "import { useVault } from \'../../../hooks/useVault\';\nimport { useHabits } from \'../../../hooks/useHabits\';\nimport { useFinance } from \'../../../hooks/useFinance\';\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';"
          start_line: 23
          end_line: 26
        }
        replacement_chunks {
          target_content: "  {\n    id: \'habits\',\n    titleKey: \'nav.habits\',\n    phase: 6,\n    icon: Flame,\n    collection: \'users/{uid}/habits + habitLogs\',\n    summary: \'Monthly-bucketed streak heatmaps, haptics, and break-pattern insights.\',\n  },\n  {\n    id: \'finance\',\n    titleKey: \'nav.finance\',\n    phase: 6,\n    icon: Wallet,\n    collection: \'users/{uid}/transactions\',\n    summary: \'Income/expense ledger in integer minor units, budgets, subscriptions, and CSV import/export.\',\n  },\n];"
          replacement_content: "  {\n    id: \'habits\',\n    titleKey: \'nav.habits\',\n    active: true,\n    icon: Flame,\n    collection: \'users/{uid}/habits + habitLogs\',\n    summary: \'Monthly-bucketed streak heatmaps, haptics, and deterministic break-pattern insights.\',\n  },\n  {\n    id: \'finance\',\n    titleKey: \'nav.finance\',\n    active: true,\n    icon: Wallet,\n    collection: \'users/{uid}/transactions + budgets + subscriptions\',\n    summary: \'Income/expense ledger in integer minor units, budgets, subscriptions, and formula-safe CSV import/export.\',\n  },\n];"
          start_line: 78
          end_line: 95
        }
        replacement_chunks {
          target_content: "  const { summary: vaultSummary } = useVault();\n\n  const [briefingLoading, setBriefingLoading] = useState(false);\n  const [briefingResult, setBriefingResult] = useState<AIResult | null>(null);\n\n  const dayKey = getTodayDayKey();\n  const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\n  const quota = evaluateDailyAiQuota(usedToday, entitlements);\n  const quotaPercent = Math.min(100, Math.round((quota.usedToday / Math.max(1, quota.dailyLimit)) * 100));\n  const debtMetrics = aggregateDebtMetrics(debts, profile.primaryCurrency, fxRates, dayKey);\n\n  const handleGenerateBriefing = async () => {\n    if (!profile.aiGlobalEnabled) {\n      setBriefingResult({\n        ok: false,\n        code: \'AI_DISABLED\',\n        error: t(\'assistant.disabledNotice\'),\n      });\n      return;\n    }\n    if (!quota.allowed) {\n      setBriefingResult({\n        ok: false,\n        code: \'DAILY_QUOTA_REACHED\',\n        error: `Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}).`,\n      });\n      return;\n    }\n\n    setBriefingLoading(true);\n    const netFmt = formatMoney(debtMetrics.equivalentNetPrimaryMinor, profile.primaryCurrency, profile.locale);\n    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders due today: ${remSummary.dueTodayCount}, overdue reminders: ${remSummary.overdueCount}, scheduled rolling queue slots: ${rollingQueue.slots.length}/64, active planner tasks: ${plannerSummary.activeCount} (${plannerSummary.dueTodayCount} due today), total notes: ${notesSummary.totalNotes} (${notesSummary.lockedCount} E2E locked \342\200\224 contents never sent), vault documents: ${vaultSummary.totalDocs} (expired: ${vaultSummary.expiredCount}, expiring within 90 days: ${vaultSummary.expiring90Count} \342\200\224 raw scans never sent). Suggest one practical next step.`;"
          replacement_content: "  const { summary: vaultSummary } = useVault();\n  const { summary: habitsSummary } = useHabits();\n  const { monthlySummary: financeSummary, subscriptionMetrics } = useFinance();\n\n  const [briefingLoading, setBriefingLoading] = useState(false);\n  const [briefingResult, setBriefingResult] = useState<AIResult | null>(null);\n\n  const dayKey = getTodayDayKey();\n  const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\n  const quota = evaluateDailyAiQuota(usedToday, entitlements);\n  const quotaPercent = Math.min(100, Math.round((quota.usedToday / Math.max(1, quota.dailyLimit)) * 100));\n  const debtMetrics = aggregateDebtMetrics(debts, profile.primaryCurrency, fxRates, dayKey);\n\n  const handleGenerateBriefing = async () => {\n    if (!profile.aiGlobalEnabled) {\n      setBriefingResult({\n        ok: false,\n        code: \'AI_DISABLED\',\n        error: t(\'assistant.disabledNotice\'),\n      });\n      return;\n    }\n    if (!quota.allowed) {\n      setBriefingResult({\n        ok: false,\n        code: \'DAILY_QUOTA_REACHED\',\n        error: `Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}).`,\n      });\n      return;\n    }\n\n    setBriefingLoading(true);\n    const netFmt = formatMoney(debtMetrics.equivalentNetPrimaryMinor, profile.primaryCurrency, profile.locale);\n    const finNetFmt = formatMoney(financeSummary.netPrimaryMinor, profile.primaryCurrency, profile.locale);\n    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders due today: ${remSummary.dueTodayCount}, overdue reminders: ${remSummary.overdueCount}, scheduled rolling queue slots: ${rollingQueue.slots.length}/64, active planner tasks: ${plannerSummary.activeCount} (${plannerSummary.dueTodayCount} due today), total notes: ${notesSummary.totalNotes} (${notesSummary.lockedCount} E2E locked \342\200\224 contents never sent), vault documents: ${vaultSummary.totalDocs} (expired: ${vaultSummary.expiredCount}, expiring within 90 days: ${vaultSummary.expiring90Count} \342\200\224 raw scans never sent), habits completed today: ${habitsSummary.completedTodayCount}/${habitsSummary.activeCount} (best streak ${habitsSummary.bestActiveStreak}d), monthly finance net cashflow: ${finNetFmt} (${financeSummary.transactionCount} tx, ${subscriptionMetrics.activeCount} active subscriptions). Suggest one practical next step.`;"
