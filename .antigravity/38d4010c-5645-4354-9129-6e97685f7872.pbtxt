  view_file {
    absolute_path_uri: "file:///src/features/home/ui/HomeView.tsx"
    end_line: 385
    content: "import React, { useState } from \'react\';\nimport {\n  ArrowUpRight,\n  Bell,\n  BookText,\n  CheckSquare,\n  Flame,\n  FolderLock,\n  Scale,\n  ShieldCheck,\n  Sparkles,\n  Wallet,\n} from \'lucide-react\';\nimport { useTranslation } from \'react-i18next\';\nimport { formatMoney } from \'../../../core/currency/currency\';\nimport { aggregateDebtMetrics } from \'../../../core/debts/debtEngine\';\nimport { evaluateDailyAiQuota, getTodayDayKey } from \'../../../core/entitlements/entitlements\';\nimport { defaultLLMProvider, type AIResult } from \'../../../core/ai/llmProvider\';\nimport { aiUsageRepository } from \'../../../data/repositories/firebaseWebAdapter\';\nimport { useDebts } from \'../../../hooks/useDebts\';\nimport { useReminders } from \'../../../hooks/useReminders\';\nimport { usePlanner } from \'../../../hooks/usePlanner\';\nimport { useNotes } from \'../../../hooks/useNotes\';\nimport { useVault } from \'../../../hooks/useVault\';\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\n\ninterface ModuleCardSpec {\n  id: NavRoute;\n  titleKey: string;\n  phase?: number;\n  active?: boolean;\n  icon: React.ComponentType<{ className?: string }>;\n  collection: string;\n  summary: string;\n}\n\nconst MODULE_SPECS: ModuleCardSpec[] = [\n  {\n    id: \'debts\',\n    titleKey: \'nav.debts\',\n    active: true,\n    icon: Scale,\n    collection: \'users/{uid}/debts + debtLedgers\',\n    summary: \'Multi-currency IQD/USD ledgers, deterministic repayment probability, snowball/avalanche plans, and EN/AR/KU reminder drafts.\',\n  },\n  {\n    id: \'reminders\',\n    titleKey: \'nav.reminders\',\n    active: true,\n    icon: Bell,\n    collection: \'users/{uid}/reminders\',\n    summary: \'RRULE recurrence engine, 8 channels, quiet hours, and unit-tested rolling 64-notification scheduler.\',\n  },\n  {\n    id: \'planner\',\n    titleKey: \'nav.planner\',\n    active: true,\n    icon: CheckSquare,\n    collection: \'users/{uid}/tasks\',\n    summary: \'Single-write fractional-index task ordering, subtasks, unified calendar, and AI goal breakdown.\',\n  },\n  {\n    id: \'notes\',\n    titleKey: \'nav.notes\',\n    active: true,\n    icon: BookText,\n    collection: \'users/{uid}/notes + noteFolders + versions\',\n    summary: \'Markdown notes, nested folders, version history, and opt-in AES-256-GCM locked notes.\',\n  },\n  {\n    id: \'vault\',\n    titleKey: \'nav.vault\',\n    active: true,\n    icon: FolderLock,\n    collection: \'Local-Only Vault + users/{uid}/documents + vaultFolders\',\n    summary: \'Zero-billing local document storage, multi-page PDF scan pipeline, expiry alerts, opt-in E2E encryption, and privacy-gated OCR.\',\n  },\n  {\n    id: \'habits\',\n    titleKey: \'nav.habits\',\n    phase: 6,\n    icon: Flame,\n    collection: \'users/{uid}/habits + habitLogs\',\n    summary: \'Monthly-bucketed streak heatmaps, haptics, and break-pattern insights.\',\n  },\n  {\n    id: \'finance\',\n    titleKey: \'nav.finance\',\n    phase: 6,\n    icon: Wallet,\n    collection: \'users/{uid}/transactions\',\n    summary: \'Income/expense ledger in integer minor units, budgets, subscriptions, and CSV import/export.\',\n  },\n];\n\nexport const HomeView: React.FC = () => {\n  const { t } = useTranslation();\n  const profile = useUIStore((s) => s.profile);\n  const authUser = useUIStore((s) => s.authUser);\n  const entitlements = useUIStore((s) => s.entitlements);\n  const todayAiUsage = useUIStore((s) => s.todayAiUsage);\n  const pinEnabled = useUIStore((s) => s.pinEnabled);\n  const setActiveRoute = useUIStore((s) => s.setActiveRoute);\n  const setCommandPaletteOpen = useUIStore((s) => s.setCommandPaletteOpen);\n  const incrementLocalAiUsage = useUIStore((s) => s.incrementLocalAiUsage);\n\n  const { debts, fxRates } = useDebts();\n  const { summary: remSummary, rollingQueue } = useReminders();\n  const { summary: plannerSummary } = usePlanner();\n  const { summary: notesSummary } = useNotes();\n  const { summary: vaultSummary } = useVault();\n\n  const [briefingLoading, setBriefingLoading] = useState(false);\n  const [briefingResult, setBriefingResult] = useState<AIResult | null>(null);\n\n  const dayKey = getTodayDayKey();\n  const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\n  const quota = evaluateDailyAiQuota(usedToday, entitlements);\n  const quotaPercent = Math.min(100, Math.round((quota.usedToday / Math.max(1, quota.dailyLimit)) * 100));\n  const debtMetrics = aggregateDebtMetrics(debts, profile.primaryCurrency, fxRates, dayKey);\n\n  const handleGenerateBriefing = async () => {\n    if (!profile.aiGlobalEnabled) {\n      setBriefingResult({\n        ok: false,\n        code: \'AI_DISABLED\',\n        error: t(\'assistant.disabledNotice\'),\n      });\n      return;\n    }\n    if (!quota.allowed) {\n      setBriefingResult({\n        ok: false,\n        code: \'DAILY_QUOTA_REACHED\',\n        error: `Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}).`,\n      });\n      return;\n    }\n\n    setBriefingLoading(true);\n    const netFmt = formatMoney(debtMetrics.equivalentNetPrimaryMinor, profile.primaryCurrency, profile.locale);\n    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders due today: ${remSummary.dueTodayCount}, overdue reminders: ${remSummary.overdueCount}, scheduled rolling queue slots: ${rollingQueue.slots.length}/64, active planner tasks: ${plannerSummary.activeCount} (${plannerSummary.dueTodayCount} due today), total notes: ${notesSummary.totalNotes} (${notesSummary.lockedCount} E2E locked \342\200\224 contents never sent), vault documents: ${vaultSummary.totalDocs} (expired: ${vaultSummary.expiredCount}, expiring within 90 days: ${vaultSummary.expiring90Count} \342\200\224 raw scans never sent). Suggest one practical next step.`;\n    const res = await defaultLLMProvider.complete(\n      {\n        module: \'assistant\',\n        taskType: \'briefing\',\n        text: prompt,\n        locale: profile.locale,\n        tier: \'lite\',\n      },\n      true\n    );\n    setBriefingResult(res);\n    setBriefingLoading(false);\n\n    if (res.ok && !res.meta.cached) {\n      incrementLocalAiUsage(dayKey, res.meta.inputTokensEst, res.meta.outputTokensEst);\n      if (authUser) {\n        void aiUsageRepository.recordUsage(\n          authUser.uid,\n          dayKey,\n          todayAiUsage.dayKey === dayKey ? todayAiUsage : null,\n          res.meta.inputTokensEst,\n          res.meta.outputTokensEst\n        );\n      }\n    }\n  };\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Page Header */}\n      <section className=\"flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between\">\n        <div>\n          <p className=\"text-xs font-medium text-[var(--text-muted)]\">\n            <span>{authUser ? t(\'common.syncedCloudMode\') : t(\'common.offlineLocalMode\')}</span>\n            <span aria-hidden=\"true\"> \302\267 </span>\n            <span>{t(\'common.phaseReady\')}</span>\n            <span aria-hidden=\"true\"> \302\267 </span>\n            <span className=\"font-numeric\">{dayKey}</span>\n          </p>\n          <h1 className=\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]\">\n            {t(\'home.greeting\')}, {authUser?.displayName || profile.displayName}\n          </h1>\n          <p className=\"mt-1.5 max-w-2xl text-sm text-[var(--text-secondary)]\">\n            {t(\'home.subtitle\')}\n          </p>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveRoute(\'settings\')}\n          className=\"self-start sm:self-auto inline-flex min-h-[42px] items-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors whitespace-nowrap\"\n        >\n          <ShieldCheck className=\"h-4 w-4 text-[var(--accent)]\" />\n          <span>{t(\'nav.settings\')}</span>\n        </button>\n      </section>\n\n      {/* 4-Column Flat KPI / Posture Strip (Single Elevation, Hairline Dividers, Tabular Figures) */}\n      <section\n        aria-label=\"Workspace overview metrics\"\n        className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl border border-[var(--border-hairline)] bg-[var(--border-hairline)] overflow-hidden\"\n      >\n        <div className=\"bg-[var(--bg-surface)] p-5\">\n          <div className=\"text-xs font-medium text-[var(--text-muted)]\">\n            {t(\'debts.netPosition\')} ({profile.primaryCurrency})\n          </div>\n          <div\n            className={`mt-2 font-numeric text-xl font-semibold ${\n              debtMetrics.equivalentNetPrimaryMinor > 0\n                ? \'text-[var(--accent)]\'\n                : debtMetrics.equivalentNetPrimaryMinor < 0\n                  ? \'text-red-600 dark:text-red-400\'\n                  : \'text-[var(--text-primary)]\'\n            }`}\n          >\n            {debtMetrics.equivalentNetPrimaryMinor > 0 ? \'+\' : \'\'}\n            {formatMoney(debtMetrics.equivalentNetPrimaryMinor, profile.primaryCurrency, profile.locale)}\n          </div>\n          <div className=\"mt-1 font-numeric text-xs text-[var(--text-muted)]\">\n            {debtMetrics.totalOpenCount} open \302\267 {debtMetrics.totalOverdueCount} overdue\n          </div>\n        </div>\n\n        <div className=\"bg-[var(--bg-surface)] p-5\">\n          <div className=\"text-xs font-medium text-[var(--text-muted)]\">\n            {t(\'home.aiQuotaTitle\')}\n          </div>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"font-numeric text-xl font-semibold text-[var(--text-primary)]\">\n              {quota.usedToday} / {quota.dailyLimit}\n            </span>\n            <span className=\"text-xs text-[var(--text-muted)]\">({entitlements.plan})</span>\n          </div>\n          <div className=\"mt-2.5 h-1.5 w-full rounded-full bg-[var(--bg-subtle)] overflow-hidden\">\n            <div\n              className=\"h-full rounded-full bg-[var(--accent)] transition-all duration-200\"\n              style={{ width: `${quotaPercent}%` }}\n            />\n          </div>\n        </div>\n\n        <div className=\"bg-[var(--bg-surface)] p-5\">\n          <div className=\"text-xs font-medium text-[var(--text-muted)]\">\n            {t(\'home.vaultPosture\')}\n          </div>\n          <div className=\"mt-2 text-base font-semibold text-[var(--text-primary)]\">\n            {profile.vaultStorageMode === \'local_only\' ? \'Local-Only Vault\' : \'Private Cloud Vault\'}\n          </div>\n          <div className=\"mt-1 font-numeric text-xs text-[var(--text-muted)]\">\n            {vaultSummary.totalDocs} {vaultSummary.totalDocs === 1 ? \'doc\' : \'docs\'} \302\267{\' \'}\n            {vaultSummary.expiredCount + vaultSummary.expiring90Count} expiring \302\267{\' \'}\n            {profile.e2eConfigured ? \'E2E Ready\' : \'E2E Opt-in\'}\n          </div>\n        </div>\n\n        <div className=\"bg-[var(--bg-surface)] p-5\">\n          <div className=\"text-xs font-medium text-[var(--text-muted)]\">\n            {t(\'nav.reminders\')} \302\267 {t(\'reminders.kpiDueToday\')}\n          </div>\n          <div className=\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)] whitespace-nowrap\">\n            {remSummary.dueTodayCount} due today\n          </div>\n          <div className=\"mt-1 font-numeric text-xs text-[var(--text-muted)]\">\n            {remSummary.overdueCount} overdue \302\267 Queue {rollingQueue.slots.length}/64 \302\267 PIN {pinEnabled ? \'On\' : \'Off\'}\n          </div>\n        </div>\n      </section>\n\n      {/* Daily Briefing Surface */}\n      <section className=\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-6\">\n        <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <h2 className=\"text-base font-semibold text-[var(--text-primary)]\">\n              {t(\'home.briefingTitle\')}\n            </h2>\n            <p className=\"mt-0.5 text-xs text-[var(--text-muted)]\">\n              Deterministic totals stay on-device \302\267 AI summarizes only minimal non-sensitive counts\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2.5\">\n            <button\n              type=\"button\"\n              disabled={briefingLoading}\n              onClick={() => void handleGenerateBriefing()}\n              className=\"inline-flex min-h-[40px] items-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] disabled:opacity-50 transition-colors whitespace-nowrap\"\n            >\n              <Sparkles className=\"h-3.5 w-3.5 text-[var(--accent)]\" />\n              <span>{briefingLoading ? \'Generating...\' : t(\'home.runBriefingBtn\')}</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setCommandPaletteOpen(true)}\n              className=\"inline-flex min-h-[40px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-3.5 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)] transition-colors whitespace-nowrap\"\n            >\n              <span>{t(\'common.quickAction\')}</span>\n            </button>\n          </div>\n        </div>\n\n        <div className=\"mt-4 pt-4 border-t border-[var(--border-hairline)]\">\n          {!briefingResult ? (\n            <p className=\"text-sm leading-relaxed text-[var(--text-secondary)]\">\n              {debtMetrics.totalOpenCount > 0 || remSummary.activeCount > 0 || plannerSummary.activeCount > 0 || notesSummary.totalNotes > 0 || vaultSummary.totalDocs > 0\n                ? `${plannerSummary.activeCount} active ${plannerSummary.activeCount === 1 ? \'task\' : \'tasks\'} (${plannerSummary.dueTodayCount} due today) \302\267 ${remSummary.activeCount} active ${remSummary.activeCount === 1 ? \'reminder\' : \'reminders\'} \302\267 ${debtMetrics.totalOpenCount} open ${debtMetrics.totalOpenCount === 1 ? \'debt\' : \'debts\'} \302\267 ${vaultSummary.totalDocs} vault ${vaultSummary.totalDocs === 1 ? \'doc\' : \'docs\'} (${vaultSummary.expiredCount + vaultSummary.expiring90Count} expiring). Click \"${t(\'home.runBriefingBtn\')}\" for a 2-sentence summary.`\n                : t(\'home.briefingEmpty\')}\n            </p>\n          ) : briefingResult.ok ? (\n            <div>\n              <p className=\"text-sm leading-relaxed text-[var(--text-primary)]\">\n                {briefingResult.data.summary}\n              </p>\n              <div className=\"mt-2 font-numeric text-xs text-[var(--text-muted)]\">\n                {briefingResult.meta.modelUsed} \302\267{\' \'}\n                {briefingResult.meta.cached ? \'Cached\' : `${briefingResult.meta.latencyMs}ms`}\n              </div>\n            </div>\n          ) : (\n            <p className=\"text-sm text-amber-700 dark:text-amber-300\">{briefingResult.error}</p>\n          )}\n        </div>\n      </section>\n\n      {/* Module Architecture List (Clean Hairline Rows, Zero Card-in-Card Nesting) */}\n      <section>\n        <div className=\"flex items-baseline justify-between mb-3\">\n          <h2 className=\"text-base font-semibold text-[var(--text-primary)]\">\n            {t(\'home.foundationModulesTitle\')}\n          </h2>\n          <span className=\"text-xs text-[var(--text-muted)]\">\n            Firestore rules &amp; repository contracts active\n          </span>\n        </div>\n\n        <div className=\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)] overflow-hidden\">\n          {MODULE_SPECS.map((mod) => {\n            const Icon = mod.icon;\n            return (\n              <button\n                key={mod.id}\n                type=\"button\"\n                onClick={() => setActiveRoute(mod.id)}\n                className=\"w-full min-h-[64px] px-5 py-4 text-start flex items-center justify-between gap-4 hover:bg-[var(--bg-subtle)]/60 transition-colors\"\n              >\n                <div className=\"flex items-start gap-3.5 min-w-0\">\n                  <div className=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[var(--bg-subtle)] text-[var(--accent)]\">\n                    <Icon className=\"h-4 w-4\" />\n                  </div>\n                  <div className=\"min-w-0\">\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      <span className=\"text-sm font-semibold text-[var(--text-primary)]\">\n                        {t(mod.titleKey)}\n                      </span>\n                      <span aria-hidden=\"true\" className=\"text-xs text-[var(--text-muted)]\">\n                        \302\267\n                      </span>\n                      <span\n                        className={`font-numeric text-xs ${\n                          mod.active ? \'font-semibold text-[var(--accent)]\' : \'text-[var(--text-muted)]\'\n                        }`}\n                      >\n                        {mod.active ? \'Active\' : `Phase ${mod.phase}`}\n                      </span>\n                      <span aria-hidden=\"true\" className=\"hidden sm:inline text-xs text-[var(--text-muted)]\">\n                        \302\267\n                      </span>\n                      <span className=\"hidden sm:inline font-numeric text-xs text-[var(--text-muted)]\">\n                        {mod.collection}\n                      </span>\n                    </div>\n                    <p className=\"mt-0.5 text-xs text-[var(--text-secondary)] line-clamp-2\">\n                      {mod.summary}\n                    </p>\n                  </div>\n                </div>\n                <ArrowUpRight className=\"h-4 w-4 shrink-0 text-[var(--text-muted)]\" />\n              </button>\n            );\n          })}\n        </div>\n      </section>\n    </div>\n  );\n};\n"
    num_lines: 386
