      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Mount RemindersView for the \'reminders\' route in src/App.tsx.\", \"EndLine\":30, \"Instruction\":\"Import RemindersView and render it when activeRoute === \'reminders\'.\", \"ReplacementContent\":\"import { HomeView } from \'./features/home/ui/HomeView\';\\nimport { DebtsView } from \'./features/debts/ui/DebtsView\';\\nimport { RemindersView } from \'./features/reminders/ui/RemindersView\';\\nimport { SettingsView } from \'./features/settings/ui/SettingsView\';\\nimport { ModuleReadinessView } from \'./features/modules/ui/ModuleReadinessView\';\\nimport { useLifeOSSync } from \'./hooks/useLifeOS\';\\nimport { useUIStore } from \'./state/useUIStore\';\\n\\nfunction LifeOSWorkspace() {\\n  useLifeOSSync();\\n  const activeRoute = useUIStore((s) => s.activeRoute);\\n\\n  return (\\n    <>\\n      <AppShell>\\n        {activeRoute === \'home\' ? (\\n          <HomeView />\\n        ) : activeRoute === \'debts\' ? (\\n          <DebtsView />\\n        ) : activeRoute === \'reminders\' ? (\\n          <RemindersView />\\n        ) : activeRoute === \'settings\' ? (\\n          <SettingsView />\\n        ) : (\\n          <ModuleReadinessView route={activeRoute} />\\n        )}\\n      </AppShell>\", \"StartLine\":6, \"TargetContent\":\"import { HomeView } from \'./features/home/ui/HomeView\';\\nimport { DebtsView } from \'./features/debts/ui/DebtsView\';\\nimport { SettingsView } from \'./features/settings/ui/SettingsView\';\\nimport { ModuleReadinessView } from \'./features/modules/ui/ModuleReadinessView\';\\nimport { useLifeOSSync } from \'./hooks/useLifeOS\';\\nimport { useUIStore } from \'./state/useUIStore\';\\n\\nfunction LifeOSWorkspace() {\\n  useLifeOSSync();\\n  const activeRoute = useUIStore((s) => s.activeRoute);\\n\\n  return (\\n    <>\\n      <AppShell>\\n        {activeRoute === \'home\' ? (\\n          <HomeView />\\n        ) : activeRoute === \'debts\' ? (\\n          <DebtsView />\\n        ) : activeRoute === \'settings\' ? (\\n          <SettingsView />\\n        ) : (\\n          <ModuleReadinessView route={activeRoute} />\\n        )}\\n      </AppShell>\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring RemindersView into App.tsx\", \"toolSummary\":\"Wire RemindersView in App.tsx\"}"
      original_name: "replace_file_content"
    }
