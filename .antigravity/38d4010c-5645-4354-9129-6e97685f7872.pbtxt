              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  showToast: (message, onUndo) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const id = String(Date.now());"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
