  view_file {
    absolute_path_uri: "file:///src/components/AppShell.tsx"
    end_line: 392
    content: "import React, { useEffect } from \'react\';\nimport {\n  Bell,\n  BookText,\n  CheckSquare,\n  Cloud,\n  CloudOff,\n  Flame,\n  FolderLock,\n  Home,\n  LayoutGrid,\n  Lock,\n  LogIn,\n  LogOut,\n  Settings,\n  Sparkles,\n  Wallet,\n  Scale,\n  X,\n} from \'lucide-react\';\nimport { useTranslation } from \'react-i18next\';\nimport { useUIStore, type NavRoute } from \'../state/useUIStore\';\nimport { useOnlineStatus } from \'../hooks/useLifeOS\';\nimport { authRepository } from \'../data/repositories/firebaseWebAdapter\';\nimport { PWAInstallButton } from \'./PWAInstallButton\';\n\ninterface NavItem {\n  id: NavRoute;\n  labelKey: string;\n  icon: React.ComponentType<{ className?: string }>;\n  phase?: number;\n}\n\nexport const ALL_NAV_ITEMS: NavItem[] = [\n  { id: \'home\', labelKey: \'nav.home\', icon: Home },\n  { id: \'debts\', labelKey: \'nav.debts\', icon: Scale, phase: 2 },\n  { id: \'reminders\', labelKey: \'nav.reminders\', icon: Bell, phase: 3 },\n  { id: \'planner\', labelKey: \'nav.planner\', icon: CheckSquare, phase: 4 },\n  { id: \'notes\', labelKey: \'nav.notes\', icon: BookText, phase: 4 },\n  { id: \'vault\', labelKey: \'nav.vault\', icon: FolderLock, phase: 5 },\n  { id: \'habits\', labelKey: \'nav.habits\', icon: Flame, phase: 6 },\n  { id: \'finance\', labelKey: \'nav.finance\', icon: Wallet, phase: 6 },\n  { id: \'settings\', labelKey: \'nav.settings\', icon: Settings },\n];\n\nconst MOBILE_PRIMARY_TABS: NavRoute[] = [\'home\', \'debts\', \'reminders\', \'vault\'];\n\nexport const AppShell: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const { t } = useTranslation();\n  const activeRoute = useUIStore((s) => s.activeRoute);\n  const setActiveRoute = useUIStore((s) => s.setActiveRoute);\n  const setCommandPaletteOpen = useUIStore((s) => s.setCommandPaletteOpen);\n  const mobileMoreOpen = useUIStore((s) => s.mobileMoreOpen);\n  const setMobileMoreOpen = useUIStore((s) => s.setMobileMoreOpen);\n  const authUser = useUIStore((s) => s.authUser);\n  const pinEnabled = useUIStore((s) => s.pinEnabled);\n  const lockApp = useUIStore((s) => s.lockApp);\n  const toast = useUIStore((s) => s.toast);\n  const dismissToast = useUIStore((s) => s.dismissToast);\n  const showToast = useUIStore((s) => s.showToast);\n\n  const isOnline = useOnlineStatus();\n\n  useEffect(() => {\n    window.scrollTo({ top: 0, behavior: \'instant\' as ScrollBehavior });\n  }, [activeRoute]);\n\n  useEffect(() => {\n    if (!toast) return;\n    const timer = window.setTimeout(() => {\n      dismissToast();\n    }, toast.onUndo ? 7000 : 4500);\n    return () => window.clearTimeout(timer);\n  }, [toast, dismissToast]);\n\n  const handleGoogleSignIn = async () => {\n    try {\n      await authRepository.signInWithGoogle();\n      showToast(\'Signed in with Google. Cloud Firestore sync active.\');\n    } catch (err) {\n      const msg = err instanceof Error ? err.message : \'Sign-in cancelled or failed.\';\n      showToast(msg);\n    }\n  };\n\n  const handleSignOut = async () => {\n    try {\n      await authRepository.signOut();\n      showToast(\'Signed out. Local offline workspace remains available.\');\n    } catch {\n      showToast(\'Could not complete sign-out.\');\n    }\n  };\n\n  const activeNavMeta = ALL_NAV_ITEMS.find((i) => i.id === activeRoute) ?? ALL_NAV_ITEMS[0];\n\n  return (\n    <div className=\"min-h-dvh flex bg-[var(--bg-canvas)] text-[var(--text-primary)]\">\n      {/* Desktop / Tablet Sidebar (260px, mirrors automatically in RTL via logical borders/spacing) */}\n      <aside className=\"hidden lg:flex lg:w-[260px] lg:shrink-0 lg:flex-col border-e border-[var(--border-hairline)] bg-[var(--bg-surface)] sticky top-0 h-dvh\">\n        <div className=\"flex h-16 items-center justify-between px-5 border-b border-[var(--border-hairline)]\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveRoute(\'home\')}\n            className=\"flex items-center gap-2.5 text-start focus:outline-none\"\n          >\n            <img\n              src=\"/icon.svg\"\n              alt=\"LifeOS\"\n              className=\"h-7 w-7 rounded-lg shrink-0\"\n            />\n            <span className=\"font-display text-lg font-bold tracking-tight text-[var(--text-primary)] whitespace-nowrap\">\n              {t(\'appName\')}\n            </span>\n          </button>\n          {pinEnabled && (\n            <button\n              type=\"button\"\n              aria-label={t(\'settings.pinLockNowBtn\')}\n              onClick={lockApp}\n              className=\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)] transition-colors\"\n            >\n              <Lock className=\"h-4 w-4\" />\n            </button>\n          )}\n        </div>\n\n        <nav aria-label=\"Main navigation\" className=\"flex-1 overflow-y-auto px-3 py-4 space-y-1\">\n          {ALL_NAV_ITEMS.map((item) => {\n            const Icon = item.icon;\n            const isActive = activeRoute === item.id;\n            return (\n              <button\n                key={item.id}\n                type=\"button\"\n                onClick={() => setActiveRoute(item.id)}\n                className={`w-full min-h-[42px] flex items-center justify-between gap-3 rounded-xl px-3.5 py-2 text-sm font-medium transition-colors ${\n                  isActive\n                    ? \'bg-[var(--accent-soft)] text-[var(--accent)]\'\n                    : \'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]\'\n                }`}\n              >\n                <span className=\"flex items-center gap-3 truncate\">\n                  <Icon className=\"h-[18px] w-[18px] shrink-0\" />\n                  <span className=\"truncate\">{t(item.labelKey)}</span>\n                </span>\n                {item.phase && (\n                  <span className=\"font-numeric text-[11px] text-[var(--text-muted)] shrink-0\">\n                    P{item.phase}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Account & Install Footer */}\n        <div className=\"border-t border-[var(--border-hairline)] p-4 space-y-3\">\n          <PWAInstallButton />\n\n          {authUser ? (\n            <div className=\"flex items-center justify-between gap-2\">\n              <div className=\"min-w-0\">\n                <div className=\"truncate text-xs font-semibold text-[var(--text-primary)]\">\n                  {authUser.displayName}\n                </div>\n                <div className=\"flex items-center gap-1.5 text-[11px] text-[var(--text-muted)]\">\n                  <Cloud className=\"h-3 w-3 text-[var(--accent)] shrink-0\" />\n                  <span className=\"truncate\">{t(\'common.syncedCloudMode\')}</span>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                aria-label={t(\'common.signOut\')}\n                onClick={() => void handleSignOut()}\n                className=\"inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-primary)]\"\n              >\n                <LogOut className=\"h-4 w-4\" />\n              </button>\n            </div>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={() => void handleGoogleSignIn()}\n              className=\"w-full min-h-[42px] inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors whitespace-nowrap\"\n            >\n              <LogIn className=\"h-4 w-4 text-[var(--accent)]\" />\n              <span>{t(\'common.signInGoogle\')}</span>\n            </button>\n          )}\n        </div>\n      </aside>\n\n      {/* Main Content Column */}\n      <div className=\"flex-1 flex flex-col min-w-0\">\n        {/* Top Bar: Compact 52px on mobile, 64px 3-zone header on desktop */}\n        <header className=\"sticky top-0 z-30 h-[52px] lg:h-16 border-b border-[var(--border-hairline)] bg-[var(--bg-surface)]/90 backdrop-blur-md px-4 lg:px-8 flex items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-2.5 min-w-0\">\n            <img\n              src=\"/icon.svg\"\n              alt=\"LifeOS\"\n              className=\"h-6 w-6 rounded-md lg:hidden shrink-0\"\n            />\n            <span className=\"text-sm font-medium text-[var(--text-muted)] hidden lg:inline whitespace-nowrap\">\n              {t(\'appName\')}\n            </span>\n            <span aria-hidden=\"true\" className=\"hidden lg:inline text-[var(--text-muted)]\">\n              /\n            </span>\n            <span className=\"text-sm lg:text-base font-semibold text-[var(--text-primary)] truncate\">\n              {t(activeNavMeta.labelKey)}\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2 sm:gap-3 shrink-0\">\n            <button\n              type=\"button\"\n              onClick={() => setCommandPaletteOpen(true)}\n              className=\"inline-flex min-h-[40px] items-center gap-2 rounded-xl bg-[var(--accent)] px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-medium text-white hover:bg-[var(--accent-hover)] transition-colors whitespace-nowrap shrink-0\"\n            >\n              <Sparkles className=\"h-4 w-4 shrink-0\" />\n              <span>{t(\'common.quickAction\')}</span>\n              <kbd className=\"hidden sm:inline font-numeric text-[11px] opacity-80 ms-1\">\342\214\230K</kbd>\n            </button>\n          </div>\n        </header>\n\n        {/* Real Offline Connectivity Notice */}\n        {!isOnline && (\n          <div\n            role=\"status\"\n            className=\"bg-amber-600 px-4 py-2 text-xs font-medium text-white flex items-center justify-center gap-2\"\n          >\n            <CloudOff className=\"h-3.5 w-3.5 shrink-0\" />\n            <span>{t(\'common.offlineBanner\')}</span>\n          </div>\n        )}\n\n        {/* Main Scrollable Viewport */}\n        <main className=\"flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8 pb-24 lg:pb-10\">\n          {children}\n        </main>\n      </div>\n\n      {/* Mobile Bottom Tab Bar (60px height; combined with 52px header = 112px <= 15% of 844px) */}\n      <nav\n        aria-label=\"Mobile navigation\"\n        className=\"lg:hidden fixed bottom-0 inset-x-0 z-40 h-[60px] pb-safe border-t border-[var(--border-hairline)] bg-[var(--bg-surface)]/95 backdrop-blur-md grid grid-cols-5 items-center\"\n      >\n        {MOBILE_PRIMARY_TABS.map((tabId) => {\n          const item = ALL_NAV_ITEMS.find((i) => i.id === tabId)!;\n          const Icon = item.icon;\n          const isActive = activeRoute === tabId;\n          return (\n            <button\n              key={tabId}\n              type=\"button\"\n              onClick={() => setActiveRoute(tabId)}\n              className={`min-h-[44px] flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium transition-colors ${\n                isActive ? \'text-[var(--accent)]\' : \'text-[var(--text-muted)]\'\n              }`}\n            >\n              <Icon className=\"h-5 w-5\" />\n              <span className=\"truncate max-w-[64px]\">{t(item.labelKey)}</span>\n            </button>\n          );\n        })}\n\n        <button\n          type=\"button\"\n          onClick={() => setMobileMoreOpen(true)}\n          className={`min-h-[44px] flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium transition-colors ${\n            mobileMoreOpen || activeRoute === \'settings\'\n              ? \'text-[var(--accent)]\'\n              : \'text-[var(--text-muted)]\'\n          }`}\n        >\n          <LayoutGrid className=\"h-5 w-5\" />\n          <span>{t(\'nav.more\')}</span>\n        </button>\n      </nav>\n\n      {/* Mobile Bottom Sheet for Secondary Modules & Account */}\n      {mobileMoreOpen && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"All modules\"\n          className=\"lg:hidden fixed inset-0 z-50 flex items-end bg-slate-950/60 backdrop-blur-xs\"\n          onClick={() => setMobileMoreOpen(false)}\n        >\n          <div\n            className=\"w-full rounded-t-3xl border-t border-[var(--border-hairline)] bg-[var(--bg-surface)] p-5 pb-8 space-y-4\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <div className=\"mx-auto h-1.5 w-10 rounded-full bg-[var(--border-hairline)]\" />\n            <div className=\"flex items-center justify-between\">\n              <h2 className=\"text-base font-semibold text-[var(--text-primary)]\">{t(\'appName\')}</h2>\n              <button\n                type=\"button\"\n                aria-label={t(\'common.close\')}\n                onClick={() => setMobileMoreOpen(false)}\n                className=\"inline-flex h-10 w-10 items-center justify-center rounded-lg text-[var(--text-muted)]\"\n              >\n                <X className=\"h-5 w-5\" />\n              </button>\n            </div>\n            <div className=\"grid grid-cols-2 gap-2.5\">\n              {ALL_NAV_ITEMS.filter((i) => !MOBILE_PRIMARY_TABS.includes(i.id)).map((item) => {\n                const Icon = item.icon;\n                const isActive = activeRoute === item.id;\n                return (\n                  <button\n                    key={item.id}\n                    type=\"button\"\n                    onClick={() => setActiveRoute(item.id)}\n                    className={`min-h-[48px] flex items-center gap-3 rounded-xl border px-3.5 py-2.5 text-sm font-medium ${\n                      isActive\n                        ? \'border-[var(--accent)] bg-[var(--accent-soft)] text-[var(--accent)]\'\n                        : \'border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-primary)]\'\n                    }`}\n                  >\n                    <Icon className=\"h-4 w-4 shrink-0\" />\n                    <span className=\"truncate\">{t(item.labelKey)}</span>\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"pt-2 border-t border-[var(--border-hairline)] flex flex-col gap-2\">\n              <PWAInstallButton />\n              {!authUser ? (\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setMobileMoreOpen(false);\n                    void handleGoogleSignIn();\n                  }}\n                  className=\"min-h-[44px] w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white\"\n                >\n                  <LogIn className=\"h-4 w-4\" />\n                  <span>{t(\'common.signInGoogle\')}</span>\n                </button>\n              ) : (\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setMobileMoreOpen(false);\n                    void handleSignOut();\n                  }}\n                  className=\"min-h-[44px] w-full inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border-hairline)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)]\"\n                >\n                  <LogOut className=\"h-4 w-4\" />\n                  <span>{t(\'common.signOut\')}</span>\n                </button>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Undo / Feedback Toast */}\n      {toast && (\n        <div\n          role=\"status\"\n          className=\"fixed bottom-20 lg:bottom-6 end-4 z-50 flex items-center gap-3 rounded-xl border border-[var(--border-hairline)] bg-slate-900 dark:bg-slate-800 px-4 py-3 text-xs font-medium text-white shadow-lg max-w-sm\"\n        >\n          <span>{toast.message}</span>\n          {toast.onUndo && (\n            <button\n              type=\"button\"\n              onClick={() => {\n                toast.onUndo?.();\n                dismissToast();\n              }}\n              className=\"text-emerald-400 hover:text-emerald-300 font-semibold whitespace-nowrap\"\n            >\n              {toast.undoLabel}\n            </button>\n          )}\n          <button\n            type=\"button\"\n            aria-label=\"Dismiss notification\"\n            onClick={dismissToast}\n            className=\"text-slate-400 hover:text-white\"\n          >\n            <X className=\"h-3.5 w-3.5\" />\n          </button>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    num_lines: 393
    num_bytes: 16246
    line_range_bytes: 16246
  }
}
