              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const xrefLines = [`xref`, `0 ${allObjects.length + 1}`, `0000000000 65535 f `];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
