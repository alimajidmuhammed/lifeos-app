            }
            lines {
              text: "    // 4. Per-User Tenant Isolation Matches"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    match /users/{userId} {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow get: if isVerifiedOwner(userId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow list: if false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow create: if isVerifiedOwner(userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && isValidUserProfile(incoming(), userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().createdAt == request.time"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().updatedAt == request.time;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow update: if isVerifiedOwner(userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && isValidUserProfile(incoming(), userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().uid == existing().uid"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().createdAt == existing().createdAt"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().updatedAt == request.time"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().version == existing().version + 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().diff(existing()).affectedKeys().hasOnly(["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'displayName\', \'email\', \'locale\', \'theme\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'primaryCurrency\', \'secondaryCurrency\', \'vaultStorageMode\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'aiGlobalEnabled\', \'aiModuleToggles\', \'analyticsConsent\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'aiPrivacyNoticeAccepted\', \'e2eConfigured\', \'e2eSalt\', \'e2eVerifier\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'quietHoursStart\', \'quietHoursEnd\', \'version\', \'updatedAt\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow delete: if false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Server-only entitlements (client read-only)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      match /entitlements/{entitlementId} {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        allow get: if isVerifiedOwner(userId) && isValidId(entitlementId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        allow create, update, delete: if false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Monotonic daily AI quota counter (no delete, no decrement)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      match /aiUsage/{dayKey} {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        allow get: if isVerifiedOwner(userId) && isValidId(dayKey);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        allow create: if isVerifiedOwner(userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          && isValidAiUsageDay(incoming(), userId, dayKey)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
