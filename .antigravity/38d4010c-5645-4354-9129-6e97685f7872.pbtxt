              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const minMs = todayMs + 86_400_000; // tomorrow if lead window already passed"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
