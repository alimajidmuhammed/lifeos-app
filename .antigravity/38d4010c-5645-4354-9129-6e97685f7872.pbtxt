            lines {
              text: "export function serializeRRule(rule: ParsedRRule): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const segments: string[] = [`FREQ=${rule.freq}`];"
