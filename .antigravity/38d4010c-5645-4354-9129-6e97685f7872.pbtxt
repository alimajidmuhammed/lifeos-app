llow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(habitId)\\n          && isValidHabitItem(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(habitId)\\n          && isValidHabitItem(incoming(), userId)\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().version == existing().version + 1\\n          && (\\n            // Action 1: Update streaks & completions after check-in\\n            incoming().diff(existing()).affectedKeys().hasOnly([\\n              \'currentStreak\', \'bestStreak\', \'totalCompletions\', \'lastCompletedDate\', \'version\', \'updatedAt\'\\n            ])\\n            ||\\n            // Action 2: Edit habit definition or archive toggle\\n            incoming().diff(existing()).affectedKeys().hasOnly([\\n              \'name\', \'category\', \'frequency\', \'targetPerWeek\', \'reminderTime\', \'archived\', \'version\', \'updatedAt\'\\n            ])\\n          );\\n        allow delete: if isVerifiedOwner(userId) && isValidId(habitId);\\n      }\\n\\n      match /habitLogs/{bucketId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(bucketId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(bucketId)\\n          && isValidHabitMonthLog(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time\\n          && exists(/databases/$(database)/documents/users/$(userId)/habits/$(incoming().habitId));\\n        allow update: if isVerifiedOwner(userId) && isValidId(bucketId)\\n          && isValidHabitMonthLog(