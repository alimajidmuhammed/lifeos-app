    tool_calls {
      id: "call_15667460001490778999"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Download,\\n  Globe,\\n  KeyRound,\\n  Lock,\\n  Moon,\\n  ShieldCheck,\\n  Smartphone,\\n  Sun,\\n  Unlock,\\n} from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport {\\n  bootstrapE2EVault,\\n  decryptText,\\n  deriveAesKeyFromSecret,\\n  encryptText,\\n  verifyE2EPassphrase,\\n} from \'../../../core/crypto/e2eCrypto\';\\nimport type { CurrencyCode, SupportedLocale } from \'../../../core/currency/currency\';\\nimport { DEFAULT_FEATURE_FLAGS } from \'../../../core/entitlements/entitlements\';\\nimport type { AiModuleToggles } from \'../../../core/schemas/userProfileSchema\';\\nimport { persistProfilePatch } from \'../../../hooks/useLifeOS\';\\nimport { useUIStore, type ThemeMode } from \'../../../state/useUIStore\';\\nimport { PWAInstallButton } from \'../../../components/PWAInstallButton\';\\n\\nconst AI_MODULES: Array<{ key: keyof AiModuleToggles; labelKey: string; lockedOnFreeTier?: boolean }> = [\\n  { key: \'assistant\', labelKey: \'common.quickAction\' },\\n  { key: \'debts\', labelKey: \'nav.debts\' },\\n  { key: \'reminders\', labelKey: \'nav.reminders\' },\\n  { key: \'planner\', labelKey: \'nav.planner\' },\\n  { key: \'notes\', labelKey: \'nav.notes\' },\\n  { key: \'vault\', labelKey: \'nav.vault\', lockedOnFreeTier: true },\\n  { key: \'habits\', labelKey: \'nav.habits\' },\\n  { key: \'finance\', labelKey: \'nav.finance\' },\\n];\\n\\nexport const SettingsView: React.FC = () => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const authUser = useUIStore((s) => s.authUser);\\n  const entitlements = useUIStore((s) => s.entitlements);\\n  const pinEnabled = useUIStore((s) => s.pinEnabled);\\n  const setTheme = useUIStore((s) => s.setTheme);\\n  const setLocale = useUIStore((s) => s.setLocale);\\n  const setCurrencies = useUIStore((s) => s.setCurrencies);\\n  const toggleAiModule = useUIStore((s) => s.toggleAiModule);\\n  const configurePinLock = useUIStore((s) => s.configurePinLock);\\n  const removePinLock = useUIStore((s) => s.removePinLock);\\n  const lockApp = useUIStore((s) => s.lockApp);\\n  const showToast = useUIStore((s) => s.showToast);\\n\\n  // PIN form state\\n  const [pinInput, setPinInput] = useState(\'\');\\n  const [pinError, setPinError] = useState(\'\');\\n\\n  // E2E setup & verification state\\n  const [passphrase, setPassphrase] = useState(\'\');\\n  const [e2eError, setE2eError] = useState(\'\');\\n  const [recoveryKeyDisplay, setRecoveryKeyDisplay] = useState<string | null>(null);\\n  const [roundTripStatus, setRoundTripStatus] = useState<string | null>(null);\\n  const [e2eBusy, setE2eBusy] = useState(false);\\n\\n  const handleThemeSelect = (mode: ThemeMode) => {\\n    setTheme(mode);\\n    void persistProfilePatch({ theme: mode });\\n  };\\n\\n  const handleLocaleSelect = (loc: SupportedLocale) => {\\n    setLocale(loc);\\n    void persistProfilePatch({ locale: loc });\\n  };\\n\\n  const handleCurrencyChange = (primary: CurrencyCode, secondary: CurrencyCode) => {\\n    setCurrencies(primary, secondary);\\n    void persistProfilePatch({ primaryCurrency: primary, secondaryCurrency: secondary });\\n  };\\n\\n  const handlePinSave = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const cleaned = pinInput.trim();\\n    if (!/^\\\\d{4,8}$/.test(cleaned)) {\\n      setPinError(\'PIN must be 4 to 8 digits.\');\\n      return;\\n    }\\n    configurePinLock(cleaned);\\n    setPinInput(\'\');\\n    setPinError(\'\');\\n    showToast(\'Local PIN App Lock enabled.\');\\n  };\\n\\n  const handleE2ESetup = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setE2eError(\'\');\\n    setRoundTripStatus(null);\\n    if (passphrase.trim().length < 8) {\\n      setE2eError(\'Passphrase must be at least 8 characters.\');\\n      return;\\n    }\\n    setE2eBusy(true);\\n    try {\\n      const setup = await bootstrapE2EVault(passphrase);\\n      setRecoveryKeyDisplay(setup.recoveryKey);\\n      await persistProfilePatch({\\n        e2eConfigured: true,\\n        e2eSalt: setup.salt,\\n        e2eVerifier: setup.verifier,\\n      });\\n      showToast(\'Opt-in AES-256-GCM E2E vault initialized. Save your Recovery Key offline.\');\\n    } catch (err) {\\n      setE2eError(err instanceof Error ? err.message : \'Failed to initialize E2E encryption.\');\\n    } finally {\\n      setE2eBusy(false);\\n    }\\n  };\\n\\n  const handleVerifyE2ERoundTrip = async () => {\\n    if (!profile.e2eSalt || !profile.e2eVerifier || !passphrase) {\\n      setE2eError(\'Enter your E2E passphrase above to run a live encrypt/decrypt check.\');\\n      return;\\n    }\\n    setE2eBusy(true);\\n    setE2eError(\'\');\\n    try {\\n      const valid = await verifyE2EPassphrase(passphrase, profile.e2eSalt, profile.e2eVerifier);\\n      if (!valid) {\\n        setE2eError(\'Passphrase did not match stored verifier.\');\\n        setRoundTripStatus(null);\\n        return;\\n      }\\n      const key = await deriveAesKeyFromSecret(passphrase, profile.e2eSalt);\\n      const sample = \'LifeOS AES-256-GCM self-test passed\';\\n      const encrypted = await encryptText(sample, key);\\n      const decrypted = await decryptText(encrypted, key);\\n      if (decrypted === sample) {\\n        setRoundTripStatus(`Verified: AES-256-GCM ciphertext (${encrypted.ct.slice(0, 18)}...) decrypted cleanly.`);\\n      }\\n    } finally {\\n      setE2eBusy(false);\\n    }\\n  };\\n\\n  const handleExportJson = () => {\\n    const bundle = {\\n      exportedAt: new Date().toISOString(),\\n      schemaVersion: 1,\\n      account: authUser ? { uid: authUser.uid, email: authUser.email } : { mode: \'local_offline\' },\\n      profile,\\n      entitlements,\\n      featureFlags: DEFAULT_FEATURE_FLAGS,\\n    };\\n    const blob = new Blob([JSON.stringify(bundle, null, 2)], { type: \'application/json\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `lifeos-export-${new Date().toISOString().slice(0, 10)}.json`;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n    showToast(\'Workspace JSON exported.\');\\n  };\\n\\n  const toggles = profile.aiModuleToggles ?? {\\n    debts: true,\\n    reminders: true,\\n    planner: true,\\n    notes: true,\\n    vault: false,\\n    habits: true,\\n    finance: true,\\n    assistant: true,\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-8 max-w-4xl\\\">\\n      <div>\\n        <h1 className=\\\"text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]\\\">\\n          {t(\'settings.title\')}\\n        </h1>\\n        <p className=\\\"mt-1.5 text-sm text-[var(--text-secondary)]\\\">\\n          {t(\'settings.subtitle\')}\\n        </p>\\n      </div>\\n\\n      {/* 1. Theme & Language (RTL) */}\\n      <section className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)]\\\">\\n        <div className=\\\"p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-sm font-semibold text-[var(--text-primary)]\\\">\\n              {t(\'settings.appearanceTitle\')}\\n            </h2>\\n            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              Calm slate &amp; emerald palette across Light, Dark, and pure-black AMOLED surfaces.\\n            </p>\\n          </div>\\n          <div\\n            role=\\\"group\\\"\\n            aria-label={t(\'settings.appearanceTitle\')}\\n            className=\\\"inline-flex items-center gap-1 rounded-xl bg-[var(--bg-subtle)] p-1\\\"\\n          >\\n            {(\\n              [\\n                { id: \'light\', label: t(\'settings.light\'), icon: Sun },\\n                { id: \'dark\', label: t(\'settings.dark\'), icon: Moon },\\n                { id: \'amoled\', label: t(\'settings.amoled\'), icon: Smartphone },\\n              ] as const\\n            ).map((opt) => {\\n              const Icon = opt.icon;\\n              const active = profile.theme === opt.id;\\n              return (\\n                <button\\n                  key={opt.id}\\n                  type=\\\"button\\\"\\n                  aria-pressed={active}\\n                  onClick={() => handleThemeSelect(opt.id)}\\n                  className={`min-h-[38px] inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium transition-colors whitespace-nowrap ${\\n                    active\\n                      ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                      : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                  }`}\\n                >\\n                  <Icon className=\\\"h-3.5 w-3.5\\\" />\\n                  <span>{opt.label}</span>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-sm font-semibold text-[var(--text-primary)] flex items-center gap-2\\\">\\n              <Globe className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n              <span>{t(\'settings.languageTitle\')}</span>\\n            </h2>\\n            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              Full logical RTL layout mirroring for Arabic and Kurdish Sorani.\\n            </p>\\n          </div>\\n          <div\\n            role=\\\"group\\\"\\n            aria-label={t(\'settings.languageTitle\')}\\n            className=\\\"inline-flex items-center gap-1 rounded-xl bg-[var(--bg-subtle)] p-1\\\"\\n          >\\n            {(\\n              [\\n                { id: \'en\', label: \'English (LTR)\' },\\n                { id: \'ar\', label: \'\330\247\331\204\330\271\330\261\330\250\331\212\330\251 (RTL)\' },\\n                { id: \'ckb\', label: \'\332\251\331\210\330\261\330\257\333\214 (RTL)\' },\\n              ] as const\\n            ).map((lang) => {\\n              const active = profile.locale === lang.id;\\n              return (\\n                <button\\n                  key={lang.id}\\n                  type=\\\"button\\\"\\n                  aria-pressed={active}\\n                  onClick={() => handleLocaleSelect(lang.id)}\\n                  className={`min-h-[38px] rounded-lg px-3 py-1.5 text-xs font-medium transition-colors whitespace-nowrap ${\\n                    active\\n                      ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                      : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                  }`}\\n                >\\n                  {lang.label}\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"p-6 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n          <div>\\n            <label\\n              htmlFor=\\\"primary-currency-select\\\"\\n              className=\\\"block text-xs font-medium text-[var(--text-secondary)]\\\"\\n            >\\n              {t(\'home.primaryCurrency\')}\\n            </label>\\n            <select\\n              id=\\\"primary-currency-select\\\"\\n              value={profile.primaryCurrency}\\n              onChange={(e) =>\\n                handleCurrencyChange(e.target.value as CurrencyCode, profile.secondaryCurrency)\\n              }\\n              className=\\\"mt-1.5 min-h-[42px] w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)]\\\"\\n            >\\n              <option value=\\\"IQD\\\">IQD \342\200\224 Iraqi Dinar</option>\\n              <option value=\\\"USD\\\">USD \342\200\224 US Dollar</option>\\n              <option value=\\\"EUR\\\">EUR \342\200\224 Euro</option>\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label\\n              htmlFor=\\\"secondary-currency-select\\\"\\n              className=\\\"block text-xs font-medium text-[var(--text-secondary)]\\\"\\n            >\\n              {t(\'home.secondaryCurrency\')}\\n            </label>\\n            <select\\n              id=\\\"secondary-currency-select\\\"\\n              value={profile.secondaryCurrency}\\n              onChange={(e) =>\\n                handleCurrencyChange(profile.primaryCurrency, e.target.value as CurrencyCode)\\n              }\\n              className=\\\"mt-1.5 min-h-[42px] w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)]\\\"\\n            >\\n              <option value=\\\"USD\\\">USD \342\200\224 US Dollar</option>\\n              <option value=\\\"IQD\\\">IQD \342\200\224 Iraqi Dinar</option>\\n              <option value=\\\"EUR\\\">EUR \342\200\224 Euro</option>\\n            </select>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* 2. AI Privacy Gate & Module Toggles */}\\n      <section className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-6 space-y-5\\\">\\n        <div className=\\\"flex items-start justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)] flex items-center gap-2\\\">\\n              <ShieldCheck className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n              <span>{t(\'settings.aiPrivacyTitle\')}</span>\\n            </h2>\\n            <p className=\\\"mt-1 text-xs leading-relaxed text-[var(--text-secondary)]\\\">\\n              {t(\'settings.aiFreeTierNotice\')}\\n            </p>\\n          </div>\\n          <label className=\\\"inline-flex items-center gap-2 cursor-pointer shrink-0\\\">\\n            <input\\n              type=\\\"checkbox\\\"\\n              checked={profile.aiGlobalEnabled}\\n              onChange={(e) => {\\n                void persistProfilePatch({ aiGlobalEnabled: e.target.checked });\\n                showToast(e.target.checked ? \'AI enabled across selected modules.\' : \'AI disabled globally.\');\\n              }}\\n              className=\\\"h-4 w-4 rounded accent-emerald-600\\\"\\n            />\\n            <span className=\\\"text-xs font-medium text-[var(--text-primary)]\\\">\\n              {profile.aiGlobalEnabled ? \'On\' : \'Off\'}\\n            </span>\\n          </label>\\n        </div>\\n\\n        <div className=\\\"pt-4 border-t border-[var(--border-hairline)]\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)] mb-3\\\">\\n            {t(\'settings.aiModuleTogglesTitle\')}\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n            {AI_MODULES.map((m) => {\\n              const checked = Boolean(toggles[m.key]) && !m.lockedOnFreeTier;\\n              return (\\n                <label\\n                  key={m.key}\\n                  className={`min-h-[44px] flex items-center justify-between gap-3 rounded-xl border border-[var(--border-hairline)] px-3.5 py-2 text-xs ${\\n                    m.lockedOnFreeTier\\n                      ? \'bg-[var(--bg-subtle)]/50 text-[var(--text-muted)] cursor-not-allowed\'\\n                      : \'bg-[var(--bg-canvas)] text-[var(--text-primary)] cursor-pointer\'\\n                  }`}\\n                >\\n                  <span>\\n                    {t(m.labelKey)}\\n                    {m.lockedOnFreeTier ? \' (Blocked on free tier)\' : \'\'}\\n                  </span>\\n                  <input\\n                    type=\\\"checkbox\\\"\\n                    disabled={m.lockedOnFreeTier || !profile.aiGlobalEnabled}\\n                    checked={checked}\\n                    onChange={(e) => {\\n                      toggleAiModule(m.key, e.target.checked);\\n                      void persistProfilePatch({\\n                        aiModuleToggles: { ...toggles, [m.key]: e.target.checked },\\n                      });\\n                    }}\\n                    className=\\\"h-4 w-4 accent-emerald-600\\\"\\n                  />\\n                </label>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* 3. Device PIN Lock & Opt-In AES-256-GCM E2E Encryption */}\\n      <section className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)]\\\">\\n        {/* PIN Lock */}\\n        <div className=\\\"p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between gap-3\\\">\\n            <div>\\n              <h2 className=\\\"text-base font-semibold text-[var(--text-primary)] flex items-center gap-2\\\">\\n                <Lock className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n                <span>{t(\'settings.pinLockLabel\')}</span>\\n              </h2>\\n              <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n                Protects workspace access on shared devices. Native builds pair this with Biometrics (Face ID / Fingerprint).\\n              </p>\\n            </div>\\n            {pinEnabled && (\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={lockApp}\\n                  className=\\\"min-h-[40px] inline-flex items-center gap-1.5 rounded-xl bg-[var(--accent)] px-3.5 py-1.5 text-xs font-medium text-white hover:bg-[var(--accent-hover)]\\\"\\n                >\\n                  <Lock className=\\\"h-3.5 w-3.5\\\" />\\n                  <span>{t(\'settings.pinLockNowBtn\')}</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    removePinLock();\\n                    showToast(\'Local PIN lock removed.\');\\n                  }}\\n                  className=\\\"min-h-[40px] inline-flex items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]\\\"\\n                >\\n                  <Unlock className=\\\"h-3.5 w-3.5\\\" />\\n                  <span>{t(\'settings.pinRemoveBtn\')}</span>\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n\\n          {!pinEnabled && (\\n            <form onSubmit={handlePinSave} className=\\\"flex flex-col sm:flex-row gap-3 items-start sm:items-end\\\">\\n              <div className=\\\"w-full sm:w-56\\\">\\n                <label htmlFor=\\\"new-pin-input\\\" className=\\\"block text-xs font-medium text-[var(--text-secondary)]\\\">\\n                  Set 4\342\200\2238 digit PIN\\n                </label>\\n                <input\\n                  id=\\\"new-pin-input\\\"\\n                  type=\\\"password\\\"\\n                  inputMode=\\\"numeric\\\"\\n                  value={pinInput}\\n                  onChange={(e) => {\\n                    setPinInput(e.target.value);\\n                    setPinError(\'\');\\n                  }}\\n                  placeholder=\\\"1234\\\"\\n                  className=\\\"mt-1 min-h-[42px] w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 font-numeric text-sm text-[var(--text-primary)]\\\"\\n                />\\n              </div>\\n              <button\\n                type=\\\"submit\\\"\\n                className=\\\"min-h-[42px] rounded-xl bg-[var(--accent)] px-4 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)] transition-colors whitespace-nowrap\\\"\\n              >\\n                {t(\'settings.pinSetBtn\')}\\n              </button>\\n            </form>\\n          )}\\n          {pinError && <p className=\\\"text-xs text-red-600 dark:text-red-400\\\">{pinError}</p>}\\n        </div>\\n\\n        {/* Opt-In AES-256-GCM E2E */}\\n        <div className=\\\"p-6 space-y-4\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)] flex items-center gap-2\\\">\\n              <KeyRound className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n              <span>{t(\'settings.e2eTitle\')}</span>\\n            </h2>\\n            <p className=\\\"mt-1 text-xs leading-relaxed text-[var(--text-secondary)]\\\">\\n              {t(\'settings.e2eDesc\')}\\n            </p>\\n          </div>\\n\\n          <form onSubmit={handleE2ESetup} className=\\\"flex flex-col sm:flex-row gap-3 items-start sm:items-end\\\">\\n            <div className=\\\"w-full sm:flex-1\\\">\\n              <label htmlFor=\\\"e2e-passphrase-input\\\" className=\\\"block text-xs font-medium text-[var(--text-secondary)]\\\">\\n                Vault E2E Passphrase (min 8 chars \302\267 never leaves your device)\\n              </label>\\n              <input\\n                id=\\\"e2e-passphrase-input\\\"\\n                type=\\\"password\\\"\\n                value={passphrase}\\n                onChange={(e) => {\\n                  setPassphrase(e.target.value);\\n                  setE2eError(\'\');\\n                }}\\n                placeholder=\\\"Enter a strong vault passphrase\\\"\\n                className=\\\"mt-1 min-h-[42px] w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 text-sm text-[var(--text-primary)]\\\"\\n              />\\n            </div>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={e2eBusy}\\n              className=\\\"min-h-[42px] rounded-xl bg-[var(--accent)] px-4 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50 transition-colors whitespace-nowrap\\\"\\n            >\\n              {e2eBusy ? \'Deriving Key...\' : t(\'settings.e2eSetupBtn\')}\\n            </button>\\n            {profile.e2eConfigured && (\\n              <button\\n                type=\\\"button\\\"\\n                disabled={e2eBusy}\\n                onClick={() => void handleVerifyE2ERoundTrip()}\\n                className=\\\"min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n              >\\n                {t(\'settings.e2eTestBtn\')}\\n              </button>\\n            )}\\n          </form>\\n\\n          {e2eError && <p className=\\\"text-xs text-red-600 dark:text-red-400\\\">{e2eError}</p>}\\n\\n          {recoveryKeyDisplay && (\\n            <div className=\\\"rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 space-y-2\\\">\\n              <div className=\\\"text-xs font-semibold text-amber-800 dark:text-amber-200\\\">\\n                Save Your One-Time Recovery Key Offline\\n              </div>\\n              <div className=\\\"font-numeric text-sm font-semibold tracking-wider text-[var(--text-primary)] select-all\\\">\\n                {recoveryKeyDisplay}\\n              </div>\\n              <p className=\\\"text-xs text-[var(--text-secondary)]\\\">\\n                LifeOS never stores this key or your passphrase. Store it safely outside your phone.\\n              </p>\\n            </div>\\n          )}\\n\\n          {roundTripStatus && (\\n            <div className=\\\"flex items-center gap-2 text-xs font-medium text-emerald-700 dark:text-emerald-400\\\">\\n              <CheckCircle2 className=\\\"h-4 w-4 shrink-0\\\" />\\n              <span className=\\\"font-numeric\\\">{roundTripStatus}</span>\\n            </div>\\n          )}\\n        </div>\\n      </section>\\n\\n      {/* 4. Portability, PWA & Feature Flags */}\\n      <section className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-6 space-y-4\\\">\\n        <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n          {t(\'settings.accountTitle\')}\\n        </h2>\\n\\n        <p className=\\\"text-xs text-[var(--text-secondary)]\\\">\\n          {t(\'settings.appleSignInFlag\')}\\n        </p>\\n\\n        <label className=\\\"inline-flex items-center gap-2.5 text-xs text-[var(--text-primary)] cursor-pointer\\\">\\n          <input\\n            type=\\\"checkbox\\\"\\n            checked={profile.analyticsConsent}\\n            onChange={(e) => {\\n              void persistProfilePatch({ analyticsConsent: e.target.checked });\\n              showToast(\'Analytics consent preference updated.\');\\n            }}\\n            className=\\\"h-4 w-4 accent-emerald-600\\\"\\n          />\\n          <span>{t(\'settings.analyticsConsentLabel\')}</span>\\n        </label>\\n\\n        <div className=\\\"pt-2 flex flex-wrap items-center gap-3\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleExportJson}\\n            className=\\\"inline-flex min-h-[42px] items-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors\\\"\\n          >\\n            <Download className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n            <span>{t(\'settings.exportJsonBtn\')}</span>\\n          </button>\\n          <PWAInstallButton compact />\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create SettingsView with Light/Dark/AMOLED theme switch, EN/AR/KU RTL language switch, currency selector, AI Privacy Gate toggles, local PIN lock, AES-256-GCM E2E setup + verification, and JSON export.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/settings/ui/SettingsView.tsx\", \"toolAction\":\"Creating SettingsView component\", \"toolSummary\":\"Create SettingsView\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15667460001490779696"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { ShieldCheck, Sparkles, Settings } from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\\n\\ninterface ModuleDetailInfo {\\n  phase: number;\\n  firestorePath: string;\\n  deterministicCore: string;\\n  aiCapabilities: string;\\n  privacyRule: string;\\n}\\n\\nconst MODULE_INFO: Record<Exclude<NavRoute, \'home\' | \'settings\'>, ModuleDetailInfo> = {\\n  debts: {\\n    phase: 2,\\n    firestorePath: \'users/{uid}/debts + debtLedgers + payments\',\\n    deterministicCore:\\n      \'Integer minor-unit IQD/USD/EUR balances, partial-payment transactions, installment schedules, Beta-smoothed repayment probability, snowball vs. avalanche payoff math.\',\\n    aiCapabilities:\\n      \'Natural-language debt parsing, polite EN/AR/KU reminder drafts, and human explanations of deterministic risk scores.\',\\n    privacyRule: \'Minimal text only; never sends raw contract/receipt images while free_tier=true.\',\\n  },\\n  reminders: {\\n    phase: 3,\\n    firestorePath: \'users/{uid}/reminders\',\\n    deterministicCore:\\n      \'RRULE recurrence expansion, 8 category channels, quiet hours enforcement, and unit-tested Rolling 64-Notification Scheduler.\',\\n    aiCapabilities:\\n      \'Natural-language recurrence parsing, auto-category selection, and overload rebalancing suggestions.\',\\n    privacyRule: \'Only reminder titles/schedule windows sent on explicit user action.\',\\n  },\\n  planner: {\\n    phase: 4,\\n    firestorePath: \'users/{uid}/tasks + taskLists\',\\n    deterministicCore:\\n      \'Single-write fractional-index ordering (LexoRank), subtasks, Today/Upcoming/Completed views, unified calendar.\',\\n    aiCapabilities:\\n      \'Break big goals into subtasks, prioritize day/week, and draft weekly productivity summaries.\',\\n    privacyRule: \'Requires explicit confirmation preview before creating or modifying tasks.\',\\n  },\\n  notes: {\\n    phase: 4,\\n    firestorePath: \'users/{uid}/notes + noteFolders\',\\n    deterministicCore:\\n      \'Rich Markdown editor, nested folders, version snapshots, cross-module links, and opt-in AES-256-GCM locked notes.\',\\n    aiCapabilities:\\n      \'Summarize, rewrite, translate (EN/AR/KU), extract tasks, and auto-tag unlocked notes.\',\\n    privacyRule: \'Locked or E2E encrypted notes are strictly blocked from cloud AI by the Privacy Gate.\',\\n  },\\n  vault: {\\n    phase: 5,\\n    firestorePath: \'Local-Only IndexedDB Vault + users/{uid}/documents\',\\n    deterministicCore:\\n      \'Zero-billing Local-Only storage adapter (Spark free tier), nested folders, expiry alerts, and opt-in AES-256-GCM encryption.\',\\n    aiCapabilities:\\n      \'On-device OCR & local search on free tier. Cloud Document AI unlocks only after upgrading to a paid zero-retention provider.\',\\n    privacyRule: \'Hard Privacy Gate blocks all scanned document images and passport/ID payloads while free_tier=true.\',\\n  },\\n  habits: {\\n    phase: 6,\\n    firestorePath: \'users/{uid}/habits + habitLogs/{yyyy_mm}\',\\n    deterministicCore:\\n      \'Monthly-bucketed completion logs (12 docs/year total), deterministic streak engine, and heatmaps.\',\\n    aiCapabilities: \'Streak break analysis and adaptive reminder time suggestions.\',\\n    privacyRule: \'Only aggregated streak stats sent when AI is enabled for Habits.\',\\n  },\\n  finance: {\\n    phase: 6,\\n    firestorePath: \'users/{uid}/transactions + budgets + subscriptions\',\\n    deterministicCore:\\n      \'Integer minor-unit ledger, category budgets, recurring subscription tracker, CSV import/export, deterministic cash-flow forecast.\',\\n    aiCapabilities: \'Spending pattern summaries and subscription waste detection.\',\\n    privacyRule: \'Deterministic math runs on-device; AI receives aggregated category totals only.\',\\n  },\\n};\\n\\nexport const ModuleReadinessView: React.FC<{ route: Exclude<NavRoute, \'home\' | \'settings\'> }> = ({\\n  route,\\n}) => {\\n  const { t } = useTranslation();\\n  const setCommandPaletteOpen = useUIStore((s) => s.setCommandPaletteOpen);\\n  const setActiveRoute = useUIStore((s) => s.setActiveRoute);\\n  const info = MODULE_INFO[route];\\n\\n  return (\\n    <div className=\\\"space-y-6 max-w-3xl\\\">\\n      <div>\\n        <p className=\\\"font-numeric text-xs text-[var(--text-muted)]\\\">\\n          Phase {info.phase} Deliverable \302\267 {info.firestorePath}\\n        </p>\\n        <h1 className=\\\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]\\\">\\n          {t(`nav.${route}`)}\\n        </h1>\\n        <p className=\\\"mt-2 text-sm text-[var(--text-secondary)]\\\">\\n          Security rules, tenant isolation, and repository contracts for this module are live from Phase 1. The full interactive UI and domain engine ship next in Phase {info.phase}.\\n        </p>\\n      </div>\\n\\n      <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)]\\\">\\n        <div className=\\\"p-5\\\">\\n          <div className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n            Deterministic On-Device Core\\n          </div>\\n          <p className=\\\"mt-1 text-sm text-[var(--text-secondary)]\\\">{info.deterministicCore}</p>\\n        </div>\\n        <div className=\\\"p-5\\\">\\n          <div className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n            Embedded AI Layer\\n          </div>\\n          <p className=\\\"mt-1 text-sm text-[var(--text-secondary)]\\\">{info.aiCapabilities}</p>\\n        </div>\\n        <div className=\\\"p-5\\\">\\n          <div className=\\\"text-xs font-semibold text-[var(--text-primary)] flex items-center gap-2\\\">\\n            <ShieldCheck className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n            <span>Active Privacy Boundary</span>\\n          </div>\\n          <p className=\\\"mt-1 text-sm text-[var(--text-secondary)]\\\">{info.privacyRule}</p>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setCommandPaletteOpen(true)}\\n          className=\\\"inline-flex min-h-[42px] items-center gap-2 rounded-xl bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)] transition-colors\\\"\\n        >\\n          <Sparkles className=\\\"h-4 w-4\\\" />\\n          <span>Test AI Pipeline &amp; Privacy Gate</span>\\n        </button>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setActiveRoute(\'settings\')}\\n          className=\\\"inline-flex min-h-[42px] items-center gap-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors\\\"\\n        >\\n          <Settings className=\\\"h-4 w-4 text-[var(--text-muted)]\\\" />\\n          <span>Configure Module Security</span>\\n        </button>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ModuleReadinessView clearly communicating Phase 1 rules/contracts readiness and upcoming Phase 2-6 module deliverables without fake stubs.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/modules/ui/ModuleReadinessView.tsx\", \"toolAction\":\"Creating ModuleReadinessView component\", \"toolSummary\":\"Create ModuleReadinessView\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15667460001490776297"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { ErrorBoundary } from \'./components/ErrorBoundary\';\\nimport { AppShell } from \'./components/AppShell\';\\nimport { AICommandPalette } from \'./components/AICommandPalette\';\\nimport { AppLockOverlay } from \'./components/AppLockOverlay\';\\nimport { HomeView } from \'./features/home/ui/HomeView\';\\nimport { SettingsView } from \'./features/settings/ui/SettingsView\';\\nimport { ModuleReadinessView } from \'./features/modules/ui/ModuleReadinessView\';\\nimport { useLifeOSSync } from \'./hooks/useLifeOS\';\\nimport { useUIStore } from \'./state/useUIStore\';\\n\\nfunction LifeOSWorkspace() {\\n  useLifeOSSync();\\n  const activeRoute = useUIStore((s) => s.activeRoute);\\n\\n  return (\\n    <>\\n      <AppShell>\\n        {activeRoute === \'home\' ? (\\n          <HomeView />\\n        ) : activeRoute === \'settings\' ? (\\n          <SettingsView />\\n        ) : (\\n          <ModuleReadinessView route={activeRoute} />\\n        )}\\n      </AppShell>\\n      <AICommandPalette />\\n      <AppLockOverlay />\\n    </>\\n  );\\n}\\n\\nexport default function App() {\\n  return (\\n    <ErrorBoundary>\\n      <LifeOSWorkspace />\\n    </ErrorBoundary>\\n  );\\n}\\n\", \"Description\":\"Wire LifeOS root App component with ErrorBoundary, Firestore sync hook, responsive AppShell, AI Command Palette, and PIN Lock overlay.\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating src/App.tsx\", \"toolSummary\":\"Update src/App.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
