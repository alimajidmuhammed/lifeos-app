    content: "          </div>\n\n          {/* Primary Actions */}\n          {effStatus !== \'settled\' && (\n            <div className=\"grid grid-cols-3 gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => onLogPayment(debt)}\n                className=\"min-h-[42px] inline-flex items-center justify-center gap-1.5 rounded-xl bg-[var(--accent)] px-3 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)]\"\n              >\n                <CheckCircle2 className=\"h-3.5 w-3.5 shrink-0\" />\n                <span className=\"truncate\">{t(\'debts.logPayment\')}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onDraftReminder(debt)}\n                className=\"min-h-[42px] inline-flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\"\n              >\n                <MessageSquareText className=\"h-3.5 w-3.5 shrink-0\" />\n                <span className=\"truncate\">{t(\'debts.draftReminder\')}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onEdit(debt)}\n                className=\"min-h-[42px] inline-flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\"\n              >\n                <Edit3 className=\"h-3.5 w-3.5 shrink-0\" />\n                <span className=\"truncate\">{t(\'debts.editDebt\')}</span>\n              </button>\n            </div>\n          )}\n\n          {/* Deterministic Repayment Probability Breakdown */}\n          {prob && (\n            <div className=\"space-y-2\">\n              <div className=\"flex items-baseline justify-between\">\n                <h3 className=\"text-xs font-semibold text-[var(--text-primary)]\">\n                  {t(\'debts.repaymentScore\')} (Deterministic)\n                </h3>\n                <span\n                  className={`font-numeric text-sm font-bold ${\n                    prob.band === \'high\'\n                      ? \'text-[var(--accent)]\'\n                      : prob.band === \'moderate\'\n                        ? \'text-amber-600 dark:text-amber-400\'\n                        : \'text-red-600 dark:text-red-400\'\n                  }`}\n                >\n                  {prob.score}%\n                </span>\n              </div>\n              <ul className=\"space-y-1 text-xs text-[var(--text-secondary)]\">\n                {prob.factors.map((f, idx) => (\n                  <li key={idx} className=\"flex items-start gap-2\">\n                    <span aria-hidden=\"true\" className=\"text-[var(--text-muted)]\">\302\267</span>\n                    <span>{f}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          )}\n\n          {/* Notes */}\n          {debt.notes && (\n            <div className=\"space-y-1\">\n              <h3 className=\"text-xs font-semibold text-[var(--text-primary)]\">"
