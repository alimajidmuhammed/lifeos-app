    content: "import i18n from \'i18next\';\nimport { initReactI18next } from \'react-i18next\';\nimport type { SupportedLocale } from \'../currency/currency\';\n\nexport const RTL_LOCALES: SupportedLocale[] = [\'ar\', \'ckb\'];\n\nexport function isRtlLocale(locale: SupportedLocale): boolean {\n  return RTL_LOCALES.includes(locale);\n}\n\nconst resources = {\n  en: {\n    translation: {\n      appName: \'LifeOS\',\n      nav: {\n        home: \'Home\',\n        debts: \'Debts\',\n        reminders: \'Reminders\',\n        planner: \'Planner\',\n        notes: \'Notes\',\n        vault: \'Vault\',\n        habits: \'Habits\',\n        finance: \'Finance\',\n        settings: \'Settings\',\n        more: \'More\',\n      },\n      common: {\n        searchPlaceholder: \'Ask LifeOS or jump to a module...\',\n        quickAction: \'Ask AI\',\n        signInGoogle: \'Sign in with Google\',\n        signOut: \'Sign out\',\n        offlineLocalMode: \'Local offline workspace\',\n        syncedCloudMode: \'Cloud sync active\',\n        offlineBanner: \'Offline mode \342\200\224 changes save locally and sync automatically when online.\',\n        installApp: \'Install App\',\n        installIos: \'Install on iOS\',\n        save: \'Save\',\n        cancel: \'Cancel\',\n        confirm: \'Confirm Action\',\n        close: \'Close\',\n        phaseReady: \'Phase 3 \302\267 Debts & Reminders Active\',\n        upcomingPhase: \'Scheduled in Phase {{phase}}\',\n      },\n      home: {\n        greeting: \'Good day\',\n        subtitle: \'Your calm, offline-first command center for finances, commitments, and private records.\',\n        briefingTitle: \'Daily Briefing\',\n        briefingEmpty: \'No overdue debts, expiring documents, or pending reminders yet. Sign in to sync across devices or test the AI assistant below.\',\n        currencyStripTitle: \'Dual-Currency Reference\',\n        primaryCurrency: \'Primary Currency\',\n        secondaryCurrency: \'Secondary Currency\',\n        vaultPosture: \'Document Vault Posture\',\n        vaultLocalDesc: \'Local-Only (Spark Free Tier \302\267 Zero Billing)\',\n        aiQuotaTitle: \'AI Daily Quota\',\n        aiPrivacyGateActive: \'Privacy Gate Active (Free Tier)\',\n        foundationModulesTitle: \'Module Architecture & Rollout\',\n        runBriefingBtn: \'Generate Briefing Preview\',\n      },\n      settings: {\n        title: \'Settings & Security\',\n        subtitle: \'Control appearance, tri-lingual RTL localization, AI privacy boundaries, opt-in E2E encryption, and data portability.\',\n        appearanceTitle: \'Appearance & Theme\',\n        appearanceDesc: \'Calm slate and emerald palette across Light, Dark, and pure-black AMOLED surfaces.\',\n        light: \'Light\',\n        dark: \'Dark\',\n        amoled: \'AMOLED Black\',\n        languageTitle: \'Language & Direction (RTL)\',\n        languageDesc: \'Full logical RTL layout mirroring for Arabic and Kurdish Sorani.\',\n        currenciesTitle: \'Currencies & Quiet Hours\',\n        aiPrivacyTitle: \'AI Privacy Gate & Quotas\',\n        aiGlobalLabel: \'Enable AI Assistant across LifeOS\',\n        aiOn: \'On\',\n        aiOff: \'Off\',\n        blockedFreeTier: \'Blocked on free tier\',\n        aiFreeTierNotice: \'While on the free AI tier, scanned document images, passports, national IDs, password-vault items, and locked/E2E notes are strictly blocked from leaving your device.\',\n        aiModuleTogglesTitle: \'Per-Module AI Controls\',\n        securityTitle: \'Device Lock & Opt-In E2E Vault\',\n        pinLockLabel: \'App PIN Lock\',\n        pinDesc: \'Protects workspace access on shared devices. Native builds pair this with Biometrics.\',\n        pinInputLabel: \'Set 4\342\200\2238 digit PIN\',\n        pinSetBtn: \'Enable PIN Lock\',\n        pinLockNowBtn: \'Lock App Now\',\n        pinRemoveBtn: \'Remove PIN\',\n        e2eTitle: \'Opt-In AES-256-GCM E2E Encryption\',\n        e2eDesc: \'Encrypt selected Vault folders and locked notes on-device. If you lose both your passphrase and Recovery Key, encrypted content cannot be recovered.\',\n        e2ePassphraseLabel: \'Vault E2E Passphrase (min 8 chars \302\267 never leaves your device)\',\n        e2eSetupBtn: \'Configure E2E Passphrase\',\n        e2eTestBtn: \'Verify Encrypt/Decrypt Round-Trip\',\n        accountTitle: \'Account, Sync & Portability\',\n        appleSignInFlag: \'Sign in with Apple is isolated behind feature flag auth.apple.enabled=false for Stage 1 iOS App Store launch.\',\n        exportJsonBtn: \'Export Workspace JSON\',\n        analyticsConsentLabel: \'Opt-in anonymous usage analytics\',\n      },\n      assistant: {\n        title: \'LifeOS AI Command Palette\',\n        subtitle: \'Deterministic math stays on-device. Any data change requires your confirmation preview first.\',\n        inputPlaceholder: \'Try: \"Remind me every Sunday at 9am to review expenses\" or test the Privacy Gate with \"Scan my passport\"\',\n        sendBtn: \'Send\',\n        includeVaultToggle: \'Simulate Vault / Image Attachment (Tests Privacy Gate)\',\n        includeLockedToggle: \'Simulate Locked / E2E Note Context (Tests Privacy Gate)\',\n        previewLabel: \'Exact payload preview (transparent before sending)\',\n        privacyBlockedTitle: \'Blocked by Privacy Gate\',\n        confirmationTitle: \'Action Confirmation Preview\',\n        confirmationDesc: \'LifeOS AI never mutates data silently. Review and confirm before applying.\',\n        confirmedFeedback: \'Action approved in Phase 1 dry-run preview (persistence wires in module phase).\',\n        disabledNotice: \'AI is currently disabled in Settings. All deterministic offline LifeOS tools remain fully usable.\',\n      },\n      lock: {\n        title: \'LifeOS is Locked\',\n        subtitle: \'Enter your local PIN to unlock your workspace.\',\n        unlockBtn: \'Unlock Workspace\',\n        wrongPin: \'Incorrect PIN. Please try again.\',\n      },\n   