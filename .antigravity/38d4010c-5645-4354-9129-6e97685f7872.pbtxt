    tool_calls {
      id: "call_10044590438692590982"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Integrate live Phase 3 Reminders summary into HomeView KPIs, Daily Briefing prompt, and Active module list.\", \"Instruction\":\"Import useReminders, mark Reminders active in MODULE_SPECS, pass live reminder counts into Daily Briefing, and display live reminders count in HomeView overview strip.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":23, \"ReplacementContent\":\"import { useDebts } from \'../../../hooks/useDebts\';\\nimport { useReminders } from \'../../../hooks/useReminders\';\\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\", \"StartLine\":19, \"TargetContent\":\"import { useDebts } from \'../../../hooks/useDebts\';\\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\"}, {\"AllowMultiple\":false, \"EndLine\":50, \"ReplacementContent\":\"  {\\n    id: \'reminders\',\\n    titleKey: \'nav.reminders\',\\n    active: true,\\n    icon: Bell,\\n    collection: \'users/{uid}/reminders\',\\n    summary: \'RRULE recurrence engine, 8 channels, quiet hours, and unit-tested rolling 64-notification scheduler.\',\\n  },\", \"StartLine\":42, \"TargetContent\":\"  {\\n    id: \'reminders\',\\n    titleKey: \'nav.reminders\',\\n    phase: 3,\\n    icon: Bell,\\n    collection: \'users/{uid}/reminders\',\\n    summary: \'RRULE recurrence engine, 8 channels, quiet hours, and unit-tested rolling 64-notification scheduler.\',\\n  },\"}, {\"AllowMultiple\":false, \"EndLine\":106, \"ReplacementContent\":\"  const { debts, fxRates } = useDebts();\\n  const { summary: remSummary, rollingQueue } = useReminders();\", \"StartLine\":102, \"TargetContent\":\"  const { debts, fxRates } = useDebts();\"}, {\"AllowMultiple\":false, \"EndLine\":137, \"ReplacementContent\":\"    const netFmt = formatMoney(debtMetrics.equivalentNetPrimaryMinor, profile.primaryCurrency, profile.locale);\\n    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders due today: ${remSummary.dueTodayCount}, overdue reminders: ${remSummary.overdueCount}, scheduled rolling queue slots: ${rollingQueue.slots.length}/64, expiring vault docs: 0. Suggest one practical next step.`;\", \"StartLine\":132, \"TargetContent\":\"    const netFmt = formatMoney(debtMetrics.equivalentNetPrimaryMinor, profile.primaryCurrency, profile.locale);\\n    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders today: 0, expiring vault docs: 0. Suggest one practical next step.`;\"}, {\"AllowMultiple\":false, \"EndLine\":258, \"ReplacementContent\":\"        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            {t(\'nav.reminders\')} \302\267 {t(\'reminders.kpiDueToday\')}\\n          </div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n            {remSummary.dueTodayCount} due \302\267 {remSummary.overdueCount} overdue\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            Queue: {rollingQueue.slots.length}/64 \302\267 PIN Lock: {pinEnabled ? \'Active\' : \'Off\'}\\n          </div>\\n        </div>\", \"StartLine\":248, \"TargetContent\":\"        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            Security & Privacy Gate\\n          </div>\\n          <div className=\\\"mt-2 text-base font-semibold text-[var(--text-primary)]\\\">\\n            {t(\'home.aiPrivacyGateActive\')}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">\\n            PIN Lock: {pinEnabled ? \'Active\' : \'Off\'} \302\267 Firestore Rules Deployed\\n          </div>\\n        </div>\"}], \"TargetFile\":\"/src/features/home/ui/HomeView.tsx\", \"toolAction\":\"Wiring live Phase 3 Reminders into HomeView\", \"toolSummary\":\"Wire Reminders into HomeView\"}"
      original_name: "multi_replace_file_content"
    }
