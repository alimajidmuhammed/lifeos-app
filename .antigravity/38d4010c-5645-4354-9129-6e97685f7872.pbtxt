    command_line: "playwright-cli open http://localhost:3000 && playwright-cli resize 1440 900 && playwright-cli eval \"\n(async () => {\n  localStorage.removeItem(\'lifeos_local_debts_v1\');\n  const wait = (ms) => new Promise(r => setTimeout(r, ms));\n  const clickText = (sel, txt) => {\n    const el = Array.from(document.querySelectorAll(sel)).find(e => e.textContent && e.textContent.trim().includes(txt));\n    if (!el) throw new Error(\'Not found: \' + txt);\n    el.click();\n  };\n  clickText(\'aside button\', \'Debts\');\n  await wait(300);\n  const h1 = document.querySelector(\'h1\')?.textContent;\n\n  // Add Debt #1: Owed to me 250,000 IQD (Omar Ali)\n  clickText(\'button\', \'Add Debt\');\n  await wait(200);\n  const dialog = document.querySelector(\'[role=dialog]\');\n  const setVal = (el, v) => {\n    const proto = el.tagName === \'SELECT\' ? HTMLSelectElement.prototype : el.tagName === \'TEXTAREA\' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;\n    Object.getOwnPropertyDescriptor(proto, \'value\').set.call(el, v);\n    el.dispatchEvent(new Event(\'input\', { bubbles: true }));\n    el.dispatchEvent(new Event(\'change\', { bubbles: true }));\n  };\n  const inputs = dialog.querySelectorAll(\'input\');\n  // inputs[0] is AI quick entry, inputs[1] is personName, inputs[2] is phone, inputs[3] is amount, inputs[4] is dueDate, inputs[5] is apr\n  setVal(inputs[1], \'Omar Ali\');\n  setVal(inputs[3], \'250000\');\n  setVal(inputs[4], \'2026-12-15\');\n  clickText(\'[role=dialog] button[type=submit]\', \'Save Debt\');\n  await wait(300);\n\n  // Add Debt #2: I Owe $500 USD at 18% APR (overdue)\n  clickText(\'button\', \'Add Debt\');\n  await wait(200);\n  const d2 = document.querySelector(\'[role=dialog]\');\n  Array.from(d2.querySelectorAll(\'button\')).find(b => b.textContent?.trim() === \'I Owe\').click();\n  const in2 = d2.querySelectorAll(\'input\');\n  setVal(in2[1], \'Bank Credit Line\');\n  setVal(in2[3], \'500\');\n  setVal(d2.querySelector(\'select\'), \'USD\');\n  setVal(in2[4], \'2026-11-01\');\n  setVal(in2[5], \'18\');\n  clickText(\'[role=dialog] button[type=submit]\', \'Save Debt\');\n  await wait(300);\n\n  // Log partial payment of 50,000 IQD on Omar Ali\n  const logBtns = Array.from(document.querySelectorAll(\'button\')).filter(b => b.textContent?.includes(\'Log Payment\'));\n  logBtns[1]?.click(); // Omar Ali is second (newest first)\n  await wait(200);\n  const payDialog = document.querySelector(\'[role=dialog]\');\n  const payInput = payDialog.querySelector(\'input[type=number]\');\n  setVal(payInput, \'50000\');\n  setVal(payDialog.querySelector(\'select\'), \'zaincash\');\n  clickText(\'[role=dialog] button[type=submit]\', \'Record Payment\');\n  await wait(300);\n\n  // Verify Payoff Plan tab renders\n  clickText(\'[role=tab]\', \'Payoff Plan\');\n  await wait(200);\n  const plannerText = document.querySelector(\'main\')?.textContent?.includes(\'Bank Credit Line\');\n\n  // Verify Forecast tab renders\n  clickText(\'[role=tab]\', \'30/60/90d Forecast\');\n  await wait(200);\n  const forecastText = document.querySelector(\'main\')?.textContent?.includes(\'Overdue Now\');\n\n  // Verify People tab renders\n  clickText(\'[role=tab]\', \'People\');\n  await wait(200);\n  const peopleText = document.querySelector(\'main\')?.textContent?.includes(\'Reliability: 100% on-time\');\n\n  // Back to Ledger\n  clickText(\'[role=tab]\', \'Ledger\');\n  await wait(200);\n  const ledgerHasUpdated = document.querySelector(\'main\')?.textContent?.includes(\'200,000 IQD\');\n\n  return { h1, plannerText, forecastText, peopleText, ledgerHasUpdated };\n})()\n\" && playwright-cli screenshot --filename=/tmp/debts_desktop.png && playwright-cli resize 390 844 && sleep 1 && playwright-cli eval \"({ scrollWidth: document.documentElement.scrollWidth, clientWidth: document.documentElement.clientWidth, overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth })\" && playwright-cli screenshot --filename=/tmp/debts_mobile.png && playwright-cli console && playwright-cli close"
