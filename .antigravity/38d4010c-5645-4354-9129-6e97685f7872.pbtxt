    tool_calls {
      id: "call_17119085287290311074"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"rules_version = \'2\';\\n\\nservice cloud.firestore {\\n  match /databases/{database}/documents {\\n\\n    // 1. Global Default-Deny Safety Net\\n    match /{document=**} {\\n      allow read, write: if false;\\n    }\\n\\n    // 2. Hardened Global Primitives\\n    function isValidId(id) {\\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\');\\n    }\\n\\n    function incoming() {\\n      return request.resource.data;\\n    }\\n\\n    function existing() {\\n      return resource.data;\\n    }\\n\\n    function isVerifiedOwner(userId) {\\n      return request.auth != null\\n        && request.auth.token.email_verified == true\\n        && isValidId(userId)\\n        && request.auth.uid == userId;\\n    }\\n\\n    function isValidLocale(val) {\\n      return val in [\'en\', \'ar\', \'ckb\'];\\n    }\\n\\n    function isValidTheme(val) {\\n      return val in [\'light\', \'dark\', \'amoled\'];\\n    }\\n\\n    function isValidCurrency(val) {\\n      return val in [\'IQD\', \'USD\', \'EUR\'];\\n    }\\n\\n    function isValidTimeHHMM(val) {\\n      return val is string && val.size() == 5 && val.matches(\'^([01]\\\\\\\\d|2[0-3]):[0-5]\\\\\\\\d$\');\\n    }\\n\\n    // 3. Entity Validation Blueprints (Anti-Update-Gap)\\n    function isValidUserProfile(data, userId) {\\n      return data.keys().hasAll([\\n          \'uid\', \'displayName\', \'locale\', \'theme\',\\n          \'primaryCurrency\', \'secondaryCurrency\', \'vaultStorageMode\',\\n          \'aiGlobalEnabled\', \'analyticsConsent\', \'aiPrivacyNoticeAccepted\',\\n          \'e2eConfigured\', \'version\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.keys().hasOnly([\\n          \'uid\', \'displayName\', \'email\', \'locale\', \'theme\',\\n          \'primaryCurrency\', \'secondaryCurrency\', \'vaultStorageMode\',\\n          \'aiGlobalEnabled\', \'aiModuleToggles\', \'analyticsConsent\',\\n          \'aiPrivacyNoticeAccepted\', \'e2eConfigured\', \'e2eSalt\', \'e2eVerifier\',\\n          \'quietHoursStart\', \'quietHoursEnd\', \'version\', \'createdAt\', \'updatedAt\'\\n        ])\\n        && data.uid == userId\\n        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100\\n        && (!(\'email\' in data) || (data.email is string && data.email.size() <= 254))\\n        && isValidLocale(data.locale)\\n        && isValidTheme(data.theme)\\n        && isValidCurrency(data.primaryCurrency)\\n        && isValidCurrency(data.secondaryCurrency)\\n        && data.vaultStorageMode in [\'local_only\', \'cloud_private\']\\n        && data.aiGlobalEnabled is bool\\n        && (!(\'aiModuleToggles\' in data) || data.aiModuleToggles is map)\\n        && data.analyticsConsent is bool\\n        && data.aiPrivacyNoticeAccepted is bool\\n        && data.e2eConfigured is bool\\n        && (!(\'e2eSalt\' in data) || (data.e2eSalt is string && data.e2eSalt.size() <= 128))\\n        && (!(\'e2eVerifier\' in data) || (data.e2eVerifier is string && data.e2eVerifier.size() <= 256))\\n        && (!(\'quietHoursStart\' in data) || isValidTimeHHMM(data.quietHoursStart))\\n        && (!(\'quietHoursEnd\' in data) || isValidTimeHHMM(data.quietHoursEnd))\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidAiUsageDay(data, userId, dayKey) {\\n      return data.keys().hasAll([\'uid\', \'dayKey\', \'requestCount\', \'inputTokensEst\', \'outputTokensEst\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'dayKey\', \'requestCount\', \'inputTokensEst\', \'outputTokensEst\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.dayKey == dayKey\\n        && dayKey is string && dayKey.size() == 10 && dayKey.matches(\'^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}$\')\\n        && data.requestCount is int && data.requestCount >= 1 && data.requestCount <= 1000\\n        && data.inputTokensEst is int && data.inputTokensEst >= 0 && data.inputTokensEst <= 10000000\\n        && data.outputTokensEst is int && data.outputTokensEst >= 0 && data.outputTokensEst <= 10000000\\n        && data.updatedAt == request.time;\\n    }\\n\\n    function isValidDebtLedger(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'personName\', \'onTimeCount\', \'lateCount\', \'activeDebtCount\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'personName\', \'onTimeCount\', \'lateCount\', \'activeDebtCount\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.personName is string && data.personName.size() >= 1 && data.personName.size() <= 120\\n        && data.onTimeCount is int && data.onTimeCount >= 0\\n        && data.lateCount is int && data.lateCount >= 0\\n        && data.activeDebtCount is int && data.activeDebtCount >= 0\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidDebtRecord(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'direction\', \'personKey\', \'personName\', \'principalMinor\', \'remainingMinor\', \'currency\', \'status\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'direction\', \'personKey\', \'personName\', \'principalMinor\', \'remainingMinor\', \'currency\', \'status\', \'notes\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.direction in [\'i_owe\', \'owed_to_me\']\\n        && isValidId(data.personKey)\\n        && data.personName is string && data.personName.size() >= 1 && data.personName.size() <= 120\\n        && data.principalMinor is int && data.principalMinor > 0\\n        && data.remainingMinor is int && data.remainingMinor >= 0 && data.remainingMinor <= data.principalMinor\\n        && isValidCurrency(data.currency)\\n        && data.status in [\'active\', \'partial\', \'overdue\', \'settled\']\\n        && (!(\'notes\' in data) || (data.notes is string && data.notes.size() <= 2000))\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidReminderItem(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'title\', \'category\', \'isCompleted\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'title\', \'category\', \'rrule\', \'isCompleted\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\\n        && data.category in [\'routine\', \'birthday\', \'debt\', \'task\', \'medicine\', \'bill\', \'expiry\', \'custom\']\\n        && (!(\'rrule\' in data) || (data.rrule is string && data.rrule.size() <= 200))\\n        && data.isCompleted is bool\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidTaskItem(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'listId\', \'title\', \'priority\', \'sortKey\', \'status\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'listId\', \'title\', \'priority\', \'sortKey\', \'status\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && isValidId(data.listId)\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\\n        && data.priority is int && data.priority >= 1 && data.priority <= 4\\n        && data.sortKey is string && data.sortKey.size() >= 1 && data.sortKey.size() <= 64\\n        && data.status in [\'todo\', \'in_progress\', \'done\']\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidNoteItem(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'title\', \'content\', \'isEncrypted\', \'isLocked\', \'pinned\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'title\', \'content\', \'isEncrypted\', \'isLocked\', \'pinned\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\\n        && data.content is string && data.content.size() <= 100000\\n        && data.isEncrypted is bool\\n        && data.isLocked is bool\\n        && data.pinned is bool\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidVaultDocumentMeta(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'title\', \'docType\', \'storageMode\', \'isEncrypted\', \'sizeBytes\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'title\', \'docType\', \'storageMode\', \'isEncrypted\', \'sizeBytes\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200\\n        && data.docType in [\'passport\', \'id\', \'invoice\', \'contract\', \'receipt\', \'other\']\\n        && data.storageMode in [\'local_only\', \'cloud_private\']\\n        && data.isEncrypted is bool\\n        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 52428800\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidHabitItem(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'name\', \'frequency\', \'currentStreak\', \'bestStreak\', \'archived\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'name\', \'frequency\', \'currentStreak\', \'bestStreak\', \'archived\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120\\n        && data.frequency in [\'daily\', \'weekly\']\\n        && data.currentStreak is int && data.currentStreak >= 0\\n        && data.bestStreak is int && data.bestStreak >= 0\\n        && data.archived is bool\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    function isValidTransactionItem(data, userId) {\\n      return data.keys().hasAll([\'uid\', \'type\', \'amountMinor\', \'currency\', \'category\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.keys().hasOnly([\'uid\', \'type\', \'amountMinor\', \'currency\', \'category\', \'note\', \'version\', \'createdAt\', \'updatedAt\'])\\n        && data.uid == userId\\n        && data.type in [\'income\', \'expense\']\\n        && data.amountMinor is int && data.amountMinor > 0\\n        && isValidCurrency(data.currency)\\n        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64\\n        && (!(\'note\' in data) || (data.note is string && data.note.size() <= 500))\\n        && data.version is int && data.version >= 1\\n        && data.createdAt is timestamp\\n        && data.updatedAt is timestamp;\\n    }\\n\\n    // 4. Per-User Tenant Isolation Matches\\n    match /users/{userId} {\\n      allow get: if isVerifiedOwner(userId);\\n      allow list: if false;\\n      allow create: if isVerifiedOwner(userId)\\n        && isValidUserProfile(incoming(), userId)\\n        && incoming().createdAt == request.time\\n        && incoming().updatedAt == request.time;\\n      allow update: if isVerifiedOwner(userId)\\n        && isValidUserProfile(incoming(), userId)\\n        && incoming().uid == existing().uid\\n        && incoming().createdAt == existing().createdAt\\n        && incoming().updatedAt == request.time\\n        && incoming().version == existing().version + 1\\n        && incoming().diff(existing()).affectedKeys().hasOnly([\\n          \'displayName\', \'email\', \'locale\', \'theme\',\\n          \'primaryCurrency\', \'secondaryCurrency\', \'vaultStorageMode\',\\n          \'aiGlobalEnabled\', \'aiModuleToggles\', \'analyticsConsent\',\\n          \'aiPrivacyNoticeAccepted\', \'e2eConfigured\', \'e2eSalt\', \'e2eVerifier\',\\n          \'quietHoursStart\', \'quietHoursEnd\', \'version\', \'updatedAt\'\\n        ]);\\n      allow delete: if false;\\n\\n      // Server-only entitlements (client read-only)\\n      match /entitlements/{entitlementId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(entitlementId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create, update, delete: if false;\\n      }\\n\\n      // Monotonic daily AI quota counter (no delete, no decrement)\\n      match /aiUsage/{dayKey} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(dayKey);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId)\\n          && isValidAiUsageDay(incoming(), userId, dayKey)\\n          && incoming().requestCount == 1;\\n        allow update: if isVerifiedOwner(userId)\\n          && isValidAiUsageDay(incoming(), userId, dayKey)\\n          && incoming().uid == existing().uid\\n          && incoming().dayKey == existing().dayKey\\n          && incoming().requestCount == existing().requestCount + 1\\n          && incoming().inputTokensEst >= existing().inputTokensEst\\n          && incoming().outputTokensEst >= existing().outputTokensEst\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'requestCount\', \'inputTokensEst\', \'outputTokensEst\', \'updatedAt\']);\\n        allow delete: if false;\\n      }\\n\\n      match /debtLedgers/{personKey} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(personKey);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(personKey)\\n          && isValidDebtLedger(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(personKey)\\n          && isValidDebtLedger(incoming(), userId)\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().version == existing().version + 1\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'personName\', \'onTimeCount\', \'lateCount\', \'activeDebtCount\', \'version\', \'updatedAt\']);\\n        allow delete: if isVerifiedOwner(userId) && isValidId(personKey);\\n      }\\n\\n      match /debts/{debtId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(debtId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(debtId)\\n          && isValidDebtRecord(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(debtId)\\n          && isValidDebtRecord(incoming(), userId)\\n          && existing().status != \'settled\'\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().version == existing().version + 1\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'personName\', \'remainingMinor\', \'status\', \'notes\', \'version\', \'updatedAt\']);\\n        allow delete: if isVerifiedOwner(userId) && isValidId(debtId);\\n      }\\n\\n      match /reminders/{reminderId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(reminderId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(reminderId)\\n          && isValidReminderItem(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(reminderId)\\n          && isValidReminderItem(incoming(), userId)\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().version == existing().version + 1\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'category\', \'rrule\', \'isCompleted\', \'version\', \'updatedAt\']);\\n        allow delete: if isVerifiedOwner(userId) && isValidId(reminderId);\\n      }\\n\\n      match /tasks/{taskId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(taskId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(taskId)\\n          && isValidTaskItem(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(taskId)\\n          && isValidTaskItem(incoming(), userId)\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().version == existing().version + 1\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'listId\', \'title\', \'priority\', \'sortKey\', \'status\', \'version\', \'updatedAt\']);\\n        allow delete: if isVerifiedOwner(userId) && isValidId(taskId);\\n      }\\n\\n      match /notes/{noteId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(noteId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(noteId)\\n          && isValidNoteItem(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(noteId)\\n          && isValidNoteItem(incoming(), userId)\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && incoming().version == existing().version + 1\\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'title\', \'content\', \'isEncrypted\', \'isLocked\', \'pinned\', \'version\', \'updatedAt\']);\\n        allow delete: if isVerifiedOwner(userId) && isValidId(noteId);\\n      }\\n\\n      match /documents/{docId} {\\n        allow get: if isVerifiedOwner(userId) && isValidId(docId);\\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\\n        allow create: if isVerifiedOwner(userId) && isValidId(docId)\\n          && isValidVaultDocumentMeta(incoming(), userId)\\n          && incoming().createdAt == request.time\\n          && incoming().updatedAt == request.time;\\n        allow update: if isVerifiedOwner(userId) && isValidId(docId)\\n          && isValidVaultDocumentMeta(incoming(), userId)\\n          && incoming().uid == existing().uid\\n          && incoming().createdAt == existing().createdAt\\n          && incoming().updatedAt == request.time\\n          && inc