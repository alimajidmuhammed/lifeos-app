        instruction: "rules_version = \'2\';\n\n// Cloud Storage rules (inactive during Stage 0 Local-Only Vault mode; ready for Blaze enablement)\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /{allPaths=**} {\n      allow read, write: if false;\n    }\n\n    match /users/{userId}/vault/{docId}/{fileName} {\n      allow read: if request.auth != null\n        && request.auth.token.email_verified == true\n        && request.auth.uid == userId;\n      allow write: if request.auth != null\n        && request.auth.token.email_verified == true\n        && request.auth.uid == userId\n        && request.resource.size <= 10 * 1024 * 1024\n        && (\n          request.resource.contentType.matches(\'application/pdf\') ||\n          request.resource.contentType.matches(\'image/(jpeg|png|webp)\') ||\n          request.resource.contentType.matches(\'application/octet-stream\')\n        );\n      allow delete: if request.auth != null\n        && request.auth.token.email_verified == true\n        && request.auth.uid == userId;\n    }\n  }\n}\n"
        path {
          absolute_uri: "file:///storage.rules"
        }
        overwrite: true
      }
    }
