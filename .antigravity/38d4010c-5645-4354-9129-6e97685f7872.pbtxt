    tool_calls {
      id: "call_7273518339855619792"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Bind localized translation keys for SettingsView descriptions, free-tier indicator, PIN label, and E2E passphrase label.\", \"Instruction\":\"Replace hardcoded English helper strings in SettingsView.tsx with t() keys\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":176, \"ReplacementContent\":\"            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              {t(\'settings.appearanceDesc\')}\\n            </p>\", \"StartLine\":168, \"TargetContent\":\"            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              Calm slate &amp; emerald palette across Light, Dark, and pure-black AMOLED surfaces.\\n            </p>\"}, {\"AllowMultiple\":false, \"EndLine\":218, \"ReplacementContent\":\"            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              {t(\'settings.languageDesc\')}\\n            </p>\", \"StartLine\":210, \"TargetContent\":\"            <p className=\\\"mt-0.5 text-xs text-[var(--text-muted)]\\\">\\n              Full logical RTL layout mirroring for Arabic and Kurdish Sorani.\\n            </p>\"}, {\"AllowMultiple\":false, \"EndLine\":319, \"ReplacementContent\":\"            <span className=\\\"text-xs font-medium text-[var(--text-primary)]\\\">\\n              {profile.aiGlobalEnabled ? t(\'settings.aiOn\') : t(\'settings.aiOff\')}\\n            </span>\\n          </label>\\n        </div>\\n\\n        <div className=\\\"pt-4 border-t border-[var(--border-hairline)]\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)] mb-3\\\">\\n            {t(\'settings.aiModuleTogglesTitle\')}\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n            {AI_MODULES.map((m) => {\\n              const checked = Boolean(toggles[m.key]) && !m.lockedOnFreeTier;\\n              return (\\n                <label\\n                  key={m.key}\\n                  className={`min-h-[44px] flex items-center justify-between gap-3 rounded-xl border border-[var(--border-hairline)] px-3.5 py-2 text-xs ${\\n                    m.lockedOnFreeTier\\n                      ? \'bg-[var(--bg-subtle)]/50 text-[var(--text-muted)] cursor-not-allowed\'\\n                      : \'bg-[var(--bg-canvas)] text-[var(--text-primary)] cursor-pointer\'\\n                  }`}\\n                >\\n                  <span>\\n                    {t(m.labelKey)}\\n                    {m.lockedOnFreeTier ? ` (${t(\'settings.blockedFreeTier\')})` : \'\'}\\n                  </span>\", \"StartLine\":296, \"TargetContent\":\"            <span className=\\\"text-xs font-medium text-[var(--text-primary)]\\\">\\n              {profile.aiGlobalEnabled ? \'On\' : \'Off\'}\\n            </span>\\n          </label>\\n        </div>\\n\\n        <div className=\\\"pt-4 border-t border-[var(--border-hairline)]\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)] mb-3\\\">\\n            {t(\'settings.aiModuleTogglesTitle\')}\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n            {AI_MODULES.map((m) => {\\n              const checked = Boolean(toggles[m.key]) && !m.lockedOnFreeTier;\\n              return (\\n                <label\\n                  key={m.key}\\n                  className={`min-h-[44px] flex items-center justify-between gap-3 rounded-xl border border-[var(--border-hairline)] px-3.5 py-2 text-xs ${\\n                    m.lockedOnFreeTier\\n                      ? \'bg-[var(--bg-subtle)]/50 text-[var(--text-muted)] cursor-not-allowed\'\\n                      : \'bg-[var(--bg-canvas)] text-[var(--text-primary)] cursor-pointer\'\\n                  }`}\\n                >\\n                  <span>\\n                    {t(m.labelKey)}\\n                    {m.lockedOnFreeTier ? \' (Blocked on free tier)\' : \'\'}\\n                  </span>\"}, {\"AllowMultiple\":