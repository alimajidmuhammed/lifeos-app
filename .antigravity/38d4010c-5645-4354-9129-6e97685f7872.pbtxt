            lines {
              text: "    // 4. Per-User Tenant Isolation Matches"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    match /users/{userId} {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow get: if isVerifiedOwner(userId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow list: if false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow create: if isVerifiedOwner(userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && isValidUserProfile(incoming(), userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().createdAt == request.time"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().updatedAt == request.time;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      allow update: if isVerifiedOwner(userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && isValidUserProfile(incoming(), userId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().uid == existing().uid"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().createdAt == existing().createdAt"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().updatedAt == request.time"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().version == existing().version + 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        && incoming().diff(existing()).affectedKeys().hasOnly(["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'displayName\', \'email\', \'locale\', \'theme\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'primaryCurrency\', \'secondaryCurrency\', \'vaultStorageMode\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
