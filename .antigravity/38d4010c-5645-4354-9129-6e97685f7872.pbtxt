    thinking: "**Analyzing Debt Features**\n\nI\'m currently focused on feature implementation for debt management. The key areas under development are the detailed debt inspector with probability factors for repayments, an audit log, and editing/deleting functionalities. Also, I am working on the analytic panels for user-based data.\n\n\n"
    message_id: "nagEa4_-AabU_PUP5vGn-Ak"
    tool_calls {
      id: "call_16734685193205479514"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Edit3,\\n  MessageSquareText,\\n  Trash2,\\n  X,\\n} from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { formatMoney } from \'../../../core/currency/currency\';\\nimport {\\n  computeDaysOverdue,\\n  computeEffectiveStatus,\\n  estimateRepaymentProbability,\\n} from \'../../../core/debts/debtEngine\';\\nimport type { DebtLedger, DebtPayment, DebtRecord } from \'../../../core/debts/debtSchemas\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\n\\ninterface DebtDetailDrawerProps {\\n  debt: DebtRecord | null;\\n  ledger: DebtLedger | null;\\n  listPayments: (debtId: string) => Promise<DebtPayment[]>;\\n  onClose: () => void;\\n  onEdit: (debt: DebtRecord) => void;\\n  onLogPayment: (debt: DebtRecord) => void;\\n  onDraftReminder: (debt: DebtRecord) => void;\\n  onDelete: (debt: DebtRecord) => Promise<void>;\\n}\\n\\nexport const DebtDetailDrawer: React.FC<DebtDetailDrawerProps> = ({\\n  debt,\\n  ledger,\\n  listPayments,\\n  onClose,\\n  onEdit,\\n  onLogPayment,\\n  onDraftReminder,\\n  onDelete,\\n}) => {\\n  const { t } = useTranslation();\\n  const locale = useUIStore((s) => s.profile.locale);\\n\\n  const [payments, setPayments] = useState<DebtPayment[]>([]);\\n  const [loadingPayments, setLoadingPayments] = useState(false);\\n\\n  useEffect(() => {\\n    if (!debt) return;\\n    let active = true;\\n    setLoadingPayments(true);\\n    void listPayments(debt.id)\\n      .then((list) => {\\n        if (active) setPayments(list);\\n      })\\n      .finally(() => {\\n        if (active) setLoadingPayments(false);\\n      });\\n    return () => {\\n      active = false;\\n    };\\n  }, [debt, debt?.paymentCount, listPayments]);\\n\\n  if (!debt) return null;\\n\\n  const effStatus = computeEffectiveStatus(debt);\\n  const daysOverdue = computeDaysOverdue(debt);\\n  const paidMinor = debt.principalMinor - debt.remainingMinor;\\n  const pctPaid = Math.min(100, Math.round((paidMinor / Math.max(1, debt.principalMinor)) * 100));\\n  const prob =\\n    debt.direction === \'owed_to_me\' ? estimateRepaymentProbability(debt, ledger) : null;\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={debt.personName}\\n      className=\\\"fixed inset-0 z-50 flex justify-end bg-slate-950/50 backdrop-blur-xs\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"w-full max-w-md h-dvh overflow-y-auto border-s border-[var(--border-hairline)] bg-[var(--bg-surface)] flex flex-col\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"sticky top-0 z-10 flex items-center justify-between border-b border-[var(--border-hairline)] bg-[var(--bg-surface)] px-5 py-4\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)] truncate\\\">\\n              {debt.personName}\\n            </h2>\\n            <p className=\\\"text-xs text-[var(--text-muted)]\\\">\\n              {debt.direction === \'owed_to_me\' ? t(\'debts.owedToMe\') : t(\'debts.iOwe\')} \302\267{\' \'}\\n              {debt.category.replace(\'_\', \' \')}\\n              {debt.personPhone ? ` \302\267 ${debt.personPhone}` : \'\'}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={t(\'common.close\')}\\n            onClick={onClose}\\n            className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]\\\"\\n          >\\n            <X className=\\\"h-4 w-4\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"flex-1 p-5 space-y-6\\\">\\n          {/* Balance Summary */}\\n          <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-4 space-y-3\\\">\\n            <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n              <span className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n                {t(\'debts.remaining\')}\\n              </span>\\n              <span\\n                className={`text-xs font-medium ${\\n                  effStatus === \'overdue\'\\n                    ? \'text-red-600 dark:text-red-400\'\\n                    : effStatus === \'settled\'\\n                      ? \'text-[var(--accent)]\'\\n                      : \'text-[var(--text-secondary)]\'\\n                }`}\\n              >\\n                {effStatus === \'settled\'\\n                  ? t(\'debts.settledLocked\')\\n                  : effStatus === \'overdue\'\\n                    ? t(\'debts.overdueDays\', { count: daysOverdue })\\n                    : debt.dueDate\\n                      ? `${t(\'debts.dueDate\')} ${debt.dueDate}`\\n                      : t(\'debts.noDueDate\')}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"font-numeric text-2xl font-bold text-[var(--text-primary)]\\\">\\n              {formatMoney(debt.remainingMinor, debt.currency, locale)}\\n            </div>\\n\\n            <div className=\\\"h-1.5 w-full rounded-full bg-[var(--bg-subtle)] overflow-hidden\\\">\\n              <div\\n                className=\\\"h-full rounded-full bg-[var(--accent)] transition-all duration-200\\\"\\n                style={{ width: `${pctPaid}%` }}\\n              />\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-between text-xs text-[var(--text-muted)] font-numeric\\\">\\n              <span>\\n                Paid: {formatMoney(paidMinor, debt.currency, locale)} ({pctPaid}%)\\n              </span>\\n              <span>\\n                Principal: {formatMoney(debt.principalMinor, debt.currency, locale)}\\n              </span>\\n            </div>\\n\\n            {debt.interestRateBps > 0 && (\\n              <div className=\\\"pt-2 border-t border-[var(--border-hairline)] text-xs text-[var(--text-secondary)] font-numeric\\\">\\n                APR: {(debt.interestRateBps / 100).toFixed(2)}%\\n              </div>\\n            )}\\n          </div>\\n\\n          {/* Primary Actions */}\\n          {effStatus !== \'settled\' && (\\n            <div className=\\\"grid grid-cols-3 gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onLogPayment(debt)}\\n                className=\\\"min-h-[42px] inline-flex items-center justify-center gap-1.5 rounded-xl bg-[var(--accent)] px-3 py-2 text-xs font-medium text-white hover:bg-[var(--accent-hover)]\\\"\\n              >\\n                <CheckCircle2 className=\\\"h-3.5 w-3.5 shrink-0\\\" />\\n                <span className=\\\"truncate\\\">{t(\'debts.logPayment\')}</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onDraftReminder(debt)}\\n                className=\\\"min-h-[42px] inline-flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\\\"\\n              >\\n                <MessageSquareText className=\\\"h-3.5 w-3.5 shrink-0\\\" />\\n                <span className=\\\"truncate\\\">{t(\'debts.draftReminder\')}</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onEdit(debt)}\\n                className=\\\"min-h-[42px] inline-flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\\\"\\n              >\\n                <Edit3 className=\\\"h-3.5 w-3.5 shrink-0\\\" />\\n                <span className=\\\"truncate\\\">{t(\'debts.editDebt\')}</span>\\n              </button>\\n            </div>\\n          )}\\n\\n          {/* Deterministic Repayment Probability Breakdown */}\\n          {prob && (\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"flex items-baseline justify-between\\\">\\n                <h3 className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n                  {t(\'debts.repaymentScore\')} (Deterministic)\\n                </h3>\\n                <span\\n                  className={`font-numeric text-sm font-bold ${\\n                    prob.band === \'high\'\\n                      ? \'text-[var(--accent)]\'\\n                      : prob.band === \'moderate\'\\n                        ? \'text-amber-600 dark:text-amber-400\'\\n                        : \'text-red-600 dark:text-red-400\'\\n                  }`}\\n                >\\n                  {prob.score}%\\n                </span>\\n              </div>\\n              <ul className=\\\"space-y-1 text-xs text-[var(--text-secondary)]\\\">\\n                {prob.factors.map((f, idx) => (\\n                  <li key={idx} className=\\\"flex items-start gap-2\\\">\\n                    <span aria-hidden=\\\"true\\\" className=\\\"text-[var(--text-muted)]\\\">\302\267</span>\\n                    <span>{f}</span>\\n                  </li>\\n                ))}\\n              </ul>\\n            </div>\\n          )}\\n\\n          {/* Notes */}\\n          {debt.notes && (\\n            <div className=\\\"space-y-1\\\">\\n              <h3 className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n                {t(\'debts.notesLabel\')}\\n              </h3>\\n              <p className=\\\"text-sm text-[var(--text-secondary)] whitespace-pre-wrap leading-relaxed\\\">\\n                {debt.notes}\\n              </p>\\n            </div>\\n          )}\\n\\n          {/* Append-only Payment Audit Log */}\\n          <div className=\\\"space-y-2.5\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <h3 className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n                {t(\'debts.paymentHistory\')}\\n              </h3>\\n              <span className=\\\"font-numeric text-xs text-[var(--text-muted)]\\\">\\n                {payments.length} entries\\n              </span>\\n            </div>\\n\\n            {loadingPayments ? (\\n              <div className=\\\"space-y-2\\\">\\n                <div className=\\\"h-12 rounded-xl bg-[var(--bg-subtle)] animate-pulse\\\" />\\n              </div>\\n            ) : payments.length === 0 ? (\\n              <p className=\\\"text-xs text-[var(--text-muted)]\\\">{t(\'debts.noPaymentsYet\')}</p>\\n            ) : (\\n              <div className=\\\"rounded-xl border border-[var(--border-hairline)] divide-y divide-[var(--border-hairline)] overflow-hidden\\\">\\n                {payments.map((p) => (\\n                  <div key={p.id} className=\\\"px-3.5 py-3 flex items-center justify-between gap-3\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <div className=\\\"font-numeric text-sm font-semibold text-[var(--text-primary)]\\\">\\n                        {formatMoney(p.amountMinor, p.currency, locale)}\\n                      </div>\\n                      <div className=\\\"text-xs text-[var(--text-muted)] truncate\\\">\\n                        <span className=\\\"font-numeric\\\">{p.paidOn}</span> \302\267 {p.method.replace(\'_\', \' \')}\\n                        {p.note ? ` \302\267 ${p.note}` : \'\'}\\n                      </div>\\n                    </div>\\n                    <span\\n                      className={`text-xs font-medium whitespace-nowrap ${\\n                        p.wasOnTime\\n                          ? \'text-[var(--accent)]\'\\n                          : \'text-amber-600 dark:text-amber-400\'\\n                      }`}\\n                    >\\n                      {p.wasOnTime ? \'On time\' : \'Late\'}\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Footer Delete Action */}\\n        <div className=\\\"border-t border-[var(--border-hairline)] p-4\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              void onDelete(debt);\\n              onClose();\\n            }}\\n            className=\\\"w-full min-h-[42px] inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 dark:border-red-900/60 px-4 py-2 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors\\\"\\n          >\\n            <Trash2 className=\\\"h-3.5 w-3.5\\\" />\\n            <span>{t(\'debts.deleteDebt\')}</span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DebtDetailDrawer displaying full balance progress, deterministic repayment probability factors, append-only payment history, and edit/delete actions.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/debts/ui/DebtDetailDrawer.tsx\", \"toolAction\":\"Creating DebtDetailDrawer component\", \"toolSummary\":\"Create DebtDetailDrawer.tsx\"}"
      thinking_signature: "\022\312\b\n\307\b\001i\024}\023\333\374\370\276\036\243\333\034\247Z\354z0Y\034\230!\")1\234Y\273\350\365\344i\373\267D\202\222\t\177\204\322\364<\006\347\236E\341\232~\367\264\034#\227\200\350\313\300/\342\0010zC\343>\247\031\263\003c\206\247G\232~\2444\352\rtq\006\206\256(2mm?\034C\251c\266G\207\217re\254\370[\254\354\340\\\251w\224\251\346@\2502\016\003v9\234\v\"B\306\371\rm\0303\'\236\024>-\023_\033\323!H\033\031\213\247I\345\321\224Y\343\254!\305\301rF\220\340\243\177\373\355-\262b\030G\275\035&\344\347\326z\306E\316\257W\036\360\271\223\200E\255P\207\243\374\bxhl\212\021\257P\2069\371\366?\232\206\006c\312\'\260y\364\332b`\2321\327\341\3477O\371\223\ve\334\202\346!\372\v\006\243\236\363\2319S\000\373\037P\225\333\257\277~\211\351\351th~\375\002E;u\220\3524&\317\017J\3472\3425>\2737\373L\202\363\325X\227\211\374\3276n~\004\177\222\365\a\026\364\313U\345\347\023\376\263\322ez\300T\371I!\271\267+Y7O\362ST\"0\202\375\177\204\362\035\351#cX\006\272\016Zn\312\352\276\0274\200Q\2247E\201\024\352\251X\301\346\032\342L\212\271\177\356\214\033a\\\037\251*\312\020\200\247\314\361\270\3371\200\rU\272\236\r>\322\320{\207\307\003\363?\267\361\236\253D%Se\216\030\367\323As\324\276\312\204\323oc\333\004\265\023\306\241\321\272\n\t\256q(i\262L\226\203\\\245T\220\032b\304\323a\201v\'w)\305\355\200l\243C\360\316\034Z\0173\362\3001\305\0054\257\243\004\313(\356!\342\313|\027\251Rt\\?X\223\217\314E\302;\024k\025\373\026\322=\341;Z\034\252\225_:s\356\277\352\250m\260\342b\265\236\272\312?\260\350F\302\216ad\255\327\334q1\307\250\343\224\020>\327>\v\266?\032n\271~LdM55\036,\\\v\245\273]\254\024\227\221~\361\305\262I\317\206j\313d2\201\371\n\353\310\370\262,\260\342\216\036\307!FS!\f\264u;w\343\n\000s1 <\240\254\v\277{\253\335CN\026\031\255\031\331+\202\254p\022^\364I\260\267\3762\022.D\204\b\'G\221\ft\023\000\025\310\303d+\331\021e\314_\310B\326b\300|\315U\244^\243\241J\306\270\27586\212\376p\2273!\3546\031\260Gs\370\313\f\017k~\267\024\352\207\2240\232r\324%w\021z\'\264[\"\311\331\347iy\021\221i0\247\301\370\356\201\343\252n\024^\313\367-\031\241\324\032K\265\345{dn\357M\355\236\272\r\303\363\226a?(\3157*.\305\310+\237\351\aQ\230\263gxr\310/a\037\020\\\322\210K@2\346\023\205\3118o\317\372{9\325\262r\237\b\252\310,I\255M\345\336/\216\372\032T\036QJ\373\214\322{\216;\344\273\250;%\3621_\277\350\036\350C\226\275\204:\247>v\350\021\342\343\315o\354[\251\365\356\374\352\206&\216\247\024z\242\262\373\3255\024Q\234\177\033+\213\254@\020d\252X\307\r\030\"?\2320$\2063\323\230\217\367\211\315v[\305\347p=\035d\223\342\3213\"\260\315\355\304\233\021\256sK\235:\256\243G\223\025\372BQ\301\271\363\370b\032\336Tft\344\206\023\214\366\005\rW<\031GU\346\270jUv\327\203\350WW#F\374\030C\024Y:g\344P \274 \333\225\277\211o[d_V\302\330\275\220\000yZ\276^\355K\000\341~\033\257\333o\314`\330\326\376\221:\0274Q\261X\274\353\202,\224\377\b\350\332\222\260Tb{\264t\216\005s\360\226\320\236\352\315s\023\302\003R\031_\f\261\247\261\300\177\240\a\177\350z\375R\373\256\266\370\201\n\214\310\245}\v\216\034m\355r\r\020\271\356\245\302\277\360D\252\240\347Pw\372\302D\353L\322\t9\026\331\322=\211\037\340f\266\223\352\364\213\355b\3418"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16734685193205481265"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport { ArrowRight } from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { formatMoney, toMinorUnits, type CurrencyCode } from \'../../../core/currency/currency\';\\nimport {\\n  buildCashFlowForecast,\\n  buildPersonLedgerRollups,\\n  computePayoffPlan,\\n  SUPPORTED_CURRENCIES,\\n  type CashFlowHorizonId,\\n  type PayoffStrategy,\\n} from \'../../../core/debts/debtEngine\';\\nimport type { DebtLedger, DebtRecord, FxRatesToIqd } from \'../../../core/debts/debtSchemas\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\n\\ninterface PeoplePanelProps {\\n  debts: DebtRecord[];\\n  ledgersByKey: Record<string, DebtLedger>;\\n  onFilterByPerson: (personName: string) => void;\\n}\\n\\nexport const PeopleLedgerPanel: React.FC<PeoplePanelProps> = ({\\n  debts,\\n  ledgersByKey,\\n  onFilterByPerson,\\n}) => {\\n  const { t } = useTranslation();\\n  const locale = useUIStore((s) => s.profile.locale);\\n\\n  const people = useMemo(\\n    () => buildPersonLedgerRollups(debts, ledgersByKey),\\n    [debts, ledgersByKey]\\n  );\\n\\n  if (people.length === 0) {\\n    return (\\n      <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-8 text-center\\\">\\n        <p className=\\\"text-sm font-medium text-[var(--text-primary)]\\\">{t(\'debts.emptyTitle\')}</p>\\n        <p className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">{t(\'debts.emptyDesc\')}</p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)] overflow-hidden\\\">\\n      {people.map((person) => {\\n        const activeCurrencies = SUPPORTED_CURRENCIES.filter(\\n          (c) =>\\n            person.owedToMeByCurrencyMinor[c] !== 0 ||\\n            person.iOweByCurrencyMinor[c] !== 0\\n        );\\n        const totalHistory = person.onTimeCount + person.lateCount;\\n        const onTimePct =\\n          totalHistory > 0 ? Math.round((person.onTimeCount / totalHistory) * 100) : null;\\n\\n        return (\\n          <button\\n            key={person.personKey}\\n            type=\\\"button\\\"\\n            onClick={() => onFilterByPerson(person.personName)}\\n            className=\\\"w-full px-5 py-4 text-start flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[var(--bg-subtle)]/60 transition-colors\\\"\\n          >\\n            <div className=\\\"min-w-0\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                <span className=\\\"text-sm font-semibold text-[var(--text-primary)]\\\">\\n                  {person.personName}\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                <span className=\\\"font-numeric text-xs text-[var(--text-muted)]\\\">\\n                  {person.activeCount} open\\n                </span>\\n                {person.overdueCount > 0 && (\\n                  <>\\n                    <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                    <span className=\\\"font-numeric text-xs font-medium text-red-600 dark:text-red-400\\\">\\n                      {person.overdueCount} overdue\\n                    </span>\\n                  </>\\n                )}\\n                {person.settledCount > 0 && (\\n                  <>\\n                    <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                    <span className=\\\"font-numeric text-xs text-[var(--text-muted)]\\\">\\n                      {person.settledCount} settled\\n                    </span>\\n                  </>\\n                )}\\n              </div>\\n              <div className=\\\"mt-1 text-xs text-[var(--text-secondary)]\\\">\\n                {onTimePct !== null ? (\\n                  <span className=\\\"font-numeric\\\">\\n                    Reliability: {onTimePct}% on-time ({person.onTimeCount}/{totalHistory})\\n                  </span>\\n                ) : (\\n                  <span>No completed payment history yet</span>\\n                )}\\n                {person.avgRepaymentScore !== null && (\\n                  <>\\n                    <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n                    <span className=\\\"font-numeric\\\">\\n                      Est. repayment: {person.avgRepaymentScore}%\\n                    </span>\\n                  </>\\n                )}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-4 shrink-0\\\">\\n              <div className=\\\"text-end space-y-0.5\\\">\\n                {activeCurrencies.length === 0 ? (\\n                  <span className=\\\"text-xs font-medium text-[var(--accent)]\\\">All settled</span>\\n                ) : (\\n                  activeCurrencies.map((c) => {\\n                    const net = person.netByCurrencyMinor[c];\\n                    return (\\n                      <div\\n                        key={c}\\n                        className={`font-numeric text-sm font-semibold ${\\n                          net > 0\\n                            ? \'text-[var(--accent)]\'\\n                            : net < 0\\n                              ? \'text-red-600 dark:text-red-400\'\\n                              : \'text-[var(--text-primary)]\'\\n                        }`}\\n                      >\\n                        {net > 0 ? \'+\' : \'\'}\\n                        {formatMoney(net, c, locale)}\\n                      </div>\\n                    );\\n                  })\\n                )}\\n              </div>\\n              <ArrowRight className=\\\"h-4 w-4 text-[var(--text-muted)] rtl:rotate-180\\\" />\\n            </div>\\n          </button>\\n        );\\n      })}\\n    </div>\\n  );\\n};\\n\\ninterface PayoffPlannerPanelProps {\\n  debts: DebtRecord[];\\n  primaryCurrency: CurrencyCode;\\n  fxRates: FxRatesToIqd;\\n}\\n\\nexport const PayoffPlannerPanel: React.FC<PayoffPlannerPanelProps> = ({\\n  debts,\\n  primaryCurrency,\\n  fxRates,\\n}) => {\\n  const { t } = useTranslation();\\n  const locale = useUIStore((s) => s.profile.locale);\\n\\n  const [strategy, setStrategy] = useState<PayoffStrategy>(\'avalanche\');\\n  const defaultBudgetMajor = primaryCurrency === \'IQD\' ? \'500000\' : \'350\';\\n  const [budgetInput, setBudgetInput] = useState(defaultBudgetMajor);\\n\\n  const budgetMinor = useMemo(() => {\\n    const val = Number(budgetInput.replace(/,/g, \'\'));\\n    if (!Number.isFinite(val) || val <= 0) return 0;\\n    return toMinorUnits(val, primaryCurrency);\\n  }, [budgetInput, primaryCurrency]);\\n\\n  const snowballPlan = useMemo(\\n    () => computePayoffPlan(debts, \'snowball\', budgetMinor, primaryCurrency, fxRates),\\n    [debts, budgetMinor, primaryCurrency, fxRates]\\n  );\\n\\n  const avalanchePlan = useMemo(\\n    () => computePayoffPlan(debts, \'avalanche\', budgetMinor, primaryCurrency, fxRates),\\n    [debts, budgetMinor, primaryCurrency, fxRates]\\n  );\\n\\n  const activePlan = strategy === \'snowball\' ? snowballPlan : avalanchePlan;\\n  const interestDiff = snowballPlan.totalInterestPrimaryMinor - avalanchePlan.totalInterestPrimaryMinor;\\n\\n  const openIOweCount = debts.filter(\\n    (d) => d.direction === \'i_owe\' && d.remainingMinor > 0 && d.status !== \'settled\'\\n  ).length;\\n\\n  if (openIOweCount === 0) {\\n    return (\\n      <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-8 text-center\\\">\\n        <p className=\\\"text-sm font-semibold text-[var(--text-primary)]\\\">\\n          No open &ldquo;{t(\'debts.iOwe\')}&rdquo; debts to schedule\\n        </p>\\n        <p className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">\\n          Add any personal loan, installment, or balance you owe to compare Snowball vs. Avalanche payoff timelines.\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      {/* Controls & Side-by-Side Comparison */}\\n      <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-5 space-y-4\\\">\\n        <div className=\\\"flex flex-col md:flex-row md:items-end justify-between gap-4\\\">\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1.5\\\">\\n              {t(\'debts.monthlyBudget\')} ({primaryCurrency})\\n            </label>\\n            <input\\n              type=\\\"number\\\"\\n              min=\\\"1\\\"\\n              step={primaryCurrency === \'IQD\' ? \'25000\' : \'25\'}\\n              value={budgetInput}\\n              onChange={(e) => setBudgetInput(e.target.value)}\\n              className=\\\"w-full sm:w-56 min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 text-sm font-semibold text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-1.5 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n            {([\'avalanche\', \'snowball\'] as PayoffStrategy[]).map((s) => (\\n              <button\\n                key={s}\\n                type=\\\"button\\\"\\n                onClick={() => setStrategy(s)}\\n                className={`min-h-[40px] px-3.5 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap ${\\n                  strategy === s\\n                    ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                    : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                }`}\\n              >\\n                {s === \'avalanche\' ? t(\'debts.avalanche\') : t(\'debts.snowball\')}\\n              </button>\\n            ))}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-px rounded-xl border border-[var(--border-hairline)] bg-[var(--border-hairline)] overflow-hidden\\\">\\n          <div className=\\\"bg-[var(--bg-canvas)] p-4\\\">\\n            <div className=\\\"text-xs text-[var(--text-muted)]\\\">{t(\'debts.monthsToFree\')}</div>\\n            <div className=\\\"mt-1 font-numeric text-xl font-bold text-[var(--text-primary)]\\\">\\n              {activePlan.cappedAtMaxMonths ? \'120+ mo\' : `${activePlan.totalMonths} mo`}\\n            </div>\\n          </div>\\n          <div className=\\\"bg-[var(--bg-canvas)] p-4\\\">\\n            <div className=\\\"text-xs text-[var(--text-muted)]\\\">{t(\'debts.estInterest\')}</div>\\n            <div className=\\\"mt-1 font-numeric text-xl font-bold text-[var(--text-primary)]\\\">\\n              {formatMoney(activePlan.totalInterestPrimaryMinor, primaryCurrency, locale)}\\n            </div>\\n          </div>\\n          <div className=\\\"bg-[var(--bg-canvas)] p-4\\\">\\n            <div className=\\\"text-xs text-[var(--text-muted)]\\\">{t(\'debts.interestSaved\')}</div>\\n            <div className=\\\"mt-1 font-numeric text-xl font-bold text-[var(--accent)]\\\">\\n              {interestDiff > 0\\n                ? formatMoney(interestDiff, primaryCurrency, locale)\\n                : formatMoney(0, primaryCurrency, locale)}\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Ordered Payoff Sequence Table */}\\n      <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] overflow-x-auto\\\">\\n        <table className=\\\"w-full text-start border-collapse\\\">\\n          <thead>\\n            <tr className=\\\"border-b border-[var(--border-hairline)] text-xs font-medium text-[var(--text-muted)]\\\">\\n              <th className=\\\"py-3 px-4 text-start\\\">Order</th>\\n              <th className=\\\"py-3 px-4 text-start\\\">Lender</th>\\n              <th className=\\\"py-3 px-4 text-end\\\">Balance</th>\\n              <th className=\\\"py-3 px-4 text-end\\\">APR</th>\\n              <th className=\\\"py-3 px-4 text-end\\\">Est. Interest</th>\\n              <th className=\\\"py-3 px-4 text-end\\\">Payoff Month</th>\\n            </tr>\\n          </thead>\\n          <tbody className=\\\"divide-y divide-[var(--border-hairline)] text-sm\\\">\\n            {activePlan.items.map((item, idx) => (\\n              <tr key={item.debtId} className=\\\"hover:bg-[var(--bg-subtle)]/50\\\">\\n                <td className=\\\"py-3 px-4 font-numeric text-xs text-[var(--text-muted)]\\\">\\n                  #{idx + 1}\\n                </td>\\n                <td className=\\\"py-3 px-4 font-medium text-[var(--text-primary)]\\\">\\n                  {item.personName}\\n                </td>\\n                <td className=\\\"py-3 px-4 text-end font-numeric text-[var(--text-primary)]\\\">\\n                  {formatMoney(item.remainingOriginalMinor, item.currency, locale)}\\n                </td>\\n                <td className=\\\"py-3 px-4 text-end font-numeric text-[var(--text-secondary)]\\\">\\n                  {(item.interestRateBps / 100).toFixed(2)}%\\n                </td>\\n                <td className=\\\"py-3 px-4 text-end font-numeric text-[var(--text-secondary)]\\\">\\n                  {formatMoney(item.estimatedInterestPrimaryMinor, primaryCurrency, locale)}\\n                </td>\\n                <td className=\\\"py-3 px-4 text-end font-numeric font-semibold text-[var(--accent)]\\\">\\n                  {item.payoffMonth > 0 ? `Month ${item.payoffMonth}` : \'>120 mo\'}\\n                </td>\\n              </tr>\\n            ))}\\n          </tbody>\\n        </table>\\n      </div>\\n    </div>\\n  );\\n};\\n\\ninterface CashFlowForecastPanelProps {\\n  debts: DebtRecord[];\\n  primaryCurrency: CurrencyCode;\\n  fxRates: FxRatesToIqd;\\n}\\n\\nconst HORIZON_LABELS: Record<CashFlowHorizonId, string> = {\\n  overdue: \'Overdue Now\',\\n  days_0_30: \'Next 30 Days\',\\n  days_31_60: \'Days 31 \342\200\223 60\',\\n  days_61_90: \'Days 61 \342\200\223 90\',\\n  beyond_90: \'Beyond 90 Days\',\\n  no_date: \'Flexible / No Due Date\',\\n};\\n\\nexport const CashFlowForecastPanel: React.FC<CashFlowForecastPanelProps> = ({\\n  debts,\\n  primaryCurrency,\\n  fxRates,\\n}) => {\\n  const { t } = useTranslation();\\n  const locale = useUIStore((s) => s.profile.locale);\\n\\n  const buckets = useMemo(\\n    () => buildCashFlowForecast(debts, primaryCurrency, fxRates),\\n    [debts, primaryCurrency, fxRates]\\n  );\\n\\n  const maxFlow = Math.max(\\n    1,\\n    ...buckets.map((b) => Math.max(b.inflowPrimaryMinor, b.outflowPrimaryMinor))\\n  );\\n\\n  return (\\n    <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)] overflow-hidden\\\">\\n      <div className=\\\"px-5 py-3.5 flex flex-wrap items-center justify-between gap-2 text-xs text-[var(--text-muted)]\\\">\\n        <span>All amounts converted to {primaryCurrency} using your reference FX rates</span>\\n        <span className=\\\"font-numeric\\\">\\n          {t(\'debts.inflow\')} vs. {t(\'debts.outflow\')}\\n        </span>\\n      </div>\\n\\n      {buckets.map((b) => {\\n        const inflowPct = Math.round((b.inflowPrimaryMinor / maxFlow) * 100);\\n        const outflowPct = Math.round((b.outflowPrimaryMinor / maxFlow) * 100);\\n\\n        return (\\n          <div key={b.id} className=\\\"px-5 py-4 space-y-2.5\\\">\\n            <div className=\\\"flex flex-wrap items-baseline justify-between gap-2\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span\\n                  className={`text-sm font-semibold ${\\n                    b.id === \'overdue\' && (b.inflowCount > 0 || b.outflowCount > 0)\\n                      ? \'text-red-600 dark:text-red-400\'\\n                      : \'text-[var(--text-primary)]\'\\n                  }`}\\n                >\\n                  {HORIZON_LABELS[b.id]}\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                <span className=\\\"font-numeric text-xs text-[var(--text-muted)]\\\">\\n                  {b.inflowCount + b.outflowCount} items\\n                </span>\\n              </div>\\n\\n              <div\\n                className={`font-numeric text-sm font-semibold ${\\n                  b.netPrimaryMinor > 0\\n                    ? \'text-[var(--accent)]\'\\n                    : b.netPrimaryMinor < 0\\n                      ? \'text-red-600 dark:text-red-400\'\\n                      : \'text-[var(--text-muted)]\'\\n                }`}\\n              >\\n                {t(\'debts.netCash\')}: {b.netPrimaryMinor > 0 ? \'+\' : \'\'}\\n                {formatMoney(b.netPrimaryMinor, primaryCurrency, locale)}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\\\">\\n              <div className=\\\"space-y-1\\\">\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[var(--text-secondary)]\\\">\\n                    {t(\'debts.inflow\')} ({b.inflowCount})\\n                  </span>\\n                  <span className=\\\"font-numeric font-medium text-[var(--accent)]\\\">\\n                    {formatMoney(b.inflowPrimaryMinor, primaryCurrency, locale)}\\n                  </span>\\n                </div>\\n                <div className=\\\"h-1.5 rounded-full bg-[var(--bg-subtle)] overflow-hidden\\\">\\n                  <div\\n                    className=\\\"h-full rounded-full bg-[var(--accent)] transition-all duration-200\\\"\\n                    style={{ width: `${inflowPct}%` }}\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"space-y-1\\\">\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[var(--text-secondary)]\\\">\\n                    {t(\'debts.outflow\')} ({b.outflowCount})\\n                  </span>\\n                  <span className=\\\"font-numeric font-medium text-red-600 dark:text-red-400\\\">\\n                    {formatMoney(b.outflowPrimaryMinor, primaryCurrency, locale)}\\n                  </span>\\n                </div>\\n                <div className=\\\"h-1.5 rounded-full bg-[var(--bg-subtle)] overflow-hidden\\\">\\n                  <div\\n                    className=\\\"h-full rounded-full bg-red-500 transition-all duration-200\\\"\\n                    style={{ width: `${outflowPct}%` }}\\n                  />\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        );\\n      })}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create modular analytics panels for Phase 2 Debts Manager: People Counterparty Rollup, Snowball vs Avalanche Payoff Planner, and 30/60/90-day Cash-Flow Forecast.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/debts/ui/DebtsAnalyticsPanels.tsx\", \"toolAction\":\"Creating Debts analytics panels\", \"toolSummary\":\"Create DebtsAnalyticsPanels.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16734685193205478920"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Download,\\n  MessageSquareText,\\n  Plus,\\n  Search,\\n  SlidersHorizontal,\\n  Sparkles,\\n} from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { formatMoney } from \'../../../core/currency/currency\';\\nimport {\\n  aggregateDebtMetrics,\\n  computeDaysOverdue,\\n  computeEffectiveStatus,\\n  estimateRepaymentProbability,\\n  exportDebtsToCsv,\\n  getTodayYmd,\\n} from \'../../../core/debts/debtEngine\';\\nimport type { DebtDirection, DebtRecord } from \'../../../core/debts/debtSchemas\';\\nimport { useDebts } from \'../../../hooks/useDebts\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\nimport { DebtFormModal } from \'./DebtFormModal\';\\nimport { DebtPaymentModal } from \'./DebtPaymentModal\';\\nimport { DebtReminderModal } from \'./DebtReminderModal\';\\nimport { DebtDetailDrawer } from \'./DebtDetailDrawer\';\\nimport {\\n  CashFlowForecastPanel,\\n  PayoffPlannerPanel,\\n  PeopleLedgerPanel,\\n} from \'./DebtsAnalyticsPanels\';\\n\\ntype SubTab = \'ledger\' | \'people\' | \'planner\' | \'forecast\';\\ntype StatusFilter = \'open\' | \'overdue\' | \'settled\' | \'all\';\\ntype DirectionFilter = \'all\' | DebtDirection;\\n\\nexport const DebtsView: React.FC = () => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const showToast = useUIStore((s) => s.showToast);\\n\\n  const {\\n    debts,\\n    ledgersByKey,\\n    loading,\\n    fxRates,\\n    setFxRates,\\n    createDebt,\\n    updateDebtMeta,\\n    recordPayment,\\n    deleteDebt,\\n    restoreDebt,\\n    listPayments,\\n    isCloudSynced,\\n  } = useDebts();\\n\\n  const [subTab, setSubTab] = useState<SubTab>(\'ledger\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [directionFilter, setDirectionFilter] = useState<DirectionFilter>(\'all\');\\n  const [statusFilter, setStatusFilter] = useState<StatusFilter>(\'open\');\\n  const [fxEditorOpen, setFxEditorOpen] = useState(false);\\n  const [usdRateInput, setUsdRateInput] = useState(String(fxRates.USD));\\n  const [eurRateInput, setEurRateInput] = useState(String(fxRates.EUR));\\n\\n  const [formOpen, setFormOpen] = useState(false);\\n  const [formFocusAi, setFormFocusAi] = useState(false);\\n  const [editingDebt, setEditingDebt] = useState<DebtRecord | null>(null);\\n  const [payingDebt, setPayingDebt] = useState<DebtRecord | null>(null);\\n  const [reminderDebt, setReminderDebt] = useState<DebtRecord | null>(null);\\n  const [selectedDebtId, setSelectedDebtId] = useState<string | null>(null);\\n\\n  const todayYmd = getTodayYmd();\\n\\n  const metrics = useMemo(\\n    () => aggregateDebtMetrics(debts, profile.primaryCurrency, fxRates, todayYmd),\\n    [debts, profile.primaryCurrency, fxRates, todayYmd]\\n  );\\n\\n  const selectedDebt = useMemo(\\n    () => (selectedDebtId ? debts.find((d) => d.id === selectedDebtId) ?? null : null),\\n    [debts, selectedDebtId]\\n  );\\n\\n  const filteredDebts = useMemo(() => {\\n    const q = searchQuery.trim().toLowerCase();\\n    return debts.filter((d) => {\\n      const eff = computeEffectiveStatus(d, todayYmd);\\n      if (statusFilter === \'open\' && eff === \'settled\') return false;\\n      if (statusFilter === \'overdue\' && eff !== \'overdue\') return false;\\n      if (statusFilter === \'settled\' && eff !== \'settled\') return false;\\n      if (directionFilter !== \'all\' && d.direction !== directionFilter) return false;\\n      if (q) {\\n        const hay = `${d.personName} ${d.category} ${d.notes ?? \'\'} ${d.currency}`.toLowerCase();\\n        if (!hay.includes(q)) return false;\\n      }\\n      return true;\\n    });\\n  }, [debts, searchQuery, directionFilter, statusFilter, todayYmd]);\\n\\n  const handleSaveFxRates = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const usd = Number(usdRateInput);\\n    const eur = Number(eurRateInput);\\n    if (!Number.isFinite(usd) || usd <= 0 || !Number.isFinite(eur) || eur <= 0) {\\n      showToast(\'Enter valid positive exchange rates.\');\\n      return;\\n    }\\n    setFxRates({ IQD: 1, USD: Math.round(usd), EUR: Math.round(eur) });\\n    setFxEditorOpen(false);\\n    showToast(\'Reference FX rates updated.\');\\n  };\\n\\n  const handleExportCsv = () => {\\n    const csv = exportDebtsToCsv(debts, todayYmd);\\n    const blob = new Blob([csv], { type: \'text/csv;charset=utf-8;\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `lifeos-debts-${todayYmd}.csv`;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n    showToast(\'Exported debts CSV.\');\\n  };\\n\\n  const handleDeleteWithUndo = async (debt: DebtRecord) => {\\n    await deleteDebt(debt);\\n    showToast(`Deleted debt for ${debt.personName}.`, () => {\\n      void restoreDebt(debt);\\n    });\\n  };\\n\\n  const primaryCur = profile.primaryCurrency;\\n  const secondaryCur = profile.secondaryCurrency;\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Page Header */}\\n      <section className=\\\"flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between\\\">\\n        <div>\\n          <p className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            <span>{isCloudSynced ? t(\'common.syncedCloudMode\') : t(\'common.offlineLocalMode\')}</span>\\n            <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n            <span className=\\\"font-numeric\\\">1 USD = {fxRates.USD.toLocaleString()} IQD</span>\\n          </p>\\n          <h1 className=\\\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]\\\">\\n            {t(\'debts.title\')}\\n          </h1>\\n          <p className=\\\"mt-1 max-w-2xl text-sm text-[var(--text-secondary)]\\\">\\n            {t(\'debts.subtitle\')}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setEditingDebt(null);\\n              setFormFocusAi(true);\\n              setFormOpen(true);\\n            }}\\n            className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3.5 py-2 text-xs sm:text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors whitespace-nowrap\\\"\\n          >\\n            <Sparkles className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n            <span>{t(\'debts.aiQuickEntry\')}</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setEditingDebt(null);\\n              setFormFocusAi(false);\\n              setFormOpen(true);\\n            }}\\n            className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-4 py-2 text-xs sm:text-sm font-medium text-white hover:bg-[var(--accent-hover)] transition-colors whitespace-nowrap\\\"\\n          >\\n            <Plus className=\\\"h-4 w-4\\\" />\\n            <span>{t(\'debts.addDebt\')}</span>\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* 4-Column Flat KPI Strip (Single Elevation, Hairline Dividers, Tabular Figures) */}\\n      <section\\n        aria-label=\\\"Debts financial summary\\\"\\n        className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl border border-[var(--border-hairline)] bg-[var(--border-hairline)] overflow-hidden\\\"\\n      >\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'debts.owedToMe\')}</div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--accent)]\\\">\\n            {formatMoney(metrics.equivalentOwedToMePrimaryMinor, primaryCur, profile.locale)}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            {primaryCur}: {formatMoney(metrics.byCurrency[primaryCur].owedToMeMinor, primaryCur, profile.locale)} \302\267{\' \'}\\n            {secondaryCur}: {formatMoney(metrics.byCurrency[secondaryCur].owedToMeMinor, secondaryCur, profile.locale)}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'debts.iOwe\')}</div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n            {formatMoney(metrics.equivalentIOwePrimaryMinor, primaryCur, profile.locale)}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            {primaryCur}: {formatMoney(metrics.byCurrency[primaryCur].iOweMinor, primaryCur, profile.locale)} \302\267{\' \'}\\n            {secondaryCur}: {formatMoney(metrics.byCurrency[secondaryCur].iOweMinor, secondaryCur, profile.locale)}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'debts.netPosition\')}</span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setFxEditorOpen((v) => !v)}\\n              className=\\\"inline-flex items-center gap-1 text-[11px] font-medium text-[var(--accent)] hover:underline\\\"\\n            >\\n              <SlidersHorizontal className=\\\"h-3 w-3\\\" />\\n              <span>{t(\'debts.fxRatesBtn\')}</span>\\n            </button>\\n          </div>\\n          <div\\n            className={`mt-2 font-numeric text-xl font-semibold ${\\n              metrics.equivalentNetPrimaryMinor > 0\\n                ? \'text-[var(--accent)]\'\\n                : metrics.equivalentNetPrimaryMinor < 0\\n                  ? \'text-red-600 dark:text-red-400\'\\n                  : \'text-[var(--text-primary)]\'\\n            }`}\\n          >\\n            {metrics.equivalentNetPrimaryMinor > 0 ? \'+\' : \'\'}\\n            {formatMoney(metrics.equivalentNetPrimaryMinor, primaryCur, profile.locale)}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            {metrics.totalOpenCount} open \302\267 {metrics.totalSettledCount} settled\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'debts.overdueAttention\')}</div>\\n          <div\\n            className={`mt-2 font-numeric text-xl font-semibold ${\\n              metrics.totalOverdueCount > 0\\n                ? \'text-red-600 dark:text-red-400\'\\n                : \'text-[var(--text-primary)]\'\\n            }`}\\n          >\\n            {metrics.totalOverdueCount}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">\\n            {metrics.totalOverdueCount > 0\\n              ? \'Past due date \342\200\224 review or send reminder\'\\n              : \'All open obligations on schedule\'}\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Editable FX Rates Bar (on demand) */}\\n      {fxEditorOpen && (\\n        <form\\n          onSubmit={handleSaveFxRates}\\n          className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-4 flex flex-wrap items-end gap-3\\\"\\n        >\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n              1 USD in IQD\\n            </label>\\n            <input\\n              type=\\\"number\\\"\\n              min=\\\"1\\\"\\n              value={usdRateInput}\\n              onChange={(e) => setUsdRateInput(e.target.value)}\\n              className=\\\"w-36 min-h-[38px] font-numeric rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-1.5 text-sm text-[var(--text-primary)]\\\"\\n            />\\n          </div>\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n              1 EUR in IQD\\n            </label>\\n            <input\\n              type=\\\"number\\\"\\n              min=\\\"1\\\"\\n              value={eurRateInput}\\n              onChange={(e) => setEurRateInput(e.target.value)}\\n              className=\\\"w-36 min-h-[38px] font-numeric rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-1.5 text-sm text-[var(--text-primary)]\\\"\\n            />\\n          </div>\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"min-h-[38px] rounded-lg bg-[var(--accent)] px-4 py-1.5 text-xs font-medium text-white hover:bg-[var(--accent-hover)]\\\"\\n          >\\n            {t(\'common.save\')}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setFxEditorOpen(false)}\\n            className=\\\"min-h-[38px] rounded-lg border border-[var(--border-hairline)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)]\\\"\\n          >\\n            {t(\'common.cancel\')}\\n          </button>\\n        </form>\\n      )}\\n\\n      {/* Segmented View Tabs + CSV Export */}\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n        <div\\n          role=\\\"tablist\\\"\\n          aria-label=\\\"Debts views\\\"\\n          className=\\\"inline-flex flex-wrap items-center gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\"\\n        >\\n          {(\\n            [\\n              { id: \'ledger\', label: t(\'debts.tabLedger\') },\\n              { id: \'people\', label: t(\'debts.tabPeople\') },\\n              { id: \'planner\', label: t(\'debts.tabPlanner\') },\\n              { id: \'forecast\', label: t(\'debts.tabForecast\') },\\n            ] as const\\n          ).map((tab) => (\\n            <button\\n              key={tab.id}\\n              role=\\\"tab\\\"\\n              aria-selected={subTab === tab.id}\\n              type=\\\"button\\\"\\n              onClick={() => setSubTab(tab.id)}\\n              className={`min-h-[38px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap ${\\n                subTab === tab.id\\n                  ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                  : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n              }`}\\n            >\\n              {tab.label}\\n            </button>\\n          ))}\\n        </div>\\n\\n        {debts.length > 0 && (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleExportCsv}\\n            className=\\\"inline-flex min-h-[38px] items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3.5 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n          >\\n            <Download className=\\\"h-3.5 w-3.5\\\" />\\n            <span>{t(\'debts.exportCsv\')}</span>\\n          </button>\\n        )}\\n      </div>\\n\\n      {/* Sub-view Content */}\\n      {subTab === \'people\' ? (\\n        <PeopleLedgerPanel\\n          debts={debts}\\n          ledgersByKey={ledgersByKey}\\n          onFilterByPerson={(name) => {\\n            setSearchQuery(name);\\n            setStatusFilter(\'all\');\\n            setDirectionFilter(\'all\');\\n            setSubTab(\'ledger\');\\n          }}\\n        />\\n      ) : subTab === \'planner\' ? (\\n        <PayoffPlannerPanel\\n          debts={debts}\\n          primaryCurrency={profile.primaryCurrency}\\n          fxRates={fxRates}\\n        />\\n      ) : subTab === \'forecast\' ? (\\n        <CashFlowForecastPanel\\n          debts={debts}\\n          primaryCurrency={profile.primaryCurrency}\\n          fxRates={fxRates}\\n        />\\n      ) : (\\n        <div className=\\\"space-y-4\\\">\\n          {/* Search & Filter Toolbar */}\\n          <div className=\\\"flex flex-col md:flex-row md:items-center justify-between gap-3\\\">\\n            <div className=\\\"relative flex-1 max-w-md\\\">\\n              <Search className=\\\"pointer-events-none absolute start-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[var(--text-muted)]\\\" />\\n              <input\\n                type=\\\"search\\\"\\n                value={searchQuery}\\n                onChange={(e) => setSearchQuery(e.target.value)}\\n                placeholder={t(\'debts.searchPlaceholder\')}\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] ps-10 pe-3.5 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <div className=\\\"inline-flex items-center gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n                {(\\n                  [\\n                    { id: \'all\', label: t(\'debts.filterAll\') },\\n                    { id: \'owed_to_me\', label: t(\'debts.owedToMe\') },\\n                    { id: \'i_owe\', label: t(\'debts.iOwe\') },\\n                  ] as const\\n                ).map((item) => (\\n                  <button\\n                    key={item.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setDirectionFilter(item.id)}\\n                    className={`min-h-[34px] px-3 rounded-lg text-xs font-medium transition-colors whitespace-nowrap ${\\n                      directionFilter === item.id\\n                        ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                        : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                    }`}\\n                  >\\n                    {item.label}\\n                  </button>\\n                ))}\\n              </div>\\n\\n              <div className=\\\"inline-flex items-center gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n                {(\\n                  [\\n                    { id: \'open\', label: t(\'debts.filterOpen\') },\\n                    { id: \'overdue\', label: t(\'debts.filterOverdue\') },\\n                    { id: \'settled\', label: t(\'debts.filterSettled\') },\\n                    { id: \'all\', label: t(\'debts.filterAll\') },\\n                  ] as const\\n                ).map((item) => (\\n                  <button\\n                    key={item.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setStatusFilter(item.id)}\\n                    className={`min-h-[34px] px-3 rounded-lg text-xs font-medium transition-colors whitespace-nowrap ${\\n                      statusFilter === item.id\\n                        ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                        : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                    }`}\\n                  >\\n                    {item.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Debt Ledger Rows */}\\n          {loading ? (\\n            <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)]\\\">\\n              {[0, 1, 2].map((i) => (\\n                <div key={i} className=\\\"p-5 flex items-center justify-between gap-4\\\">\\n                  <div className=\\\"space-y-2 flex-1\\\">\\n                    <div className=\\\"h-4 w-40 rounded bg-[var(--bg-subtle)] animate-pulse\\\" />\\n                    <div className=\\\"h-3 w-64 rounded bg-[var(--bg-subtle)] animate-pulse\\\" />\\n                  </div>\\n                  <div className=\\\"h-5 w-24 rounded bg-[var(--bg-subtle)] animate-pulse\\\" />\\n                </div>\\n              ))}\\n            </div>\\n          ) : filteredDebts.length === 0 ? (\\n            <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-10 text-center space-y-3\\\">\\n              <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n                {debts.length === 0 ? t(\'debts.emptyTitle\') : \'No debts match your current filters\'}\\n              </h2>\\n              <p className=\\\"max-w-md mx-auto text-xs sm:text-sm text-[var(--text-secondary)]\\\">\\n                {debts.length === 0\\n                  ? t(\'debts.emptyDesc\')\\n                  : \'Try clearing the search box or switching status to All.\'}\\n              </p>\\n              {debts.length === 0 && (\\n                <div className=\\\"pt-2 flex flex-wrap items-center justify-center gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      setEditingDebt(null);\\n                      setFormFocusAi(false);\\n                      setFormOpen(true);\\n                    }}\\n                    className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)]\\\"\\n                  >\\n                    <Plus className=\\\"h-4 w-4\\\" />\\n                    <span>{t(\'debts.addDebt\')}</span>\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      setEditingDebt(null);\\n                      setFormFocusAi(true);\\n                      setFormOpen(true);\\n                    }}\\n                    className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\\\"\\n                  >\\n                    <Sparkles className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n                    <span>{t(\'debts.aiQuickEntry\')}</span>\\n                  </button>\\n                </div>\\n              )}\\n            </div>\\n          ) : (\\n            <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)] overflow-hidden\\\">\\n              {filteredDebts.map((debt) => {\\n                const effStatus = computeEffectiveStatus(debt, todayYmd);\\n                const daysOverdue = computeDaysOverdue(debt, todayYmd);\\n                const pctPaid = Math.min(\\n                  100,\\n                  Math.round(((debt.principalMinor - debt.remainingMinor) / Math.max(1, debt.principalMinor)) * 100)\\n                );\\n                const prob =\\n                  debt.direction === \'owed_to_me\' && effStatus !== \'settled\'\\n                    ? estimateRepaymentProbability(debt, ledgersByKey[debt.personKey] ?? null, todayYmd)\\n                    : null;\\n\\n                const statusLabel =\\n                  effStatus === \'settled\'\\n                    ? t(\'debts.statusSettled\')\\n                    : effStatus === \'overdue\'\\n                      ? t(\'debts.overdueDays\', { count: daysOverdue })\\n                      : effStatus === \'partial\'\\n                        ? t(\'debts.statusPartial\')\\n                        : t(\'debts.statusActive\');\\n\\n                return (\\n                  <div\\n                    key={debt.id}\\n                    className=\\\"px-5 py-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-[var(--bg-subtle)]/40 transition-colors\\\"\\n                  >\\n                    {/* Clickable Main Summary */}\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setSelectedDebtId(debt.id)}\\n                      className=\\\"flex-1 min-w-0 text-start space-y-1.5 focus:outline-none\\\"\\n                    >\\n                      <div className=\\\"flex flex-wrap items-center gap-x-2 gap-y-0.5\\\">\\n                        <span className=\\\"text-sm font-semibold text-[var(--text-primary)]\\\">\\n                          {debt.personName}\\n                        </span>\\n                        <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                        <span\\n                          className={`text-xs font-medium ${\\n                            debt.direction === \'owed_to_me\'\\n                              ? \'text-[var(--accent)]\'\\n                              : \'text-[var(--text-secondary)]\'\\n                          }`}\\n                        >\\n                          {debt.direction === \'owed_to_me\' ? t(\'debts.owedToMe\') : t(\'debts.iOwe\')}\\n                        </span>\\n                        <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                        <span className=\\\"text-xs text-[var(--text-muted)]\\\">\\n                          {debt.category.replace(\'_\', \' \')}\\n                        </span>\\n                        <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                        <span\\n                          className={`font-numeric text-xs font-medium ${\\n                            effStatus === \'overdue\'\\n                              ? \'text-red-600 dark:text-red-400\'\\n                              : effStatus === \'settled\'\\n                                ? \'text-[var(--accent)]\'\\n                                : \'text-[var(--text-muted)]\'\\n                          }`}\\n                        >\\n                          {statusLabel}\\n                        </span>\\n                      </div>\\n\\n                      <div className=\\\"flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--text-muted)]\\\">\\n                        <span className=\\\"font-numeric\\\">\\n                          {debt.dueDate ? `${t(\'debts.dueDate\')} ${debt.dueDate}` : t(\'debts.noDueDate\')}\\n                        </span>\\n                        {debt.interestRateBps > 0 && (\\n                          <span className=\\\"font-numeric\\\">\\n                            \302\267 APR {(debt.interestRateBps / 100).toFixed(1)}%\\n                          </span>\\n                        )}\\n                        {prob && (\\n                          <span\\n                            className={`font-numeric ${\\n                              prob.band === \'at_risk\'\\n                                ? \'text-red-600 dark:text-red-400\'\\n                                : prob.band === \'moderate\'\\n                                  ? \'text-amber-600 dark:text-amber-400\'\\n                                  : \'text-[var(--text-secondary)]\'\\n                            }`}\\n                          >\\n                            \302\267 {t(\'debts.repaymentScore\')}: {prob.score}%\\n                          </span>\\n                        )}\\n                        {debt.notes && (\\n                          <span className=\\\"truncate max-w-xs\\\">\302\267 {debt.notes}</span>\\n                        )}\\n                      </div>\\n\\n                      {/* Subtle Repayment Progress Hairline */}\\n                      {pctPaid > 0 && effStatus !== \'settled\' && (\\n                        <div className=\\\"pt-1 max-w-xs\\\">\\n                          <div className=\\\"h-1 w-full rounded-full bg-[var(--bg-subtle)] overflow-hidden\\\">\\n                            <div\\n                              className=\\\"h-full rounded-full bg-[var(--accent)]\\\"\\n                              style={{ width: `${pctPaid}%` }}\\n                            />\\n                          </div>\\n                        </div>\\n                      )}\\n                    </button>\\n\\n                    {/* Right Side: Amount + Functional Action Buttons */}\\n                    <div className=\\\"flex flex-wrap sm:flex-nowrap items-center justify-between lg:justify-end gap-4 shrink-0\\\">\\n                      <div className=\\\"text-start lg:text-end\\\">\\n                        <div\\n                          className={`font-numeric text-base font-semibold ${\\n                            effStatus === \'settled\'\\n                              ? \'text-[var(--text-muted)] line-through\'\\n                              : debt.direction === \'owed_to_me\'\\n                                ? \'text-[var(--accent)]\'\\n                                : \'text-[var(--text-primary)]\'\\n                          }`}\\n                        >\\n                          {formatMoney(debt.remainingMinor, debt.currency, profile.locale)}\\n                        </div>\\n                        {debt.remainingMinor !== debt.principalMinor && (\\n                          <div className=\\\"font-numeric text-[11px] text-[var(--text-muted)]\\\">\\n                            {t(\'debts.ofPrincipal\')} {formatMoney(debt.principalMinor, debt.currency, profile.locale)}\\n                          </div>\\n                        )}\\n                      </div>\\n\\n                      <div className=\\\"flex items-center gap-1.5\\\">\\n                        {effStatus !== \'settled\' && (\\n                          <>\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => setPayingDebt(debt)}\\n                              className=\\\"inline-flex min-h-[38px] items-center gap-1.5 rounded-lg bg-[var(--accent-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--accent)] hover:opacity-90 whitespace-nowrap\\\"\\n                            >\\n                              <CheckCircle2 className=\\\"h-3.5 w-3.5\\\" />\\n                              <span>{t(\'debts.logPayment\')}</span>\\n                            </button>\\n                            <button\\n                              type=\\\"button\\\"\\n                              aria-label={t(\'debts.draftReminder\')}\\n                              onClick={() => setReminderDebt(debt)}\\n                              className=\\\"inline-flex h-[38px] w-[38px] items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\\\"\\n                            >\\n                              <MessageSquareText className=\\\"h-4 w-4\\\" />\\n                            </button>\\n                          </>\\n                        )}\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => setSelectedDebtId(debt.id)}\\n                          className=\\\"inline-flex min-h-[38px] items-center rounded-lg border border-[var(--border-hairline)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n                        >\\n                          {t(\'debts.details\')}\\n                        </button>\\n                      </div>\\n                    </div>\\n                  </div>\\n                );\\n              })}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {/* Modals & Detail Drawer */}\\n      <DebtFormModal\\n        open={formOpen}\\n        editingDebt={editingDebt}\\n        initialFocusAi={formFocusAi}\\n        onClose={() => {\\n          setFormOpen(false);\\n          setEditingDebt(null);\\n        }}\\n        onCreate={async (input) => {\\n          await createDebt(input);\\n          showToast(`Saved debt for ${input.personName}.`);\\n        }}\\n        onUpdate={async (current, patch) => {\\n          await updateDebtMeta(current, patch);\\n          showToast(`Updated debt for ${patch.personName ?? current.personName}.`);\\n        }}\\n      />\\n\\n      <DebtPaymentModal\\n        debt={payingDebt}\\n        onClose={() => setPayingDebt(null)}\\n        onRecordPayment={async (debt, input) => {\\n          await recordPayment(debt, input);\\n          showToast(\\n            input.amountMinor === debt.remainingMinor\\n              ? `Debt with ${debt.personName} settled in full.`\\n              : `Logged payment for ${debt.personName}.`\\n          );\\n        }}\\n      />\\n\\n      <DebtReminderModal\\n        debt={reminderDebt}\\n        onClose={() => setReminderDebt(null)}\\n      />\\n\\n      <DebtDetailDrawer\\n        debt={selectedDebt}\\n        ledger={selectedDebt ? ledgersByKey[selectedDebt.personKey] ?? null : null}\\n        listPayments={listPayments}\\n        onClose={() => setSelectedDebtId(null)}\\n        onEdit={(debt) => {\\n          setSelectedDebtId(null);\\n          setEditingDebt(debt);\\n          setFormFocusAi(false);\\n          setFormOpen(true);\\n        }}\\n        onLogPayment={(debt) => {\\n          setPayingDebt(debt);\\n        }}\\n        onDraftReminder={(debt) => {\\n          setReminderDebt(debt);\\n        }}\\n        onDelete={handleDeleteWithUndo}\\n      />\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create main Phase 2 DebtsView combining KPI overview, FX editor, Ledger/People/Payoff Plan/Forecast tabs, live search & filters, CSV export, and all action modals/drawers.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/debts/ui/DebtsView.tsx\", \"toolAction\":\"Creating main DebtsView screen\", \"toolSummary\":\"Create DebtsView.tsx\"}"
      original_name: "write_to_file"
