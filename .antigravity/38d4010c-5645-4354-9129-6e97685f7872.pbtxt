    tool_calls {
      id: "call_959892791291629364"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Activate Planner and Notes modules on HomeView and wire live counts into Daily Briefing\", \"Instruction\":\"Import usePlanner and useNotes, mark planner and notes active in MODULE_SPECS, and include active tasks/notes counts in the Daily Briefing prompt and status summary.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":23, \"ReplacementContent\":\"import { useDebts } from \'../../../hooks/useDebts\';\\nimport { useReminders } from \'../../../hooks/useReminders\';\\nimport { usePlanner } from \'../../../hooks/usePlanner\';\\nimport { useNotes } from \'../../../hooks/useNotes\';\\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\", \"StartLine\":20, \"TargetContent\":\"import { useDebts } from \'../../../hooks/useDebts\';\\nimport { useReminders } from \'../../../hooks/useReminders\';\\nimport { useUIStore, type NavRoute } from \'../../../state/useUIStore\';\"}, {\"AllowMultiple\":false, \"EndLine\":67, \"ReplacementContent\":\"  {\\n    id: \'planner\',\\n    titleKey: \'nav.planner\',\\n    active: true,\\n    icon: CheckSquare,\\n    collection: \'users/{uid}/tasks\',\\n    summary: \'Single-write fractional-index task ordering, subtasks, unified calendar, and AI goal breakdown.\',\\n  },\\n  {\\n    id: \'notes\',\\n    titleKey: \'nav.notes\',\\n    active: true,\\n    icon: BookText,\\n    collection: \'users/{uid}/notes + noteFolders + versions\',\\n    summary: \'Markdown notes, nested folders, version history, and opt-in AES-256-GCM locked notes.\',\\n  },\", \"StartLine\":51, \"TargetContent\":\"  {\\n    id: \'planner\',\\n    titleKey: \'nav.planner\',\\n    phase: 4,\\n    icon: CheckSquare,\\n    collection: \'users/{uid}/tasks\',\\n    summary: \'Single-write fractional-index task ordering, subtasks, unified calendar, and AI goal breakdown.\',\\n  },\\n  {\\n    id: \'notes\',\\n    titleKey: \'nav.notes\',\\n    phase: 4,\\n    icon: BookText,\\n    collection: \'users/{uid}/notes\',\\n    summary: \'Markdown notes, nested folders, version history, and opt-in AES-256-GCM locked notes.\',\\n  },\"}, {\"AllowMultiple\":false, \"EndLine\":107, \"ReplacementContent\":\"  const { debts, fxRates } = useDebts();\\n  const { summary: remSummary, rollingQueue } = useReminders();\\n  const { summary: plannerSummary } = usePlanner();\\n  const { summary: notesSummary } = useNotes();\", \"StartLine\":104, \"TargetContent\":\"  const { debts, fxRates } = useDebts();\\n  const { summary: remSummary, rollingQueue } = useReminders();\"}, {\"AllowMultiple\":false, \"EndLine\":139, \"ReplacementContent\":\"    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders due today: ${remSummary.dueTodayCount}, overdue reminders: ${remSummary.overdueCount}, scheduled rolling queue slots: ${rollingQueue.slots.length}/64, active planner tasks: ${plannerSummary.activeCount} (${plannerSummary.dueTodayCount} due today), total notes: ${notesSummary.totalNotes} (${notesSummary.lockedCount} E2E locked \342\200\224 contents never sent), expiring vault docs: 0. Suggest one practical next step.`;\", \"StartLine\":135, \"TargetContent\":\"    const prompt = `Provide a calm 2-sentence daily briefing for a LifeOS workspace. Primary currency: ${profile.primaryCurrency}, Secondary: ${profile.secondaryCurrency}. Open debts: ${debtMetrics.totalOpenCount}, Overdue debts: ${debtMetrics.totalOverdueCount}, Net debt position: ${netFmt}, reminders due today: ${remSummary.dueTodayCount}, overdue reminders: ${remSummary.overdueCount}, scheduled rolling queue slots: ${rollingQueue.slots.length}/64, expiring vault docs: 0. Suggest one practical next step.`;\"}, {\"AllowMultiple\":false, \"EndLine\":302, \"ReplacementContent\":\"              {debtMetrics.totalOpenCount > 0 || remSummary.activeCount > 0 || plannerSummary.activeCount > 0 || notesSummary.totalNotes > 0\\n                ? `${plannerSummary.activeCount} active ${plannerSummary.activeCount === 1 ? \'task\' : \'tasks\'} (${plannerSummary.dueTodayCount} due today) \302\267 ${remSummary.activeCount} active ${remSummary.activeCount === 1 ? \'reminder\' : \'reminders\'} \302\267 ${debtMetrics.totalOpenCount} open ${debtMetrics.totalOpenCount === 1 ? \'debt\' : \'debts\'} \302\267 ${notesSummary.totalNotes} ${notesSummary.totalNotes === 1 ? \'note\' : \'notes\'}. Click \\\"${t(\'home.runBriefingBtn\')}\\\" for a 2-sentence summary.`\\n                : t(\'home.briefingEmpty\')}\", \"StartLine\":296, \"TargetContent\":\"              {debtMetrics.totalOpenCount > 0 || remSummary.activeCount > 0\\n                ? `${remSummary.activeCount} active ${remSummary.activeCount === 1 ? \'reminder\' : \'reminders\'} (${remSummary.dueTodayCount} due today, ${remSummary.overdueCount} overdue) \302\267 ${debtMetrics.totalOpenCount} open ${debtMetrics.totalOpenCount === 1 ? \'debt\' : \'debts\'}. Click \\\"${t(\'home.runBriefingBtn\')}\\\" for a 2-sentence summary.`\\n                : t(\'home.briefingEmpty\')}\"}], \"TargetFile\":\"/src/features/home/ui/HomeView.tsx\", \"toolAction\":\"Updating HomeView for Phase 4 modules\", \"toolSummary\":\"Update HomeView for Phase 4\"}"
      original_name: "multi_replace_file_content"
    }
