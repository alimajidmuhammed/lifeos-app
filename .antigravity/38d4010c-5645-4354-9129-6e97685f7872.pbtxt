      thinking_signature: "\022\310\024\n\305\024\001i\024}\023%(\v\243\005\243\304\fA\351T\024\302G\2706j\301:\362|\355\314\023\336&iu3\250xA\214vU]\364\374\360gA\223\re\v\344.\233.\322\347\032\363pc\376\202/\214\225\377\034\276\357r\205\272Z\334\203\211\342\203\035\225\360\221\327pRoj=+Q\323>\252;\002\'jg\247|v,34\027\206\242\356\032q\316\374^XTK\272\362K!i\241\304\016F\325\332\325kP|\241h\307x00\314 \245\260\235d\003Qu~]7y\264\272|L\370*W\234\337\247\257\\\353\225Dt\n\350=!\322\274w\032\226\275+\213\360\274\357\037n@<*\022\003\230\267\"V\"*FK\025:\312\005\354^\316\177\365\260\206\205M|\340~\360\351k\213m+z\31379\232\357\211?a\246%\034ne\002\027\320\366\302\321\325\2336i\220\301\254\243r\033C\232`lk\371\200\323\252\022\252\222\311\354\316\002\236R\275;\'\373\0238\215\nh\t$e\335\334\2717\357\001`\236\307\202\377\017\216\021\200=ij\\F81\322|\236QL\244#|\235r$\035?\233\277p*\247a\251TY\n{!\017\\R&\327\337v>Q<\373x\305\224\223XP2\026\035\031\322\225|4\247\256`\251 \233,\211\275\004S\375\267g\350\275w\363\025\305\214,b\206\230\t\374\244\353\230s\211\241]O\305?\273\211I\"\315\276\364w%\275\260\357\225\345_\255\344\305q\372\326\351#qT/\351\327D8\351\230\274\207\307\333\236$\032\376}c1\311(\017%\335\341\320\207\017\023Q\372\375\nX\354\314\274/<o\303/+\207\025\215\335\221Cr+=\260\323P\343t\3767u-Z\fE}\024Zv\312\225=*\362\r\f\220\025w\204Pl\232L\335{\234\360\\\314i\223F\224Q8\260\001\375\'A\3205\307\362\200\250\336\326uB\351kN\200\344S\300v\242\351w\231\273\235\326\362\301\017Y\342\227\026\021b\364lF\272\246\311S\016\241\320i\253r@\027\344t\364[\270\255(Q\222\232\177\211\251\016\n\350Qme\343\271\340\345\331\340c\f\034\227\215\005\024\224*\024N\235\304\352\005\302Mt\266\276\351\313\025\326f\263C\230\265\232\333\237\224\244#\271\303^H\017\232\214\2249sb\252/\363\220\264\2120s\216\000\344\005\200Y\262\017\350\024\373\327g\266\374\371,f\265\207\364\214\t`\310),\335/\016\344\305\206\272\273\026[\251\177\030d\345f\302\327\335$X~\030\265,\303\a\232\375\232\304\205F\213e\314JC\341<