    tool_calls {
      id: "call_14592973759023098437"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { z } from \'zod\';\\n\\nexport const TaskStatusSchema = z.enum([\'todo\', \'in_progress\', \'done\']);\\nexport type TaskStatus = z.infer<typeof TaskStatusSchema>;\\n\\nexport const TaskPrioritySchema = z.union([\\n  z.literal(1),\\n  z.literal(2),\\n  z.literal(3),\\n  z.literal(4),\\n]);\\nexport type TaskPriority = z.infer<typeof TaskPrioritySchema>;\\n\\nexport const SubtaskItemSchema = z.object({\\n  id: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  title: z.string().trim().min(1).max(200),\\n  done: z.boolean(),\\n});\\nexport type SubtaskItem = z.infer<typeof SubtaskItemSchema>;\\n\\nexport const TaskItemSchema = z.object({\\n  id: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  uid: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  listId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  title: z.string().trim().min(1).max(200),\\n  notes: z.string().max(2000).optional(),\\n  priority: z.number().int().min(1).max(4),\\n  sortKey: z.string().min(1).max(64).regex(/^[0-9A-Za-z]+$/),\\n  status: TaskStatusSchema,\\n  dueDate: z.string().regex(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/).optional(),\\n  subtasks: z.array(SubtaskItemSchema).max(20).optional(),\\n  tags: z.array(z.string().trim().min(1).max(40)).max(10).optional(),\\n  completedAtIso: z.string().min(20).max(30).optional(),\\n  version: z.number().int().min(1),\\n  createdAtIso: z.string().optional(),\\n  updatedAtIso: z.string().optional(),\\n});\\nexport type TaskItem = z.infer<typeof TaskItemSchema>;\\n\\nexport const CreateTaskInputSchema = z.object({\\n  listId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/).default(\'inbox\'),\\n  title: z.string().trim().min(1, \'Task title is required\').max(200),\\n  notes: z.string().trim().max(2000).optional(),\\n  priority: z.number().int().min(1).max(4).default(3),\\n  status: TaskStatusSchema.default(\'todo\'),\\n  dueDate: z.string().regex(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/).optional(),\\n  subtasks: z.array(SubtaskItemSchema).max(20).optional(),\\n  tags: z.array(z.string().trim().min(1).max(40)).max(10).optional(),\\n});\\nexport type CreateTaskInput = z.infer<typeof CreateTaskInputSchema>;\\n\\nexport interface TaskListMeta {\\n  id: string;\\n  labelKey: string;\\n  fallbackLabel: string;\\n}\\n\\nexport const DEFAULT_TASK_LISTS: readonly TaskListMeta[] = [\\n  { id: \'inbox\', labelKey: \'planner.listInbox\', fallbackLabel: \'Inbox\' },\\n  { id: \'personal\', labelKey: \'planner.listPersonal\', fallbackLabel: \'Personal\' },\\n  { id: \'work\', labelKey: \'planner.listWork\', fallbackLabel: \'Work\' },\\n  { id: \'finance\', labelKey: \'planner.listFinance\', fallbackLabel: \'Finance\' },\\n  { id: \'health\', labelKey: \'planner.listHealth\', fallbackLabel: \'Health\' },\\n] as const;\\n\\nexport function getTaskListMeta(listId: string): TaskListMeta {\\n  return (\\n    DEFAULT_TASK_LISTS.find((l) => l.id === listId) ?? {\\n      id: listId,\\n      labelKey: \'planner.listInbox\',\\n      fallbackLabel: listId,\\n    }\\n  );\\n}\\n\\nexport function getPriorityLabel(priority: number): { label: string; short: string } {\\n  switch (priority) {\\n    case 1:\\n      return { label: \'Urgent\', short: \'P1\' };\\n    case 2:\\n      return { label: \'High\', short: \'P2\' };\\n    case 3:\\n      return { label: \'Medium\', short: \'P3\' };\\n    default:\\n      return { label: \'Low\', short: \'P4\' };\\n  }\\n}\\n\", \"Description\":\"Create Expo-portable Zod schemas and list/priority metadata for Phase 4 Planner tasks\", \"Overwrite\":true, \"TargetFile\":\"/src/core/planner/plannerSchemas.ts\", \"toolAction\":\"Creating plannerSchemas.ts\", \"toolSummary\":\"Create plannerSchemas.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14592973759023098698"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * Expo-Portable Unified Calendar Aggregator\\n *\\n * Merges due dates across Tasks, Smart Reminders, and Open Debts into a deterministic\\n * 42-cell (6-week) monthly calendar grid without any DOM or Firebase dependencies.\\n */\\n\\nimport type { DebtRecord } from \'../debts/debtSchemas\';\\nimport { computeEffectiveStatus } from \'../debts/debtEngine\';\\nimport { getEffectiveFireDate } from \'../reminders/notificationScheduler\';\\nimport type { ReminderItem } from \'../reminders/reminderSchemas\';\\nimport type { TaskItem } from \'./plannerSchemas\';\\n\\nexport type CalendarEventKind = \'task\' | \'reminder\' | \'debt\';\\n\\nexport interface CalendarEvent {\\n  id: string;\\n  sourceId: string;\\n  kind: CalendarEventKind;\\n  dateYmd: string;\\n  title: string;\\n  subtitle?: string;\\n  timeLabel?: string;\\n  isDone: boolean;\\n  isUrgent: boolean;\\n}\\n\\nexport interface CalendarDayCell {\\n  dateYmd: string;\\n  dayOfMonth: number;\\n  inCurrentMonth: boolean;\\n  isToday: boolean;\\n  events: CalendarEvent[];\\n}\\n\\nexport interface MonthlyCalendarGrid {\\n  year: number;\\n  monthIndex: number; // 0..11\\n  days: CalendarDayCell[];\\n  totalEventsInMonth: number;\\n}\\n\\nexport function formatLocalYmd(d: Date): string {\\n  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \'0\')}-${String(d.getDate()).padStart(2, \'0\')}`;\\n}\\n\\nfunction formatHHMM(d: Date): string {\\n  return `${String(d.getHours()).padStart(2, \'0\')}:${String(d.getMinutes()).padStart(2, \'0\')}`;\\n}\\n\\nexport function buildUnifiedMonthlyCalendar(params: {\\n  year: number;\\n  monthIndex: number; // 0..11\\n  todayYmd: string;\\n  tasks: readonly TaskItem[];\\n  reminders: readonly ReminderItem[];\\n  debts: readonly DebtRecord[];\\n}): MonthlyCalendarGrid {\\n  const { year, monthIndex, todayYmd, tasks, reminders, debts } = params;\\n\\n  const eventsByDay = new Map<string, CalendarEvent[]>();\\n  const pushEvent = (ev: CalendarEvent) => {\\n    const arr = eventsByDay.get(ev.dateYmd);\\n    if (arr) {\\n      arr.push(ev);\\n    } else {\\n      eventsByDay.set(ev.dateYmd, [ev]);\\n    }\\n  };\\n\\n  for (const task of tasks) {\\n    if (!task.dueDate) continue;\\n    pushEvent({\\n      id: `task_${task.id}`,\\n      sourceId: task.id,\\n      kind: \'task\',\\n      dateYmd: task.dueDate,\\n      title: task.title,\\n      subtitle: task.listId,\\n      isDone: task.status === \'done\',\\n      isUrgent: task.priority === 1 && task.status !== \'done\',\\n    });\\n  }\\n\\n  for (const rem of reminders) {\\n    if (rem.status === \'archived\') continue;\\n    const fire = getEffectiveFireDate(rem);\\n    if (Number.isNaN(fire.getTime())) continue;\\n    const ymd = formatLocalYmd(fire);\\n    pushEvent({\\n      id: `rem_${rem.id}`,\\n      sourceId: rem.id,\\n      kind: \'reminder\',\\n      dateYmd: ymd,\\n      title: rem.title,\\n      subtitle: rem.category,\\n      timeLabel: formatHHMM(fire),\\n      isDone: rem.isCompleted,\\n      isUrgent: !rem.isCompleted && (rem.priority === \'urgent\' || rem.priority === \'high\'),\\n    });\\n  }\\n\\n  for (const debt of debts) {\\n    if (!debt.dueDate) continue;\\n    const status = computeEffectiveStatus(debt, todayYmd);\\n    if (status === \'settled\') continue;\\n    pushEvent({\\n      id: `debt_${debt.id}`,\\n      sourceId: debt.id,\\n      kind: \'debt\',\\n      dateYmd: debt.dueDate,\\n      title: `${debt.direction === \'i_owe\' ? \'Pay\' : \'Collect\'}: ${debt.personName}`,\\n      subtitle: debt.currency,\\n      isDone: false,\\n      isUrgent: status === \'overdue\',\\n    });\\n  }\\n\\n  const firstOfMonth = new Date(year, monthIndex, 1);\\n  const startWeekday = firstOfMonth.getDay(); // 0 = Sunday\\n  const gridStart = new Date(year, monthIndex, 1 - startWeekday);\\n\\n  const days: CalendarDayCell[] = [];\\n  let totalEventsInMonth = 0;\\n\\n  for (let i = 0; i < 42; i++) {\\n    const cellDate = new Date(gridStart.getFullYear(), gridStart.getMonth(), gridStart.getDate() + i);\\n    const dateYmd = formatLocalYmd(cellDate);\\n    const inCurrentMonth = cellDate.getMonth() === monthIndex && cellDate.getFullYear() === year;\\n    const dayEvents = (eventsByDay.get(dateYmd) ?? []).sort((a, b) => {\\n      if (a.isDone !== b.isDone) return a.isDone ? 1 : -1;\\n      if (a.isUrgent !== b.isUrgent) return a.isUrgent ? -1 : 1;\\n      return a.title.localeCompare(b.title);\\n    });\\n    if (inCurrentMonth) {\\n      totalEventsInMonth += dayEvents.length;\\n    }\\n    days.push({\\n      dateYmd,\\n      dayOfMonth: cellDate.getDate(),\\n      inCurrentMonth,\\n      isToday: dateYmd === todayYmd,\\n      events: dayEvents,\\n    });\\n  }\\n\\n  return {\\n    year,\\n    monthIndex,\\n    days,\\n    totalEventsInMonth,\\n  };\\n}\\n\", \"Description\":\"Create Expo-portable unified calendar engine merging Tasks, Reminders, and Open Debts into a 42-day monthly grid\", \"Overwrite\":true, \"TargetFile\":\"/src/core/planner/unifiedCalendar.ts\", \"toolAction\":\"Creating unifiedCalendar.ts\", \"toolSummary\":\"Create unifiedCalendar.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14592973759023098959"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { z } from \'zod\';\\nimport { sortBySortKey } from \'../planner/fractionalIndex\';\\n\\nexport const NoteFolderSchema = z.object({\\n  id: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  uid: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  name: z.string().trim().min(1, \'Folder name is required\').max(80),\\n  parentId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/).optional(),\\n  sortKey: z.string().min(1).max(64).regex(/^[0-9A-Za-z]+$/),\\n  isLockedFolder: z.boolean(),\\n  version: z.number().int().min(1),\\n  createdAtIso: z.string().optional(),\\n  updatedAtIso: z.string().optional(),\\n});\\nexport type NoteFolder = z.infer<typeof NoteFolderSchema>;\\n\\nexport const CreateFolderInputSchema = z.object({\\n  name: z.string().trim().min(1, \'Folder name is required\').max(80),\\n  parentId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/).optional(),\\n  isLockedFolder: z.boolean().default(false),\\n});\\nexport type CreateFolderInput = z.infer<typeof CreateFolderInputSchema>;\\n\\nexport const NoteItemSchema = z.object({\\n  id: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  uid: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  folderId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/).optional(),\\n  title: z.string().trim().min(1, \'Note title is required\').max(200),\\n  content: z.string().max(100000),\\n  tags: z.array(z.string().trim().min(1).max(40)).max(10).optional(),\\n  isEncrypted: z.boolean(),\\n  isLocked: z.boolean(),\\n  pinned: z.boolean(),\\n  wordCount: z.number().int().min(0).max(100000),\\n  version: z.number().int().min(1),\\n  createdAtIso: z.string().optional(),\\n  updatedAtIso: z.string().optional(),\\n});\\nexport type NoteItem = z.infer<typeof NoteItemSchema>;\\n\\nexport const CreateNoteInputSchema = z.object({\\n  folderId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/).optional(),\\n  title: z.string().trim().min(1, \'Note title is required\').max(200),\\n  content: z.string().max(100000).default(\'\'),\\n  tags: z.array(z.string().trim().min(1).max(40)).max(10).optional(),\\n  isEncrypted: z.boolean().default(false),\\n  isLocked: z.boolean().default(false),\\n  pinned: z.boolean().default(false),\\n});\\nexport type CreateNoteInput = z.infer<typeof CreateNoteInputSchema>;\\n\\nexport const NoteVersionSchema = z.object({\\n  id: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  uid: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  noteId: z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/),\\n  title: z.string().min(1).max(200),\\n  content: z.string().max(100000),\\n  isEncrypted: z.boolean(),\\n  versionNumber: z.number().int().min(1).max(100000),\\n  createdAtIso: z.string(),\\n});\\nexport type NoteVersion = z.infer<typeof NoteVersionSchema>;\\n\\nexport function countMarkdownWords(markdown: string): number {\\n  const cleaned = markdown\\n    .replace(/```[\\\\s\\\\S]*?```/g, \' \')\\n    .replace(/[#>*_`~\\\\-[\\\\]()]/g, \' \')\\n    .trim();\\n  if (!cleaned) return 0;\\n  return cleaned.split(/\\\\s+/).filter(Boolean).length;\\n}\\n\\nexport interface FolderTreeNode {\\n  folder: NoteFolder;\\n  depth: number;\\n  children: FolderTreeNode[];\\n}\\n\\n/**\\n * Builds a deterministic nested folder tree with cycle protection and depth cap (max depth 5).\\n */\\nexport function buildFolderTree(folders: readonly NoteFolder[]): FolderTreeNode[] {\\n  const sorted = sortBySortKey(folders);\\n  const byId = new Map(sorted.map((f) => [f.id, f]));\\n  const childrenMap = new Map<string | null, NoteFolder[]>();\\n\\n  for (const f of sorted) {\\n    const validParent =\\n      f.parentId && f.parentId !== f.id && byId.has(f.parentId) ? f.parentId : null;\\n    const list = childrenMap.get(validParent) ?? [];\\n    list.push(f);\\n    childrenMap.set(validParent, list);\\n  }\\n\\n  const visited = new Set<string>();\\n\\n  const buildNodes = (parentId: string | null, depth: number): FolderTreeNode[] => {\\n    if (depth > 5) return [];\\n    const list = childrenMap.get(parentId) ?? [];\\n    const result: FolderTreeNode[] = [];\\n    for (const folder of list) {\\n      if (visited.has(folder.id)) continue;\\n      visited.add(folder.id);\\n      result.push({\\n        folder,\\n        depth,\\n        children: buildNodes(folder.id, depth + 1),\\n      });\\n    }\\n    return result;\\n  };\\n\\n  return buildNodes(null, 0);\\n}\\n\\nexport function flattenFolderTree(nodes: readonly FolderTreeNode[]): Array<{ folder: NoteFolder; depth: number }> {\\n  const out: Array<{ folder: NoteFolder; depth: number }> = [];\\n  const walk = (list: readonly FolderTreeNode[]) => {\\n    for (const n of list) {\\n      out.push({ folder: n.folder, depth: n.depth });\\n      if (n.children.length > 0) walk(n.children);\\n    }\\n  };\\n  walk(nodes);\\n  return out;\\n}\\n\", \"Description\":\"Create Expo-portable Zod schemas, word counter, and cycle-safe nested folder tree builder for Phase 4 Notes\", \"Overwrite\":true, \"TargetFile\":\"/src/core/notes/noteSchemas.ts\", \"toolAction\":\"Creating noteSchemas.ts\", \"toolSummary\":\"Create noteSchemas.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_14592973759023099220"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * Expo-Portable Safe Markdown AST Parser (Zero Raw HTML / Zero dangerouslySetInnerHTML)\\n *\\n * Parses Markdown into strongly-typed block and inline AST nodes so React (or React Native)\\n * renders native elements with strict URL scheme filtering (only http:// and https://).\\n */\\n\\nexport type InlineToken =\\n  | { type: \'text\'; value: string }\\n  | { type: \'bold\'; value: string }\\n  | { type: \'italic\'; value: string }\\n  | { type: \'strike\'; value: string }\\n  | { type: \'code\'; value: string }\\n  | { type: \'link\'; label: string; href: string };\\n\\nexport type MarkdownBlock =\\n  | { type: \'heading\'; level: 1 | 2 | 3; tokens: InlineToken[] }\\n  | { type: \'paragraph\'; tokens: InlineToken[] }\\n  | { type: \'blockquote\'; tokens: InlineToken[] }\\n  | { type: \'code_block\'; language: string; code: string }\\n  | { type: \'hr\' }\\n  | { type: \'bullet_list\'; items: InlineToken[][] }\\n  | { type: \'ordered_list\'; items: InlineToken[][] }\\n  | { type: \'checklist\'; items: Array<{ lineIndex: number; checked: boolean; tokens: InlineToken[] }> };\\n\\nexport function isSafeHttpUrl(url: string): boolean {\\n  const trimmed = url.trim();\\n  return /^https?:\\\\/\\\\/[^\\\\s<>\\\"]+$/i.test(trimmed);\\n}\\n\\nexport function parseInlineMarkdown(text: string): InlineToken[] {\\n  const tokens: InlineToken[] = [];\\n  let remaining = text;\\n\\n  const pattern =\\n    /(`[^`]+`|\\\\*\\\\*[^*]+\\\\*\\\\*|~~[^~]+~~|\\\\*[^*]+\\\\*|\\\\[([^\\\\]]+)\\\\]\\\\(([^)]+)\\\\))/;\\n\\n  while (remaining.length > 0) {\\n    const match = pattern.exec(remaining);\\n    if (!match || match.index === undefined) {\\n      tokens.push({ type: \'text\', value: remaining });\\n      break;\\n    }\\n\\n    if (match.index > 0) {\\n      tokens.push({ type: \'text\', value: remaining.slice(0, match.index) });\\n    }\\n\\n    const raw = match[0];\\n    if (raw.startsWith(\'`\') && raw.endsWith(\'`\')) {\\n      tokens.push({ type: \'code\', value: raw.slice(1, -1) });\\n    } else if (raw.startsWith(\'**\') && raw.endsWith(\'**\')) {\\n      tokens.push({ type: \'bold\', value: raw.slice(2, -2) });\\n    } else if (raw.startsWith(\'~~\') && raw.endsWith(\'~~\')) {\\n      tokens.push({ type: \'strike\', value: raw.slice(2, -2) });\\n    } else if (raw.startsWith(\'*\') && raw.endsWith(\'*\')) {\\n      tokens.push({ type: \'italic\', value: raw.slice(1, -1) });\\n    } else if (raw.startsWith(\'[\')) {\\n      const label = match[2] ?? \'\';\\n      const href = (match[3] ?? \'\').trim();\\n      if (isSafeHttpUrl(href)) {\\n        tokens.push({ type: \'link\', label, href });\\n      } else {\\n        // Neutralize non-http(s) links (e.g. javascript:, data:) into plain text\\n        tokens.push({ type: \'text\', value: label });\\n      }\\n    }\\n\\n    remaining = remaining.slice(match.index + raw.length);\\n  }\\n\\n  return tokens;\\n}\\n\\nexport function parseMarkdownBlocks(markdown: string): MarkdownBlock[] {\\n  const lines = markdown.replace(/\\\\r\\\\n/g, \'\\\\n\').split(\'\\\\n\');\\n  const blocks: MarkdownBlock[] = [];\\n  let i = 0;\\n\\n  while (i < lines.length) {\\n    const line = lines[i];\\n    const trimmed = line.trim();\\n\\n    if (!trimmed) {\\n      i++;\\n      continue;\\n    }\\n\\n    // Fenced code block\\n    if (trimmed.startsWith(\'```\')) {\\n      const language = trimmed.slice(3).trim().slice(0, 24);\\n      const codeLines: string[] = [];\\n      i++;\\n      while (i < lines.length && !lines[i].trim().startsWith(\'```\')) {\\n        codeLines.push(lines[i]);\\n        i++;\\n      }\\n      if (i < lines.length) i++; // skip closing fence\\n      blocks.push({ type: \'code_block\', language, code: codeLines.join(\'\\\\n\') });\\n      continue;\\n    }\\n\\n    // Horizontal rule\\n    if (/^(-{3,}|\\\\*{3,}|_{3,})$/.test(trimmed)) {\\n      blocks.push({ type: \'hr\' });\\n      i++;\\n      continue;\\n    }\\n\\n    // Headings (#, ##, ###)\\n    const headingMatch = /^(#{1,3})\\\\s+(.+)$/.exec(trimmed);\\n    if (headingMatch) {\\n      const level = headingMatch[1].length as 1 | 2 | 3;\\n      blocks.push({ type: \'heading\', level, tokens: parseInlineMarkdown(headingMatch[2]) });\\n      i++;\\n      continue;\\n    }\\n\\n    // Blockquote\\n    if (trimmed.startsWith(\'> \')) {\\n      const quoteLines: string[] = [];\\n      while (i < lines.length && lines[i].trim().startsWith(\'> \')) {\\n        quoteLines.push(lines[i].trim().slice(2));\\n        i++;\\n      }\\n      blocks.push({ type: \'blockquote\', tokens: parseInlineMarkdown(quoteLines.join(\' \')) });\\n      continue;\\n    }\\n\\n    // Checklist (- [ ] or - [x])\\n    if (/^[-*]\\\\s+\\\\[([ xX])\\\\]\\\\s+/.test(trimmed)) {\\n      const items: Array<{ lineIndex: number; checked: boolean; tokens: InlineToken[] }> = [];\\n      while (i < lines.length) {\\n        const m = /^[-*]\\\\s+\\\\[([ xX])\\\\]\\\\s+(.*)$/.exec(lines[i].trim());\\n        if (!m) break;\\n        items.push({\\n          lineIndex: i,\\n          checked: m[1].toLowerCase() === \'x\',\\n          tokens: parseInlineMarkdown(m[2]),\\n        });\\n        i++;\\n      }\\n      blocks.push({ type: \'checklist\', items });\\n      continue;\\n    }\\n\\n    // Bullet list\\n    if (/^[-*]\\\\s+/.test(trimmed)) {\\n      const items: InlineToken[][] = [];\\n      while (i < lines.length) {\\n        const t = lines[i].trim();\\n        if (/^[-*]\\\\s+\\\\[([ xX])\\\\]\\\\s+/.test(t)) break;\\n        const m = /^[-*]\\\\s+(.*)$/.exec(t);\\n        if (!m) break;\\n        items.push(parseInlineMarkdown(m[1]));\\n        i++;\\n      }\\n      blocks.push({ type: \'bullet_list\', items });\\n      continue;\\n    }\\n\\n    // Ordered list\\n    if (/^\\\\d+\\\\.\\\\s+/.test(trimmed)) {\\n      const items: InlineToken[][] = [];\\n      while (i < lines.length) {\\n        const m = /^\\\\d+\\\\.\\\\s+(.*)$/.exec(lines[i].trim());\\n        if (!m) break;\\n        items.push(parseInlineMarkdown(m[1]));\\n        i++;\\n      }\\n      blocks.push({ type: \'ordered_list\', items });\\n      continue;\\n    }\\n\\n    // Paragraph (join contiguous non-blank plain lines)\\n    const paraLines: string[] = [];\\n    while (\\n      i < lines.length &&\\n      lines[i].trim() !== \'\' &&\\n      !/^(#{1,3}\\\\s+|```|>\\\\s+|[-*]\\\\s+|\\\\d+\\\\.\\\\s+|-{3,}$|\\\\*{3,}$)/.test(lines[i].trim())\\n    ) {\\n      paraLines.push(lines[i].trim());\\n      i++;\\n    }\\n    blocks.push({ type: \'paragraph\', tokens: parseInlineMarkdown(paraLines.join(\' \')) });\\n  }\\n\\n  return blocks;\\n}\\n\\n/**\\n * Toggles a specific markdown checklist line (0-based line index) safely.\\n */\\nexport function toggleMarkdownChecklistLine(markdown: string, lineIndex: number): string {\\n  const lines = markdown.replace(/\\\\r\\\\n/g, \'\\\\n\').split(\'\\\\n\');\\n  if (lineIndex < 0 || lineIndex >= lines.length) return markdown;\\n  const line = lines[lineIndex];\\n  if (/^(\\\\s*[-*]\\\\s+)\\\\[ \\\\](.*)$/.test(line)) {\\n    lines[lineIndex] = line.replace(/^(\\\\s*[-*]\\\\s+)\\\\[ \\\\](.*)$/, \'$1[x]$2\');\\n  } else if (/^(\\\\s*[-*]\\\\s+)\\\\[[xX]\\\\](.*)$/.test(line)) {\\n    lines[lineIndex] = line.replace(/^(\\\\s*[-*]\\\\s+)\\\\[[xX]\\\\](.*)$/, \'$1[ ]$2\');\\n  }\\n  return lines.join(\'\\\\n\');\\n}\\n\", \"Description\":\"Create zero-dangerouslySetInnerHTML safe Markdown AST parser and checklist toggle helper\", \"Overwrite\":true, \"TargetFile\":\"/src/core/notes/safeMarkdown.ts\", \"toolAction\":\"Creating safeMarkdown.ts\", \"toolSummary\":\"Create safeMarkdown.ts\"}"
      original_name: "write_to_file"
    }
