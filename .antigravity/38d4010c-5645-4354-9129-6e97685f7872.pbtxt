       allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\n        allow create: if isVerifiedOwner(userId) && isValidId(habitId)\n          && isValidHabitItem(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isVerifiedOwner(userId) && isValidId(habitId)\n          && isValidHabitItem(incoming(), userId)\n          && incoming().uid == existing().uid\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().version == existing().version + 1\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'name\', \'frequency\', \'currentStreak\', \'bestStreak\', \'archived\', \'version\', \'updatedAt\']);\n        allow delete: if isVerifiedOwner(userId) && isValidId(habitId);\n      }\n\n      match /transactions/{txId} {\n        allow get: if isVerifiedOwner(userId) && isValidId(txId);\n        allow list: if isVerifiedOwner(userId) && resource.data.uid == request.auth.uid;\n        allow create: if isVerifiedOwner(userId) && isValidId(txId)\n          && isValidTransactionItem(incoming(), userId)\n          && incoming().createdAt == request.time\n          && incoming().updatedAt == request.time;\n        allow update: if isVerifiedOwner(userId) && isValidId(txId)\n          && isValidTransactionItem(incoming(), userId)\n          && incoming().uid == existing().uid\n          && incoming().createdAt == existing().createdAt\n          && incoming().updatedAt == request.time\n          && incoming().version == existing().version + 1\n          && incoming().diff(existing()).affectedKeys().hasOnly([\'type\', \'amountMinor\', \'currency\', \'category\', \'note\', \'version\', \'updatedAt\']);\n        allow delete: if isVerifiedOwner(userId) && isValidId(txId);\n      }\n    }\n  }\n}\n"
