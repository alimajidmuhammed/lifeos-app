    tool_calls {
      id: "call_3220078722342210865"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport {\\n  bootstrapE2EVault,\\n  decryptText,\\n  deriveAesKeyFromSecret,\\n  encryptText,\\n  verifyE2EPassphrase,\\n  type EncryptedEnvelope,\\n} from \'../core/crypto/e2eCrypto\';\\nimport {\\n  buildFolderTree,\\n  countMarkdownWords,\\n  flattenFolderTree,\\n  type CreateFolderInput,\\n  type CreateNoteInput,\\n  type NoteFolder,\\n  type NoteItem,\\n  type NoteVersion,\\n} from \'../core/notes/noteSchemas\';\\nimport { generateSortKeyBetween } from \'../core/planner/fractionalIndex\';\\nimport {\\n  firebaseNotesRepository,\\n  localNotesRepository,\\n} from \'../data/repositories/notesRepository\';\\nimport { userProfileRepository } from \'../data/repositories/firebaseWebAdapter\';\\nimport { useUIStore } from \'../state/useUIStore\';\\n\\nexport function useNotes() {\\n  const authUser = useUIStore((s) => s.authUser);\\n  const authReady = useUIStore((s) => s.authReady);\\n  const profile = useUIStore((s) => s.profile);\\n  const setProfile = useUIStore((s) => s.setProfile);\\n  const isLocked = useUIStore((s) => s.isLocked);\\n\\n  const [folders, setFolders] = useState<NoteFolder[]>([]);\\n  const [notes, setNotes] = useState<NoteItem[]>([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  // Session-only in-memory AES-256-GCM key & unlocked plaintexts (NEVER written to storage)\\n  const sessionKeyRef = useRef<CryptoKey | null>(null);\\n  const [vaultUnlocked, setVaultUnlocked] = useState(false);\\n  const [decryptedBodies, setDecryptedBodies] = useState<Record<string, string>>({});\\n\\n  const isCloud = Boolean(authUser?.uid);\\n  const uid = authUser?.uid ?? \'local\';\\n  const repo = isCloud ? firebaseNotesRepository : localNotesRepository;\\n\\n  // Wipe session E2E key immediately if app lock activates\\n  useEffect(() => {\\n    if (isLocked) {\\n      sessionKeyRef.current = null;\\n      setVaultUnlocked(false);\\n      setDecryptedBodies({});\\n    }\\n  }, [isLocked]);\\n\\n  useEffect(() => {\\n    if (!authReady) return;\\n    setLoading(true);\\n    setError(null);\\n    let foldersLoaded = false;\\n    let notesLoaded = false;\\n    const markDone = () => {\\n      if (foldersLoaded && notesLoaded) setLoading(false);\\n    };\\n\\n    const unsubFolders = repo.subscribeFolders(\\n      uid,\\n      (list) => {\\n        setFolders(list);\\n        foldersLoaded = true;\\n        markDone();\\n      },\\n      (err) => {\\n        setError(err.message);\\n        setLoading(false);\\n      }\\n    );\\n\\n    const unsubNotes = repo.subscribeNotes(\\n      uid,\\n      (list) => {\\n        setNotes(list);\\n        notesLoaded = true;\\n        markDone();\\n      },\\n      (err) => {\\n        setError(err.message);\\n        setLoading(false);\\n      }\\n    );\\n\\n    return () => {\\n      unsubFolders();\\n      unsubNotes();\\n    };\\n  }, [authReady, repo, uid]);\\n\\n  const folderTree = useMemo(() => buildFolderTree(folders), [folders]);\\n  const flatFolders = useMemo(() => flattenFolderTree(folderTree), [folderTree]);\\n\\n  const summary = useMemo(() => {\\n    let pinnedCount = 0;\\n    let lockedCount = 0;\\n    for (const n of notes) {\\n      if (n.pinned) pinnedCount++;\\n      if (n.isLocked || n.isEncrypted) lockedCount++;\\n    }\\n    return {\\n      totalNotes: notes.length,\\n      pinnedCount,\\n      lockedCount,\\n      folderCount: folders.length,\\n    };\\n  }, [notes, folders.length]);\\n\\n  const createFolder = useCallback(\\n    async (input: CreateFolderInput) => {\\n      const lastKey = folders.length > 0 ? folders[folders.length - 1].sortKey : null;\\n      const sortKey = generateSortKeyBetween(lastKey, null);\\n      return repo.createFolder(uid, input, sortKey);\\n    },\\n    [folders, repo, uid]\\n  );\\n\\n  const deleteFolder = useCallback(\\n    async (folderId: string) => {\\n      await repo.deleteFolder(uid, folderId);\\n    },\\n    [repo, uid]\\n  );\\n\\n  const createNote = useCallback(\\n    async (input: CreateNoteInput) => {\\n      return repo.createNote(uid, input);\\n    },\\n    [repo, uid]\\n  );\\n\\n  const saveNote = useCallback(\\n    async (\\n      current: NoteItem,\\n      patch: {\\n        title?: string;\\n        plaintextContent?: string;\\n        folderId?: string | null;\\n        tags?: string[];\\n        pinned?: boolean;\\n      },\\n      saveSnapshot = true\\n    ) => {\\n      let storedContent = patch.plaintextContent;\\n      let wordCount: number | undefined;\\n\\n      if (current.isEncrypted && patch.plaintextContent !== undefined) {\\n        if (!sessionKeyRef.current) {\\n          throw new Error(\'Unlock your E2E vault passphrase before saving an encrypted note.\');\\n        }\\n        const env = await encryptText(patch.plaintextContent, sessionKeyRef.current);\\n        storedContent = JSON.stringify(env);\\n        wordCount = 0;\\n        setDecryptedBodies((prev) => ({\\n          ...prev,\\n          [current.id]: patch.plaintextContent!,\\n        }));\\n      } else if (patch.plaintextContent !== undefined) {\\n        wordCount = countMarkdownWords(patch.plaintextContent);\\n      }\\n\\n      await repo.updateNoteContent(\\n        uid,\\n        current,\\n        {\\n          title: patch.title,\\n          content: storedContent,\\n          folderId: patch.folderId,\\n          tags: patch.tags,\\n          pinned: patch.pinned,\\n          wordCount,\\n        },\\n        saveSnapshot\\n      );\\n    },\\n    [repo, uid]\\n  );\\n\\n  const togglePin = useCallback(\\n    async (note: NoteItem) => {\\n      await repo.togglePinOrFolder(uid, note, { pinned: !note.pinned });\\n    },\\n    [repo, uid]\\n  );\\n\\n  const moveNoteToFolder = useCallback(\\n    async (note: NoteItem, folderId: string | null) => {\\n      await repo.togglePinOrFolder(uid, note, { folderId });\\n    },\\n    [repo, uid]\\n  );\\n\\n  const deleteNote = useCallback(\\n    async (note: NoteItem) => {\\n      await repo.deleteNote(uid, note);\\n    },\\n    [repo, uid]\\n  );\\n\\n  const restoreNote = useCallback(\\n    async (note: NoteItem) => {\\n      await repo.restoreNote(uid, note);\\n    },\\n    [repo, uid]\\n  );\\n\\n  const listVersions = useCallback(\\n    async (noteId: string): Promise<NoteVersion[]> => {\\n      return repo.listVersions(uid, noteId);\\n    },\\n    [repo, uid]\\n  );\\n\\n  const restoreVersion = useCallback(\\n    async (current: NoteItem, version: NoteVersion) => {\\n      await repo.updateNoteContent(\\n        uid,\\n        current,\\n        {\\n          title: version.title,\\n          content: version.content,\\n          wordCount: version.isEncrypted ? 0 : countMarkdownWords(version.content),\\n        },\\n        true\\n      );\\n      if (version.isEncrypted && sessionKeyRef.current) {\\n        try {\\n          const env = JSON.parse(version.content) as EncryptedEnvelope;\\n          const plain = await decryptText(env, sessionKeyRef.current);\\n          setDecryptedBodies((prev) => ({ ...prev, [current.id]: plain }));\\n        } catch {\\n          // leave locked if key mismatch\\n        }\\n      }\\n    },\\n    [repo, uid]\\n  );\\n\\n  /**\\n   * Initializes opt-in E2E encryption on the user profile if not configured yet,\\n   * returning the one-time Recovery Key for the user to store offline.\\n   */\\n  const initializeE2EPassphrase = useCallback(\\n    async (passphrase: string): Promise<string> => {\\n      const boot = await bootstrapE2EVault(passphrase);\\n      const nextProfile = {\\n        ...profile,\\n        e2eConfigured: true,\\n        e2eSalt: boot.salt,\\n        e2eVerifier: boot.verifier,\\n      };\\n      setProfile(nextProfile);\\n      if (authUser) {\\n        await userProfileRepository.updateProfile(authUser.uid, profile, {\\n          e2eConfigured: true,\\n          e2eSalt: boot.salt,\\n          e2eVerifier: boot.verifier,\\n        });\\n      }\\n      sessionKeyRef.current = await deriveAesKeyFromSecret(passphrase, boot.salt);\\n      setVaultUnlocked(true);\\n      return boot.recoveryKey;\\n    },\\n    [authUser, profile, setProfile]\\n  );\\n\\n  const unlockVaultSession = useCallback(\\n    async (passphrase: string): Promise<boolean> => {\\n      if (!profile.e2eConfigured || !profile.e2eSalt || !profile.e2eVerifier) {\\n        return false;\\n      }\\n      const valid = await verifyE2EPassphrase(passphrase, profile.e2eSalt, profile.e2eVerifier);\\n      if (!valid) return false;\\n      sessionKeyRef.current = await deriveAesKeyFromSecret(passphrase, profile.e2eSalt);\\n      setVaultUnlocked(true);\\n      return true;\\n    },\\n    [profile.e2eConfigured, profile.e2eSalt, profile.e2eVerifier]\\n  );\\n\\n  const lockVaultSession = useCallback(() => {\\n    sessionKeyRef.current = null;\\n    setVaultUnlocked(false);\\n    setDecryptedBodies({});\\n  }, []);\\n\\n  const decryptNoteIntoSession = useCallback(async (note: NoteItem): Promise<string | null> => {\\n    if (!note.isEncrypted) return note.content;\\n    if (!sessionKeyRef.current) return null;\\n    try {\\n      const env = JSON.parse(note.content) as EncryptedEnvelope;\\n      const plain = await decryptText(env, sessionKeyRef.current);\\n      setDecryptedBodies((prev) => ({ ...prev, [note.id]: plain }));\\n      return plain;\\n    } catch {\\n      return null;\\n    }\\n  }, []);\\n\\n  const encryptAndLockNote = useCallback(\\n    async (note: NoteItem, plaintext: string) => {\\n      if (!sessionKeyRef.current) {\\n        throw new Error(\'Unlock or configure your E2E passphrase first.\');\\n      }\\n      const env = await encryptText(plaintext, sessionKeyRef.current);\\n      await repo.setNoteEncryptionState(uid, note, {\\n        content: JSON.stringify(env),\\n        isEncrypted: true,\\n        isLocked: true,\\n        wordCount: 0,\\n      });\\n      setDecryptedBodies((prev) => ({ ...prev, [note.id]: plaintext }));\\n    },\\n    [repo, uid]\\n  );\\n\\n  const decryptAndUnlockNotePermanently = useCallback(\\n    async (note: NoteItem, plaintext: string) => {\\n      await repo.setNoteEncryptionState(uid, note, {\\n        content: plaintext,\\n        isEncrypted: false,\\n        isLocked: false,\\n        wordCount: countMarkdownWords(plaintext),\\n      });\\n      setDecryptedBodies((prev) => {\\n        const copy = { ...prev };\\n        delete copy[note.id];\\n        return copy;\\n      });\\n    },\\n    [repo, uid]\\n  );\\n\\n  return {\\n    folders,\\n    folderTree,\\n    flatFolders,\\n    notes,\\n    loading,\\n    error,\\n    summary,\\n    isCloudSynced: isCloud,\\n    vaultUnlocked,\\n    decryptedBodies,\\n    createFolder,\\n    deleteFolder,\\n    createNote,\\n    saveNote,\\n    togglePin,\\n    moveNoteToFolder,\\n    deleteNote,\\n    restoreNote,\\n    listVersions,\\n    restoreVersion,\\n    initializeE2EPassphrase,\\n    unlockVaultSession,\\n    lockVaultSession,\\n    decryptNoteIntoSession,\\n    encryptAndLockNote,\\n    decryptAndUnlockNotePermanently,\\n  };\\n}\\n\", \"Description\":\"Create useNotes hook managing nested folders, Markdown notes, immutable version snapshots, and session-scoped AES-256-GCM E2E locking\", \"Overwrite\":true, \"TargetFile\":\"/src/hooks/useNotes.ts\", \"toolAction\":\"Creating useNotes.ts hook\", \"toolSummary\":\"Create useNotes.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3220078722342209412"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Plus, ShieldAlert, Sparkles, Trash2, X } from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { requestGoalBreakdown } from \'../../../core/ai/plannerAiClient\';\\nimport { evaluateDailyAiQuota, getTodayDayKey } from \'../../../core/entitlements/entitlements\';\\nimport {\\n  DEFAULT_TASK_LISTS,\\n  type CreateTaskInput,\\n  type SubtaskItem,\\n  type TaskItem,\\n  type TaskStatus,\\n} from \'../../../core/planner/plannerSchemas\';\\nimport { aiUsageRepository } from \'../../../data/repositories/firebaseWebAdapter\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\n\\ninterface TaskFormModalProps {\\n  open: boolean;\\n  editingTask: TaskItem | null;\\n  defaultListId?: string;\\n  defaultDueDate?: string;\\n  initialFocusAi?: boolean;\\n  onClose: () => void;\\n  onCreate: (input: CreateTaskInput) => Promise<void>;\\n  onUpdate: (\\n    current: TaskItem,\\n    patch: Partial<\\n      Pick<\\n        TaskItem,\\n        \'listId\' | \'title\' | \'notes\' | \'priority\' | \'dueDate\' | \'subtasks\' | \'tags\' | \'status\'\\n      >\\n    >\\n  ) => Promise<void>;\\n}\\n\\nfunction makeSubtaskId(): string {\\n  return `sub_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 7)}`;\\n}\\n\\nexport const TaskFormModal: React.FC<TaskFormModalProps> = ({\\n  open,\\n  editingTask,\\n  defaultListId = \'inbox\',\\n  defaultDueDate = \'\',\\n  initialFocusAi = false,\\n  onClose,\\n  onCreate,\\n  onUpdate,\\n}) => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const authUser = useUIStore((s) => s.authUser);\\n  const entitlements = useUIStore((s) => s.entitlements);\\n  const todayAiUsage = useUIStore((s) => s.todayAiUsage);\\n  const incrementLocalAiUsage = useUIStore((s) => s.incrementLocalAiUsage);\\n\\n  const [title, setTitle] = useState(\'\');\\n  const [notes, setNotes] = useState(\'\');\\n  const [listId, setListId] = useState(defaultListId);\\n  const [priority, setPriority] = useState<number>(3);\\n  const [status, setStatus] = useState<TaskStatus>(\'todo\');\\n  const [dueDate, setDueDate] = useState(defaultDueDate);\\n  const [subtasks, setSubtasks] = useState<SubtaskItem[]>([]);\\n  const [newSubtaskText, setNewSubtaskText] = useState(\'\');\\n\\n  // AI Goal Breakdown state\\n  const [aiGoal, setAiGoal] = useState(\'\');\\n  const [aiLoading, setAiLoading] = useState(false);\\n  const [aiNotice, setAiNotice] = useState<string | null>(null);\\n  const [aiError, setAiError] = useState<string | null>(null);\\n\\n  const [saving, setSaving] = useState(false);\\n  const [formError, setFormError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    if (!open) return;\\n    setFormError(null);\\n    setAiError(null);\\n    setAiNotice(null);\\n    setAiGoal(\'\');\\n    setNewSubtaskText(\'\');\\n\\n    if (editingTask) {\\n      setTitle(editingTask.title);\\n      setNotes(editingTask.notes ?? \'\');\\n      setListId(editingTask.listId);\\n      setPriority(editingTask.priority);\\n      setStatus(editingTask.status);\\n      setDueDate(editingTask.dueDate ?? \'\');\\n      setSubtasks(editingTask.subtasks ? [...editingTask.subtasks] : []);\\n    } else {\\n      setTitle(\'\');\\n      setNotes(\'\');\\n      setListId(defaultListId || \'inbox\');\\n      setPriority(3);\\n      setStatus(\'todo\');\\n      setDueDate(defaultDueDate || \'\');\\n      setSubtasks([]);\\n    }\\n  }, [open, editingTask, defaultListId, defaultDueDate]);\\n\\n  if (!open) return null;\\n\\n  const isEditing = Boolean(editingTask);\\n  const aiAllowed = profile.aiGlobalEnabled && (profile.aiModuleToggles?.planner ?? true);\\n\\n  const addSubtask = () => {\\n    const clean = newSubtaskText.trim();\\n    if (!clean || subtasks.length >= 20) return;\\n    setSubtasks((prev) => [...prev, { id: makeSubtaskId(), title: clean, done: false }]);\\n    setNewSubtaskText(\'\');\\n  };\\n\\n  const removeSubtask = (id: string) => {\\n    setSubtasks((prev) => prev.filter((s) => s.id !== id));\\n  };\\n\\n  const handleAiBreakdown = async () => {\\n    const cleanGoal = aiGoal.trim();\\n    if (!cleanGoal) return;\\n    if (!aiAllowed) {\\n      setAiError(t(\'assistant.disabledNotice\'));\\n      return;\\n    }\\n\\n    const dayKey = getTodayDayKey();\\n    const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\\n    const quota = evaluateDailyAiQuota(usedToday, entitlements);\\n    if (!quota.allowed) {\\n      setAiError(`Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}). Add subtasks manually below.`);\\n      return;\\n    }\\n\\n    setAiLoading(true);\\n    setAiError(null);\\n    setAiNotice(null);\\n\\n    const res = await requestGoalBreakdown({\\n      goal: cleanGoal,\\n      locale: profile.locale,\\n      todayYmd: dayKey,\\n      freeTier: entitlements.plan === \'free\',\\n    });\\n\\n    setAiLoading(false);\\n\\n    if (!res.ok) {\\n      setAiError(res.error);\\n      return;\\n    }\\n\\n    const draft = res.data;\\n    setTitle(draft.title);\\n    setListId(draft.listId);\\n    setPriority(draft.priority);\\n    if (draft.dueDate) setDueDate(draft.dueDate);\\n    if (draft.notes) setNotes(draft.notes);\\n    setSubtasks(\\n      draft.subtasks.slice(0, 20).map((st) => ({\\n        id: makeSubtaskId(),\\n        title: st,\\n        done: false,\\n      }))\\n    );\\n    setAiNotice(t(\'planner.aiBreakdownNotice\'));\\n\\n    incrementLocalAiUsage(dayKey, res.meta.inputTokensEst, res.meta.outputTokensEst);\\n    if (authUser) {\\n      void aiUsageRepository.recordUsage(\\n        authUser.uid,\\n        dayKey,\\n        todayAiUsage.dayKey === dayKey ? todayAiUsage : null,\\n        res.meta.inputTokensEst,\\n        res.meta.outputTokensEst\\n      );\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setFormError(null);\\n\\n    const cleanTitle = title.trim();\\n    if (!cleanTitle) {\\n      setFormError(\'Task title is required.\');\\n      return;\\n    }\\n\\n    setSaving(true);\\n    try {\\n      if (isEditing && editingTask) {\\n        await onUpdate(editingTask, {\\n          title: cleanTitle,\\n          notes: notes.trim() || undefined,\\n          listId,\\n          priority,\\n          status,\\n          dueDate: dueDate || undefined,\\n          subtasks,\\n        });\\n      } else {\\n        await onCreate({\\n          title: cleanTitle,\\n          notes: notes.trim() || undefined,\\n          listId,\\n          priority,\\n          status,\\n          dueDate: dueDate || undefined,\\n          subtasks: subtasks.length > 0 ? subtasks : undefined,\\n        });\\n      }\\n      onClose();\\n    } catch (err) {\\n      setFormError(err instanceof Error ? err.message : \'Could not save task.\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={isEditing ? t(\'planner.editTask\') : t(\'planner.addTask\')}\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4 overflow-y-auto\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"w-full max-w-xl rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] shadow-xl overflow-hidden my-auto max-h-[92dvh] flex flex-col\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"flex items-center justify-between px-5 py-4 border-b border-[var(--border-hairline)] shrink-0\\\">\\n          <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n            {isEditing ? t(\'planner.editTask\') : t(\'planner.addTask\')}\\n          </h2>\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={t(\'common.close\')}\\n            onClick={onClose}\\n            className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]\\\"\\n          >\\n            <X className=\\\"h-4 w-4\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"p-5 space-y-5 overflow-y-auto\\\">\\n          {!isEditing && (\\n            <div className=\\\"rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-3.5 space-y-2.5\\\">\\n              <div className=\\\"flex items-center justify-between gap-2\\\">\\n                <span className=\\\"inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--text-primary)]\\\">\\n                  <Sparkles className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" />\\n                  <span>{t(\'planner.aiGoalBreakdown\')}</span>\\n                </span>\\n                <span className=\\\"text-[11px] text-[var(--text-muted)]\\\">Preview before saving</span>\\n              </div>\\n              <div className=\\\"flex gap-2\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  autoFocus={initialFocusAi}\\n                  value={aiGoal}\\n                  onChange={(e) => setAiGoal(e.target.value)}\\n                  onKeyDown={(e) => {\\n                    if (e.key === \'Enter\') {\\n                      e.preventDefault();\\n                      void handleAiBreakdown();\\n                    }\\n                  }}\\n                  placeholder={t(\'planner.aiGoalPlaceholder\')}\\n                  className=\\\"flex-1 min-w-0 min-h-[40px] rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={aiLoading || !aiGoal.trim()}\\n                  onClick={() => void handleAiBreakdown()}\\n                  className=\\\"min-h-[40px] rounded-lg bg-[var(--accent)] px-3.5 py-1.5 text-xs font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50 whitespace-nowrap shrink-0\\\"\\n                >\\n                  {aiLoading ? \'...\' : t(\'planner.aiBreakdownBtn\')}\\n                </button>\\n              </div>\\n              {aiNotice && <p className=\\\"text-xs text-[var(--accent)] font-medium\\\">{aiNotice}</p>}\\n              {aiError && (\\n                <p className=\\\"flex items-start gap-1.5 text-xs text-amber-700 dark:text-amber-300\\\">\\n                  <ShieldAlert className=\\\"h-3.5 w-3.5 shrink-0 mt-0.5\\\" />\\n                  <span>{aiError}</span>\\n                </p>\\n              )}\\n            </div>\\n          )}\\n\\n          <form onSubmit={(e) => void handleSubmit(e)} className=\\\"space-y-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'planner.taskTitleLabel\')}\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                maxLength={200}\\n                value={title}\\n                onChange={(e) => setTitle(e.target.value)}\\n                placeholder=\\\"Prepare passport renewal documents\\\"\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'planner.listLabel\')}\\n                </label>\\n                <select\\n                  value={listId}\\n                  onChange={(e) => setListId(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                >\\n                  {DEFAULT_TASK_LISTS.map((l) => (\\n                    <option key={l.id} value={l.id}>\\n                      {t(l.labelKey)}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'planner.priorityLabel\')}\\n                </label>\\n                <select\\n                  value={priority}\\n                  onChange={(e) => setPriority(Number(e.target.value))}\\n                  className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                >\\n                  <option value={1}>P1 \302\267 Urgent</option>\\n                  <option value={2}>P2 \302\267 High</option>\\n                  <option value={3}>P3 \302\267 Medium</option>\\n                  <option value={4}>P4 \302\267 Low</option>\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'planner.dueDateLabel\')}\\n                </label>\\n                <input\\n                  type=\\\"date\\\"\\n                  value={dueDate}\\n                  onChange={(e) => setDueDate(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {isEditing && (\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  Status\\n                </label>\\n                <select\\n                  value={status}\\n                  onChange={(e) => setStatus(e.target.value as TaskStatus)}\\n                  className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                >\\n                  <option value=\\\"todo\\\">{t(\'planner.statusTodo\')}</option>\\n                  <option value=\\\"in_progress\\\">{t(\'planner.statusInProgress\')}</option>\\n                  <option value=\\\"done\\\">{t(\'planner.statusDone\')}</option>\\n                </select>\\n              </div>\\n            )}\\n\\n            {/* Subtasks Builder (capped at 20 per Pillar 5) */}\\n            <div className=\\\"rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-3.5 space-y-2.5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-xs font-semibold text-[var(--text-primary)]\\\">\\n                  {t(\'planner.subtasksLabel\')}\\n                </span>\\n                <span className=\\\"font-numeric text-[11px] text-[var(--text-muted)]\\\">\\n                  {subtasks.length} / 20\\n                </span>\\n              </div>\\n\\n              {subtasks.length > 0 && (\\n                <div className=\\\"space-y-1.5\\\">\\n                  {subtasks.map((st, idx) => (\\n                    <div\\n                      key={st.id}\\n                      className=\\\"flex items-center justify-between gap-2 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-2\\\"\\n                    >\\n                      <span className=\\\"text-xs text-[var(--text-primary)] min-w-0 flex-1 truncate\\\">\\n                        <span className=\\\"font-numeric text-[var(--text-muted)] me-1.5\\\">{idx + 1}.</span>\\n                        {st.title}\\n                      </span>\\n                      <button\\n                        type=\\\"button\\\"\\n                        aria-label=\\\"Remove subtask\\\"\\n                        onClick={() => removeSubtask(st.id)}\\n                        className=\\\"text-[var(--text-muted)] hover:text-red-600 dark:hover:text-red-400 p-1\\\"\\n                      >\\n                        <Trash2 className=\\\"h-3.5 w-3.5\\\" />\\n                      </button>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n\\n              <div className=\\\"flex gap-2\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  maxLength={200}\\n                  value={newSubtaskText}\\n                  onChange={(e) => setNewSubtaskText(e.target.value)}\\n                  onKeyDown={(e) => {\\n                    if (e.key === \'Enter\') {\\n                      e.preventDefault();\\n                      addSubtask();\\n                    }\\n                  }}\\n                  placeholder={t(\'planner.addSubtaskPlaceholder\')}\\n                  className=\\\"flex-1 min-w-0 min-h-[38px] rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={!newSubtaskText.trim() || subtasks.length >= 20}\\n                  onClick={addSubtask}\\n                  className=\\\"inline-flex min-h-[38px] items-center gap-1 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] disabled:opacity-50 whitespace-nowrap\\\"\\n                >\\n                  <Plus className=\\\"h-3.5 w-3.5\\\" />\\n                  <span>Add</span>\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                Notes\\n              </label>\\n              <textarea\\n                rows={2}\\n                maxLength={2000}\\n                value={notes}\\n                onChange={(e) => setNotes(e.target.value)}\\n                placeholder=\\\"Optional context, checklist notes, or links...\\\"\\n                className=\\\"w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            {formError && (\\n              <p className=\\\"text-xs font-medium text-red-600 dark:text-red-400\\\">{formError}</p>\\n            )}\\n\\n            <div className=\\\"flex items-center justify-end gap-2.5 pt-2 border-t border-[var(--border-hairline)]\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onClose}\\n                className=\\\"min-h-[42px] rounded-xl border border-[var(--border-hairline)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]\\\"\\n              >\\n                {t(\'common.cancel\')}\\n              </button>\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={saving}\\n                className=\\\"min-h-[42px] rounded-xl bg-[var(--accent)] px-5 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50\\\"\\n              >\\n                {saving ? \'...\' : isEditing ? t(\'planner.saveChanges\') : t(\'planner.saveTask\')}\\n              </button>\\n            </div>\\n          </form>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create TaskFormModal with privacy-gated AI Goal Breakdown preview and dynamic subtask builder\", \"Overwrite\":true, \"TargetFile\":\"/src/features/planner/ui/TaskFormModal.tsx\", \"toolAction\":\"Creating TaskFormModal.tsx\", \"toolSummary\":\"Create TaskFormModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3220078722342207959"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport { ChevronLeft, ChevronRight, Plus } from \'lucide-react\';\\nimport type { DebtRecord } from \'../../../core/debts/debtSchemas\';\\nimport type { ReminderItem } from \'../../../core/reminders/reminderSchemas\';\\nimport type { TaskItem } from \'../../../core/planner/plannerSchemas\';\\nimport {\\n  buildUnifiedMonthlyCalendar,\\n  formatLocalYmd,\\n  type CalendarEventKind,\\n} from \'../../../core/planner/unifiedCalendar\';\\n\\ninterface UnifiedCalendarPanelProps {\\n  tasks: readonly TaskItem[];\\n  reminders: readonly ReminderItem[];\\n  debts: readonly DebtRecord[];\\n  locale: string;\\n  onAddTaskForDate: (ymd: string) => void;\\n}\\n\\nconst WEEKDAYS = [\'Sun\', \'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\'];\\n\\nconst KIND_LABELS: Record<CalendarEventKind, string> = {\\n  task: \'Task\',\\n  reminder: \'Reminder\',\\n  debt: \'Debt Due\',\\n};\\n\\nexport const UnifiedCalendarPanel: React.FC<UnifiedCalendarPanelProps> = ({\\n  tasks,\\n  reminders,\\n  debts,\\n  locale,\\n  onAddTaskForDate,\\n}) => {\\n  const today = new Date();\\n  const todayYmd = formatLocalYmd(today);\\n\\n  const [cursorYear, setCursorYear] = useState(today.getFullYear());\\n  const [cursorMonth, setCursorMonth] = useState(today.getMonth());\\n  const [selectedYmd, setSelectedYmd] = useState(todayYmd);\\n\\n  const grid = useMemo(\\n    () =>\\n      buildUnifiedMonthlyCalendar({\\n        year: cursorYear,\\n        monthIndex: cursorMonth,\\n        todayYmd,\\n        tasks,\\n        reminders,\\n        debts,\\n      }),\\n    [cursorYear, cursorMonth, todayYmd, tasks, reminders, debts]\\n  );\\n\\n  const selectedCell = useMemo(\\n    () => grid.days.find((d) => d.dateYmd === selectedYmd) ?? grid.days.find((d) => d.isToday) ?? grid.days[0],\\n    [grid.days, selectedYmd]\\n  );\\n\\n  const monthTitle = useMemo(() => {\\n    const dt = new Date(cursorYear, cursorMonth, 1);\\n    return new Intl.DateTimeFormat(locale === \'en\' ? \'en-US\' : locale, {\\n      month: \'long\',\\n      year: \'numeric\',\\n    }).format(dt);\\n  }, [cursorYear, cursorMonth, locale]);\\n\\n  const shiftMonth = (delta: number) => {\\n    const next = new Date(cursorYear, cursorMonth + delta, 1);\\n    setCursorYear(next.getFullYear());\\n    setCursorMonth(next.getMonth());\\n  };\\n\\n  return (\\n    <div className=\\\"grid grid-cols-1 xl:grid-cols-3 gap-6 items-start\\\">\\n      {/* Monthly Grid */}\\n      <div className=\\\"xl:col-span-2 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] overflow-hidden\\\">\\n        <div className=\\\"px-5 py-4 border-b border-[var(--border-hairline)] flex flex-wrap items-center justify-between gap-3\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">{monthTitle}</h2>\\n            <p className=\\\"text-xs text-[var(--text-muted)] font-numeric\\\">\\n              {grid.totalEventsInMonth} scheduled {grid.totalEventsInMonth === 1 ? \'item\' : \'items\'} \302\267 Tasks \302\267 Reminders \302\267 Debts\\n            </p>\\n          </div>\\n          <div className=\\\"inline-flex items-center gap-1.5\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setCursorYear(today.getFullYear());\\n                setCursorMonth(today.getMonth());\\n                setSelectedYmd(todayYmd);\\n              }}\\n              className=\\\"min-h-[36px] px-3 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]\\\"\\n            >\\n              Today\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              aria-label=\\\"Previous month\\\"\\n              onClick={() => shiftMonth(-1)}\\n              className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]\\\"\\n            >\\n              <ChevronLeft className=\\\"h-4 w-4\\\" />\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              aria-label=\\\"Next month\\\"\\n              onClick={() => shiftMonth(1)}\\n              className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]\\\"\\n            >\\n              <ChevronRight className=\\\"h-4 w-4\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-7 border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)]\\\">\\n          {WEEKDAYS.map((wd) => (\\n            <div\\n              key={wd}\\n              className=\\\"py-2 text-center text-[11px] font-semibold text-[var(--text-muted)]\\\"\\n            >\\n              {wd}\\n            </div>\\n          ))}\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-7 gap-px bg-[var(--border-hairline)]\\\">\\n          {grid.days.map((cell) => {\\n            const isSelected = cell.dateYmd === selectedCell?.dateYmd;\\n            const visibleEvents = cell.events.slice(0, 2);\\n            const moreCount = cell.events.length - visibleEvents.length;\\n\\n            return (\\n              <button\\n                key={cell.dateYmd}\\n                type=\\\"button\\\"\\n                onClick={() => setSelectedYmd(cell.dateYmd)}\\n                className={`min-h-[84px] sm:min-h-[96px] p-2 text-start flex flex-col justify-between transition-colors ${\\n                  isSelected\\n                    ? \'bg-[var(--accent-soft)]\'\\n                    : cell.inCurrentMonth\\n                      ? \'bg-[var(--bg-surface)] hover:bg-[var(--bg-subtle)]/50\'\\n                      : \'bg-[var(--bg-canvas)] text-[var(--text-muted)]\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between w-full\\\">\\n                  <span\\n                    className={`font-numeric text-xs font-semibold ${\\n                      cell.isToday\\n                        ? \'text-[var(--accent)]\'\\n                        : cell.inCurrentMonth\\n                          ? \'text-[var(--text-primary)]\'\\n                          : \'text-[var(--text-muted)]\'\\n                    }`}\\n                  >\\n                    {cell.dayOfMonth}\\n                  </span>\\n                  {cell.events.length > 0 && (\\n                    <span className=\\\"font-numeric text-[10px] text-[var(--text-muted)]\\\">\\n                      {cell.events.length}\\n                    </span>\\n                  )}\\n                </div>\\n\\n                <div className=\\\"space-y-0.5 w-full mt-1\\\">\\n                  {visibleEvents.map((ev) => (\\n                    <div\\n                      key={ev.id}\\n                      className={`truncate text-[11px] leading-tight ${\\n                        ev.isDone\\n                          ? \'line-through text-[var(--text-muted)]\'\\n                          : ev.kind === \'debt\'\\n                            ? \'text-amber-700 dark:text-amber-300 font-medium\'\\n                            : ev.kind === \'reminder\'\\n                              ? \'text-[var(--accent)] font-medium\'\\n                              : \'text-[var(--text-primary)]\'\\n                      }`}\\n                    >\\n                      {ev.title}\\n                    </div>\\n                  ))}\\n                  {moreCount > 0 && (\\n                    <div className=\\\"font-numeric text-[10px] text-[var(--text-muted)]\\\">\\n                      +{moreCount} more\\n                    </div>\\n                  )}\\n                </div>\\n              </button>\\n            );\\n          })}\\n        </div>\\n      </div>\\n\\n      {/* Selected Day Agenda Inspector */}\\n      <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] overflow-hidden\\\">\\n        <div className=\\\"px-5 py-4 border-b border-[var(--border-hairline)] flex items-center justify-between gap-2\\\">\\n          <div>\\n            <h3 className=\\\"font-numeric text-sm font-semibold text-[var(--text-primary)]\\\">\\n              {selectedCell?.dateYmd}\\n            </h3>\\n            <p className=\\\"text-xs text-[var(--text-muted)]\\\">\\n              {selectedCell?.events.length ?? 0}{\' \'}\\n              {(selectedCell?.events.length ?? 0) === 1 ? \'entry\' : \'entries\'} across modules\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onAddTaskForDate(selectedCell?.dateYmd ?? todayYmd)}\\n            className=\\\"inline-flex min-h-[36px] items-center gap-1 rounded-lg bg-[var(--accent)] px-3 py-1.5 text-xs font-medium text-white hover:bg-[var(--accent-hover)] whitespace-nowrap\\\"\\n          >\\n            <Plus className=\\\"h-3.5 w-3.5\\\" />\\n            <span>Add Task</span>\\n          </button>\\n        </div>\\n\\n        {!selectedCell || selectedCell.events.length === 0 ? (\\n          <div className=\\\"p-6 text-center text-xs text-[var(--text-muted)]\\\">\\n            No tasks, reminders, or debt due dates scheduled on this day.\\n          </div>\\n        ) : (\\n          <div className=\\\"divide-y divide-[var(--border-hairline)]\\\">\\n            {selectedCell.events.map((ev) => (\\n              <div key={ev.id} className=\\\"px-5 py-3.5 space-y-0.5\\\">\\n                <div className=\\\"flex items-center justify-between gap-2\\\">\\n                  <span\\n                    className={`text-sm font-medium ${\\n                      ev.isDone ? \'line-through text-[var(--text-muted)]\' : \'text-[var(--text-primary)]\'\\n                    }`}\\n                  >\\n                    {ev.title}\\n                  </span>\\n                  {ev.timeLabel && (\\n                    <span className=\\\"font-numeric text-xs text-[var(--text-muted)] shrink-0\\\">\\n                      {ev.timeLabel}\\n                    </span>\\n                  )}\\n                </div>\\n                <div className=\\\"text-xs text-[var(--text-muted)]\\\">\\n                  <span\\n                    className={\\n                      ev.kind === \'debt\'\\n                        ? \'text-amber-700 dark:text-amber-300 font-medium\'\\n                        : ev.kind === \'reminder\'\\n                          ? \'text-[var(--accent)] font-medium\'\\n                          : \'text-[var(--text-secondary)] font-medium\'\\n                    }\\n                  >\\n                    {KIND_LABELS[ev.kind]}\\n                  </span>\\n                  {ev.subtitle && (\\n                    <>\\n                      <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n                      <span>{ev.subtitle}</span>\\n                    </>\\n                  )}\\n                  {ev.isUrgent && (\\n                    <>\\n                      <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n                      <span className=\\\"text-red-600 dark:text-red-400 font-medium\\\">Priority</span>\\n                    </>\\n                  )}\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create UnifiedCalendarPanel merging Tasks, Reminders, and Open Debts into a clean 42-day monthly grid with day inspector\", \"Overwrite\":true, \"TargetFile\":\"/src/features/planner/ui/UnifiedCalendarPanel.tsx\", \"toolAction\":\"Creating UnifiedCalendarPanel.tsx\", \"toolSummary\":\"Create UnifiedCalendarPanel.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3220078722342210602"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  ArrowDown,\\n  ArrowUp,\\n  Check,\\n  ChevronDown,\\n  ChevronRight,\\n  Edit3,\\n  GripVertical,\\n  Plus,\\n  Search,\\n  Sparkles,\\n  Trash2,\\n} from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport {\\n  DEFAULT_TASK_LISTS,\\n  getPriorityLabel,\\n  getTaskListMeta,\\n  type TaskItem,\\n  type TaskStatus,\\n} from \'../../../core/planner/plannerSchemas\';\\nimport { formatLocalYmd } from \'../../../core/planner/unifiedCalendar\';\\nimport { useDebts } from \'../../../hooks/useDebts\';\\nimport { usePlanner } from \'../../../hooks/usePlanner\';\\nimport { useReminders } from \'../../../hooks/useReminders\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\nimport { TaskFormModal } from \'./TaskFormModal\';\\nimport { UnifiedCalendarPanel } from \'./UnifiedCalendarPanel\';\\n\\ntype PlannerTab = \'tasks\' | \'calendar\';\\ntype StatusFilter = \'active\' | \'todo\' | \'in_progress\' | \'done\' | \'all\';\\n\\nexport const PlannerView: React.FC = () => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const showToast = useUIStore((s) => s.showToast);\\n\\n  const {\\n    tasks,\\n    loading,\\n    summary,\\n    isCloudSynced,\\n    createTask,\\n    reorderTaskBetween,\\n    setTaskStatus,\\n    toggleSubtask,\\n    updateTaskMeta,\\n    deleteTask,\\n    restoreTask,\\n  } = usePlanner();\\n  const { reminders } = useReminders();\\n  const { debts } = useDebts();\\n\\n  const [tab, setTab] = useState<PlannerTab>(\'tasks\');\\n  const [listFilter, setListFilter] = useState<string>(\'all\');\\n  const [statusFilter, setStatusFilter] = useState<StatusFilter>(\'active\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [expandedIds, setExpandedIds] = useState<Record<string, boolean>>({});\\n  const [draggedTaskId, setDraggedTaskId] = useState<string | null>(null);\\n  const [dragOverTaskId, setDragOverTaskId] = useState<string | null>(null);\\n\\n  const [formOpen, setFormOpen] = useState(false);\\n  const [formFocusAi, setFormFocusAi] = useState(false);\\n  const [formDefaultDate, setFormDefaultDate] = useState(\'\');\\n  const [editingTask, setEditingTask] = useState<TaskItem | null>(null);\\n\\n  const todayYmd = formatLocalYmd(new Date());\\n\\n  const filteredTasks = useMemo(() => {\\n    const q = searchQuery.trim().toLowerCase();\\n    return tasks.filter((task) => {\\n      if (statusFilter === \'active\' && task.status === \'done\') return false;\\n      if (statusFilter === \'todo\' && task.status !== \'todo\') return false;\\n      if (statusFilter === \'in_progress\' && task.status !== \'in_progress\') return false;\\n      if (statusFilter === \'done\' && task.status !== \'done\') return false;\\n      if (listFilter !== \'all\' && task.listId !== listFilter) return false;\\n      if (q) {\\n        const subs = (task.subtasks ?? []).map((s) => s.title).join(\' \');\\n        const hay = `${task.title} ${task.notes ?? \'\'} ${task.listId} ${subs}`.toLowerCase();\\n        if (!hay.includes(q)) return false;\\n      }\\n      return true;\\n    });\\n  }, [tasks, statusFilter, listFilter, searchQuery]);\\n\\n  const canReorder = searchQuery.trim() === \'\';\\n\\n  const handleMoveByOffset = async (indexInFiltered: number, delta: -1 | 1) => {\\n    const targetIndex = indexInFiltered + delta;\\n    if (targetIndex < 0 || targetIndex >= filteredTasks.length) return;\\n    const moving = filteredTasks[indexInFiltered];\\n    const withoutMoving = filteredTasks.filter((t) => t.id !== moving.id);\\n    const prev = targetIndex > 0 ? withoutMoving[targetIndex - 1] : null;\\n    const next = targetIndex < withoutMoving.length ? withoutMoving[targetIndex] : null;\\n    await reorderTaskBetween(moving, prev, next);\\n  };\\n\\n  const handleDropOnTask = async (targetTaskId: string) => {\\n    setDragOverTaskId(null);\\n    if (!draggedTaskId || draggedTaskId === targetTaskId) {\\n      setDraggedTaskId(null);\\n      return;\\n    }\\n    const moving = filteredTasks.find((t) => t.id === draggedTaskId);\\n    const targetIdx = filteredTasks.findIndex((t) => t.id === targetTaskId);\\n    const sourceIdx = filteredTasks.findIndex((t) => t.id === draggedTaskId);\\n    setDraggedTaskId(null);\\n    if (!moving || targetIdx === -1 || sourceIdx === -1) return;\\n\\n    const withoutMoving = filteredTasks.filter((t) => t.id !== moving.id);\\n    const insertIdx = sourceIdx < targetIdx ? targetIdx : targetIdx;\\n    const prev = insertIdx > 0 ? withoutMoving[insertIdx - 1] : null;\\n    const next = insertIdx < withoutMoving.length ? withoutMoving[insertIdx] : null;\\n    await reorderTaskBetween(moving, prev, next);\\n  };\\n\\n  const handleCycleStatus = async (task: TaskItem) => {\\n    const nextStatus: TaskStatus = task.status === \'done\' ? \'todo\' : \'done\';\\n    await setTaskStatus(task, nextStatus);\\n    showToast(nextStatus === \'done\' ? `Completed \\\"${task.title}\\\".` : `Reopened \\\"${task.title}\\\".`);\\n  };\\n\\n  const handleDeleteWithUndo = async (task: TaskItem) => {\\n    await deleteTask(task);\\n    showToast(`Deleted \\\"${task.title}\\\".`, () => {\\n      void restoreTask(task);\\n    });\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Header */}\\n      <section className=\\\"flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between\\\">\\n        <div>\\n          <p className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">\\n            <span>{isCloudSynced ? t(\'common.syncedCloudMode\') : t(\'common.offlineLocalMode\')}</span>\\n            <span aria-hidden=\\\"true\\\"> \302\267 </span>\\n            <span>Single-write fractional-index ordering</span>\\n          </p>\\n          <h1 className=\\\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]\\\">\\n            {t(\'planner.title\')}\\n          </h1>\\n          <p className=\\\"mt-1 max-w-2xl text-sm text-[var(--text-secondary)]\\\">\\n            {t(\'planner.subtitle\')}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setEditingTask(null);\\n              setFormDefaultDate(\'\');\\n              setFormFocusAi(true);\\n              setFormOpen(true);\\n            }}\\n            className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3.5 py-2 text-xs sm:text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors whitespace-nowrap\\\"\\n          >\\n            <Sparkles className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n            <span>{t(\'planner.aiGoalBreakdown\')}</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setEditingTask(null);\\n              setFormDefaultDate(\'\');\\n              setFormFocusAi(false);\\n              setFormOpen(true);\\n            }}\\n            className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-4 py-2 text-xs sm:text-sm font-medium text-white hover:bg-[var(--accent-hover)] transition-colors whitespace-nowrap\\\"\\n          >\\n            <Plus className=\\\"h-4 w-4\\\" />\\n            <span>{t(\'planner.addTask\')}</span>\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* 4-Column Flat KPI Strip */}\\n      <section\\n        aria-label=\\\"Planner metrics\\\"\\n        className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl border border-[var(--border-hairline)] bg-[var(--border-hairline)] overflow-hidden\\\"\\n      >\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'planner.kpiActive\')}</div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n            {summary.activeCount}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            {summary.inProgressCount} in progress\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'planner.kpiDueToday\')}</div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--accent)]\\\">\\n            {summary.dueTodayCount}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            {summary.overdueCount} overdue\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'planner.kpiCompleted\')}</div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n            {summary.completedCount}\\n          </div>\\n          <div className=\\\"mt-1 font-numeric text-xs text-[var(--text-muted)]\\\">\\n            of {summary.totalCount} total {summary.totalCount === 1 ? \'task\' : \'tasks\'}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"bg-[var(--bg-surface)] p-5\\\">\\n          <div className=\\\"text-xs font-medium text-[var(--text-muted)]\\\">{t(\'planner.kpiCalendarItems\')}</div>\\n          <div className=\\\"mt-2 font-numeric text-xl font-semibold text-[var(--text-primary)]\\\">\\n            {tasks.filter((x) => Boolean(x.dueDate) && x.status !== \'done\').length +\\n              reminders.filter((r) => !r.isCompleted).length}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-[var(--text-muted)]\\\">\\n            Tasks, reminders &amp; debt dates\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* View Switcher */}\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n        <div\\n          role=\\\"tablist\\\"\\n          aria-label=\\\"Planner views\\\"\\n          className=\\\"inline-flex items-center gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\"\\n        >\\n          <button\\n            type=\\\"button\\\"\\n            role=\\\"tab\\\"\\n            aria-selected={tab === \'tasks\'}\\n            onClick={() => setTab(\'tasks\')}\\n            className={`min-h-[38px] px-4 py-1.5 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap ${\\n              tab === \'tasks\'\\n                ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n            }`}\\n          >\\n            {t(\'planner.tabTasks\')}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            role=\\\"tab\\\"\\n            aria-selected={tab === \'calendar\'}\\n            onClick={() => setTab(\'calendar\')}\\n            className={`min-h-[38px] px-4 py-1.5 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap ${\\n              tab === \'calendar\'\\n                ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n            }`}\\n          >\\n            {t(\'planner.tabCalendar\')}\\n          </button>\\n        </div>\\n      </div>\\n\\n      {tab === \'calendar\' ? (\\n        <UnifiedCalendarPanel\\n          tasks={tasks}\\n          reminders={reminders}\\n          debts={debts}\\n          locale={profile.locale}\\n          onAddTaskForDate={(ymd) => {\\n            setEditingTask(null);\\n            setFormDefaultDate(ymd);\\n            setFormFocusAi(false);\\n            setFormOpen(true);\\n          }}\\n        />\\n      ) : (\\n        <div className=\\\"space-y-4\\\">\\n          {/* Search, List & Status Filters */}\\n          <div className=\\\"flex flex-col lg:flex-row lg:items-center justify-between gap-3\\\">\\n            <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-1\\\">\\n              <div className=\\\"relative flex-1 max-w-md\\\">\\n                <Search className=\\\"pointer-events-none absolute start-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[var(--text-muted)]\\\" />\\n                <input\\n                  type=\\\"search\\\"\\n                  value={searchQuery}\\n                  onChange={(e) => setSearchQuery(e.target.value)}\\n                  placeholder={t(\'planner.searchPlaceholder\')}\\n                  className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] ps-10 pe-3.5 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n\\n              <select\\n                aria-label=\\\"Filter by list\\\"\\n                value={listFilter}\\n                onChange={(e) => setListFilter(e.target.value)}\\n                className=\\\"min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              >\\n                <option value=\\\"all\\\">{t(\'planner.allLists\')}</option>\\n                {DEFAULT_TASK_LISTS.map((l) => (\\n                  <option key={l.id} value={l.id}>\\n                    {t(l.labelKey)}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div className=\\\"inline-flex flex-wrap items-center gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n              {(\\n                [\\n                  { id: \'active\', label: \'Active\' },\\n                  { id: \'todo\', label: t(\'planner.statusTodo\') },\\n                  { id: \'in_progress\', label: t(\'planner.statusInProgress\') },\\n                  { id: \'done\', label: t(\'planner.statusDone\') },\\n                  { id: \'all\', label: \'All\' },\\n                ] as const\\n              ).map((item) => (\\n                <button\\n                  key={item.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => setStatusFilter(item.id)}\\n                  className={`min-h-[34px] px-3 rounded-lg text-xs font-medium transition-colors whitespace-nowrap ${\\n                    statusFilter === item.id\\n                      ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                      : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                  }`}\\n                >\\n                  {item.label}\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Task List */}\\n          {loading ? (\\n            <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)]\\\">\\n              {[0, 1, 2].map((i) => (\\n                <div key={i} className=\\\"p-5 flex items-center justify-between gap-4\\\">\\n                  <div className=\\\"space-y-2 flex-1\\\">\\n                    <div className=\\\"h-4 w-52 rounded bg-[var(--bg-subtle)] animate-pulse\\\" />\\n                    <div className=\\\"h-3 w-72 rounded bg-[var(--bg-subtle)] animate-pulse\\\" />\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          ) : filteredTasks.length === 0 ? (\\n            <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-10 text-center space-y-3\\\">\\n              <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n                {tasks.length === 0 ? t(\'planner.emptyTitle\') : \'No tasks match your filters\'}\\n              </h2>\\n              <p className=\\\"max-w-md mx-auto text-xs sm:text-sm text-[var(--text-secondary)]\\\">\\n                {tasks.length === 0\\n                  ? t(\'planner.emptyDesc\')\\n                  : \'Clear the search box or switch status to All.\'}\\n              </p>\\n              {tasks.length === 0 && (\\n                <div className=\\\"pt-2 flex flex-wrap items-center justify-center gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      setEditingTask(null);\\n                      setFormDefaultDate(\'\');\\n                      setFormFocusAi(false);\\n                      setFormOpen(true);\\n                    }}\\n                    className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)]\\\"\\n                  >\\n                    <Plus className=\\\"h-4 w-4\\\" />\\n                    <span>{t(\'planner.addTask\')}</span>\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      setEditingTask(null);\\n                      setFormDefaultDate(\'\');\\n                      setFormFocusAi(true);\\n                      setFormOpen(true);\\n                    }}\\n                    className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\\\"\\n                  >\\n                    <Sparkles className=\\\"h-4 w-4 text-[var(--accent)]\\\" />\\n                    <span>{t(\'planner.aiGoalBreakdown\')}</span>\\n                  </button>\\n                </div>\\n              )}\\n            </div>\\n          ) : (\\n            <div className=\\\"rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] divide-y divide-[var(--border-hairline)] overflow-hidden\\\">\\n              {filteredTasks.map((task, idx) => {\\n                const prio = getPriorityLabel(task.priority);\\n                const listMeta = getTaskListMeta(task.listId);\\n                const subs = task.subtasks ?? [];\\n                const doneSubs = subs.filter((s) => s.done).length;\\n                const isExpanded = Boolean(expandedIds[task.id]);\\n                const isOverdue = Boolean(task.dueDate && task.dueDate < todayYmd && task.status !== \'done\');\\n                const isDragTarget = dragOverTaskId === task.id && draggedTaskId !== task.id;\\n\\n                return (\\n                  <div\\n                    key={task.id}\\n                    draggable={canReorder}\\n                    onDragStart={() => setDraggedTaskId(task.id)}\\n                    onDragOver={(e) => {\\n                      if (!canReorder) return;\\n                      e.preventDefault();\\n                      setDragOverTaskId(task.id);\\n                    }}\\n                    onDragLeave={() => {\\n                      if (dragOverTaskId === task.id) setDragOverTaskId(null);\\n                    }}\\n                    onDrop={(e) => {\\n                      e.preventDefault();\\n                      void handleDropOnTask(task.id);\\n                    }}\\n                    onDragEnd={() => {\\n                      setDraggedTaskId(null);\\n                      setDragOverTaskId(null);\\n                    }}\\n                    className={`px-5 py-4 transition-colors ${\\n                      isDragTarget ? \'bg-[var(--accent-soft)]\' : \'hover:bg-[var(--bg-subtle)]/40\'\\n                    }`}\\n                  >\\n                    <div className=\\\"flex flex-col lg:flex-row lg:items-center justify-between gap-3\\\">\\n                      <div className=\\\"flex items-start gap-3 min-w-0 flex-1\\\">\\n                        {canReorder && (\\n                          <span\\n                            aria-hidden=\\\"true\\\"\\n                            title=\\\"Drag to reorder\\\"\\n                            className=\\\"mt-1 hidden sm:inline-flex text-[var(--text-muted)] cursor-grab active:cursor-grabbing shrink-0\\\"\\n                          >\\n                            <GripVertical className=\\\"h-4 w-4\\\" />\\n                          </span>\\n                        )}\\n\\n                        <button\\n                          type=\\\"button\\\"\\n                          aria-label={task.status === \'done\' ? \'Reopen task\' : \'Complete task\'}\\n                          onClick={() => void handleCycleStatus(task)}\\n                          className={`mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border transition-colors ${\\n                            task.status === \'done\'\\n                              ? \'border-[var(--accent)] bg-[var(--accent)] text-white\'\\n                              : \'border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-transparent hover:border-[var(--accent)]\'\\n                          }`}\\n                        >\\n                          <Check className=\\\"h-3.5 w-3.5\\\" />\\n                        </button>\\n\\n                        <div className=\\\"min-w-0 flex-1 space-y-1\\\">\\n                          <div className=\\\"flex flex-wrap items-center gap-x-2 gap-y-0.5\\\">\\n                            <span\\n                              className={`text-sm font-semibold ${\\n                                task.status === \'done\'\\n                                  ? \'line-through text-[var(--text-muted)]\'\\n                                  : \'text-[var(--text-primary)]\'\\n                              }`}\\n                            >\\n                              {task.title}\\n                            </span>\\n                            <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                            <span className=\\\"text-xs font-medium text-[var(--accent)]\\\">\\n                              {t(listMeta.labelKey)}\\n                            </span>\\n                            <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                            <span\\n                              className={`font-numeric text-xs font-medium ${\\n                                task.priority === 1\\n                                  ? \'text-red-600 dark:text-red-400\'\\n                                  : task.priority === 2\\n                                    ? \'text-amber-600 dark:text-amber-400\'\\n                                    : \'text-[var(--text-muted)]\'\\n                              }`}\\n                            >\\n                              {prio.short}\\n                            </span>\\n                            {task.status === \'in_progress\' && (\\n                              <>\\n                                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                                <span className=\\\"text-xs font-medium text-[var(--accent)]\\\">\\n                                  {t(\'planner.statusInProgress\')}\\n                                </span>\\n                              </>\\n                            )}\\n                            {isOverdue && (\\n                              <>\\n                                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[var(--text-muted)]\\\">\302\267</span>\\n                                <span className=\\\"text-xs font-semibold text-red-600 dark:text-red-400\\\">\\n                                  Overdue\\n                                </span>\\n                              </>\\n                            )}\\n                          </div>\\n\\n                          <div className=\\\"flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-xs text-[var(--text-muted)]\\\">\\n                            {task.dueDate && (\\n                              <span className=\\\"font-numeric\\\">Due {task.dueDate}</span>\\n                            )}\\n                            {subs.length > 0 && (\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() =>\\n                                  setExpandedIds((prev) => ({ ...prev, [task.id]: !prev[task.id] }))\\n                                }\\n                                className=\\\"inline-flex items-center gap-1 font-numeric text-[var(--text-secondary)] hover:text-[var(--text-primary)]\\\"\\n                              >\\n                                {isExpanded ? (\\n                                  <ChevronDown className=\\\"h-3.5 w-3.5\\\" />\\n                                ) : (\\n                                  <ChevronRight className=\\\"h-3.5 w-3.5\\\" />\\n                                )}\\n                                <span>\\n                                  {doneSubs}/{subs.length} subtasks\\n                                </span>\\n                              </button>\\n                            )}\\n                            <span className=\\\"font-numeric text-[11px] opacity-70\\\">\\n                              key:{task.sortKey}\\n                            </span>\\n                            {task.notes && (\\n                              <span className=\\\"truncate max-w-xs\\\">\302\267 {task.notes}</span>\\n                            )}\\n                          </div>\\n                        </div>\\n                      </div>\\n\\n                      {/* Row Action Controls */}\\n                      <div className=\\\"flex flex-wrap items-center justify-end gap-1.5 shrink-0\\\">\\n                        {task.status !== \'done\' && (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() =>\\n                              void setTaskStatus(\\n                                task,\\n                                task.status === \'in_progress\' ? \'todo\' : \'in_progress\'\\n                              )\\n                            }\\n                            className=\\\"min-h-[36px] rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2.5 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] whitespace-nowrap\\\"\\n                          >\\n                            {task.status === \'in_progress\' ? \'Pause\' : \'Start\'}\\n                          </button>\\n                        )}\\n\\n                        {canReorder && filteredTasks.length > 1 && (\\n                          <>\\n                            <button\\n                              type=\\\"button\\\"\\n                              aria-label=\\\"Move task up\\\"\\n                              disabled={idx === 0}\\n                              onClick={() => void handleMoveByOffset(idx, -1)}\\n                              className=\\\"inline-flex h-[36px] w-[36px] items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] disabled:opacity-35\\\"\\n                            >\\n                              <ArrowUp className=\\\"h-3.5 w-3.5\\\" />\\n                            </button>\\n                            <button\\n                              type=\\\"button\\\"\\n                              aria-label=\\\"Move task down\\\"\\n                              disabled={idx === filteredTasks.length - 1}\\n                              onClick={() => void handleMoveByOffset(idx, 1)}\\n                              className=\\\"inline-flex h-[36px] w-[36px] items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] disabled:opacity-35\\\"\\n                            >\\n                              <ArrowDown className=\\\"h-3.5 w-3.5\\\" />\\n                            </button>\\n                          </>\\n                        )}\\n\\n                        <button\\n                          type=\\\"button\\\"\\n                          aria-label={t(\'planner.editTask\')}\\n                          onClick={() => {\\n                            setEditingTask(task);\\n                            setFormFocusAi(false);\\n                            setFormOpen(true);\\n                          }}\\n                          className=\\\"inline-flex h-[36px] w-[36px] items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]\\\"\\n                        >\\n                          <Edit3 className=\\\"h-3.5 w-3.5\\\" />\\n                        </button>\\n\\n                        <button\\n                          type=\\\"button\\\"\\n                          aria-label=\\\"Delete task\\\"\\n                          onClick={() => void handleDeleteWithUndo(task)}\\n                          className=\\\"inline-flex h-[36px] w-[36px] items-center justify-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-muted)] hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30\\\"\\n                        >\\n                          <Trash2 className=\\\"h-3.5 w-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n\\n                    {/* Expanded Subtasks Checklist */}\\n                    {isExpanded && subs.length > 0 && (\\n                      <div className=\\\"mt-3 ps-9 sm:ps-16 space-y-1.5\\\">\\n                        {subs.map((st) => (\\n                          <label\\n                            key={st.id}\\n                            className=\\\"flex items-center gap-2.5 text-xs text-[var(--text-secondary)] cursor-pointer py-1\\\"\\n                          >\\n                            <input\\n                              type=\\\"checkbox\\\"\\n                              checked={st.done}\\n                              onChange={() => void toggleSubtask(task, st.id)}\\n                              className=\\\"h-4 w-4 accent-[var(--accent)] rounded\\\"\\n                            />\\n                            <span className={st.done ? \'line-through text-[var(--text-muted)]\' : \'\'}>\\n                              {st.title}\\n                            </span>\\n                          </label>\\n                        ))}\\n                      </div>\\n                    )}\\n                  </div>\\n                );\\n              })}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      <TaskFormModal\\n        open={formOpen}\\n        editingTask={editingTask}\\n        defaultListId={listFilter === \'all\' ? \'inbox\' : listFilter}\\n        defaultDueDate={formDefaultDate}\\n        initialFocusAi={formFocusAi}\\n        onClose={() => {\\n          setFormOpen(false);\\n          setEditingTask(null);\\n        }}\\n        onCreate={async (input) => {\\n          await createTask(input);\\n          showToast(`Added task \\\"${input.title}\\\".`);\\n        }}\\n        onUpdate={async (current, patch) => {\\n          await updateTaskMeta(current, patch);\\n          showToast(`Updated \\\"${patch.title ?? current.title}\\\".`);\\n        }}\\n      />\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create PlannerView with 4-col KPI strip, single-write fractional-index drag/button reordering, subtasks, AI Goal Breakdown, and Unified Calendar\", \"Overwrite\":true, \"TargetFile\":\"/src/features/planner/ui/PlannerView.tsx\", \"toolAction\":\"Creating PlannerView.tsx\", \"toolSummary\":\"Create PlannerView.tsx\"}"
      original_name: "write_to_file"
    }
