      thinking_signature: "\022\352\t\n\347\t\001i\024}\023W\257!w/\260\r\246\240F\210y\321\006\315\306Kf\350\323D\334fj|\365\272F\331E\266\bMl=\266\214\310\314\243V2\n\177\314\036\034iA<}\032\260\n\215\337\030o\347\260\020,!\340fPo\306I\016\301Z#\325(\022\aM|!\375\017b\\\273\023+n\356#\023\222\244O\266\225\363\237\236\300\304\313\v`\324\214\270\223\267hP\263\342\263\373\340!5\362\fi\017\035\233\373\332\376uU\231\272\252\355@g\024l\322\344\216\233\033\350l\300\004\264\372\251\310zRR?t\356\202Tu.N\r\035?\255>\274\334*\177B\263+\203\341\356fo|\246\\;$\244\207\036\365\3264$\263&\a\213\303\362\351\237\366\243\267\241\304K\024T\002\211\021.\026Q\272k\307\016N\224\302\322W\262g~x\255sh\342\321\247\031\021\360\375\005He\267s\352\240\254qA\220\\\302W\260\323\000 \034\344`1k\341B\366\267\0372\302\216\310\255d\215\242\323\212\302\211\254\a\034\314\274\275\367\330?(6\270Kf\375\225h\227\341\334\371\237\300\373\272\\}|\377\232\313\026*T\225\314\232\321\343\354<\211\021\035\365I\377A\027\2233\232GC\316\3005\0263\201\306B\\e\331B\237\017\341\021\235\330\344\266e\3705\206!E\v\253\264q\302\233\250\325\350\274\217x\016\226\226\311\by\356#\022\b\352\376\203+\304\2264/\235\3660\'\364\315o\214\240\275\036\244\262\271\202\303C\353YZ1\356UF\346\336_g4}\311F\333\240p[\201\017\343\002\316\304\355\352z\327\321\t\023*\303u\373C^\337;\312\377\217\326e\032K\032{\247\337\250|9\324\0367\337\364\377\242\323g\351J9 t\237\215\267y\316\346\272$\002\342\275\036\317V\206EM\207\275\006H\f\3459\025F\254\2719\335\277a_\361\277\212\307\373#\371vW\315\r\336\253_\273c\031\\\006T\311\200\b\335\204_\035\037\254\v\373\001\227\f\270{8X\331\353\202\300a\371\225i\016\335t4\t\234\3236\265\340N_\022\313\2160\370\231\335\177_\233\247\321\351\324\005\364\353x\b\200\300\322\374\223,\021`\006\'\260Z[o!\"O\352+J+\321LQ\006h\"t\254\227\2331\231\226\271\355\236\250+\365\377\017\020\326W\363E\322\240\324\236\315\316\221\212\377\340\376\237\000(=IlH\002N\263\220W\305N\304\356\230d\343\357\210\256\n\000\224\253.VYpLZJ\36579k\027\233\001b\252\2068\b\b\031Y\3371\225x\252\315)\034\002\017\032\vw\001\362S9m\a\361b10\333\2322\326\332\331]\035(u\353\327\031\3652PF\375\344\213d\225\325\bZM\200\376\272\352\257\234\275\210\320\201jX\272+\271\225a\347\025-\"\235\234-w\263\1779@8\fvVy\006\036b\203\376\340\264\272\337\022\003-a\036|Rzk\262/DC\215\212\263\351#\234\343\036\002.\006\300q\256\v\364\335\276!\341d?\366\365\273\f?\225\272\237\017\004\356\375\350b*\371:\204\273v\020\2355\b\357\022m\332D\237`\275S\265\212 U\222\376\361~\263\366~\2006{\v\214PO\270\3551\244\200\206Mh\b: B\267\353Y\300\032\"\377\344hF\313\n\261\210\307\344\376\374\r\346q<\257\004\367\377;p\325\211SI0\210\301\234\362\356\016\313\2466\036\207\222PV\276\352\255\254\233\a\t\321\335\t\333\335\024Cf\025\331\001\200\261\030\\\375d\203\277UW\302\343i\314c\fp\246\331\203\241i\2400\370G\256\036<:\243\016\20493\236f\342\335)\016\232\246GYz\305\267\006+\177.\305a\v+l&\270\251\270\3527g4\375\325+m\006l\344\276\223G\242\252\025x\262\306\344\314\242]2\233\230k\266\351\260\363\177\266\201\377\372*L\346\243\222H\362Z\264\263\234KV\003\277ut\273\256dd#\242\360l/}\214\017<vS1\266\345\241\321b8({\342$2E\266\326\203@\230\354\257\322M3\260\341N+X\212N\264\373|\255\210\033\3416^\377\317?\023\205(v\357\232&\300\233\034\301!\031~3b\021?#VU)\3665\227F\321\363\302\244\212h\026;\312G\253\377\237C\331V\332$\332+g\365\004\343\364\347z\033\021(\232\302\323\320G\025\220rw\346t\335\364\321U\205a[?B\006\271\343\270\032\204\207\241lQ\371L]\275\212\260=\357\006\002Q\326o<\357\b/\206jBmxM\204\356\326\320\024edw\255\350\256\270\327f\214m\r\357\307\235?\016\331S\005\323\006<"
