  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Lock } from \'lucide-react\';\nimport { useTranslation } from \'react-i18next\';\nimport { useUIStore } from \'../state/useUIStore\';\n\nexport const AppLockOverlay: React.FC = () => {\n  const { t } = useTranslation();\n  const isAppLocked = useUIStore((s) => s.isAppLocked);\n  const unlockApp = useUIStore((s) => s.unlockApp);\n  const [pin, setPin] = useState(\'\');\n  const [error, setError] = useState(\'\');\n\n  if (!isAppLocked) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const ok = unlockApp(pin);\n    if (ok) {\n      setPin(\'\');\n      setError(\'\');\n    } else {\n      setError(t(\'lock.wrongPin\'));\n      setPin(\'\');\n    }\n  };\n\n  return (\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label={t(\'lock.title\')}\n      className=\"fixed inset-0 z-50 flex items-center justify-center bg-[var(--bg-canvas)]/95 p-6 backdrop-blur-md\"\n    >\n      <form\n        onSubmit={handleSubmit}\n        className=\"w-full max-w-sm rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-6\"\n      >\n        <div className=\"flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--accent-soft)] text-[var(--accent)]\">\n          <Lock className=\"h-5 w-5\" />\n        </div>\n        <h1 className=\"mt-4 text-xl font-semibold text-[var(--text-primary)]\">{t(\'lock.title\')}</h1>\n        <p className=\"mt-1 text-sm text-[var(--text-secondary)]\">{t(\'lock.subtitle\')}</p>\n\n        <div className=\"mt-5\">\n          <label htmlFor=\"unlock-pin-input\" className=\"block text-xs font-medium text-[var(--text-secondary)]\">\n            PIN\n          </label>\n          <input\n            id=\"unlock-pin-input\"\n            type=\"password\"\n            inputMode=\"numeric\"\n            autoComplete=\"off\"\n            autoFocus\n            value={pin}\n            onChange={(e) => {\n              setPin(e.target.value);\n              setError(\'\');\n            }}\n            placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\"\n            className=\"mt-1.5 min-h-[44px] w-full rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 font-numeric text-base tracking-widest text-[var(--text-primary)] focus:border-[var(--accent)] focus:outline-none\"\n          />\n          {error && <p className=\"mt-2 text-xs text-red-600 dark:text-red-400\">{error}</p>}\n        </div>\n\n        <button\n          type=\"submit\"\n          className=\"mt-5 min-h-[44px] w-full rounded-lg bg-[var(--accent)] px-4 py-2.5 text-sm font-medium text-white hover:bg-[var(--accent-hover)] transition-colors\"\n        >\n          {t(\'lock.unlockBtn\')}\n        </button>\n      </form>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AppLockOverlay.tsx"
        }
        overwrite: true
      }
    }
