225\331\205\331\210\331\210 \333\214\333\225\332\251\330\264\333\225\331\205\331\205\333\225 \331\210 \332\206\331\210\330\247\330\261\330\264\333\225\331\205\331\205\333\225\333\214\333\225\332\251 \332\251\330\247\330\252\332\230\331\205\333\216\330\261 \331\250\333\214 \330\246\333\216\331\210\330\247\330\261\333\225 \332\244\333\214\330\252\330\247\331\205\333\214\331\206 \330\250\330\256\333\206\331\205\"...\',\n        aiParseBtn: \'\330\264\333\214\332\251\330\261\330\257\331\206\333\225\331\210\333\225\',\n        aiDraftNotice: \'\332\225\333\225\330\264\331\206\331\210\331\210\330\263\333\214 \330\256\330\264\330\252\333\225 \330\250\333\225 AI \330\246\330\247\331\205\330\247\330\257\333\225 \332\251\330\261\330\247 \342\200\224 \331\276\333\216\330\264 \331\276\330\247\330\264\333\225\332\251\333\225\331\210\330\252\332\251\330\261\330\257\331\206 \331\276\333\216\330\257\330\247\332\206\331\210\331\210\331\206\333\225\331\210\333\225 \330\250\332\251\333\225.\',\n        prioLow: \'\331\206\330\262\331\205\',\n        prioNormal: \'\330\246\330\247\330\263\330\247\333\214\333\214\',\n        prioHigh: \'\330\250\333\225\330\261\330\262\',\n        prioUrgent: \'\330\250\333\225\331\276\333\225\331\204\333\225\',\n        catRoutine: \'\332\225\333\206\330\252\333\214\331\206\',\n        catMedicine: \'\330\257\333\225\330\261\331\205\330\247\331\206\',\n        catDebt: \'\331\202\333\225\330\261\330\262\',\n        catBill: \'\331\276\330\263\331\210\331\210\332\265\333\225\',\n        catExpiry: \'\330\250\333\225\330\263\333\225\330\261\332\206\331\210\331\210\331\206\',\n        catBirthday: \'\332\225\333\206\332\230\333\214 \331\204\333\225\330\257\330\247\333\214\332\251\330\250\331\210\331\210\331\206\',\n        catTask: \'\330\246\333\225\330\261\332\251\',\n        catCustom: \'\330\252\330\247\333\214\330\250\333\225\330\252\',\n        schedulerTitle: \'\332\225\333\214\330\262\333\214 \331\246\331\244 \330\246\330\247\332\257\330\247\330\2