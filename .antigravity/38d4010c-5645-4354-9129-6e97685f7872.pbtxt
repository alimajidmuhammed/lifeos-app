 129; }\n      const p = row + 1 + x * 4;\n      raw[p] = R; raw[p + 1] = G; raw[p + 2] = B; raw[p + 3] = A;\n    }\n  }\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(size, 0);\n  ihdr.writeUInt32BE(size, 4);\n  ihdr[8] = 8; ihdr[9] = 6; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n  const idat = zlib.deflateSync(raw);\n  return Buffer.concat([\n    Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),\n    chunk(\"IHDR\", ihdr),\n    chunk(\"IDAT\", idat),\n    chunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n}\nfs.writeFileSync(\"public/pwa-192x192.png\", makeIcon(192, false));\nfs.writeFileSync(\"public/pwa-512x512.png\", makeIcon(512, false));\nfs.writeFileSync(\"public/pwa-maskable-512x512.png\", makeIcon(512, true));\nfs.writeFileSync(\"public/apple-touch-icon.png\", makeIcon(180, false));\nconsole.log(\"Generated 4 PNG PWA icons\");\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\nfs.mkdirSync(\"public\", { recursive: true });\nfunction crc32(buf) {\n  let c = 0xffffffff;\n  for (let i = 0; i < buf.length; i++) {\n    c ^= buf[i];\n    for (let k = 0; k < 8; k++) c = (c >>> 1) ^ (0xedb88320 & -(c & 1));\n  }\n  return (c ^ 0xffffffff) >>> 0;\n}\nfunction chunk(type, data) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(data.length, 0);\n  const t = Buffer.from(type);\n  const crc = Buffer.alloc(4);\n  crc.writeUInt32BE(crc32(Buffer.concat([t, data])), 0);\n  return Buffer.concat([len, t, data, crc]);\n}\nfunction makeIcon(size, maskable) {\n  const raw = Buffer.alloc((size * 4 + 1) * size);\n  const pad = maskable ? 0.18 : 0.08;\n  const cx = size * 0.62, cy = size * 0.40, r = size * (maskable ? 0.085 : 0.10);\n  const lx1 = size * (pad + 0.20), lx2 = size * (pad + 0.30);\n  const ly1 = size * (pad + 0.16), ly2 = size * (1 - pad - 0.18);\n  const bx2 = size * (1 - pad - 0.18), by1 = size * (1 - pad - 0.28);\n  for (let y = 0; y < size; y++) {\n    const row = y * (size * 4 + 1);\n    raw[row] = 0;\n    for (let x = 0; x < size; x++) {\n      let R = 15, G = 23, B = 42, A = 255; // #0F172A slate background\n      // Subtle emerald border frame\n      const m = size * pad;\n      const inFrame = x >= m && x <= size - m && y >= m && y <= size - m;\n      const border = Math.max(2, size * 0.018);\n      const onEdge = inFrame && (x < m + border || x > size - m - border || y < m + border || y > size - m - border);\n      if (onEdge) { R = 16; G = 185; B = 129; }\n      else if (inFrame) { R = 14; G = 35; B = 46; }\n      // L mark\n      const inVert = x >= lx1 && x <= lx2 && y >= ly1 && y <= ly2;\n      const inHoriz = x >= lx1 && x <= bx2 && y >= by1 && y <= ly2;\n      if (inVert || inHoriz) { R = 248; G = 250; B = 252; }\n      // Emerald orb dot\n      const dx = x - cx, dy = y - cy;\n      if (dx * dx + dy * dy <= r * r) { R = 16; G = 185; B = 129; }\n      const p = row + 1 + x * 4;\n      raw[p] = R; raw[p + 1] = G; raw[p + 2] = B; raw[p + 3] = A;\n    }\n  }\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(size, 0);\n  ihdr.writeUInt32BE(size, 4);\n  ihdr[8] = 8; ihdr[9] = 6; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n  const idat = zlib.deflateSync(raw);\n  return Buffer.concat([\n    Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),\n    chunk(\"IHDR\", ihdr),\n    chunk(\"IDAT\", idat),\n    chunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n}\nfs.writeFileSync(\"public/pwa-192x192.png\", makeIcon(192, false));\nfs.writeFileSync(\"public/pwa-512x512.png\", makeIcon(512, false));\nfs.writeFileSync(\"public/pwa-maskable-512x512.png\", makeIcon(512, true));\nfs.writeFileSync(\"public/apple-touch-icon.png\", makeIcon(180, false));\nconsole.log(\"Generated 4 PNG PWA icons\");\n\'"
    shell_name: "bash"
  }
}
