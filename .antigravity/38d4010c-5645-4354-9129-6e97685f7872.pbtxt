        target_content: "  const handleToggleDay = async (habit: HabitItem, ymd: string) => {\n    try {\n      const res = await toggleHabitDay(habit, ymd);\n      showToast(\n        res.completed\n          ? `Checked in \"${habit.name}\" (${ymd}) \302\267 ${res.stats.currentStreak}d streak.`\n          : `Unchecked \"${habit.name}\" (${ymd}).`,\n        () => {\n          void toggleHabitDay(habit, ymd);\n        },\n        \'Undo\'\n      );\n    } catch (err) {\n      showToast(err instanceof Error ? err.message : \'Could not update habit check-in.\');\n    }\n  };\n\n  const handleDeleteHabit = async (habit: HabitItem) => {\n    try {\n      await deleteHabit(habit);\n      showToast(\n        `Deleted habit \"${habit.name}\".`,\n        () => {\n          void restoreHabit(habit);\n        },\n        \'Undo\'\n      );\n    } catch (err) {\n      showToast(err instanceof Error ? err.message : \'Could not delete habit.\');\n    }\n  };"
        replacement_content: "  const handleToggleDay = async (habit: HabitItem, ymd: string) => {\n    try {\n      const res = await toggleHabitDay(habit, ymd);\n      showToast(\n        res.added\n          ? `Checked in \"${habit.name}\" (${ymd}) \302\267 ${res.currentStreak}d streak.`\n          : `Unchecked \"${habit.name}\" (${ymd}).`,\n        () => {\n          void toggleHabitDay(habit, ymd);\n        }\n      );\n    } catch (err) {\n      showToast(err instanceof Error ? err.message : \'Could not update habit check-in.\');\n    }\n  };\n\n  const handleDeleteHabit = async (habit: HabitItem) => {\n    try {\n      await deleteHabit(habit);\n      showToast(`Deleted habit \"${habit.name}\".`, () => {\n        void restoreHabit(habit);\n      });\n    } catch (err) {\n      showToast(err instanceof Error ? err.message : \'Could not delete habit.\');\n    }\n  };"
