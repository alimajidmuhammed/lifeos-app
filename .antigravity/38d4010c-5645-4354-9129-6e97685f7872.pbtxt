    command_line: "mkdir -p .playwright-cli && playwright-cli open http://localhost:3000 && playwright-cli run-code \'async (page) => {\n  await page.setViewportSize({ width: 1280, height: 860 });\n  await page.goto(\"http://localhost:3000\", { waitUntil: \"domcontentloaded\" });\n  await page.evaluate(() => {\n    localStorage.removeItem(\"lifeos_local_habits_v1\");\n    localStorage.removeItem(\"lifeos_local_habit_logs_v1\");\n    localStorage.removeItem(\"lifeos_local_transactions_v1\");\n    localStorage.removeItem(\"lifeos_local_budgets_v1\");\n    localStorage.removeItem(\"lifeos_local_subscriptions_v1\");\n    localStorage.removeItem(\"lifeos_local_reminders_v1\");\n  });\n  await page.reload({ waitUntil: \"domcontentloaded\" });\n  await page.waitForSelector(\"text=LifeOS\");\n\n  // 1. Habits Tracker\n  await page.getByRole(\"button\", { name: \"Habits\" }).first().click();\n  await page.waitForSelector(\"text=Habits Tracker\");\n  await page.getByRole(\"button\", { name: \"Add Habit\" }).first().click();\n  await page.fill(\"#habit-name-input\", \"Morning Walk 20m\");\n  await page.getByRole(\"button\", { name: \"Save Habit\" }).click();\n  await page.waitForSelector(\"text=Morning Walk 20m\");\n\n  // Check in today + 2 prior days in 7-day strip\n  const toggleGroup = page.getByRole(\"group\", { name: \"Last 7 days for Morning Walk 20m\" });\n  const dayButtons = toggleGroup.locator(\"button\");\n  await dayButtons.nth(4).click();\n  await dayButtons.nth(5).click();\n  await dayButtons.nth(6).click();\n  await page.waitForSelector(\"text=3d streak\");\n  await page.screenshot({ path: \".playwright-cli/p6_habits.png\", fullPage: false });\n\n  // Verify Heatmap & Break Patterns tabs\n  await page.getByRole(\"button\", { name: \"84-Day Heatmap\" }).click();\n  await page.waitForSelector(\"text=84-Day Consistency Heatmap\");\n  await page.getByRole(\"button\", { name: \"Break Patterns\" }).click();\n  await page.waitForSelector(\"text=Weekday Break-Pattern Analysis\");\n\n  // 2. Personal Finance\n  await page.getByRole(\"button\", { name: \"Finance\" }).first().click();\n  await page.waitForSelector(\"text=Personal Finance\");\n\n  // Add Income\n  await page.getByRole(\"button\", { name: \"Add Transaction\" }).first().click();\n  await page.getByRole(\"button\", { name: \"Income\" }).click();\n  await page.fill(\"#tx-amount-input\", \"1500000\");\n  await page.fill(\"#tx-merchant-input\", \"Tech Corp Salary\");\n  await page.getByRole(\"button\", { name: \"Save\" }).click();\n  await page.waitForSelector(\"text=Tech Corp Salary\");\n\n  // Add Expense\n  await page.getByRole(\"button\", { name: \"Add Transaction\" }).first().click();\n  await page.fill(\"#tx-amount-input\", \"45000\");\n  await page.fill(\"#tx-merchant-input\", \"Family Mall\");\n  await page.getByRole(\"button\", { name: \"Save\" }).click();\n  await page.waitForSelector(\"text=Family Mall\");\n\n  // Test CSV Import (multi-currency USD)\n  await page.getByRole(\"button\", { name: \"Import CSV\" }).click();\n  const todayYmd = new Date().toISOString().slice(0, 10);\n  await page.locator(\"textarea\").fill(`date,type,amount,currency,category,account,merchant,note\\n${todayYmd},expense,20,USD,transport,card,Careem,Airport ride`);\n  await page.waitForSelector(\"text=Ready to import: 1 valid rows\");\n  await page.getByRole(\"button\", { name: \"Import 1 Rows\" }).click();\n  await page.waitForSelector(\"text=Careem\");\n  await page.screenshot({ path: \".playwright-cli/p6_finance.png\", fullPage: false });\n\n  // Budgets tab\n  await page.getByRole(\"button\", { name: \"Budgets\" }).click();\n  await page.getByRole(\"button\", { name: \"Set Budget Limit\" }).first().click();\n  await page.fill(\"#budget-limit-input\", \"100000\");\n  await page.getByRole(\"button\", { name: \"Save\" }).click();\n  await page.waitForSelector(\"text=45%\");\n\n  // Subscriptions tab + Remind integration\n  await page.getByRole(\"button\", { name: \"Subscriptions\" }).click();\n  await page.getByRole(\"button\", { name: \"Add Subscription\" }).first().click();\n  await page.fill(\"#sub-name-input\", \"Fiber Internet\");\n  await page.fill(\"#sub-amount-input\", \"45000\");\n  await page.getByRole(\"button\", { name: \"Save\" }).click();\n  await page.waitForSelector(\"text=Fiber Internet\");\n  await page.getByRole(\"button\", { name: \"Remind\" }).click();\n  await page.waitForSelector(\"text=Reminder linked\");\n\n  // 3. Global Search & AI Command Palette\n  await page.getByRole(\"button\", { name: /Ask AI/i }).first().click();\n  await page.waitForSelector(\"text=Global Search & AI Command Palette\");\n  await page.fill(\"#ai-command-input\", \"Family Mall\");\n  await page.waitForSelector(\"text=1 instant local matches\");\n\n  // Verify Privacy Gate block inside palette\n  await page.locator(\"input[type=checkbox]\").first().check();\n  await page.getByRole(\"button\", { name: \"Ask AI Assistant\" }).click();\n  await page.waitForSelector(\"text=Blocked by Privacy Gate\");\n  await page.screenshot({ path: \".playwright-cli/p6_global_search.png\", fullPage: false });\n  await page.getByRole(\"button\", { name: \"Close\" }).click();\n\n  // 4. Home View check\n  await page.getByRole(\"button\", { name: \"Home\" }).first().click();\n  await page.waitForSelector(\"text=Phase 6 \302\267 All 7 Modules & Global AI Search Active\");\n  await page.screenshot({ path: \".playwright-cli/p6_home.png\", fullPage: false });\n\n  // 5. Clean up test data\n  await page.evaluate(() => {\n    localStorage.removeItem(\"lifeos_local_habits_v1\");\n    localStorage.removeItem(\"lifeos_local_habit_logs_v1\");\n    localStorage.removeItem(\"lifeos_local_transactions_v1\");\n    localStorage.removeItem(\"lifeos_local_budgets_v1\");\n    localStorage.removeItem(\"lifeos_local_subscriptions_v1\");\n    localStorage.removeItem(\"lifeos_local_reminders_v1\");\n  });\n  return \"PHASE6_E2E_OK\";\n}\' && playwright-cli console && playwright-cli close"
