              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 2. Hardened Global Primitives"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    function isValidId(id) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    function incoming() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return request.resource.data;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    function existing() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
