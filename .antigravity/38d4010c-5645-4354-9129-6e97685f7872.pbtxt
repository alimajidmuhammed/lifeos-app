      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add vite-plugin-pwa/client to TypeScript types in tsconfig.json.\", \"EndLine\":10, \"Instruction\":\"Add vite-plugin-pwa/client to compilerOptions.types\", \"ReplacementContent\":\"    \\\"types\\\": [\\\"vite/client\\\", \\\"vite-plugin-pwa/client\\\"],\", \"StartLine\":6, \"TargetContent\":\"    \\\"types\\\": [\\\"vite/client\\\"],\", \"TargetFile\":\"/tsconfig.json\", \"toolAction\":\"Adding PWA types to tsconfig.json\", \"toolSummary\":\"Update tsconfig.json\"}"
