            }
            lines {
              text: "    xrefOffsets.push(offset);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const prefix = encoder.encode(`${obj.id} 0 obj\\n`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
