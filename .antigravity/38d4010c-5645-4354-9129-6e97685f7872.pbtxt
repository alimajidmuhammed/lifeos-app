    command_line: "playwright-cli run-code \"async page => {\n  // 1. Add first debt: Karwan Ali, Owed to Me, 450000 IQD\n  await page.getByRole(\'button\', { name: \'Add Debt\' }).first().click();\n  await page.getByPlaceholder(\'e.g. Karwan Ali\').fill(\'Karwan Ali\');\n  await page.getByPlaceholder(\'e.g. 250000\').fill(\'450000\');\n  await page.locator(\'input[type=\\\"date\\\"]\').fill(\'2026-12-05\');\n  await page.getByRole(\'button\', { name: \'Save Debt\' }).click();\n  await page.waitForTimeout(400);\n\n  // 2. Add second debt: Soran Hardware, I Owe, 320 USD, 12% APR, overdue\n  await page.getByRole(\'button\', { name: \'Add Debt\' }).first().click();\n  await page.getByRole(\'button\', { name: \'I Owe\' }).last().click();\n  await page.getByPlaceholder(\'e.g. Karwan Ali\').fill(\'Soran Hardware\');\n  await page.locator(\'select\').first().selectOption(\'USD\');\n  await page.getByPlaceholder(\'e.g. 250000\').fill(\'320\');\n  await page.locator(\'input[type=\\\"number\\\"]\').nth(1).fill(\'12\');\n  await page.locator(\'input[type=\\\"date\\\"]\').fill(\'2026-11-18\');\n  await page.getByRole(\'button\', { name: \'Save Debt\' }).click();\n  await page.waitForTimeout(400);\n\n  // 3. Add third debt: Zainab Hassan, I Owe, 150000 IQD\n  await page.getByRole(\'button\', { name: \'Add Debt\' }).first().click();\n  await page.getByRole(\'button\', { name: \'I Owe\' }).last().click();\n  await page.getByPlaceholder(\'e.g. Karwan Ali\').fill(\'Zainab Hassan\');\n  await page.getByPlaceholder(\'e.g. 250000\').fill(\'150000\');\n  await page.locator(\'input[type=\\\"date\\\"]\').fill(\'2027-01-05\');\n  await page.getByRole(\'button\', { name: \'Save Debt\' }).click();\n  await page.waitForTimeout(400);\n\n  // 4. Log partial payment on Karwan Ali (last row or search)\n  const karwanRow = page.locator(\'div\', { hasText: \'Karwan Ali\' }).filter({ has: page.getByRole(\'button\', { name: \'Log Payment\' }) }).last();\n  await karwanRow.getByRole(\'button\', { name: \'Log Payment\' }).click();\n  await page.locator(\'form input[type=\\\"number\\\"]\').first().fill(\'150000\');\n  await page.getByRole(\'button\', { name: \'Confirm Payment\' }).click();\n  await page.waitForTimeout(400);\n\n  await page.screenshot({ path: \'/tmp/lifeos_debts_ledger.png\', fullPage: true });\n\n  // 5. Open Payoff Plan tab\n  await page.getByRole(\'tab\', { name: \'Payoff Plan\' }).click();\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: \'/tmp/lifeos_debts_planner.png\', fullPage: true });\n\n  // 6. Open Forecast tab\n  await page.getByRole(\'tab\', { name: \'30/60/90d Forecast\' }).click();\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: \'/tmp/lifeos_debts_forecast.png\', fullPage: true });\n\n  // 7. Back to Ledger -> Open Detail Drawer for Karwan Ali\n  await page.getByRole(\'tab\', { name: \'Ledger\' }).click();\n  await page.waitForTimeout(200);\n  await page.getByRole(\'button\', { name: /Karwan Ali/ }).first().click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: \'/tmp/lifeos_debt_drawer.png\' });\n}\" && playwright-cli console && playwright-cli close"
    proposed_command_line: "playwright-cli run-code \"async page => {\n  // 1. Add first debt: Karwan Ali, Owed to Me, 450000 IQD\n  await page.getByRole(\'button\', { name: \'Add Debt\' }).first().click();\n  await page.getByPlaceholder(\'e.g. Karwan Ali\').fill(\'Karwan Ali\');\n  await page.getByPlaceholder(\'e.g. 250000\').fill(\'450000\');\n  await page.locator(\'input[type=\\\"date\\\"]\').fill(\'2026-12-05\');\n  await page.getByRole(\'button\', { name: \'Save Debt\' }).click();\n  await page.waitForTimeout(400);\n\n  // 2. Add second debt: Soran Hardware, I Owe, 320 USD, 12% APR, overdue\n  await page.getByRole(\'button\', { name: \'Add Debt\' }).first().click();\n  await page.getByRole(\'button\', { name: \'I Owe\' }).last().click();\n  await page.getByPlaceholder(\'e.g. Karwan Ali\').fill(\'Soran Hardware\');\n  await page.locator(\'select\').first().selectOption(\'USD\');\n  await page.getByPlaceholder(\'e.g. 250000\').fill(\'320\');\n  await page.locator(\'input[type=\\\"number\\\"]\').nth(1).fill(\'12\');\n  await page.locator(\'input[type=\\\"date\\\"]\').fill(\'2026-11-18\');\n  await page.getByRole(\'button\', { name: \'Save Debt\' }).click();\n  await page.waitForTimeout(400);\n\n  // 3. Add third debt: Zainab Hassan, I Owe, 150000 IQD\n  await page.getByRole(\'button\', { name: \'Add Debt\' }).first().click();\n  await page.getByRole(\'button\', { name: \'I Owe\' }).last().click();\n  await page.getByPlaceholder(\'e.g. Karwan Ali\').fill(\'Zainab Hassan\');\n  await page.getByPlaceholder(\'e.g. 250000\').fill(\'150000\');\n  await page.locator(\'input[type=\\\"date\\\"]\').fill(\'2027-01-05\');\n  await page.getByRole(\'button\', { name: \'Save Debt\' }).click();\n  await page.waitForTimeout(400);\n\n  // 4. Log partial payment on Karwan Ali (last row or search)\n  const karwanRow = page.locator(\'div\', { hasText: \'Karwan Ali\' }).filter({ has: page.getByRole(\'button\', { name: \'Log Payment\' }) }).last();\n  await karwanRow.getByRole(\'button\