      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Import FunctionDeclaration in server.ts, type WORKSPACE_FUNCTION_DECLARATIONS cleanly, and align finance account enum with Iraqi accounts\", \"Instruction\":\"Import FunctionDeclaration, type WORKSPACE_FUNCTION_DECLARATIONS, and align account enum to cash/bank/zaincash/fib/fastpay/card\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":8, \"ReplacementContent\":\"import { GoogleGenAI, Type, type FunctionDeclaration } from \'@google/genai\';\", \"StartLine\":5, \"TargetContent\":\"import { GoogleGenAI, Type } from \'@google/genai\';\"}, {\"AllowMultiple\":false, \"EndLine\":1005, \"ReplacementContent\":\"    occurredOn: z.string().regex(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/),\\n    account: z.enum([\'cash\', \'bank\', \'zaincash\', \'fib\', \'fastpay\', \'card\']).default(\'cash\'),\\n    merchant: z.string().max(120).nullable().optional().default(null),\\n    note: z.string().max(500).nullable().optional().default(null),\\n  });\\n\\n  app.post(\'/api/ai/finance/parse\', async (req, res) => {\\n    const ip = req.ip || \'local\';\\n    if (!checkRateLimit(ip)) {\\n      res.status(429).json({ error: \'Rate limit exceeded. Please wait a minute.\', code: \'RATE_LIMITED\' });\\n      return;\\n    }\\n\\n    const parsed = financeParseReqSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: \'Invalid finance parse input.\', code: \'INVALID_PAYLOAD\' });\\n      return;\\n    }\\n\\n    const payload = parsed.data;\\n    const gate = evaluatePrivacyGate({\\n      freeTier: AI_RUNTIME_CONFIG.freeTier,\\n      module: \'finance\',\\n      text: payload.text,\\n    });\\n    if (!gate.allowed) {\\n      res.status(403).json({ error: gate.reason, code: gate.code, privacyBlocked: true });\\n      return;\\n    }\\n\\n    const ai = getGenAIClient();\\n    if (!ai) {\\n      res.status(503).json({\\n        error: \'AI provider is not configured on the server. Enter the transaction manually offline.\',\\n        code: \'AI_UNAVAILABLE\',\\n      });\\n      return;\\n    }\\n\\n    const systemInstruction = [\\n      \'Extract a structured personal finance transaction draft from natural language in English, Arabic, or Kurdish Sorani.\',\\n      `Today is ${payload.todayYmd}. Default currency if omitted is ${payload.defaultCurrency}.`,\\n      \'Set type=\\\"income\\\" for salary, freelance payment, gift received, or business revenue; set type=\\\"expense\\\" for purchases, bills, groceries, transport, rent, subscriptions.\',\\n      \'Choose category from: salary, freelance, business, gift, housing, food, transport, utilities, health, shopping, subscriptions, education, entertainment, debt_payment, savings, other.\',\\n      \'Choose account from: cash, bank, zaincash, fib, fastpay, card.\',\", \"StartLine\":955, \"TargetContent\":\"    occurredOn: z.string().regex(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/),\\n    account: z.enum([\'cash\', \'bank\', \'card\', \'wallet\', \'other\']).default(\'cash\'),\\n    merchant: z.string().max(120).nullable().optional().default(null),\\n    note: z.string().max(500).nullable().optional().default(null),\\n  });\\n\\n  app.post(\'/api/ai/finance/parse\', async (req, res) => {\\n    const ip = req.ip || \'local\';\\n    if (!checkRateLimit(ip)) {\\n      res.status(429).json({ error: \'Rate limit exceeded. Please wait a minute.\', code: \'RATE_LIMITED\' });\\n      return;\\n    }\\n\\n    const parsed = financeParseReqSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: \'Invalid finance parse input.\', code: \'INVALID_PAYLOAD\' });\\n      return;\\n    }\\n\\n    const payload = parsed.data;\\n    const gate = evaluatePrivacyGate({\\n      freeTier: AI_RUNTIME_CONFIG.freeTier,\\n      module: \'finance\',\\n      text: payload.text,\\n    });\\n    if (!gate.allowed) {\\n      res.status(403).json({ error: gate.reason, code: gate.code, privacyBlocked: true });\\n      return;\\n    }\\n\\n    const ai = getGenAIClient();\\n    if (!ai) {\\n      res.status(503).json({\\n        error: \'AI provider is not configured on the server. Enter the transaction manually offline.\',\\n        code: \'AI_UNAVAILABLE\',\\n      });\\n      return;\\n    }\\n\\n    const systemInstruction = [\\n      \'Extract a structured personal finance transaction draft from natural language in English, Arabic, or Kurdish Sorani.\',\\n      `Today is ${payload.todayYmd}. Default currency if omitted is ${payload.defaultCurrency}.`,\\n      \'Set type=\\\"income\\\" for salary, freelance payment, gift received, or business revenue; set type=\\\"expense\\\" for purchases, bills, groceries, transport, rent, subscriptions.\',\\n      \'Choose category from: salary, freelance, business, gift, housing, food, transport, utilities, health, shopping, subscriptions, education, entertainment, debt_payment, savings, other.\',\\n      \'Choose account from: cash, bank, card, wallet, other.\',\"}, {\"AllowMultiple\":false, \"EndLine\":1095, \"ReplacementContent\":\"  const WORKSPACE_FUNCTION_DECLARATIONS: FunctionDeclaration[] = [\", \"StartLine\":1080, \"TargetContent\":\"  const WORKSPACE_FUNCTION_DECLARATIONS = [\"}], \"TargetFile\":\"/server.ts\", \"toolAction\":\"Fixing FunctionDeclaration typing in server.ts\", \"toolSummary\":\"Fix server.ts FunctionDeclaration typing & account enum\"}"
