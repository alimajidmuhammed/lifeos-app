      full: "function cleanUrl(pathname) {\tconst url = new URL(pathname, \"http://vite.dev\");\turl.searchParams.delete(\"direct\");\treturn url.pathname + url.search;}let isFirstUpdate = true;const outdatedLinkTags = /* @__PURE__ */ new WeakSet();const debounceReload = (time) => {\tlet timer;\treturn () => {\t\tif (timer) {\t\t\tclearTimeout(timer);\t\t\ttimer = null;\t\t}\t\ttimer = setTimeout(() => {\t\t\tlocation.reload();\t\t}, time);\t};};const pageReload = debounceReload(20);const hmrClient = new HMRClient({\terror: (err) => console.error(\"[vite]\", err),\tdebug: (...msg) => console.debug(\"[vite]\", ...msg)}, transport, async function importUpdatedModule({ acceptedPath, timestamp, explicitImportRequired, isWithinCircularImport }) {\tconst [acceptedPathWithoutQuery, query] = acceptedPath.split(`?`);\tconst importPromise = import(\t\t/* @vite-ignore */\t\tmoduleUrlToBrowserUrl(`${acceptedPathWithoutQuery}?${explicitImportRequired ? \"import&\" : \"\"}t=${timestamp}${query ? `&${query}` : \"\"}`, base));\tif (isWithinCircularImport) importPromise.catch(() => {\t\tconsole.info(`[hmr] ${acceptedPath} failed to apply HMR as it\'s within a circular import. Reloading page to reset the execution order. To debug and break the circular import, you can run \\`vite --debug hmr\\` to log the circular dependency path if a file change triggered it.`);\t\tpageReload();\t});\treturn await importPromise;});let bundledDevClient;transport.connect(createHMRHandler(handleMessage));setupForwardConsoleHandler(transport, forwardConsole);function clearOverlayOrReloadOnFirstUpdate() {\tif (hasDocument) {\t\tif (isFirstUpdate && hasErrorOverlay()) {\t\t\tlocation.reload();\t\t\treturn \"reload\";\t\t}\t\tif (enableOverlay) clearErrorOverlay();\t\tisFirstUpdate = false;\t}\treturn \"continue\";}async function handleMessage(payload) {\tconst activeHmrClient = hmrClient;\tswitch (payload.type) {\t\tcase \"connected\":\t\t\tconsole.debug(`[vite] connected.`);\t\t\tbreak;\t\tcase \"bundled-dev-update\":\t\t\tbundledDevClient.handlePush(payload);\t\t\tbreak;\t\tcase \"update\":\t\t\tawait activeHmrClient.notifyListeners(\"vite:beforeUpdate\", payload);\t\t\tif (clearOverlayOrReloadOnFirstUpdate() === \"reload\") return;\t\t\tawait Promise.all(payload.updates.map(async (update) => {\t\t\t\tif (update.type === \"js-update\") return hmrClient.queueUpdate(update);\t\t\t\tconst { path, timestamp } = update;\t\t\t\tconst searchUrl = cleanUrl(path);\t\t\t\tconst el = Array.from(document.querySelectorAll(\"link\")).find((e) => !outdatedLinkTags.has(e) && cleanUrl(e.href).includes(searchUrl));\t\t\t\tif (!el) return;\t\t\t\tconst browserUrl = moduleUrlToBrowserUrl(`${searchUrl}${searchUrl.includes(\"?\") ? \"&\" : \"?\"}t=${timestamp}`, base);\t\t\t\treturn new Promise((resolve) => {\t\t\t\t\tconst newLinkTag = el.cloneNode();\t\t\t\t\tnewLinkTag.href = new URL(browserUrl, el.href).href;\t\t\t\t\tconst removeOldEl = () => {\t\t\t\t\t\tel.remove();\t\t\t\t\t\tconsole.debug(`[vite] css hot updated: ${searchUrl}`);\t\t\t\t\t\tresolve();\t\t\t\t\t};\t\t\t\t\tnewLinkTag.addEventListener(\"load\", removeOldEl);\t\t\t\t\tnewLinkTag.addEventListener(\"error\", removeOldEl);\t\t\t\t\toutdatedLinkTags.add(el);\t\t\t\t\tel.after(newLinkTag);\t\t\t\t});\t\t\t}));\t\t\tawait activeHmrClient.notifyListeners(\"vite:afterUpdate\", payload);\t\t\tbreak;\t\tcase \"custom\":\t\t\tawait activeHmrClient.notifyListeners(payload.event, payload.data);\t\t\tif (payload.event === \"vite:ws:disconnect\") {\t\t\t\tif (hasDocument && !willUnload) {\t\t\t\t\tconsole.log(`[vite] server connection lost. Polling for restart...`);\t\t\t\t\tconst socket = payload.data.webSocket;\t\t\t\t\tconst url = new URL(socket.url);"
