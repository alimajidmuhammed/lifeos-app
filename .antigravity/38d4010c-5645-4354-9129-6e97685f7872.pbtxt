erySelector(\'select\'), \'USD\');\n  setVal(in2[4], \'2026-11-01\');\n  setVal(in2[5], \'18\');\n  clickText(\'[role=dialog] button[type=submit]\', \'Save Debt\');\n  await wait(300);\n\n  // Log partial payment of 50,000 IQD on Omar Ali\n  const logBtns = Array.from(document.querySelectorAll(\'button\')).filter(b => b.textContent?.includes(\'Log Payment\'));\n  logBtns[1]?.click(); // Omar Ali is second (newest first)\n  await wait(200);\n  const payDialog = document.querySelector(\'[role=dialog]\');\n  const payInput = payDialog.querySelector(\'input[type=number]\');\n  setVal(payInput, \'50000\');\n  setVal(payDialog.querySelector(\'select\'), \'zaincash\');\n  clickText(\'[role=dialog] button[type=submit]\', \'Record Payment\');\n  await wait(300);\n\n  // Verify Payoff Plan tab renders\n  clickText(\'[role=tab]\', \'Payoff Plan\');\n  await wait(200);\n  const plannerText = document.querySelector(\'main\')?.textContent?.includes(\'Bank Credit Line\');\n\n  // Verify Forecast tab renders\n  clickText(\'[role=tab]\', \'30/60/90d Forecast\');\n  await wait(200);\n  const forecastText = document.querySelector(\'main\')?.textContent?.includes(\'Overdue Now\');\n\n  // Verify People tab renders\n  clickText(\'[role=tab]\', \'People\');\n  await wait(200);\n  const peopleText = document.querySelector(\'main\')?.textContent?.includes(\'Reliability: 100% on-time\');\n\n  // Back to Ledger\n  clickText(\'[role=tab]\', \'Ledger\');\n  await wait(200);\n  const ledgerHasUpdated = document.querySelector(\'main\')?.textContent?.includes(\'200,000 IQD\');\n\n  return { h1, plannerText, forecastText, peopleText, ledgerHasUpdated };\n})()\n\" && playwright-cli screenshot --filename=/tmp/debts_desktop.png && playwright-cli resize 390 844 && sleep 1 && playwright-cli eval \"({ scrollWidth: document.documentElement.scrollWidth, clientWidth: document.documentElement.clientWidth, overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth })\" && playwrigh