47\330\261\333\214\330\257\333\225\330\257\333\225\330\261\333\214 AI \331\207\333\225\330\261\332\257\333\214\330\262 \330\250\333\225 \330\250\333\216\330\257\333\225\331\206\332\257\333\214 \330\262\330\247\331\206\333\214\330\247\330\261\333\214 \331\206\330\247\332\257\333\206\332\225\333\216\330\252. \331\276\333\216\330\264 \330\254\333\216\330\250\333\225\330\254\333\216\332\251\330\261\330\257\331\206 \331\276\333\216\330\257\330\247\332\206\331\210\331\210\331\206\333\225\331\210\333\225 \330\250\332\251\333\225.\',\\n        confirmedFeedback: \'\332\251\330\261\330\257\330\247\330\261\333\225\332\251\333\225 \331\204\333\225 \331\276\333\216\330\264\330\250\333\214\331\206\333\214\331\206\333\214 \331\202\333\206\331\206\330\247\330\272\333\214 \331\241 \331\276\333\225\330\263\333\225\331\206\330\257 \332\251\330\261\330\247.\',\\n        disabledNotice: \'\333\214\330\247\330\261\333\214\330\257\333\225\330\257\333\225\330\261\333\214 AI \331\204\333\225 \332\225\333\216\332\251\330\256\330\263\330\252\331\206\333\225\332\251\330\247\331\206\330\257\330\247 \331\206\330\247\332\206\330\247\331\204\330\247\332\251 \332\251\330\261\330\247\331\210\333\225. \331\207\333\225\331\205\331\210\331\210 \330\246\330\247\331\205\330\261\330\247\330\262\333\225 \331\206\330\247\331\210\330\256\333\206\333\214\333\214\333\225\332\251\330\247\331\206 \332\251\330\247\330\261 \330\257\333\225\332\251\333\225\331\206.\',\\n      },\\n      lock: {\\n        title: \'\330\246\333\225\331\276\333\225\332\251\333\225 \331\202\331\201\332\265 \332\251\330\261\330\247\331\210\333\225\',\\n        subtitle: \'\332\251\333\206\330\257\333\214 PIN \330\250\331\206\331\210\331\210\330\263\333\225 \330\250\333\206 \332\251\330\261\330\257\331\206\333\225\331\210\333\225\333\214 \330\264\331\210\333\216\331\206\333\214 \332\251\330\247\330\261\333\225\332\251\333\225\330\252.\',\\n        unlockBtn: \'\332\251\330\261\330\257\331\206\333\225\331\210\333\225\333\214 \330\246\333\225\331\276\',\\n        wrongPin: \'\332\251\333\206\330\257\333\214 PIN \331\207\333\225\332\265\333\225\333\214\333\225. \330\252\332\251\330\247\333\214\333\225 \330\257\331\210\331\210\330\250\330\247\330\261\333\225 \331\207\333\225\331\210\332\265 \330\250\330\257\333\225\330\261\333\225\331\210\333\225.\',\\n      },\\n    },\\n  },\\n};\\n\\nexport function applyDocumentLocale(locale: SupportedLocale): void {\\n  if (typeof document !== \'undefined\') {\\n    document.documentElement.lang = locale;\\n    document.documentElement.dir = isRtlLocale(locale) ? \'rtl\' : \'ltr\';\\n  }\\n  try {\\n    localStorage.setItem(\'lifeos_lang\', locale);\\n  } catch {\\n    // Ignore storage unavailability\\n  }\\n}\\n\\nconst initialLocale: SupportedLocale = (() => {\\n  try {\\n    const saved = localStorage.getItem(\'lifeos_lang\');\\n    if (saved === \'en\' || saved === \'ar\' || saved === \'ckb\') return saved;\\n  } catch {\\n    // Ignore\\n  }\\n  return \'en\';\\n})();\\n\\ni18n.use(initReactI18next).init({\\n  resources,\\n  lng: initialLocale,\\n  fallbackLng: \'en\',\\n  interpolation: {\\n    escapeValue: false,\\n  },\\n});\\n\\napplyDocumentLocale(initialLocale);\\n\\nexport default i18n;\\n\", \"Description\":\"Create tri-lingual i18next configuration supporting English, Arabic (RTL), and Kurdish Sorani (RTL) with automatic document dir synchronization.\", \"Overwrite\":true, \"TargetFile\":\"/src/core/i18n/i18n.ts\", \"toolAction\":\"Creating tri-lingual RTL i18n setup\", \"toolSummary\":\"Create i18n setup\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_7975067746906603235"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { z } from \'zod\';\\nimport {\\n  computePromptCacheKey,\\n  evaluatePrivacyGate,\\n  type LifeOSModuleId,\\n} from \'./privacyGate\';\\nimport type { SupportedLocale } from \'../currency/currency\';\\n\\nexport interface AIRequestPayload {\\n  module: LifeOSModuleId;\\n  taskType: \'briefing\' | \'parse\' | \'explain\' | \'draft\' | \'classify\';\\n  text: string;\\n  locale: SupportedLocale;\\n  hasAttachmentImage?: boolean;\\n  containsLockedOrE2E?: boolean;\\n  containsVaultSensitiveDoc?: boolean;\\n  tier?: \'primary\' | \'lite\';\\n}\\n\\nexport const SuggestedActionSchema = z.object({\\n  requiresConfirmation: z.boolean(),\\n  module: z.enum([\'debts\', \'reminders\', \'planner\', \'notes\', \'habits\', \'finance\', \'none\']),\\n  actionType: z.string(),\\n  title: z.string(),\\n  details: z.string(),\\n});\\n\\nexport const AIResponseDataSchema = z.object({\\n  summary: z.string(),\\n  suggestedAction: SuggestedActionSchema.nullable().optional().default(null),\\n  safetyNote: z.string().nullable().optional().default(null),\\n});\\n\\nexport type AIResponseData = z.infer<typeof AIResponseDataSchema>;\\n\\nexport interface AIExecutionMeta {\\n  modelUsed: string;\\n  promptVersion: string;\\n  latencyMs: number;\\n  freeTier: boolean;\\n  cached: boolean;\\n  inputTokensEst: number;\\n  outputTokensEst: number;\\n}\\n\\nexport type AIResult =\\n  | {\\n      ok: true;\\n      data: AIResponseData;\\n      meta: AIExecutionMeta;\\n    }\\n  | {\\n      ok: false;\\n      privacyBlocked?: boolean;\\n      code: string;\\n      error: string;\\n    };\\n\\nexport interface AIRuntimeStatus {\\n  provider: string;\\n  primaryModel: string;\\n  liteModel: string;\\n  freeTier: boolean;\\n  promptVersion: string;\\n  configured: boolean;\\n}\\n\\n/**\\n * Provider-agnostic AI interface so Stage 1 can swap from Firebase AI Logic / Express proxy\\n * to Cloud Functions (Vertex AI / Claude / OpenAI) with zero UI changes.\\n */\\nexport interface LLMProvider {\\n  getRuntimeStatus(): Promise<AIRuntimeStatus>;\\n  complete(payload: AIRequestPayload, freeTier: boolean): Promise<AIResult>;\\n}\\n\\nconst memoryCache = new Map<string, { data: AIResponseData; meta: AIExecutionMeta; expiresAt: number }>();\\nconst CACHE_TTL_MS = 10 * 60 * 1000;\\n\\nexport class ServerProxyLLMProvider implements LLMProvider {\\n  async getRuntimeStatus(): Promise<AIRuntimeStatus> {\\n    try {\\n      const res = await fetch(\'/api/ai/config\');\\n      if (!res.ok) throw new Error(\'Failed to fetch AI config\');\\n      return (await res.json()) as AIRuntimeStatus;\\n    } catch {\\n      return {\\n        provider: \'offline-fallback\',\\n        primaryModel: \'gemini-4-hydrogen\',\\n        liteModel: \'gemini-3.1-flash-lite\',\\n        freeTier: true,\\n        promptVersion: \'lifeos-v1.0\',\\n        configured: false,\\n      };\\n    }\\n  }\\n\\n  async complete(payload: AIRequestPayload, freeTier: boolean): Promise<AIResult> {\\n    // 1. Client-side Privacy Gate pre-flight (prevents sensitive bytes from even leaving browser)\\n    const gate = evaluatePrivacyGate({\\n      freeTier,\\n      module: payload.module,\\n      text: payload.text,\\n      hasAttachmentImage: payload.hasAttachmentImage,\\n      containsLockedOrE2E: payload.containsLockedOrE2E,\\n      containsVaultSensitiveDoc: payload.containsVaultSensitiveDoc,\\n    });\\n\\n    if (!gate.allowed) {\\n      return {\\n        ok: false,\\n        privacyBlocked: true,\\n        code: gate.code,\\n        error: gate.reason,\\n      };\\n    }\\n\\n    // 2. Offline check\\n    if (typeof navigator !== \'undefined\' && !navigator.onLine) {\\n      return {\\n        ok: false,\\n        code: \'OFFLINE\',\\n        error: \'You are currently offline. Cloud AI is paused while all offline LifeOS features stay available.\',\\n      };\\n    }\\n\\n    // 3. Deterministic prompt cache lookup\\n    const cacheKey = computePromptCacheKey([\\n      \'lifeos-v1.0\',\\n      payload.locale,\\n      payload.module,\\n      payload.taskType,\\n      payload.tier ?? \'primary\',\\n      payload.text.trim(),\\n    ]);\\n    const hit = memoryCache.get(cacheKey);\\n    if (hit && hit.expiresAt > Date.now()) {\\n      return {\\n        ok: true,\\n        data: hit.data,\\n        meta: { ...hit.meta, cached: true, latencyMs: 1 },\\n      };\\n    }\\n\\n    // 4. Network request with exponential backoff on 429\\n    let attempt = 0;\\n    const maxAttempts = 2;\\n\\n    while (attempt < maxAttempts) {\\n      attempt += 1;\\n      try {\\n        const response = await fetch(\'/api/ai/complete\', {\\n          method: \'POST\',\\n          headers: { \'Content-Type\': \'application/json\' },\\n          body: JSON.stringify(payload),\\n        });\\n\\n        const body = (await response.json()) as Record<string, unknown>;\\n\\n        if (response.status === 429 && attempt < maxAttempts) {\\n          await new Promise((r) => setTimeout(r, 600 * attempt));\\n          continue;\\n        }\\n\\n        if (!response.ok) {\\n          return {\\n            ok: false,\\n            privacyBlocked: Boolean(body.privacyBlocked),\\n            code: String(body.code ?? \'HTTP_ERROR\'),\\n            error: String(body.error ?? \'AI request failed.\'),\\n          };\\n        }\\n\\n        const parsed = AIResponseDataSchema.safeParse(body.data);\\n        if (!parsed.success) {\\n          return {\\n            ok: false,\\n            code: \'INVALID_AI_SCHEMA\',\\n            error: \'Received malformed structured output from AI provider.\',\\n          };\\n        }\\n\\n        const metaObj = (body.meta ?? {}) as Record<string, unknown>;\\n        const meta: AIExecutionMeta = {\\n          modelUsed: String(metaObj.modelUsed ?? \'gemini-4-hydrogen\'),\\n          promptVersion: String(metaObj.promptVersion ?? \'lifeos-v1.0\'),\\n          latencyMs: Number(metaObj.latencyMs ?? 0),\\n          freeTier: Boolean(metaObj.freeTier ?? freeTier),\\n          cached: false,\\n          inputTokensEst: Number(metaObj.inputTokensEst ?? 0),\\n          outputTokensEst: Number(metaObj.outputTokensEst ?? 0),\\n        };\\n\\n        memoryCache.set(cacheKey, {\\n          data: parsed.data,\\n          meta,\\n          expiresAt: Date.now() + CACHE_TTL_MS,\\n        });\\n\\n        return { ok: true, data: parsed.data, meta };\\n      } catch {\\n        if (attempt >= maxAttempts) {\\n          return {\\n            ok: false,\\n            code: \'NETWORK_ERROR\',\\n            error: \'Unable to reach LifeOS AI service. Non-AI tools remain fully functional.\',\\n          };\\n        }\\n      }\\n    }\\n\\n    return {\\n      ok: false,\\n      code: \'AI_UNAVAILABLE\',\\n      error: \'AI service temporarily unavailable.\',\\n    };\\n  }\\n}\\n\\nexport const defaultLLMProvider: LLMProvider = new ServerProxyLLMProvider();\\n\", \"Description\":\"Create provider-agnostic LLMProvider interface and ServerProxyLLMProvider with Privacy Gate pre-flight, caching, retry backoff, and Zod validation.\", \"Overwrite\":true, \"TargetFile\":\"/src/core/ai/llmProvider.ts\", \"toolAction\":\"Creating provider-agnostic LLMProvider\", \"toolSummary\":\"Create LLMProvider\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_7975067746906599430"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { initializeApp } from \'firebase/app\';\\nimport { getAuth } from \'firebase/auth\';\\nimport {\\n  doc,\\n  getDocFromServer,\\n  getFirestore,\\n  initializeFirestore,\\n  persistentLocalCache,\\n  persistentMultipleTabManager,\\n  type Firestore,\\n} from \'firebase/firestore\';\\nimport firebaseConfig from \'../../../firebase-applet-config.json\';\\n\\nexport enum OperationType {\\n  CREATE = \'create\',\\n  UPDATE = \'update\',\\n  DELETE = \'delete\',\\n  LIST = \'list\',\\n  GET = \'get\',\\n  WRITE = \'write\',\\n}\\n\\nexport interface FirestoreErrorInfo {\\n  error: string;\\n  operationType: OperationType;\\n  path: string | null;\\n  authInfo: {\\n    userId?: string | null;\\n    email?: string | null;\\n    emailVerified?: boolean | null;\\n    isAnonymous?: boolean | null;\\n    tenantId?: string | null;\\n    providerInfo?: {\\n      providerId?: string | null;\\n      email?: string | null;\\n    }[];\\n  };\\n}\\n\\nexport const firebaseApp = initializeApp(firebaseConfig);\\nexport const auth = getAuth(firebaseApp);\\n\\n// Initialize Firestore with multi-tab IndexedDB offline persistence (the sync engine)\\nfunction createOfflineFirstFirestore(): Firestore {\\n  try {\\n    return initializeFirestore(\\n      firebaseApp,\\n      {\\n        localCache: persistentLocalCache({\\n          tabManager: persistentMultipleTabManager(),\\n        }),\\n      },\\n      firebaseConfig.firestoreDatabaseId\\n    );\\n  } catch {\\n    return getFirestore(firebaseApp, firebaseConfig.firestoreDatabaseId);\\n  }\\n}\\n\\nexport const db = createOfflineFirstFirestore();\\n\\nexport function handleFirestoreError(\\n  error: unknown,\\n  operationType: OperationType,\\n  path: string | null\\n): never {\\n  const errInfo: FirestoreErrorInfo = {\\n    error: error instanceof Error ? error.message : String(error),\\n    authInfo: {\\n      userId: auth.currentUser?.uid,\\n      email: auth.currentUser?.email,\\n      emailVerified: auth.currentUser?.emailVerified,\\n      isAnonymous: auth.currentUser?.isAnonymous,\\n      tenantId: auth.currentUser?.tenantId,\\n      providerInfo:\\n        auth.currentUser?.providerData?.map((provider) => ({\\n          providerId: provider.providerId,\\n          email: provider.email,\\n        })) || [],\\n    },\\n    operationType,\\n    path,\\n  };\\n  console.error(\'Firestore Error: \', JSON.stringify(errInfo));\\n  throw new Error(JSON.stringify(errInfo));\\n}\\n\\n// Startup connectivity verification per Firebase integration guidelines\\nlet connectionChecked = false;\\nexport async function testFirestoreConnection(): Promise<boolean> {\\n  if (connectionChecked) return true;\\n  connectionChecked = true;\\n  try {\\n    await getDocFromServer(doc(db, \'test\', \'connection\'));\\n    return true;\\n  } catch (error) {\\n    if (error instanceof Error && error.message.includes(\'the client is offline\')) {\\n      console.error(\'Please check your Firebase configuration \342\200\224 Firestore client reports offline.\');\\n      return false;\\n    }\\n    // Permission denied on /test/connection confirms Firestore server is reachable and Rules are enforced!\\n    return true;\\n  }\\n}\\n\", \"Description\":\"Initialize Firebase JS SDK with Firestore persistentLocalCache, startup connection validation, and structured Firestore error handler.\", \"Overwrite\":true, \"TargetFile\":\"/src/data/firebase/firebaseClient.ts\", \"toolAction\":\"Creating Firebase web client adapter\", \"toolSummary\":\"Create Firebase web client\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_7975067746906599721"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { UserProfileData } from \'../../core/schemas/userProfileSchema\';\\nimport type { PlanEntitlements } from \'../../core/entitlements/entitlements\';\\n\\nexport interface AuthUserSummary {\\n  uid: string;\\n  displayName: string;\\n  email: string | null;\\n  emailVerified: boolean;\\n  photoURL: string | null;\\n}\\n\\nexport interface AuthRepository {\\n  onAuthStateChanged(callback: (user: AuthUserSummary | null) => void): () => void;\\n  signInWithGoogle(): Promise<AuthUserSummary>;\\n  signInWithApple(): Promise<AuthUserSummary>;\\n  signOut(): Promise<void>;\\n}\\n\\nexport interface UserProfileRepository {\\n  subscribeProfile(\\n    uid: string,\\n    onData: (profile: UserProfileData) => void,\\n    onError?: (err: Error) => void\\n  ): () => void;\\n  ensureProfile(user: AuthUserSummary): Promise<UserProfileData>;\\n  updateProfile(uid: string, current: UserProfileData, patch: Partial<UserProfileData>): Promise<void>;\\n  subscribeEntitlements(\\n    uid: string,\\n    onData: (entitlements: PlanEntitlements) => void\\n  ): () => void;\\n}\\n\\nexport interface AiUsageRecord {\\n  dayKey: string;\\n  requestCount: number;\\n  inputTokensEst: number;\\n  outputTokensEst: number;\\n}\\n\\nexport interface AiUsageRepository {\\n  subscribeTodayUsage(uid: string, dayKey: string, onData: (usage: AiUsageRecord) => void): () => void;\\n  recordUsage(\\n    uid: string,\\n    dayKey: string,\\n    current: AiUsageRecord | null,\\n    inputTokensEst: number,\\n    outputTokensEst: number\\n  ): Promise<void>;\\n}\\n\\nexport interface LocalVaultEntryMeta {\\n  id: string;\\n  name: string;\\n  mimeType: string;\\n  sizeBytes: number;\\n  isEncrypted: boolean;\\n  savedAt: string;\\n}\\n\\nexport interface LocalVaultStorageAdapter {\\n  listLocalEntries(): Promise<LocalVaultEntryMeta[]>;\\n  saveLocalEntry(meta: LocalVaultEntryMeta, payload: string): Promise<void>;\\n  removeLocalEntry(id: string): Promise<void>;\\n}\\n\", \"Description\":\"Define platform-agnostic repository interfaces so UI and hooks remain decoupled from Firebase SDK and Expo-portable.\", \"Overwrite\":true, \"TargetFile\":\"/src/data/repositories/interfaces.ts\", \"toolAction\":\"Creating repository interfaces\", \"toolSummary\":\"Create repository interfaces\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_7975067746906600012"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  GoogleAuthProvider,\\n  onAuthStateChanged as fbOnAuthStateChanged,\\n  signInWithPopup,\\n  signOut as fbSignOut,\\n  type User,\\n} from \'firebase/auth\';\\nimport {\\n  doc,\\n  getDoc,\\n  onSnapshot,\\n  serverTimestamp,\\n  setDoc,\\n  updateDoc,\\n} from \'firebase/firestore\';\\nimport {\\n  auth,\\n  db,\\n  handleFirestoreError,\\n  OperationType,\\n} from \'../firebase/firebaseClient\';\\nimport {\\n  createDefaultUserProfile,\\n  UserProfileSchema,\\n  type UserProfileData,\\n} from \'../../core/schemas/userProfileSchema\';\\nimport {\\n  DEFAULT_FEATURE_FLAGS,\\n  PLAN_CATALOG,\\n  type PlanEntitlements,\\n  type PlanTier,\\n} from \'../../core/entitlements/entitlements\';\\nimport type {\\n  AiUsageRecord,\\n  AiUsageRepository,\\n  AuthRepository,\\n  AuthUserSummary,\\n  LocalVaultEntryMeta,\\n  LocalVaultStorageAdapter,\\n  UserProfileRepository,\\n} from \'./interfaces\';\\n\\nfunction mapFirebaseUser(user: User): AuthUserSummary {\\n  return {\\n    uid: user.uid,\\n    displayName: user.displayName || user.email?.split(\'@\')[0] || \'LifeOS User\',\\n    email: user.email,\\n    emailVerified: user.emailVerified,\\n    photoURL: user.photoURL,\\n  };\\n}\\n\\nexport class FirebaseWebAuthRepository implements AuthRepository {\\n  onAuthStateChanged(callback: (user: AuthUserSummary | null) => void): () => void {\\n    return fbOnAuthStateChanged(auth, (fbUser) => {\\n      callback(fbUser ? mapFirebaseUser(fbUser) : null);\\n    });\\n  }\\n\\n  async signInWithGoogle(): Promise<AuthUserSummary> {\\n    const provider = new GoogleAuthProvider();\\n    provider.setCustomParameters({ prompt: \'select_account\' });\\n    const credential = await signInWithPopup(auth, provider);\\n    return mapFirebaseUser(credential.user);\\n  }\\n\\n  async signInWithApple(): Promise<AuthUserSummary> {\\n    if (!DEFAULT_FEATURE_FLAGS[\'auth.apple.enabled\']) {\\n      throw new Error(\\n        \'Sign in with Apple is disabled behind feature flag auth.apple.enabled=false during Stage 0. Enable after configuring Apple Developer Services ID and Firebase Auth.\'\\n      );\\n    }\\n    throw new Error(\'Apple Sign-In provider is not yet configured.\');\\n  }\\n\\n  async signOut(): Promise<void> {\\n    await fbSignOut(auth);\\n  }\\n}\\n\\nexport class FirebaseWebUserProfileRepository implements UserProfileRepository {\\n  subscribeProfile(\\n    uid: string,\\n    onData: (profile: UserProfileData) => void,\\n    onError?: (err: Error) => void\\n  ): () => void {\\n    const path = `users/${uid}`;\\n    const ref = doc(db, \'users\', uid);\\n    return onSnapshot(\\n      ref,\\n      (snap) => {\\n        if (!snap.exists()) return;\\n        const raw = snap.data();\\n        const parsed = UserProfileSchema.safeParse(raw);\\n        if (parsed.success) {\\n          onData(parsed.data);\\n        }\\n      },\\n      (err) => {\\n        if (onError) onError(err);\\n        handleFirestoreError(err, OperationType.GET, path);\\n      }\\n    );\\n  }\\n\\n  async ensureProfile(user: AuthUserSummary): Promise<UserProfileData> {\\n    const path = `users/${user.uid}`;\\n    const ref = doc(db, \'users\', user.uid);\\n    try {\\n      const snap = await getDoc(ref);\\n      if (snap.exists()) {\\n        const parsed = UserProfileSchema.safeParse(snap.data());\\n        if (parsed.success) return parsed.data;\\n      }\\n\\n      const defaults = createDefaultUserProfile(\\n        user.uid,\\n        user.displayName,\\n        user.email ?? undefined\\n      );\\n      // Validate strictly against blueprint schema prior to write\\n      const validated = UserProfileSchema.parse(defaults);\\n      await setDoc(ref, {\\n        ...validated,\\n        createdAt: serverTimestamp(),\\n        updatedAt: serverTimestamp(),\\n      });\\n      return validated;\\n    } catch (error) {\\n      handleFirestoreError(error, OperationType.WRITE, path);\\n    }\\n  }\\n\\n  async updateProfile(\\n    uid: string,\\n    current: UserProfileData,\\n    patch: Partial<UserProfileData>\\n  ): Promise<void> {\\n    const path = `users/${uid}`;\\n    const ref = doc(db, \'users\', uid);\\n    const next: UserProfileData = {\\n      ...current,\\n      ...patch,\\n      uid,\\n      version: current.version + 1,\\n    };\\n    const validated = UserProfileSchema.parse(next);\\n\\n    // Explicitly send only allowed mutable fields to satisfy Eight-Pillar affectedKeys().hasOnly()\\n    const payload: Record<string, unknown> = {\\n      displayName: validated.displayName,\\n      locale: validated.locale,\\n      theme: validated.theme,\\n      primaryCurrency: validated.primaryCurrency,\\n      secondaryCurrency: validated.secondaryCurrency,\\n      vaultStorageMode: validated.vaultStorageMode,\\n      aiGlobalEnabled: validated.aiGlobalEnabled,\\n      analyticsConsent: validated.analyticsConsent,\\n      aiPrivacyNoticeAccepted: validated.aiPrivacyNoticeAccepted,\\n      e2eConfigured: validated.e2eConfigured,\\n      version: validated.version,\\n      updatedAt: serverTimestamp(),\\n    };\\n\\n    if (validated.email !== undefined) payload.email = validated.email;\\n    if (validated.aiModuleToggles !== undefined) payload.aiModuleToggles = validated.aiModuleToggles;\\n    if (validated.e2eSalt !== undefined) payload.e2eSalt = validated.e2eSalt;\\n    if (validated.e2eVerifier !== undefined) payload.e2eVerifier = validated.e2eVerifier;\\n    if (validated.quietHoursStart !== undefined) payload.quietHoursStart = validated.quietHoursStart;\\n    if (validated.quietHoursEnd !== undefined) payload.quietHoursEnd = validated.quietHoursEnd;\\n\\n    try {\\n      await updateDoc(ref, payload);\\n    } catch (error) {\\n      handleFirestoreError(error, OperationType.UPDATE, path);\\n    }\\n  }\\n\\n  subscribeEntitlements(\\n    uid: string,\\n    onData: (entitlements: PlanEntitlements) => void\\n  ): () => void {\\n    const path = `users/${uid}/entitlements/current`;\\n    const ref = doc(db, \'users\', uid, \'entitlements\', \'current\');\\n    return onSnapshot(\\n      ref,\\n      (snap) => {\\n        if (!snap.exists()) {\\n          onData(PLAN_CATALOG.free);\\n          return;\\n        }\\n        const raw = snap.data();\\n        const tier = (raw.plan as PlanTier) in PLAN_CATALOG ? (raw.plan as PlanTier) : \'free\';\\n        onData({\\n          ...PLAN_CATALOG[tier],\\n          aiDailyQuota:\\n            typeof raw.aiDailyQuota === \'number\'\\n              ? raw.aiDailyQuota\\n              : PLAN_CATALOG[tier].aiDailyQuota,\\n          storageMbLimit:\\n            typeof raw.storageMbLimit === \'number\'\\n              ? raw.storageMbLimit\\n              : PLAN_CATALOG[tier].storageMbLimit,\\n          maxDocuments:\\n            typeof raw.maxDocuments === \'number\'\\n              ? raw.maxDocuments\\n              : PLAN_CATALOG[tier].maxDocuments,\\n          e2eVaultAllowed:\\n            typeof raw.e2eVaultAllowed === \'boolean\'\\n              ? raw.e2eVaultAllowed\\n              : PLAN_CATALOG[tier].e2eVaultAllowed,\\n        });\\n      },\\n      (err) => {\\n        // Default safely to Free tier if entitlements doc does not exist yet\\n        console.warn(\'Entitlements snapshot fell back to Free tier:\', path, err.message);\\n        onData(PLAN_CATALOG.free);\\n      }\\n    );\\n  }\\n}\\n\\nexport class FirebaseWebAiUsageRepository implements AiUsageRepository {\\n  subscribeTodayUsage(\\n    uid: string,\\n    dayKey: string,\\n    onData: (usage: AiUsageRecord) => void\\n  ): () => void {\\n    const path = `users/${uid}/aiUsage/${dayKey}`;\\n    const ref = doc(db, \'users\', uid, \'aiUsage\', dayKey);\\n    return onSnapshot(\\n      ref,\\n      (snap) => {\\n        if (!snap.exists()) {\\n          onData({ dayKey, requestCount: 0, inputTokensEst: 0, outputTokensEst: 0 });\\n          return;\\n        }\\n        const raw = snap.data();\\n        onData({\\n          dayKey,\\n          requestCount: Number(raw.requestCount ?? 0),\\n          inputTokensEst: Number(raw.inputTokensEst ?? 0),\\n          outputTokensEst: Number(raw.outputTokensEst ?? 0),\\n        });\\n      },\\n      (err) => {\\n        handleFirestoreError(err, OperationType.GET, path);\\n      }\\n    );\\n  }\\n\\n  async recordUsage(\\n    uid: string,\\n    dayKey: string,\\n    current: AiUsageRecord | null,\\n    inputTokensEst: number,\\n    outputTokensEst: number\\n  ): Promise<void> {\\n    const path = `users/${uid}/aiUsage/${dayKey}`;\\n    const ref = doc(db, \'users\', uid, \'aiUsage\', dayKey);\\n    try {\\n      if (!current || current.requestCount === 0) {\\n        await setDoc(ref, {\\n          uid,\\n          dayKey,\\n          requestCount: 1,\\n          inputTokensEst: Math.max(0, Math.floor(inputTokensEst)),\\n          outputTokensEst: Math.max(0, Math.floor(outputTokensEst)),\\n          updatedAt: serverTimestamp(),\\n        });\\n      } else {\\n        await updateDoc(ref, {\\n          requestCount: current.requestCount + 1,\\n          inputTokensEst: current.inputTokensEst + Math.max(0, Math.floor(inputTokensEst)),\\n          outputTokensEst: current.outputTokensEst + Math.max(0, Math.floor(outputTokensEst)),\\n          updatedAt: serverTimestamp(),\\n        });\\n      }\\n    } catch (error) {\\n      handleFirestoreError(error, OperationType.WRITE, path);\\n    }\\n  }\\n}\\n\\n/**\\n * Local-Only Document Vault adapter using browser IndexedDB (zero Cloud Storage / Blaze billing).\\n */\\nexport class IndexedDBLocalVaultAdapter implements LocalVaultStorageAdapter {\\n  private readonly metaKey = \'lifeos_local_vault_entries_v1\';\\n\\n  async listLocalEntries(): Promise<LocalVaultEntryMeta[]> {\\n    try {\\n      const raw = localStorage.getItem(this.metaKey);\\n      return raw ? (JSON.parse(raw) as LocalVaultEntryMeta[]) : [];\\n    } catch {\\n      return [];\\n    }\\n  }\\n\\n  async saveLocalEntry(meta: LocalVaultEntryMeta, payload: string): Promise<void> {\\n    const list = await this.listLocalEntries();\\n    const updated = [meta, ...list.filter((e) => e.id !== meta.id)];\\n    localStorage.setItem(this.metaKey, JSON.stringify(updated));\\n    localStorage.setItem(`lifeos_local_vault_blob_${meta.id}`, payload);\\n  }\\n\\n  async removeLocalEntry(id: string): Promise<void> {\\n    const list = await this.listLocalEntries();\\n    localStorage.setItem(this.metaKey, JSON.stringify(list.filter((e) => e.id !== id)));\\n    localStorage.removeItem(`lifeos_local_vault_blob_${id}`);\\n  }\\n}\\n\\nexport const authRepository: AuthRepository = new FirebaseWebAuthRepository();\\nexport const userProfileRepository: UserProfileRepository = new FirebaseWebUserProfileRepository();\\nexport const aiUsageRepository: AiUsageRepository = new FirebaseWebAiUsageRepository();\\nexport const localVaultAdapter: LocalVaultStorageAdapter = new IndexedDBLocalVaultAdapter();\\n\", \"Description\":\"Implement Firebase Web adapters for Auth, UserProfile, Entitlements, monotonic AI Usage, and Local-Only Document Vault behind repository interfaces.\", \"Overwrite\":true, \"TargetFile\":\"/src/data/repositories/firebaseWebAdapter.ts\", \"toolAction\":\"Creating Firebase web repository adapters\", \"toolSummary\":\"Create Firebase web adapters\"}"
      original_name: "write_to_file"
