    tool_calls {
      id: "call_15074586544777738402"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * Zero-dependency, standards-compliant PDF 1.4 Multi-Page JPEG Encoder\\n * Pure TypeScript (works in Web, Node tests, and React Native without native PDF libs).\\n * Embeds each scanned/enhanced JPEG page via /DCTDecode XObjects scaled to A4 or native aspect ratio.\\n */\\n\\nexport interface PdfJpegPage {\\n  jpegBytes: Uint8Array;\\n  width: number;\\n  height: number;\\n}\\n\\nconst encoder = new TextEncoder();\\n\\nfunction concatBytes(chunks: Uint8Array[]): Uint8Array {\\n  let total = 0;\\n  for (const c of chunks) total += c.byteLength;\\n  const out = new Uint8Array(total);\\n  let offset = 0;\\n  for (const c of chunks) {\\n    out.set(c, offset);\\n    offset += c.byteLength;\\n  }\\n  return out;\\n}\\n\\nexport function buildMultiPagePdfFromJpegs(pages: PdfJpegPage[]): Uint8Array {\\n  if (pages.length === 0) {\\n    throw new Error(\'At least one page is required to generate a PDF.\');\\n  }\\n\\n  // Object numbering:\\n  // 1: Catalog\\n  // 2: Pages\\n  // For page i (0..N-1):\\n  //   pageObj = 3 + i * 3\\n  //   imgObj  = 4 + i * 3\\n  //   cntObj  = 5 + i * 3\\n  const objectBodies: Array<{ id: number; bytes: Uint8Array }> = [];\\n  const pageIds: number[] = [];\\n\\n  for (let i = 0; i < pages.length; i++) {\\n    const p = pages[i];\\n    const pageObjId = 3 + i * 3;\\n    const imgObjId = 4 + i * 3;\\n    const contentObjId = 5 + i * 3;\\n    pageIds.push(pageObjId);\\n\\n    // Fit onto A4-width (595pt) while preserving scanned image aspect ratio\\n    const safeW = Math.max(1, Math.round(p.width));\\n    const safeH = Math.max(1, Math.round(p.height));\\n    const pageW = 595;\\n    const pageH = Math.max(200, Math.min(1200, Math.round((safeH / safeW) * pageW)));\\n\\n    const pageDict =\\n      `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageW} ${pageH}] ` +\\n      `/Resources << /XObject << /Im0 ${imgObjId} 0 R >> >> /Contents ${contentObjId} 0 R >>`;\\n    objectBodies.push({ id: pageObjId, bytes: encoder.encode(pageDict) });\\n\\n    const imgHeader =\\n      `<< /Type /XObject /Subtype /Image /Width ${safeW} /Height ${safeH} ` +\\n      `/ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${p.jpegBytes.byteLength} >>\\\\nstream\\\\n`;\\n    const imgFooter = `\\\\nendstream`;\\n    objectBodies.push({\\n      id: imgObjId,\\n      bytes: concatBytes([encoder.encode(imgHeader), p.jpegBytes, encoder.encode(imgFooter)]),\\n    });\\n\\n    const contentStream = `q\\\\n${pageW} 0 0 ${pageH} 0 0 cm\\\\n/Im0 Do\\\\nQ\\\\n`;\\n    const contentDict = `<< /Length ${contentStream.length} >>\\\\nstream\\\\n${contentStream}endstream`;\\n    objectBodies.push({ id: contentObjId, bytes: encoder.encode(contentDict) });\\n  }\\n\\n  const catalogObj = {\\n    id: 1,\\n    bytes: encoder.encode(\'<< /Type /Catalog /Pages 2 0 R >>\'),\\n  };\\n  const pagesObj = {\\n    id: 2,\\n    bytes: encoder.encode(\\n      `<< /Type /Pages /Kids [${pageIds.map((id) => `${id} 0 R`).join(\' \')}] /Count ${pageIds.length} >>`\\n    ),\\n  };\\n\\n  const allObjects = [catalogObj, pagesObj, ...objectBodies].sort((a, b) => a.id - b.id);\\n\\n  const chunks: Uint8Array[] = [];\\n  const header = encoder.encode(\'%PDF-1.4\\\\n%\\\\xFF\\\\xFF\\\\xFF\\\\xFF\\\\n\');\\n  chunks.push(header);\\n\\n  let offset = header.byteLength;\\n  const xrefOffsets: number[] = [0]; // index 0 = free object\\n\\n  for (const obj of allObjects) {\\n    xrefOffsets.push(offset);\\n    const prefix = encoder.encode(`${obj.id} 0 obj\\\\n`);\\n    const suffix = encoder.encode(\'\\\\nendobj\\\\n\');\\n    chunks.push(prefix, obj.bytes, suffix);\\n    offset += prefix.byteLength + obj.bytes.byteLength + suffix.byteLength;\\n  }\\n\\n  const xrefStart = offset;\\n  const xrefLines = [`xref`, `0 ${allObjects.length + 1}`, `0000000000 65535 f `];\\n  for (let i = 1; i < xrefOffsets.length; i++) {\\n    xrefLines.push(`${String(xrefOffsets[i]).padStart(10, \'0\')} 00000 n `);\\n  }\\n  const trailer = [\\n    ...xrefLines,\\n    `trailer`,\\n    `<< /Size ${allObjects.length + 1} /Root 1 0 R >>`,\\n    `startxref`,\\n    `${xrefStart}`,\\n    `%%EOF`,\\n    \'\',\\n  ].join(\'\\\\n\');\\n\\n  chunks.push(encoder.encode(trailer));\\n  return concatBytes(chunks);\\n}\\n\", \"Description\":\"Create zero-dependency multi-page JPEG-to-PDF 1.4 binary generator for Document Vault scans\", \"Overwrite\":true, \"TargetFile\":\"/src/core/vault/pdfGenerator.ts\", \"toolAction\":\"Creating pdfGenerator.ts\", \"toolSummary\":\"Create pdfGenerator.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15074586544777739693"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * Browser-side Document Scan Enhancer (Crop, Rotate 90deg, Document B&W / Crisp Color filters)\\n * Produces compressed JPEG bytes ready for local IndexedDB storage or multi-page PDF export.\\n */\\n\\nexport type ScanFilterPreset = \'original\' | \'document_bw\' | \'vivid_color\';\\n\\nexport interface ScanTransformOptions {\\n  rotationDeg: 0 | 90 | 180 | 270;\\n  cropInsetPct: number; // 0..20 (% trimmed symmetrically from each edge)\\n  filter: ScanFilterPreset;\\n  quality?: number; // 0.5..0.95\\n  maxDimension?: number;\\n}\\n\\nexport interface EnhancedScanResult {\\n  dataUrl: string;\\n  jpegBytes: Uint8Array;\\n  width: number;\\n  height: number;\\n  sizeBytes: number;\\n}\\n\\nfunction loadImageElement(src: string): Promise<HTMLImageElement> {\\n  return new Promise((resolve, reject) => {\\n    const img = new Image();\\n    img.onload = () => resolve(img);\\n    img.onerror = () => reject(new Error(\'Could not decode image for scan enhancement.\'));\\n    img.src = src;\\n  });\\n}\\n\\nfunction dataUrlToBytes(dataUrl: string): Uint8Array {\\n  const commaIdx = dataUrl.indexOf(\',\');\\n  const b64 = commaIdx >= 0 ? dataUrl.slice(commaIdx + 1) : dataUrl;\\n  const bin = atob(b64);\\n  const out = new Uint8Array(bin.length);\\n  for (let i = 0; i < bin.length; i++) {\\n    out[i] = bin.charCodeAt(i);\\n  }\\n  return out;\\n}\\n\\nexport async function enhanceScannedImage(\\n  sourceDataUrl: string,\\n  opts: ScanTransformOptions\\n): Promise<EnhancedScanResult> {\\n  const img = await loadImageElement(sourceDataUrl);\\n  const inset = Math.max(0, Math.min(20, opts.cropInsetPct)) / 100;\\n\\n  const sx = Math.round(img.naturalWidth * inset);\\n  const sy = Math.round(img.naturalHeight * inset);\\n  const sw = Math.max(16, Math.round(img.naturalWidth * (1 - inset * 2)));\\n  const sh = Math.max(16, Math.round(img.naturalHeight * (1 - inset * 2)));\\n\\n  const maxDim = opts.maxDimension ?? 1600;\\n  const scale = Math.min(1, maxDim / Math.max(sw, sh));\\n  const scaledW = Math.max(16, Math.round(sw * scale));\\n  const scaledH = Math.max(16, Math.round(sh * scale));\\n\\n  const quarterTurns = opts.rotationDeg === 90 || opts.rotationDeg === 270;\\n  const outW = quarterTurns ? scaledH : scaledW;\\n  const outH = quarterTurns ? scaledW : scaledH;\\n\\n  const canvas = document.createElement(\'canvas\');\\n  canvas.width = outW;\\n  canvas.height = outH;\\n  const ctx = canvas.getContext(\'2d\');\\n  if (!ctx) throw new Error(\'Canvas 2D context unavailable.\');\\n\\n  ctx.fillStyle = \'#FFFFFF\';\\n  ctx.fillRect(0, 0, outW, outH);\\n\\n  ctx.save();\\n  ctx.translate(outW / 2, outH / 2);\\n  ctx.rotate((opts.rotationDeg * Math.PI) / 180);\\n  if (opts.filter === \'document_bw\') {\\n    ctx.filter = \'grayscale(100%) contrast(155%) brightness(108%)\';\\n  } else if (opts.filter === \'vivid_color\') {\\n    ctx.filter = \'contrast(120%) brightness(105%) saturate(112%)\';\\n  } else {\\n    ctx.filter = \'none\';\\n  }\\n  ctx.drawImage(img, sx, sy, sw, sh, -scaledW / 2, -scaledH / 2, scaledW, scaledH);\\n  ctx.restore();\\n\\n  const quality = opts.quality ?? 0.85;\\n  const dataUrl = canvas.toDataURL(\'image/jpeg\', quality);\\n  const jpegBytes = dataUrlToBytes(dataUrl);\\n\\n  return {\\n    dataUrl,\\n    jpegBytes,\\n    width: outW,\\n    height: outH,\\n    sizeBytes: jpegBytes.byteLength,\\n  };\\n}\\n\", \"Description\":\"Create browser canvas scan enhancer supporting crop, 90deg rotation, and B&W/Vivid filters\", \"Overwrite\":true, \"TargetFile\":\"/src/core/vault/imageEnhancer.ts\", \"toolAction\":\"Creating imageEnhancer.ts\", \"toolSummary\":\"Create imageEnhancer.ts\"}"
      original_name: "write_to_file"
    }
