    tool_calls {
      id: "call_10621355245219964898"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add Phase 5 VaultFolder and VaultDocumentMeta invariants to firestore.rules.test.ts\", \"EndLine\":60, \"Instruction\":\"Add assertions for isValidVaultFolder, isValidVaultDocumentMeta, and vaultFolders collection coverage.\", \"ReplacementContent\":\"  assert.match(rules, /match \\\\/versions\\\\/\\\\{versionId\\\\}[\\\\s\\\\S]*allow update: if false;/);\\n  assert.match(rules, /isValidVaultFolder/);\\n  assert.match(rules, /isValidVaultDocumentMeta/);\\n  assert.match(rules, /data\\\\.sizeBytes is int && data\\\\.sizeBytes >= 0 && data\\\\.sizeBytes <= 52428800/);\\n});\\n\\ntest(\'firebase-blueprint.json paths are all covered in firestore.rules\', () => {\\n  const rules = fs.readFileSync(path.resolve(process.cwd(), \'firestore.rules\'), \'utf8\');\\n  const blueprint = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), \'firebase-blueprint.json\'), \'utf8\'));\\n  const expectedCollections = [\\n    \'entitlements\',\\n    \'aiUsage\',\\n    \'debtLedgers\',\\n    \'debts\',\\n    \'payments\',\\n    \'reminders\',\\n    \'tasks\',\\n    \'noteFolders\',\\n    \'notes\',\\n    \'versions\',\\n    \'vaultFolders\',\\n    \'documents\',\\n    \'habits\',\\n    \'transactions\',\\n  ];\\n  assert.ok(blueprint.firestore[\'/users/{userId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/debts/{debtId}/payments/{paymentId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/noteFolders/{folderId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/notes/{noteId}/versions/{versionId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/vaultFolders/{folderId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/documents/{docId}\']);\\n  for (const col of expectedCollections) {\\n    assert.ok(rules.includes(`match /${col}/`), `Missing security rule match block for collection: ${col}`);\\n  }\\n});\", \"StartLine\":32, \"TargetContent\":\"  assert.match(rules, /match \\\\/versions\\\\/\\\\{versionId\\\\}[\\\\s\\\\S]*allow update: if false;/);\\n});\\n\\ntest(\'firebase-blueprint.json paths are all covered in firestore.rules\', () => {\\n  const rules = fs.readFileSync(path.resolve(process.cwd(), \'firestore.rules\'), \'utf8\');\\n  const blueprint = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), \'firebase-blueprint.json\'), \'utf8\'));\\n  const expectedCollections = [\\n    \'entitlements\',\\n    \'aiUsage\',\\n    \'debtLedgers\',\\n    \'debts\',\\n    \'payments\',\\n    \'reminders\',\\n    \'tasks\',\\n    \'noteFolders\',\\n    \'notes\',\\n    \'versions\',\\n    \'documents\',\\n    \'habits\',\\n    \'transactions\',\\n  ];\\n  assert.ok(blueprint.firestore[\'/users/{userId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/debts/{debtId}/payments/{paymentId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/noteFolders/{folderId}\']);\\n  assert.ok(blueprint.firestore[\'/users/{userId}/notes/{noteId}/versions/{versionId}\']);\\n  for (const col of expectedCollections) {\\n    assert.ok(rules.includes(`match /${col}/`), `Missing security rule match block for collection: ${col}`);\\n  }\\n});\", \"TargetFile\":\"/firestore.rules.test.ts\", \"toolAction\":\"Updating firestore.rules.test.ts for Phase 5 Vault\", \"toolSummary\":\"Update rules tests for Vault\"}"
      original_name: "replace_file_content"
    }
