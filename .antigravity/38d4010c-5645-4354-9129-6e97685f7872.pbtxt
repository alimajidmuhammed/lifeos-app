\333\225\331\276\333\225\332\251\333\225\330\257\330\247\',\n        aiOn: \'\332\206\330\247\331\204\330\247\332\251\',\n        aiOff: \'\331\206\330\247\332\206\330\247\331\204\330\247\332\251\',\n        blockedFreeTier: \'\331\204\333\225 \331\276\331\204\330\247\331\206\333\214 \330\256\333\206\332\225\330\247\333\214\333\214\330\257\330\247 \332\225\330\247\332\257\333\214\330\261\330\247\331\210\333\225\',\n        aiFreeTierNotice: \'\331\204\333\225 \332\251\330\247\330\252\333\214 \330\250\333\225\332\251\330\247\330\261\331\207\333\216\331\206\330\247\331\206\333\214 \331\276\331\204\330\247\331\206\333\214 \330\256\333\206\332\225\330\247\333\214\333\214\330\257\330\247\330\214 \331\210\333\216\331\206\333\225\333\214 \330\250\333\225\332\265\332\257\333\225\331\206\330\247\331\205\333\225\332\251\330\247\331\206\330\214 \331\276\330\247\330\263\331\276\333\206\330\261\330\252\330\214 \331\206\330\247\330\263\331\206\330\247\331\205\333\225\330\214 \331\210 \330\252\333\216\330\250\333\214\331\206\333\214\333\214\333\225 \331\202\331\201\332\265\332\251\330\261\330\247\331\210\333\225\332\251\330\247\331\206 \330\250\333\225 \330\252\333\225\331\210\330\247\331\210\333\214 \332\225\333\216\332\257\330\261\333\214\333\214\330\247\331\206 \331\204\333\216 \330\257\333\225\332\251\330\261\333\216\330\252 \331\204\333\225 \331\206\330\247\330\261\330\257\331\206.\',\n        aiModuleTogglesTitle: \'\332\251\333\206\331\206\330\252\330\261\333\206\332\265\333\214 AI \330\250\333\206 \331\207\333\225\330\261 \330\250\333\225\330\264\333\216\332\251\',\n        securityTitle: \'\331\202\331\201\332\265\333\214 \330\246\330\247\331\205\333\216\330\261 \331\210 \332\251\333\206\330\257\332\251\330\261\330\257\331\206\333\214 \330\256\333\225\330\262\333\216\331\206\333\225\333\214 E2E\',\n        pinLockLabel: \'\331\202\331\201\332\265\333\214 PIN \330\250\333\206 \330\246\333\225\331\276\',\n        pinDesc: \'\330\264\331\210\333\216\331\206\333\214 \332\251\