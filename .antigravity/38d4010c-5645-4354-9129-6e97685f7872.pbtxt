      name: "ask_question"
      arguments_json: "{\"questions\":[{\"is_multi_select\":false, \"options\":[\"(Recommended) Live React Web/PWA here with Expo-portable core\", \"Exportable Expo React Native codebase for local EAS builds\", \"Both: live Web/PWA app plus Expo config blueprint\"], \"question\":\"This workspace runs a live Vite web preview rather than native Expo/iOS/Android build tools. How should we build Phase 1?\"}, {\"is_multi_select\":false, \"options\":[\"(Recommended) Spark free tier with Local-Only Vault first\", \"Enable Blaze with budget alerts and Cloud Storage\", \"Use AI Studio provisioned Firestore for web testing\"], \"question\":\"Cloud Storage requires Firebase Blaze (pay-as-you-go with free allowances). Which Stage 0 storage posture do you prefer?\"}, {\"is_multi_select\":false, \"options\":[\"(Recommended) English UI with IQD and USD dual currency\", \"Arabic RTL first with IQD and USD\", \"Kurdish Sorani RTL first with IQD and USD\"], \"question\":\"Which primary language and default currency should Stage 0 optimize first while keeping EN, AR, and Kurdish Sorani RTL ready?\"}, {\"is_multi_select\":false, \"options\":[\"(Recommended) Opt-in per folder/note with recovery key\", \"Always-on E2E for entire Document Vault\", \"Defer E2E to Phase 5 and use biometric lock first\"], \"question\":\"How should client-side E2E encryption work for your sensitive Vault documents and locked notes?\"}, {\"is_multi_select\":false, \"options\":[\"(Recommended) Calm slate and emerald Material You + iOS polish\", \"Warm stone and amber editorial minimalism\", \"High-contrast obsidian AMOLED productivity cockpit\"], \"question\":\"What default visual direction should LifeOS use across its light, dark, and AMOLED themes?\"}], \"toolAction\":\"Asking clarifying architecture questions\", \"toolSummary\":\"Ask clarifying architecture questions\"}"
