              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetIdx = filteredTasks.findIndex((t) => t.id === targetTaskId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const sourceIdx = filteredTasks.findIndex((t) => t.id === draggedTaskId);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    setDraggedTaskId(null);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!moving || targetIdx === -1 || sourceIdx === -1) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const withoutMoving = filteredTasks.filter((t) => t.id !== moving.id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const insertIdx = sourceIdx < targetIdx ? targetIdx : targetIdx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const prev = insertIdx > 0 ? withoutMoving[insertIdx - 1] : null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const next = insertIdx < withoutMoving.length ? withoutMoving[insertIdx] : null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    await reorderTaskBetween(moving, prev, next);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const handleCycleStatus = async (task: TaskItem) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const nextStatus: TaskStatus = task.status === \'done\' ? \'todo\' : \'done\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    await setTaskStatus(task, nextStatus);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    showToast(nextStatus === \'done\' ? `Completed \"${task.title}\".` : `Reopened \"${task.title}\".`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const handleDeleteWithUndo = async (task: TaskItem) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    await deleteTask(task);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    showToast(`Deleted \"${task.title}\".`, () => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      void restoreTask(task);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
