      arguments_json: "{\"CodeContent\":\"import firebaseRulesPlugin from \'@firebase/eslint-plugin-security-rules\';\\n\\nexport default [\\n  {\\n    ignores: [\'dist/**/*\', \'node_modules/**/*\'],\\n  },\\n  firebaseRulesPlugin.configs[\'flat/recommended\'],\\n];\\n\", \"Description\":\"Configure ESLint flat config with @firebase/eslint-plugin-security-rules for auditing Firestore rules.\", \"Overwrite\":true, \"TargetFile\":\"/eslint.config.mjs\", \"toolAction\":\"Creating eslint.config.mjs for Firestore rules\", \"toolSummary\":\"Create eslint.config.mjs\"}"
