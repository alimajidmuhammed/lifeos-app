331\207\333\216\331\206\333\214 E2E\',\n        e2eTestBtn: \'\330\252\330\247\331\202\333\214\332\251\330\261\330\257\331\206\333\225\331\210\333\225\333\214 \332\251\333\206\330\257\332\251\330\261\330\257\331\206 \331\210 \332\251\330\261\330\257\331\206\333\225\331\210\333\225\',\n        accountTitle: \'\331\207\333\225\332\230\331\205\330\247\330\261\330\214 \331\207\330\247\331\210\332\251\330\247\330\252\332\251\330\261\330\257\331\206 \331\210 \331\207\333\225\331\206\330\247\330\261\330\257\333\225\332\251\330\261\330\257\331\206\',\n        appleSignInFlag: \'\332\206\331\210\331\210\331\206\333\225\332\230\331\210\331\210\330\261\333\225\331\210\333\225 \330\250\333\225 Apple \331\204\333\225 \331\276\330\264\330\252 \330\246\330\247\332\265\330\247\333\214 auth.apple.enabled=false \330\257\330\247\331\206\330\261\330\247\331\210\333\225 \330\250\333\206 \331\202\333\206\331\206\330\247\330\272\333\214 \330\250\332\265\330\247\331\210\332\251\330\261\330\257\331\206\333\225\331\210\333\225\333\214 App Store.\',\n        exportJsonBtn: \'\331\207\333\225\331\206\330\247\330\261\330\257\333\225\332\251\330\261\330\257\331\206\333\214 \330\262\330\247\331\206\333\214\330\247\330\261\333\214 JSON\',\n        analyticsConsentLabel: \'\332\225\333\225\330\262\330\247\331\205\333\225\331\206\330\257\333\214 \331\207\333\225\332\265\330\250\332\230\330\247\330\261\330\257\333\225\333\214\333\214 \330\250\333\206 \330\246\330\247\331\205\330\247\330\261\333\214 \331\206\333\225\331\206\330\247\330\263\330\261\330\247\331\210\',\n      },\n      assistant: {\n        title: \'\331\276\330\247\331\206\333\216\332\265\333\214 \331\201\333\225\330\261\331\205\330\247\331\206\333\225\332\251\330\247\331\206\333\214 AI\',\n        subtitle: \'\332\230\331\205\330\247\330\261\330\257\331\206\333\225 \330\257\330\247\330\261\330\247\333\214\333\214\333\225\332\251\330\247\331\206 \331\204\333\225\330\263\333\225\330\261 \330\246\330\247\331\205\333\216\330\261\333\225\33