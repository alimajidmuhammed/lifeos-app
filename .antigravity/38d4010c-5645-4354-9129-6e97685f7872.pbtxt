        replacement_content: "    \"HabitItem\": {\n      \"title\": \"HabitItem\",\n      \"description\": \"Habit definition with frequency, weekly target, category, and streak counters.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 120 },\n        \"category\": { \"type\": \"string\", \"enum\": [\"health\", \"mindfulness\", \"learning\", \"finance\", \"fitness\", \"productivity\", \"custom\"] },\n        \"frequency\": { \"type\": \"string\", \"enum\": [\"daily\", \"weekly\"] },\n        \"targetPerWeek\": { \"type\": \"integer\" },\n        \"reminderTime\": { \"type\": \"string\", \"maxLength\": 5, \"pattern\": \"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\" },\n        \"currentStreak\": { \"type\": \"integer\" },\n        \"bestStreak\": { \"type\": \"integer\" },\n        \"totalCompletions\": { \"type\": \"integer\" },\n        \"lastCompletedDate\": { \"type\": \"string\", \"maxLength\": 10, \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n        \"archived\": { \"type\": \"boolean\" },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"name\", \"category\", \"frequency\", \"targetPerWeek\", \"currentStreak\", \"bestStreak\", \"totalCompletions\", \"archived\", \"version\", \"createdAt\", \"updatedAt\"]\n    },\n    \"HabitMonthLog\": {\n      \"title\": \"HabitMonthLog\",\n      \"description\": \"Monthly-bucketed completion days for a habit (up to 31 YYYY-MM-DD entries per document).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"habitId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"monthKey\": { \"type\": \"string\", \"maxLength\": 7, \"pattern\": \"^\\\\d{4}-\\\\d{2}$\" },\n        \"days\": { \"type\": \"array\", \"description\": \"Bounded up to 31 YYYY-MM-DD completed day keys.\" },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"habitId\", \"monthKey\", \"days\", \"version\", \"createdAt\", \"updatedAt\"]\n    },\n    \"TransactionItem\": {\n      \"title\": \"TransactionItem\",\n      \"description\": \"Personal finance income or expense record stored strictly in integer minor units.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"type\": { \"type\": \"string\", \"enum\": [\"income\", \"expense\"] },\n        \"amountMinor\": { \"type\": \"integer\" },\n        \"currency\": { \"type\": \"string\", \"enum\": [\"IQD\", \"USD\", \"EUR\"] },\n        \"category\": { \"type\": \"string\", \"enum\": [\"salary\", \"freelance\", \"business\", \"gift\", \"housing\", \"food\", \"transport\", \"utilities\", \"health\", \"shopping\", \"subscriptions\", \"education\", \"entertainment\", \"debt_payment\", \"savings\", \"other\"] },\n        \"occurredOn\": { \"type\": \"string\", \"maxLength\": 10, \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n        \"merchant\": { \"type\": \"string\", \"maxLength\": 120 },\n        \"account\": { \"type\": \"string\", \"enum\": [\"cash\", \"bank\", \"zaincash\", \"fib\", \"fastpay\", \"card\"] },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"isRecurring\": { \"type\": \"boolean\" },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"type\", \"amountMinor\", \"currency\", \"category\", \"occurredOn\", \"account\", \"isRecurring\", \"version\", \"createdAt\", \"updatedAt\"]\n    },\n    \"BudgetLimit\": {\n      \"title\": \"BudgetLimit\",\n      \"description\": \"Monthly category spending budget in integer minor units.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"category\": { \"type\": \"string\", \"enum\": [\"housing\", \"food\", \"transport\", \"utilities\", \"health\", \"shopping\", \"subscriptions\", \"education\", \"entertainment\", \"debt_payment\", \"savings\", \"other\"] },\n        \"limitMinor\": { \"type\": \"integer\" },\n        \"currency\": { \"type\": \"string\", \"enum\": [\"IQD\", \"USD\", \"EUR\"] },\n        \"alertThresholdPct\": { \"type\": \"integer\" },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"category\", \"limitMinor\", \"currency\", \"alertThresholdPct\", \"version\", \"createdAt\", \"updatedAt\"]\n    },\n    \"SubscriptionItem\": {\n      \"title\": \"SubscriptionItem\",\n      \"description\": \"Recurring subscription or fixed bill tracked in integer minor units.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 120 },\n        \"amountMinor\": { \"type\": \"integer\" },\n        \"currency\": { \"type\": \"string\", \"enum\": [\"IQD\", \"USD\", \"EUR\"] },\n        \"cadence\": { \"type\": \"string\", \"enum\": [\"weekly\", \"monthly\", \"yearly\"] },\n        \"nextBillingDate\": { \"type\": \"string\", \"maxLength\": 10, \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n        \"category\": { \"type\": \"string\", \"enum\": [\"housing\", \"food\", \"transport\", \"utilities\", \"health\", \"shopping\", \"subscriptions\", \"education\", \"entertainment\", \"debt_payment\", \"savings\", \"other\"] },\n        \"status\": { \"type\": \"string\", \"enum\": [\"active\", \"paused\", \"cancelled\"] },\n        \"linkedReminderId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"note\": { \"type\": \"string\", \"maxLength\": 500 },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"name\", \"amountMinor\", \"currency\", \"cadence\", \"nextBillingDate\", \"category\", \"status\", \"version\", \"createdAt\", \"updatedAt\"]\n    }\n  },\n  \"firestore\": {\n    \"/users/{userId}\": {\n      \"schema\": { \"$ref\": \"#/entities/UserProfile\" },\n      \"description\": \"Root per-user profile, localization, theme, and privacy preferences.\"\n    },\n    \"/users/{userId}/entitlements/{entitlementId}\": {\n      \"schema\": { \"$ref\": \"#/entities/Entitlement\" },\n      \"description\": \"Server-managed plan limits and entitlements (read-only for client).\"\n    },\n    \"/users/{userId}/aiUsage/{dayKey}\": {\n      \"schema\": { \"$ref\": \"#/entities/AiUsageDay\" },\n      \"description\": \"Monotonic daily per-user AI quota counters.\"\n    },\n    \"/users/{userId}/debtLedgers/{personKey}\": {\n      \"schema\": { \"$ref\": \"#/entities/DebtLedger\" },\n      \"description\": \"Per-person debt ledger aggregates.\"\n    },\n    \"/users/{userId}/debts/{debtId}\": {\n      \"schema\": { \"$ref\": \"#/entities/DebtRecord\" },\n      \"description\": \"User debt items.\"\n    },\n    \"/users/{userId}/debts/{debtId}/payments/{paymentId}\": {\n      \"schema\": { \"$ref\": \"#/entities/DebtPayment\" },\n      \"description\": \"Immutable append-only repayment audit entries for a specific debt.\"\n    },\n    \"/users/{userId}/reminders/{reminderId}\": {\n      \"schema\": { \"$ref\": \"#/entities/ReminderItem\" },\n      \"description\": \"Smart reminder items.\"\n    },\n    \"/users/{userId}/tasks/{taskId}\": {\n      \"schema\": { \"$ref\": \"#/entities/TaskItem\" },\n      \"description\": \"Planner task items.\"\n    },\n    \"/users/{userId}/noteFolders/{folderId}\": {\n      \"schema\": { \"$ref\": \"#/entities/NoteFolder\" },\n      \"description\": \"Nested note folders with optional E2E default lock.\"\n    },\n    \"/users/{userId}/notes/{noteId}\": {\n      \"schema\": { \"$ref\": \"#/entities/NoteItem\" },\n      \"description\": \"Notes and opt-in E2E encrypted notes.\"\n    },\n    \"/users/{userId}/notes/{noteId}/versions/{versionId}\": {\n      \"schema\": { \"$ref\": \"#/entities/NoteVersion\" },\n      \"description\": \"Immutable append-only note version history snapshots.\"\n    },\n    \"/users/{userId}/vaultFolders/{folderId}\": {\n      \"schema\": { \"$ref\": \"#/entities/VaultFolder\" },\n      \"description\": \"Nested Document Vault folders with optional E2E default lock.\"\n    },\n    \"/users/{userId}/documents/{docId}\": {\n      \"schema\": { \"$ref\": \"#/entities/VaultDocumentMeta\" },\n      \"description\": \"Document Vault metadata records (raw binaries stay in Local IndexedDB or private Cloud Storage).\"\n    },\n    \"/users/{userId}/habits/{habitId}\": {\n      \"schema\": { \"$ref\": \"#/entities/HabitItem\" },\n      \"description\": \"Habit tracker definitions.\"\n    },\n    \"/users/{userId}/habitLogs/{bucketId}\": {\n      \"schema\": { \"$ref\": \"#/entities/HabitMonthLog\" },\n      \"description\": \"Monthly-bucketed habit check-in logs (30x fewer reads/writes).\"\n    },\n    \"/users/{userId}/transactions/{txId}\": {\n      \"schema\": { \"$ref\": \"#/entities/TransactionItem\" },\n      \"description\": \"Personal finance income and expense ledger entries.\"\n    },\n    \"/users/{userId}/budgets/{budgetId}\": {\n      \"schema\": { \"$ref\": \"#/entities/BudgetLimit\" },\n      \"description\": \"Monthly category spending limits.\"\n    },\n    \"/users/{userId}/subscriptions/{subId}\": {\n      \"schema\": { \"$ref\": \"#/entities/SubscriptionItem\" },\n      \"description\": \"Recurring subscriptions and fixed bills.\"\n    }\n  }\n}"
