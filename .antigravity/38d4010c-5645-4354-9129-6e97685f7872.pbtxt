          replacement_content: "    \"VaultFolder\": {\n      \"title\": \"VaultFolder\",\n      \"description\": \"Nested folder for organizing Document Vault items, with optional E2E default lock.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"name\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 80 },\n        \"parentId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"sortKey\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 64, \"pattern\": \"^[0-9A-Za-z]+$\" },\n        \"isLockedFolder\": { \"type\": \"boolean\" },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"uid\", \"name\", \"sortKey\", \"isLockedFolder\", \"version\", \"createdAt\", \"updatedAt\"]\n    },\n    \"VaultDocumentMeta\": {\n      \"title\": \"VaultDocumentMeta\",\n      \"description\": \"Document Vault metadata with expiry tracking and local/cloud posture (never stores raw binaries in Firestore).\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"uid\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"folderId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"title\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 200 },\n        \"docType\": { \"type\": \"string\", \"enum\": [\"passport\", \"id\", \"license\", \"insurance\", \"warranty\", \"invoice\", \"contract\", \"receipt\", \"medical\", \"other\"] },\n        \"storageMode\": { \"type\": \"string\", \"enum\": [\"local_only\", \"cloud_private\"] },\n        \"mimeType\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 100 },\n        \"sizeBytes\": { \"type\": \"integer\" },\n        \"pageCount\": { \"type\": \"integer\" },\n        \"expiryDate\": { \"type\": \"string\", \"maxLength\": 10, \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },\n        \"issuer\": { \"type\": \"string\", \"maxLength\": 120 },\n        \"documentNumberLast4\": { \"type\": \"string\", \"maxLength\": 16 },\n        \"tags\": { \"type\": \"array\", \"description\": \"Bounded up to 10 short string tags.\" },\n        \"notes\": { \"type\": \"string\", \"maxLength\": 2000 },\n        \"ocrText\": { \"type\": \"string\", \"maxLength\": 20000 },\n        \"isEncrypted\": { \"type\": \"boolean\" },\n        \"isLocked\": { \"type\": \"boolean\" },\n        \"localFileKey\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"linkedReminderId\": { \"type\": \"string\", \"minLength\": 1, \"maxLength\": 128, \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\" },\n        \"version\": { \"type\": \"integer\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"updatedAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\n        \"uid\",\n        \"title\",\n        \"docType\",\n        \"storageMode\",\n        \"mimeType\",\n        \"sizeBytes\",\n        \"pageCount\",\n        \"isEncrypted\",\n        \"isLocked\",\n        \"version\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    },"
