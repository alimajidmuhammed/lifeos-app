      thinking_signature: "\022\364\004\n\361\004\001i\024}\023\337S\220\313NW\203\206\n\020\332\005\264\355Cl,\2041\034Z[\340\006u\225\325\320\266o\227\vX\027\363\201\320\330-(\345`\243\264G\\\226\262\327]3>\217\203\000\247P\272M@\"\323\177\370\r\242p\211\216\377\331\227h\277\310w\236\240\224\230\344\020g\244\\D&\"\341gi\315\225\206p\022E\275hv\223\323\\\33695\241\313B\237.8\030\215\215\336\370-0V\374\241^\276\215X8\300\301NCT@&\021\242aq\343\016&\237\2727\315\234\005%\266\271\370\372\025%S\021\024\371g6\236kzd\357b}\201El\255\3304\250\331\034\036\250%w\3319\201\302\302\332x\221\021\033\017\216\236\317\031\'\025\200\352\3436a\361T*|\373\n\300]P\320\374\375N\322K\200\245\032\311\271\253\212\017\203\201@\305\375D\336k\346\314\300\025\ae\322\343\302x\277\304)\023\024\363\006\353\235j,Bx\253JDE\304\264\215\006\203\206\356vOs\021\036\325}JE\035l\315o\352\fR\361\352P\316\004\245F\357n\225\006n\300\234\317\217\350\255\262\265\325\220\367\363\362\271\202/\3178EF\264M\341\257\377\344T^F\r\032U\207\251\371H\365\252)J\020\002sy\264D\024\360*d\261\333\004\374\003\335\311\300\376\032\035V\231\344_\220i)%\331(\203C,\254\256\347\245\226#\177:\242\367j\3013\325\360\3770\311w\030$9N\r\005\322\300e\320\021+\311\032T\221V\'\267\311\302\225<R\337\255S\"\347T\221\3778\300L\3602\020P`\336Zw\255\2731\r~\253\346\310=5=\251\025\373\306\261\270\234\325\264pO\325DeM\v\004\217\032@\256^r4&\326t\305\263\227\016\261\347|\022\365\254\315K\364l\222\330\002^7\211\252o\317\240\034\r\376\337\216\177Da\305Q\356\nL\005\227\256\340\\\3558m\v\360\266\322\253\271\264\035\256\177\177\366k\345\305\017\351\270\t\036\274S\035\237.\r\245\357l\344\305\367\254\305>F;u\330\335\201X*\256\221s\351\313\336\'\036\355&\031eq\032\002\246h\300c*>Dx`\031pcI\251\023\264xix\320v\177m#A\372\346\335\245\002\360\240\320w\033\344}\'\337\346\033\av+\000\277\032\201"
