              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!doc.expiryDate) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const expMs = parseYmdUtcMs(doc.expiryDate);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const todayMs = parseYmdUtcMs(todayYmd);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (expMs === null || todayMs === null) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
