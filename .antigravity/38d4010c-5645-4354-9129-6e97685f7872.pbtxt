      thinking_signature: "\022\376\021\n\373\021\001i\024}\023\256\215o\231\244\371\337\325\225\3402(\232\212\376\a\b\304Zz\242\a\271\2753\031\342\300\\\370\344\362\211[\224\317C\377n\204\262\362\024c\265\003\223\301\300\363pc\023\353 4\3616\332\206\205\326F8\221\244u\352\201\335\251#\353\t\363\224\".\3176\244\033]:7\356\252\340\354\360\367\020\267\322Z\366b\324\346<Z\204<F\301K%x\3707\354\2018\023\352\263\006\364\362\005\321\336O\276\211\356\230T\275_Mv!\363\035\206\220\"j\310\334\273\252\376\003\234\243z\246`\361\205\250\327v\350\026d(g\237\v\003\020\347\207\026\216Jy\325\350t]%\356\307\232\335M4\214\022\341E\020`\210\f\342\340\301\036X\233\0376\001\f\353\335\203\265z-/\351\351\3453\265\202Jti\226)\1770c\345\357\030^m\'[G\024%~+|\267\365\2404\264\267\261\022Y\367\034\300p\212\213.{9h\005\017\034L\370\361\025\262\260\2047]\322t\"\264\217\':f\221\231N\337%\212\217{\n\221CT\324\364\214N\366\025\213\304Y\f\363\2710\023\260\006A\375\300\344ko\267\234\001\246\275\327#\334\273\304\n_\252\257\315\257{V&\245\307\305L\266\360=\203\207H\345\367i\320\000y5k\357\325\274T\262SB\',\363JJ\036\344M0\rp\270\347\240\030\203t\317\277z\315\v\250\265\235]\320$\326\337\207aA+\217}\265j\345/\244\355\234]\352a\005/,\325\253\240\377\351n\210\344\326BP\257\033\222\221\315\257\255:\305\035\351sMg\261\365V\274\345\273\374S\201\201\377fuQ\211l\371\204\005\265I?%J2<\250\237sb\222\256\v5XYZ\a\344\232\302Oo\031ob\336%\377\310\372i\215\211\330\203\274\276\372\243\204\354\n\027\211\315\001\236\030\272\345\313\317Ak1j\330\"\257\204\346Y\226\316\330\255\316\263JFW\333J\254ay\261\270\256?\033I\f;S\261=\244\244\001\036\325@Z\224\355\335\255>\371\336t\314Q{\277\346\226`\327\032$\274\030S\321V \351\305\302\324,\214\304\366\r\253J\337?\300\322[\250ue\361\"%\247\033e%\323\233\354\246\340\000\244\271\320w\214\203\212n\376\b\301\261\200\300\335\200\235\a\3052a\327?\341\310\tP5m@\'\rE\2156B\204G!\335Y0\003F\231a\031_\301 S\303\376G!\317\252\312\276LF\207XL\204\260\200)C\227`\204\354\275\260\265\303x-f\"\211\