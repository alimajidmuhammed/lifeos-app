      id: "call_3008329976238256983"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { z } from \'zod\';\\nimport type { CurrencyCode } from \'../currency/currency\';\\n\\nexport const INCOME_CATEGORIES = [\'salary\', \'freelance\', \'business\', \'gift\', \'other\'] as const;\\n\\nexport const EXPENSE_CATEGORIES = [\\n  \'housing\',\\n  \'food\',\\n  \'transport\',\\n  \'utilities\',\\n  \'health\',\\n  \'shopping\',\\n  \'subscriptions\',\\n  \'education\',\\n  \'entertainment\',\\n  \'debt_payment\',\\n  \'savings\',\\n  \'other\',\\n] as const;\\n\\nexport const ALL_TRANSACTION_CATEGORIES = [\\n  \'salary\',\\n  \'freelance\',\\n  \'business\',\\n  \'gift\',\\n  \'housing\',\\n  \'food\',\\n  \'transport\',\\n  \'utilities\',\\n  \'health\',\\n  \'shopping\',\\n  \'subscriptions\',\\n  \'education\',\\n  \'entertainment\',\\n  \'debt_payment\',\\n  \'savings\',\\n  \'other\',\\n] as const;\\n\\nexport type ExpenseCategory = (typeof EXPENSE_CATEGORIES)[number];\\nexport type TransactionCategory = (typeof ALL_TRANSACTION_CATEGORIES)[number];\\n\\nexport const FINANCE_ACCOUNTS = [\'cash\', \'bank\', \'zaincash\', \'fib\', \'fastpay\', \'card\'] as const;\\nexport type FinanceAccount = (typeof FINANCE_ACCOUNTS)[number];\\n\\nexport const TRANSACTION_CATEGORY_LABELS: Record<TransactionCategory, string> = {\\n  salary: \'Salary\',\\n  freelance: \'Freelance\',\\n  business: \'Business\',\\n  gift: \'Gift / Bonus\',\\n  housing: \'Housing & Rent\',\\n  food: \'Food & Groceries\',\\n  transport: \'Transport & Fuel\',\\n  utilities: \'Utilities & Internet\',\\n  health: \'Health & Medical\',\\n  shopping: \'Shopping\',\\n  subscriptions: \'Subscriptions\',\\n  education: \'Education\',\\n  entertainment: \'Entertainment\',\\n  debt_payment: \'Debt Payment\',\\n  savings: \'Savings Transfer\',\\n  other: \'Other\',\\n};\\n\\nexport const FINANCE_ACCOUNT_LABELS: Record<FinanceAccount, string> = {\\n  cash: \'Cash\',\\n  bank: \'Bank Account\',\\n  zaincash: \'ZainCash\',\\n  fib: \'FIB (First Iraqi Bank)\',\\n  fastpay: \'FastPay\',\\n  card: \'Card\',\\n};\\n\\nconst dateYmdRegex = /^\\\\d{4}-\\\\d{2}-\\\\d{2}$/;\\nconst CurrencyEnum = z.enum([\'IQD\', \'USD\', \'EUR\']);\\n\\nexport const TransactionItemSchema = z.object({\\n  id: z.string().min(1).max(128),\\n  uid: z.string().min(1).max(128),\\n  type: z.enum([\'income\', \'expense\']),\\n  amountMinor: z.number().int().positive().max(1_000_000_000_000),\\n  currency: CurrencyEnum,\\n  category: z.enum(ALL_TRANSACTION_CATEGORIES),\\n  occurredOn: z.string().regex(dateYmdRegex),\\n  merchant: z.string().trim().max(120).optional(),\\n  account: z.enum(FINANCE_ACCOUNTS),\\n  note: z.string().trim().max(500).optional(),\\n  isRecurring: z.boolean(),\\n  version: z.number().int().min(1),\\n  createdAt: z.string(),\\n  updatedAt: z.string(),\\n});\\n\\nexport type TransactionItem = z.infer<typeof TransactionItemSchema>;\\n\\nexport const CreateTransactionInputSchema = z.object({\\n  type: z.enum([\'income\', \'expense\']),\\n  amountMinor: z.number().int().positive().max(1_000_000_000_000),\\n  currency: CurrencyEnum,\\n  category: z.enum(ALL_TRANSACTION_CATEGORIES),\\n  occurredOn: z.string().regex(dateYmdRegex),\\n  merchant: z.string().trim().max(120).optional(),\\n  account: z.enum(FINANCE_ACCOUNTS).default(\'cash\'),\\n  note: z.string().trim().max(500).optional(),\\n  isRecurring: z.boolean().default(false),\\n});\\n\\nexport type CreateTransactionInput = z.infer<typeof CreateTransactionInputSchema>;\\n\\nexport const BudgetLimitSchema = z.object({\\n  id: z.string().min(1).max(128),\\n  uid: z.string().min(1).max(128),\\n  category: z.enum(EXPENSE_CATEGORIES),\\n  limitMinor: z.number().int().positive().max(1_000_000_000_000),\\n  currency: CurrencyEnum,\\n  alertThresholdPct: z.number().int().min(50).max(100),\\n  version: z.number().int().min(1),\\n  createdAt: z.string(),\\n  updatedAt: z.string(),\\n});\\n\\nexport type BudgetLimit = z.infer<typeof BudgetLimitSchema>;\\n\\nexport const UpsertBudgetInputSchema = z.object({\\n  category: z.enum(EXPENSE_CATEGORIES),\\n  limitMinor: z.number().int().positive().max(1_000_000_000_000),\\n  currency: CurrencyEnum,\\n  alertThresholdPct: z.number().int().min(50).max(100).default(80),\\n});\\n\\nexport type UpsertBudgetInput = z.infer<typeof UpsertBudgetInputSchema>;\\n\\nexport const SubscriptionCadenceSchema = z.enum([\'weekly\', \'monthly\', \'yearly\']);\\nexport type SubscriptionCadence = z.infer<typeof SubscriptionCadenceSchema>;\\n\\nexport const SubscriptionStatusSchema = z.enum([\'active\', \'paused\', \'cancelled\']);\\nexport type SubscriptionStatus = z.infer<typeof SubscriptionStatusSchema>;\\n\\nexport const SubscriptionItemSchema = z.object({\\n  id: z.string().min(1).max(128),\\n  uid: z.string().min(1).max(128),\\n  name: z.string().trim().min(1).max(120),\\n  amountMinor: z.number().int().positive().max(1_000_000_000_000),\\n  currency: CurrencyEnum,\\n  cadence: SubscriptionCadenceSchema,\\n  nextBillingDate: z.string().regex(dateYmdRegex),\\n  category: z.enum(EXPENSE_CATEGORIES),\\n  status: SubscriptionStatusSchema,\\n  linkedReminderId: z.string().min(1).max(128).optional(),\\n  note: z.string().trim().max(500).optional(),\\n  version: z.number().int().min(1),\\n  createdAt: z.string(),\\n  updatedAt: z.string(),\\n});\\n\\nexport type SubscriptionItem = z.infer<typeof SubscriptionItemSchema>;\\n\\nexport const CreateSubscriptionInputSchema = z.object({\\n  name: z.string().trim().min(1).max(120),\\n  amountMinor: z.number().int().positive().max(1_000_000_000_000),\\n  currency: CurrencyEnum,\\n  cadence: SubscriptionCadenceSchema.default(\'monthly\'),\\n  nextBillingDate: z.string().regex(dateYmdRegex),\\n  category: z.enum(EXPENSE_CATEGORIES).default(\'subscriptions\'),\\n  note: z.string().trim().max(500).optional(),\\n});\\n\\nexport type CreateSubscriptionInput = z.infer<typeof CreateSubscriptionInputSchema>;\\n\\nexport type FinanceCurrency = CurrencyCode;\\n\", \"Description\":\"Create Expo-portable Zod schemas for Finance transactions, budgets, and subscriptions\", \"Overwrite\":true, \"TargetFile\":\"/src/core/finance/financeSchemas.ts\", \"toolAction\":\"Creating financeSchemas.ts\", \"toolSummary\":\"Create src/core/finance/financeSchemas.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3008329976238257576"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  convertMinorUnits,\\n  fromMinorUnits,\\n  toMinorUnits,\\n  type CurrencyCode,\\n  type FxRatesToIqd,\\n} from \'../currency/currency\';\\nimport type { CreateReminderInput } from \'../reminders/reminderSchemas\';\\nimport {\\n  ALL_TRANSACTION_CATEGORIES,\\n  FINANCE_ACCOUNTS,\\n  type BudgetLimit,\\n  type CreateTransactionInput,\\n  type ExpenseCategory,\\n  type FinanceAccount,\\n  type SubscriptionItem,\\n  type TransactionCategory,\\n  type TransactionItem,\\n} from \'./financeSchemas\';\\n\\nexport interface CategorySpendItem {\\n  category: TransactionCategory;\\n  totalPrimaryMinor: number;\\n  sharePct: number;\\n  txCount: number;\\n}\\n\\nexport interface MonthlyCashflowSummary {\\n  monthKey: string;\\n  primaryCurrency: CurrencyCode;\\n  incomePrimaryMinor: number;\\n  expensePrimaryMinor: number;\\n  netPrimaryMinor: number;\\n  savingsRatePct: number;\\n  transactionCount: number;\\n  expenseBreakdown: CategorySpendItem[];\\n}\\n\\nexport interface BudgetEvaluation {\\n  budget: BudgetLimit;\\n  spentInBudgetCurrencyMinor: number;\\n  remainingMinor: number;\\n  usedPct: number;\\n  status: \'on_track\' | \'warning\' | \'exceeded\';\\n}\\n\\nexport interface SubscriptionMetrics {\\n  activeCount: number;\\n  monthlyBurnPrimaryMinor: number;\\n  annualBurnPrimaryMinor: number;\\n  upcomingWithin14Days: SubscriptionItem[];\\n}\\n\\nexport interface ParsedCsvImportResult {\\n  validRows: CreateTransactionInput[];\\n  errors: Array<{ line: number; reason: string }>;\\n}\\n\\n/**\\n * Deterministic monthly cashflow aggregator in exact integer minor units.\\n */\\nexport function computeMonthlyFinanceSummary(\\n  transactions: TransactionItem[],\\n  monthKey: string,\\n  primaryCurrency: CurrencyCode,\\n  fxRates: FxRatesToIqd\\n): MonthlyCashflowSummary {\\n  let incomePrimaryMinor = 0;\\n  let expensePrimaryMinor = 0;\\n  let transactionCount = 0;\\n  const catMap = new Map<TransactionCategory, { total: number; count: number }>();\\n\\n  for (const tx of transactions) {\\n    if (!tx.occurredOn.startsWith(monthKey)) continue;\\n    transactionCount += 1;\\n    const eqMinor = convertMinorUnits(tx.amountMinor, tx.currency, primaryCurrency, fxRates);\\n    if (tx.type === \'income\') {\\n      incomePrimaryMinor += eqMinor;\\n    } else {\\n      expensePrimaryMinor += eqMinor;\\n      const prev = catMap.get(tx.category) ?? { total: 0, count: 0 };\\n      catMap.set(tx.category, { total: prev.total + eqMinor, count: prev.count + 1 });\\n    }\\n  }\\n\\n  const netPrimaryMinor = incomePrimaryMinor - expensePrimaryMinor;\\n  const savingsRatePct =\\n    incomePrimaryMinor > 0\\n      ? Math.max(-100, Math.min(100, Math.round((netPrimaryMinor / incomePrimaryMinor) * 100)))\\n      : 0;\\n\\n  const expenseBreakdown: CategorySpendItem[] = Array.from(catMap.entries())\\n    .map(([category, info]) => ({\\n      category,\\n      totalPrimaryMinor: info.total,\\n      sharePct: expensePrimaryMinor > 0 ? Math.round((info.total / expensePrimaryMinor) * 100) : 0,\\n      txCount: info.count,\\n    }))\\n    .sort((a, b) => b.totalPrimaryMinor - a.totalPrimaryMinor);\\n\\n  return {\\n    monthKey,\\n    primaryCurrency,\\n    incomePrimaryMinor,\\n    expensePrimaryMinor,\\n    netPrimaryMinor,\\n    savingsRatePct,\\n    transactionCount,\\n    expenseBreakdown,\\n  };\\n}\\n\\n/**\\n * Evaluates each monthly category budget against actual spending in `monthKey`\\n * (converting multi-currency expenses into each budget\'s declared currency via FX rates).\\n */\\nexport function evaluateMonthlyBudgets(\\n  budgets: BudgetLimit[],\\n  transactions: TransactionItem[],\\n  monthKey: string,\\n  fxRates: FxRatesToIqd\\n): BudgetEvaluation[] {\\n  return budgets\\n    .map((budget) => {\\n      let spent = 0;\\n      for (const tx of transactions) {\\n        if (tx.type !== \'expense\') continue;\\n        if (!tx.occurredOn.startsWith(monthKey)) continue;\\n        if (tx.category !== (budget.category as TransactionCategory)) continue;\\n        spent += convertMinorUnits(tx.amountMinor, tx.currency, budget.currency, fxRates);\\n      }\\n\\n      const usedPct = Math.round((spent / Math.max(1, budget.limitMinor)) * 100);\\n      const remainingMinor = budget.limitMinor - spent;\\n      const status: BudgetEvaluation[\'status\'] =\\n        spent >= budget.limitMinor\\n          ? \'exceeded\'\\n          : usedPct >= budget.alertThresholdPct\\n            ? \'warning\'\\n            : \'on_track\';\\n\\n      return {\\n        budget,\\n        spentInBudgetCurrencyMinor: spent,\\n        remainingMinor,\\n        usedPct,\\n        status,\\n      };\\n    })\\n    .sort((a, b) => b.usedPct - a.usedPct);\\n}\\n\\n/**\\n * Computes normalized monthly & annualized recurring burn across active subscriptions.\\n */\\nexport function computeSubscriptionMetrics(\\n  subscriptions: SubscriptionItem[],\\n  primaryCurrency: CurrencyCode,\\n  fxRates: FxRatesToIqd,\\n  todayYmd: string\\n): SubscriptionMetrics {\\n  const active = subscriptions.filter((s) => s.status === \'active\');\\n  let monthlyBurnPrimaryMinor = 0;\\n  const upcomingWithin14Days: SubscriptionItem[] = [];\\n\\n  const todayMs = Date.parse(`${todayYmd}T00:00:00Z`);\\n\\n  for (const sub of active) {\\n    const eqMinor = convertMinorUnits(sub.amountMinor, sub.currency, primaryCurrency, fxRates);\\n    const monthlyEq =\\n      sub.cadence === \'weekly\'\\n        ? Math.round((eqMinor * 52) / 12)\\n        : sub.cadence === \'yearly\'\\n          ? Math.round(eqMinor / 12)\\n          : eqMinor;\\n    monthlyBurnPrimaryMinor += monthlyEq;\\n\\n    const billMs = Date.parse(`${sub.nextBillingDate}T00:00:00Z`);\\n    const diffDays = Math.round((billMs - todayMs) / 86_400_000);\\n    if (diffDays >= 0 && diffDays <= 14) {\\n      upcomingWithin14Days.push(sub);\\n    }\\n  }\\n\\n  upcomingWithin14Days.sort((a, b) => a.nextBillingDate.localeCompare(b.nextBillingDate));\\n\\n  return {\\n    activeCount: active.length,\\n    monthlyBurnPrimaryMinor,\\n    annualBurnPrimaryMinor: monthlyBurnPrimaryMinor * 12,\\n    upcomingWithin14Days,\\n  };\\n}\\n\\nexport function buildSubscriptionReminderInput(sub: SubscriptionItem): CreateReminderInput {\\n  const rrule =\\n    sub.cadence === \'weekly\'\\n      ? \'FREQ=WEEKLY;INTERVAL=1\'\\n      : sub.cadence === \'yearly\'\\n        ? \'FREQ=YEARLY;INTERVAL=1\'\\n        : \'FREQ=MONTHLY;INTERVAL=1\';\\n\\n  return {\\n    title: `Renew ${sub.name} (${fromMinorUnits(sub.amountMinor, sub.currency)} ${sub.currency})`,\\n    notes: `Recurring ${sub.cadence} subscription in Finance (${sub.category}).${sub.note ? ` ${sub.note}` : \'\'}`.slice(0, 1000),\\n    category: \'bill\',\\n    priority: \'normal\',\\n    dueAtIso: `${sub.nextBillingDate}T09:00:00.000Z`,\\n    rrule,\\n    respectQuietHours: true,\\n  };\\n}\\n\\n/**\\n * Neutralizes spreadsheet CSV formula injection (=, +, -, @, tab, CR) and applies RFC-4180 quoting.\\n */\\nfunction csvEscapeSafe(raw: string): string {\\n  const trimmed = raw ?? \'\';\\n  const neutralized = /^[=+\\\\-@\\\\t\\\\r]/.test(trimmed) ? `\'${trimmed}` : trimmed;\\n  if (/[\\\",\\\\n\\\\r]/.test(neutralized)) {\\n    return `\\\"${neutralized.replace(/\\\"/g, \'\\\"\\\"\')}\\\"`;\\n  }\\n  return neutralized;\\n}\\n\\nexport function exportTransactionsToCsv(transactions: TransactionItem[]): string {\\n  const header = [\'date\', \'type\', \'amount\', \'currency\', \'category\', \'account\', \'merchant\', \'note\'];\\n  const lines = [header.join(\',\')];\\n\\n  const sorted = [...transactions].sort((a, b) => b.occurredOn.localeCompare(a.occurredOn));\\n  for (const tx of sorted) {\\n    const major = fromMinorUnits(tx.amountMinor, tx.currency);\\n    lines.push(\\n      [\\n        csvEscapeSafe(tx.occurredOn),\\n        csvEscapeSafe(tx.type),\\n        String(major),\\n        csvEscapeSafe(tx.currency),\\n        csvEscapeSafe(tx.category),\\n        csvEscapeSafe(tx.account),\\n        csvEscapeSafe(tx.merchant ?? \'\'),\\n        csvEscapeSafe(tx.note ?? \'\'),\\n      ].join(\',\')\\n    );\\n  }\\n  return lines.join(\'\\\\n\');\\n}\\n\\nfunction splitCsvLine(line: string): string[] {\\n  const fields: string[] = [];\\n  let cur = \'\';\\n  let inQuotes = false;\\n  for (let i = 0; i < line.length; i++) {\\n    const ch = line[i];\\n    if (inQuotes) {\\n      if (ch === \'\\\"\' && line[i + 1] === \'\\\"\') {\\n        cur += \'\\\"\';\\n        i += 1;\\n      } else if (ch === \'\\\"\') {\\n        inQuotes = false;\\n      } else {\\n        cur += ch;\\n      }\\n    } else if (ch === \'\\\"\') {\\n      inQuotes = true;\\n    } else if (ch === \',\') {\\n      fields.push(cur.trim());\\n      cur = \'\';\\n    } else {\\n      cur += ch;\\n    }\\n  }\\n  fields.push(cur.trim());\\n  return fields;\\n}\\n\\n/**\\n * Parses CSV text (header: date,type,amount,currency,category,account,merchant,note) into validated CreateTransactionInput drafts.\\n */\\nexport function parseTransactionsCsv(\\n  csvText: string,\\n  defaultCurrency: CurrencyCode = \'IQD\'\\n): ParsedCsvImportResult {\\n  const rawLines = csvText\\n    .split(/\\\\r?\\\\n/)\\n    .map((l) => l.trim())\\n    .filter(Boolean);\\n\\n  if (rawLines.length === 0) {\\n    return { validRows: [], errors: [{ line: 1, reason: \'CSV input is empty.\' }] };\\n  }\\n\\n  const validRows: CreateTransactionInput[] = [];\\n  const errors: Array<{ line: number; reason: string }> = [];\\n\\n  const firstCells = splitCsvLine(rawLines[0]).map((c) => c.toLowerCase());\\n  const hasHeader = firstCells.includes(\'date\') || firstCells.includes(\'amount\') || firstCells.includes(\'type\');\\n  const startIdx = hasHeader ? 1 : 0;\\n\\n  const validCats = new Set<string>(ALL_TRANSACTION_CATEGORIES);\\n  const validAccounts = new Set<string>(FINANCE_ACCOUNTS);\\n\\n  for (let i = startIdx; i < rawLines.length; i++) {\\n    const lineNo = i + 1;\\n    const cols = splitCsvLine(rawLines[i]);\\n    if (cols.length < 3) {\\n      errors.push({ line: lineNo, reason: \'Expected at least date, type, amount columns.\' });\\n      continue;\\n    }\\n\\n    const [dateRaw, typeRaw, amountRaw, currRaw, catRaw, accRaw, merchantRaw, noteRaw] = cols;\\n    const occurredOn = dateRaw.replace(/^\'/, \'\');\\n    if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(occurredOn)) {\\n      errors.push({ line: lineNo, reason: `Invalid date \\\"${occurredOn}\\\" (expected YYYY-MM-DD).` });\\n      continue;\\n    }\\n\\n    const typeNorm = typeRaw.toLowerCase();\\n    if (typeNorm !== \'income\' && typeNorm !== \'expense\') {\\n      errors.push({ line: lineNo, reason: `Invalid type \\\"${typeRaw}\\\" (use income or expense).` });\\n      continue;\\n    }\\n\\n    const amountNum = Number(amountRaw.replace(/,/g, \'\'));\\n    if (!Number.isFinite(amountNum) || amountNum <= 0) {\\n      errors.push({ line: lineNo, reason: `Invalid amount \\\"${amountRaw}\\\".` });\\n      continue;\\n    }\\n\\n    const currUpper = (currRaw || defaultCurrency).toUpperCase();\\n    const currency: CurrencyCode =\\n      currUpper === \'USD\' || currUpper === \'EUR\' || currUpper === \'IQD\'\\n        ? currUpper\\n        : defaultCurrency;\\n\\n    const amountMinor = toMinorUnits(amountNum, currency);\\n    if (amountMinor <= 0) {\\n      errors.push({ line: lineNo, reason: \'Amount converts to 0 minor units.\' });\\n      continue;\\n    }\\n\\n    const catNorm = (catRaw || \'other\').toLowerCase();\\n    const category: TransactionCategory = validCats.has(catNorm)\\n      ? (catNorm as TransactionCategory)\\n      : \'other\';\\n\\n    const accNorm = (accRaw || \'cash\').toLowerCase();\\n    const account: FinanceAccount = validAccounts.has(accNorm)\\n      ? (accNorm as FinanceAccount)\\n      : \'cash\';\\n\\n    const cleanMerchant = (merchantRaw ?? \'\').replace(/^\'/, \'\').slice(0, 120) || undefined;\\n    const cleanNote = (noteRaw ?? \'\').replace(/^\'/, \'\').slice(0, 500) || undefined;\\n\\n    validRows.push({\\n      type: typeNorm,\\n      amountMinor,\\n      currency,\\n      category,\\n      occurredOn,\\n      account,\\n      merchant: cleanMerchant,\\n      note: cleanNote,\\n      isRecurring: false,\\n    });\\n  }\\n\\n  return { validRows, errors };\\n}\\n\\nexport function isExpenseCategory(cat: string): cat is ExpenseCategory {\\n  return (\\n    cat === \'housing\' ||\\n    cat === \'food\' ||\\n    cat === \'transport\' ||\\n    cat === \'utilities\' ||\\n    cat === \'health\' ||\\n    cat === \'shopping\' ||\\n    cat === \'subscriptions\' ||\\n    cat === \'education\' ||\\n    cat === \'entertainment\' ||\\n    cat === \'debt_payment\' ||\\n    cat === \'savings\' ||\\n    cat === \'other\'\\n  );\\n}\\n\", \"Description\":\"Create pure deterministic Finance ledger, budget tracker, subscription burn, and formula-safe CSV engine\", \"Overwrite\":true, \"TargetFile\":\"/src/core/finance/financeEngine.ts\", \"toolAction\":\"Creating financeEngine.ts\", \"toolSummary\":\"Create src/core/finance/financeEngine.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3008329976238258169"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { formatMoney, type CurrencyCode, type FxRatesToIqd, type SupportedLocale } from \'../currency/currency\';\\nimport { aggregateDebtMetrics } from \'../debts/debtEngine\';\\nimport type { DebtRecord } from \'../debts/debtSchemas\';\\nimport {\\n  computeMonthlyFinanceSummary,\\n  computeSubscriptionMetrics,\\n} from \'../finance/financeEngine\';\\nimport type { BudgetLimit, SubscriptionItem, TransactionItem } from \'../finance/financeSchemas\';\\nimport {\\n  collectHabitCompletedDays,\\n  computeHabitsOverview,\\n  computeHabitStreakStats,\\n} from \'../habits/habitEngine\';\\nimport type { HabitItem, HabitMonthLog } from \'../habits/habitSchemas\';\\nimport type { NoteItem } from \'../notes/noteSchemas\';\\nimport type { TaskItem } from \'../planner/plannerSchemas\';\\nimport type { ReminderItem } from \'../reminders/reminderSchemas\';\\nimport { evaluateDocumentExpiry } from \'../vault/expiryEngine\';\\nimport type { VaultDocumentMeta } from \'../vault/vaultSchemas\';\\n\\nexport type SearchModuleId =\\n  | \'debts\'\\n  | \'reminders\'\\n  | \'planner\'\\n  | \'notes\'\\n  | \'vault\'\\n  | \'habits\'\\n  | \'finance\';\\n\\nexport interface WorkspaceSearchHit {\\n  id: string;\\n  module: SearchModuleId;\\n  title: string;\\n  subtitle: string;\\n  score: number;\\n  isPrivacyRedacted?: boolean;\\n}\\n\\nexport interface WorkspaceSnapshot {\\n  debts: DebtRecord[];\\n  reminders: ReminderItem[];\\n  tasks: TaskItem[];\\n  notes: NoteItem[];\\n  vaultDocs: VaultDocumentMeta[];\\n  habits: HabitItem[];\\n  habitLogs: HabitMonthLog[];\\n  transactions: TransactionItem[];\\n  budgets: BudgetLimit[];\\n  subscriptions: SubscriptionItem[];\\n  primaryCurrency: CurrencyCode;\\n  locale: SupportedLocale;\\n  fxRates: FxRatesToIqd;\\n  todayYmd: string;\\n}\\n\\nfunction scoreMatch(queryLower: string, primaryText: string, secondaryText = \'\'): number {\\n  const p = primaryText.toLowerCase();\\n  const s = secondaryText.toLowerCase();\\n  if (p === queryLower) return 100;\\n  if (p.startsWith(queryLower)) return 85;\\n  if (p.includes(queryLower)) return 70;\\n  const tokens = queryLower.split(/\\\\s+/).filter(Boolean);\\n  if (tokens.length > 1 && tokens.every((tk) => p.includes(tk) || s.includes(tk))) {\\n    return 60;\\n  }\\n  if (s.includes(queryLower)) return 45;\\n  return 0;\\n}\\n\\n/**\\n * Deterministic cross-module offline search across all 7 LifeOS modules.\\n * Strict Privacy Rule:\\n * - Never searches or returns decrypted/raw content of E2E locked notes.\\n * - Never exposes sensitive Vault OCR or binary text when `forCloudAiTool === true` (free tier).\\n */\\nexport function searchWorkspaceSnapshot(\\n  snapshot: WorkspaceSnapshot,\\n  query: string,\\n  options?: {\\n    moduleFilter?: SearchModuleId | \'all\';\\n    forCloudAiTool?: boolean;\\n    limit?: number;\\n  }\\n): WorkspaceSearchHit[] {\\n  const q = query.trim().toLowerCase();\\n  if (!q) return [];\\n\\n  const filter = options?.moduleFilter ?? \'all\';\\n  const forAi = Boolean(options?.forCloudAiTool);\\n  const limit = options?.limit ?? 15;\\n  const hits: WorkspaceSearchHit[] = [];\\n\\n  if (filter === \'all\' || filter === \'debts\') {\\n    for (const d of snapshot.debts) {\\n      const score = scoreMatch(q, d.personName, `${d.category} ${d.status} ${d.notes ?? \'\'}`);\\n      if (score > 0) {\\n        hits.push({\\n          id: d.id,\\n          module: \'debts\',\\n          title: `${d.personName} (${d.direction === \'i_owe\' ? \'I owe\' : \'Owed to me\'})`,\\n          subtitle: `${formatMoney(d.remainingMinor, d.currency, snapshot.locale)} \302\267 ${d.status}${d.dueDate ? ` \302\267 Due ${d.dueDate}` : \'\'}`,\\n          score,\\n        });\\n      }\\n    }\\n  }\\n\\n  if (filter === \'all\' || filter === \'reminders\') {\\n    for (const r of snapshot.reminders) {\\n      const score = scoreMatch(q, r.title, `${r.category} ${r.notes ?? \'\'}`);\\n      if (score > 0) {\\n        hits.push({\\n          id: r.id,\\n          module: \'reminders\',\\n          title: r.title,\\n          subtitle: `${r.category} \302\267 ${r.status} \302\267 ${r.dueAtIso.slice(0, 10)}`,\\n          score,\\n        });\\n      }\\n    }\\n  }\\n\\n  if (filter === \'all\' || filter === \'planner\') {\\n    for (const tk of snapshot.tasks) {\\n      const score = scoreMatch(q, tk.title, `${tk.listId} ${tk.notes ?? \'\'} ${tk.tags.join(\' \')}`);\\n      if (score > 0) {\\n        hits.push({\\n          id: tk.id,\\n          module: \'planner\',\\n          title: tk.title,\\n          subtitle: `${tk.listId} \302\267 ${tk.status}${tk.dueDate ? ` \302\267 Due ${tk.dueDate}` : \'\'}`,\\n          score,\\n        });\\n      }\\n    }\\n  }\\n\\n  if (filter === \'all\' || filter === \'notes\') {\\n    for (const n of snapshot.notes) {\\n      // Never search encrypted ciphertext or expose locked note content to AI tools\\n      const searchableBody = n.isEncrypted || n.isLocked ? \'\' : `${n.content.slice(0, 400)} ${n.tags.join(\' \')}`;\\n      if (forAi && (n.isEncrypted || n.isLocked)) continue;\\n      const score = scoreMatch(q, n.title, searchableBody);\\n      if (score > 0) {\\n        hits.push({\\n          id: n.id,\\n          module: \'notes\',\\n          title: n.title,\\n          subtitle: n.isEncrypted\\n            ? \'E2E Locked Note \302\267 On-device encrypted\'\\n            : `${n.wordCount} words${n.pinned ? \' \302\267 Pinned\' : \'\'}`,\\n          score,\\n          isPrivacyRedacted: n.isEncrypted || n.isLocked,\\n        });\\n      }\\n    }\\n  }\\n\\n  // Vault: allow local on-device search, NEVER transmit vault documents/OCR to free-tier cloud AI tools\\n  if ((filter === \'all\' || filter === \'vault\') && !forAi) {\\n    for (const doc of snapshot.vaultDocs) {\\n      const searchable = doc.isEncrypted\\n        ? `${doc.docType} ${doc.issuer ?? \'\'}`\\n        : `${doc.docType} ${doc.issuer ?? \'\'} ${doc.ocrText ?? \'\'} ${doc.notes ?? \'\'}`;\\n      const score = scoreMatch(q, doc.title, searchable);\\n      if (score > 0) {\\n        const exp = evaluateDocumentExpiry(doc.expiryDate, snapshot.todayYmd);\\n        hits.push({\\n          id: doc.id,\\n          module: \'vault\',\\n          title: doc.title,\\n          subtitle: `${doc.docType}${exp.status !== \'no_expiry\' ? ` \302\267 ${exp.label}` : \'\'}${doc.isEncrypted ? \' \302\267 E2E Encrypted\' : \'\'}`,\\n          score,\\n          isPrivacyRedacted: doc.isEncrypted,\\n        });\\n      }\\n    }\\n  }\\n\\n  if (filter === \'all\' || filter === \'habits\') {\\n    for (const h of snapshot.habits) {\\n      if (h.archived) continue;\\n      const score = scoreMatch(q, h.name, `${h.category} ${h.frequency}`);\\n      if (score > 0) {\\n        const days = collectHabitCompletedDays(h.id, snapshot.habitLogs);\\n        const stats = computeHabitStreakStats(h, days, snapshot.todayYmd);\\n        hits.push({\\n          id: h.id,\\n          module: \'habits\',\\n          title: h.name,\\n          subtitle: `${h.category} \302\267 Streak ${stats.currentStreak} \302\267 30d ${stats.consistency30dPct}%`,\\n          score,\\n        });\\n      }\\n    }\\n  }\\n\\n  if (filter === \'all\' || filter === \'finance\') {\\n    for (const tx of snapshot.transactions) {\\n      const score = scoreMatch(\\n        q,\\n        tx.merchant || tx.category,\\n        `${tx.type} ${tx.category} ${tx.account} ${tx.note ?? \'\'} ${tx.occurredOn}`\\n      );\\n      if (score > 0) {\\n        hits.push({\\n          id: tx.id,\\n          module: \'finance\',\\n          title: tx.merchant ? `${tx.merchant} (${tx.category})` : tx.category,\\n          subtitle: `${tx.type === \'income\' ? \'+\' : \'-\'}${formatMoney(tx.amountMinor, tx.currency, snapshot.locale)} \302\267 ${tx.occurredOn}`,\\n          score,\\n        });\\n      }\\n    }\\n\\n    for (const sub of snapshot.subscriptions) {\\n      const score = scoreMatch(q, sub.name, `${sub.category} ${sub.cadence} ${sub.status}`);\\n      if (score > 0) {\\n        hits.push({\\n          id: sub.id,\\n          module: \'finance\',\\n          title: `${sub.name} (Subscription)`,\\n          subtitle: `${formatMoney(sub.amountMinor, sub.currency, snapshot.locale)}/${sub.cadence} \302\267 Next ${sub.nextBillingDate}`,\\n          score,\\n        });\\n      }\\n    }\\n  }\\n\\n  return hits.sort((a, b) => b.score - a.score).slice(0, limit);\\n}\\n\\n/**\\n * Deterministic read-only tool executor invoked locally when Gemini Function Calling\\n * requests workspace summaries (keeps raw records, locked notes, and Vault scans off cloud AI).\\n */\\nexport function executeWorkspaceAiTool(\\n  toolName: string,\\n  args: Record<string, unknown>,\\n  snapshot: WorkspaceSnapshot\\n): Record<string, unknown> {\\n  const monthKey = snapshot.todayYmd.slice(0, 7);\\n\\n  if (toolName === \'search_workspace\') {\\n    const query = String(args.query ?? \'\').trim();\\n    const moduleFilter = (String(args.moduleFilter ?? \'all\') as SearchModuleId | \'all\');\\n    const hits = searchWorkspaceSnapshot(snapshot, query, {\\n      moduleFilter,\\n      forCloudAiTool: true,\\n      limit: 8,\\n    });\\n    return {\\n      query,\\n      resultCount: hits.length,\\n      privacyNote: \'Locked notes and Document Vault files are automatically excluded on free tier.\',\\n      matches: hits.map((h) => ({ module: h.module, title: h.title, summary: h.subtitle })),\\n    };\\n  }\\n\\n  if (toolName === \'get_financial_snapshot\') {\\n    const fin = computeMonthlyFinanceSummary(\\n      snapshot.transactions,\\n      monthKey,\\n      snapshot.primaryCurrency,\\n      snapshot.fxRates\\n    );\\n    const subs = computeSubscriptionMetrics(\\n      snapshot.subscriptions,\\n      snapshot.primaryCurrency,\\n      snapshot.fxRates,\\n      snapshot.todayYmd\\n    );\\n    const debtMetrics = aggregateDebtMetrics(\\n      snapshot.debts,\\n      snapshot.primaryCurrency,\\n      snapshot.fxRates,\\n      snapshot.todayYmd\\n    );\\n    return {\\n      monthKey,\\n      primaryCurrency: snapshot.primaryCurrency,\\n      monthlyIncome: formatMoney(fin.incomePrimaryMinor, snapshot.primaryCurrency, snapshot.locale),\\n      monthlyExpense: formatMoney(fin.expensePrimaryMinor, snapshot.primaryCurrency, snapshot.locale),\\n      monthlyNet: formatMoney(fin.netPrimaryMinor, snapshot.primaryCurrency, snapshot.locale),\\n      savingsRatePct: fin.savingsRatePct,\\n      topExpenseCategories: fin.expenseBreakdown.slice(0, 4).map((c) => ({\\n        category: c.category,\\n        amount: formatMoney(c.totalPrimaryMinor, snapshot.primaryCurrency, snapshot.locale),\\n        sharePct: c.sharePct,\\n      })),\\n      activeSubscriptions: subs.activeCount,\\n      monthlySubscriptionBurn: formatMoney(subs.monthlyBurnPrimaryMinor, snapshot.primaryCurrency, snapshot.locale),\\n      openDebtsCount: debtMetrics.totalOpenCount,\\n      overdueDebtsCount: debtMetrics.totalOverdueCount,\\n      netDebtPosition: formatMoney(debtMetrics.equivalentNetPrimaryMinor, snapshot.primaryCurrency, snapshot.locale),\\n    };\\n  }\\n\\n  if (toolName === \'get_habit_consistency\') {\\n    const overview = computeHabitsOverview(snapshot.habits, snapshot.habitLogs, snapshot.todayYmd);\\n    const activeHabits = snapshot.habits\\n      .filter((h) => !h.archived)\\n      .slice(0, 10)\\n      .map((h) => {\\n        const stats = computeHabitStreakStats(\\n          h,\\n          collectHabitCompletedDays(h.id, snapshot.habitLogs),\\n          snapshot.todayYmd\\n        );\\n        return {\\n          name: h.name,\\n          category: h.category,\\n          completedToday: stats.completedToday,\\n          currentStreak: stats.currentStreak,\\n          consistency30dPct: stats.consistency30dPct,\\n        };\\n      });\\n    return {\\n      overview,\\n      habits: activeHabits,\\n    };\\n  }\\n\\n  if (toolName === \'get_upcoming_commitments\') {\\n    const activeReminders = snapshot.reminders\\n      .filter((r) => r.status === \'scheduled\' || r.status === \'snoozed\')\\n      .slice(0, 6)\\n      .map((r) => ({ title: r.title, category: r.category, dueDate: r.dueAtIso.slice(0, 10) }));\\n    const openTasks = snapshot.tasks\\n      .filter((t) => t.status !== \'done\')\\n      .slice(0, 6)\\n      .map((t) => ({ title: t.title, listId: t.listId, dueDate: t.dueDate ?? null }));\\n    return {\\n      todayYmd: snapshot.todayYmd,\\n      activeRemindersCount: activeReminders.length,\\n      upcomingReminders: activeReminders,\\n      openTasksCount: openTasks.length,\\n      openTasks,\\n    };\\n  }\\n\\n  return { error: `Unknown tool \\\"${toolName}\\\"` };\\n}\\n\", \"Description\":\"Create deterministic cross-module global search and Privacy-Gated AI tool executor across all 7 LifeOS modules\", \"Overwrite\":true, \"TargetFile\":\"/src/core/search/globalSearchEngine.ts\", \"toolAction\":\"Creating globalSearchEngine.ts\", \"toolSummary\":\"Create src/core/search/globalSearchEngine.ts\"}"
      original_name: "write_to_file"
    }
