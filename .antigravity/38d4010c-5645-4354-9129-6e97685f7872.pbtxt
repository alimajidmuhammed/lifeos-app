tte />\\n      <AppLockOverlay />\\n    </>\\n  );\\n}\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring DebtsView into App router\", \"toolSummary\":\"Wire DebtsView in App.tsx\"}"
      thinking_signature: "\022\227\005\n\224\005\001i\024}\023C\020]z\253%H\227>q\340\370\340j\323\031\242\205F\205|C\351B\271\036\351%\232\257\304\211\276\244c:\337\210\364<Z\365\364\247\031\025\204\352\222\202\304\253\272\361\202\312\322\254&:\377\362u(\272\346)\271\0042dy\254\v%\230K\263\n\003\232\263\270\225%D[\257\351^$\027\032t\364\016\000\255VT\261\223\326\344\310\312V\003\207:\0224!\350\240\231FVF\273\360\024\310\354\360aW\300@e\227E\217\',\023\277\233\005\346\313`\027\244\217\355v\205\242]l~\023=\312\027\242\250l\220\004\357\256\211\330\372\352\305\310\327\255\350}H&\341\231\n\2148\330`\321\362\006\026\331\302\300\334Q\252\026A\254t\313\243$\272\022\354%\316\207\350\030XU\243\233\022\303\352\315\030\004\367\237\3159\005\374_\2223\254Z\244\364d%\310\242{\027\030:\207\245f\315\352\222\001\334,\310\000\352o-\200\340\315<\353c(o\265\220\262\017\272-\206 \312\257c\372~\004\306\221\323\372\272\340\373y)\306\227t5\006>@\024\304\b\346\336\345<\270\016\360\312\370\232\353H)A!\342;\2425L-\256g\3223h\a\305\006\331\034%\263\367\217\245a\351z\310\247\2116c\325\025b\0014\363\265K\nK\023X\2771E\tb\264K\312\250\205V0\021\000OIc\t\246\031,\247\2516H\033\324\376\0040i\000_\274\276\306 4\r\335\23076\002\315\023[\257\210f*s\f\322\\\201tO\032gC\205\351\261\'\025.:\034\326d\t?w\030\317\246\236\254\265D\227\035\355\331\f=`gG\304\300\022DLU\314\220\033\020\324\247\322\032U|P\005z\024\360\263\272-@\213\313\323\277\225\334\342\000\213\240\332Z\273&\016\324\241\251\321H\023.\351J{\':X\242\036Z;\025\271;\205\303\300\314\351\324I\247\240\323h\225\314;\324\035\261\364\016\003\001_m\205\037bO \214LZ\271\t#\360\307\302*l\363eM\231\177\223\341\205\363\227q4\210}\243~{#\360\213=D\332\236C4b\364\255\374\372@f\023&\361\261-\325\234Z\207\361-w\222\314\246\263\"\277\204}\354!\312\255\242vS\376\226\033\210\034\021\006)\207)^\345\226$.\002\304\337P\221\362r\237\211\313\034\0051\346vZ`$\020^\003b\342\263\274:la\341\321\256\3457\241\3042\366\325hB\204A"
