    tool_calls {
      id: "call_12466507482178939348"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Sparkles, X, ShieldAlert } from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { fromMinorUnits, toMinorUnits, type CurrencyCode } from \'../../../core/currency/currency\';\\nimport { getTodayYmd } from \'../../../core/debts/debtEngine\';\\nimport type {\\n  CreateDebtInput,\\n  DebtCategory,\\n  DebtDirection,\\n  DebtRecord,\\n} from \'../../../core/debts/debtSchemas\';\\nimport { parseNaturalLanguageDebt } from \'../../../core/ai/debtsAiClient\';\\nimport { evaluateDailyAiQuota, getTodayDayKey } from \'../../../core/entitlements/entitlements\';\\nimport { aiUsageRepository } from \'../../../data/repositories/firebaseWebAdapter\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\n\\ninterface DebtFormModalProps {\\n  open: boolean;\\n  editingDebt: DebtRecord | null;\\n  initialFocusAi?: boolean;\\n  onClose: () => void;\\n  onCreate: (input: CreateDebtInput) => Promise<void>;\\n  onUpdate: (\\n    current: DebtRecord,\\n    patch: Partial<\\n      Pick<DebtRecord, \'personName\' | \'personPhone\' | \'category\' | \'interestRateBps\' | \'dueDate\' | \'notes\'>\\n    >\\n  ) => Promise<void>;\\n}\\n\\nconst CATEGORIES: DebtCategory[] = [\'personal\', \'family\', \'business\', \'loan\', \'bill_split\', \'other\'];\\n\\nexport const DebtFormModal: React.FC<DebtFormModalProps> = ({\\n  open,\\n  editingDebt,\\n  initialFocusAi = false,\\n  onClose,\\n  onCreate,\\n  onUpdate,\\n}) => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const authUser = useUIStore((s) => s.authUser);\\n  const entitlements = useUIStore((s) => s.entitlements);\\n  const todayAiUsage = useUIStore((s) => s.todayAiUsage);\\n  const incrementLocalAiUsage = useUIStore((s) => s.incrementLocalAiUsage);\\n\\n  const [direction, setDirection] = useState<DebtDirection>(\'owed_to_me\');\\n  const [personName, setPersonName] = useState(\'\');\\n  const [personPhone, setPersonPhone] = useState(\'\');\\n  const [amountInput, setAmountInput] = useState(\'\');\\n  const [currency, setCurrency] = useState<CurrencyCode>(profile.primaryCurrency);\\n  const [category, setCategory] = useState<DebtCategory>(\'personal\');\\n  const [aprInput, setAprInput] = useState(\'0\');\\n  const [dueDate, setDueDate] = useState(\'\');\\n  const [notes, setNotes] = useState(\'\');\\n\\n  const [aiText, setAiText] = useState(\'\');\\n  const [aiParsing, setAiParsing] = useState(false);\\n  const [aiNotice, setAiNotice] = useState<string | null>(null);\\n  const [aiError, setAiError] = useState<string | null>(null);\\n\\n  const [saving, setSaving] = useState(false);\\n  const [formError, setFormError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    if (!open) return;\\n    setFormError(null);\\n    setAiError(null);\\n    setAiNotice(null);\\n    setAiText(\'\');\\n\\n    if (editingDebt) {\\n      setDirection(editingDebt.direction);\\n      setPersonName(editingDebt.personName);\\n      setPersonPhone(editingDebt.personPhone ?? \'\');\\n      setAmountInput(String(fromMinorUnits(editingDebt.principalMinor, editingDebt.currency)));\\n      setCurrency(editingDebt.currency);\\n      setCategory(editingDebt.category);\\n      setAprInput((editingDebt.interestRateBps / 100).toString());\\n      setDueDate(editingDebt.dueDate ?? \'\');\\n      setNotes(editingDebt.notes ?? \'\');\\n    } else {\\n      setDirection(\'owed_to_me\');\\n      setPersonName(\'\');\\n      setPersonPhone(\'\');\\n      setAmountInput(\'\');\\n      setCurrency(profile.primaryCurrency);\\n      setCategory(\'personal\');\\n      setAprInput(\'0\');\\n      setDueDate(\'\');\\n      setNotes(\'\');\\n    }\\n  }, [open, editingDebt, profile.primaryCurrency]);\\n\\n  if (!open) return null;\\n\\n  const isEditing = Boolean(editingDebt);\\n  const aiAllowedForDebts = profile.aiGlobalEnabled && (profile.aiModuleToggles?.debts ?? true);\\n\\n  const handleAiParse = async () => {\\n    const trimmed = aiText.trim();\\n    if (!trimmed) return;\\n    if (!aiAllowedForDebts) {\\n      setAiError(t(\'assistant.disabledNotice\'));\\n      return;\\n    }\\n\\n    const dayKey = getTodayDayKey();\\n    const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\\n    const quota = evaluateDailyAiQuota(usedToday, entitlements);\\n    if (!quota.allowed) {\\n      setAiError(`Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}). Fill fields manually below.`);\\n      return;\\n    }\\n\\n    setAiParsing(true);\\n    setAiError(null);\\n    setAiNotice(null);\\n\\n    const res = await parseNaturalLanguageDebt({\\n      text: trimmed,\\n      locale: profile.locale,\\n      defaultCurrency: profile.primaryCurrency,\\n      todayYmd: getTodayYmd(),\\n      freeTier: entitlements.plan === \'free\',\\n    });\\n\\n    setAiParsing(false);\\n\\n    if (!res.ok) {\\n      setAiError(res.error);\\n      return;\\n    }\\n\\n    const draft = res.data;\\n    setDirection(draft.direction);\\n    setPersonName(draft.personName);\\n    setAmountInput(String(draft.amountMajor));\\n    setCurrency(draft.currency);\\n    setCategory(draft.category);\\n    setAprInput(String(draft.interestRatePercent ?? 0));\\n    setDueDate(draft.dueDate ?? \'\');\\n    setNotes(draft.notes ?? \'\');\\n    setAiNotice(draft.confidenceNote || t(\'debts.aiDraftNotice\'));\\n\\n    incrementLocalAiUsage(dayKey, res.meta.inputTokensEst, res.meta.outputTokensEst);\\n    if (authUser) {\\n      void aiUsageRepository.recordUsage(\\n        authUser.uid,\\n        dayKey,\\n        todayAiUsage.dayKey === dayKey ? todayAiUsage : null,\\n        res.meta.inputTokensEst,\\n        res.meta.outputTokensEst\\n      );\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setFormError(null);\\n\\n    const cleanName = personName.trim();\\n    if (!cleanName) {\\n      setFormError(\'Please enter a person or lender name.\');\\n      return;\\n    }\\n\\n    const aprVal = Number(aprInput || \'0\');\\n    if (!Number.isFinite(aprVal) || aprVal < 0 || aprVal > 100) {\\n      setFormError(\'APR must be between 0% and 100%.\');\\n      return;\\n    }\\n    const interestRateBps = Math.round(aprVal * 100);\\n\\n    setSaving(true);\\n    try {\\n      if (editingDebt) {\\n        await onUpdate(editingDebt, {\\n          personName: cleanName,\\n          personPhone: personPhone.trim() || undefined,\\n          category,\\n          interestRateBps,\\n          dueDate: dueDate || undefined,\\n          notes: notes.trim() || undefined,\\n        });\\n      } else {\\n        const major = Number(amountInput.replace(/,/g, \'\'));\\n        if (!Number.isFinite(major) || major <= 0) {\\n          setFormError(\'Enter a valid amount greater than 0.\');\\n          setSaving(false);\\n          return;\\n        }\\n        const principalMinor = toMinorUnits(major, currency);\\n        await onCreate({\\n          direction,\\n          personName: cleanName,\\n          personPhone: personPhone.trim() || undefined,\\n          category,\\n          principalMinor,\\n          currency,\\n          interestRateBps,\\n          dueDate: dueDate || undefined,\\n          notes: notes.trim() || undefined,\\n        });\\n      }\\n      onClose();\\n    } catch (err) {\\n      setFormError(err instanceof Error ? err.message : \'Failed to save debt record.\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={isEditing ? t(\'debts.editDebt\') : t(\'debts.addDebt\')}\\n      className=\\\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-950/60 backdrop-blur-xs p-0 sm:p-4\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"w-full sm:max-w-lg max-h-[92dvh] overflow-y-auto rounded-t-3xl sm:rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] shadow-xl\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"sticky top-0 z-10 flex items-center justify-between border-b border-[var(--border-hairline)] bg-[var(--bg-surface)] px-5 py-4\\\">\\n          <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n            {isEditing ? t(\'debts.editDebt\') : t(\'debts.addDebt\')}\\n          </h2>\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={t(\'common.close\')}\\n            onClick={onClose}\\n            className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]\\\"\\n          >\\n            <X className=\\\"h-4 w-4\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"p-5 space-y-5\\\">\\n          {/* AI Natural Language Quick Parser (Create mode only, always confirmation-gated) */}\\n          {!isEditing && (\\n            <div className=\\\"rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-3.5 space-y-2.5\\\">\\n              <div className=\\\"flex items-center justify-between gap-2\\\">\\n                <span className=\\\"inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--text-primary)]\\\">\\n                  <Sparkles className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" />\\n                  <span>{t(\'debts.aiQuickEntry\')}</span>\\n                </span>\\n                <span className=\\\"text-[11px] text-[var(--text-muted)]\\\">EN \302\267 AR \302\267 CKB</span>\\n              </div>\\n              <div className=\\\"flex gap-2\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  autoFocus={initialFocusAi}\\n                  value={aiText}\\n                  onChange={(e) => setAiText(e.target.value)}\\n                  onKeyDown={(e) => {\\n                    if (e.key === \'Enter\') {\\n                      e.preventDefault();\\n                      void handleAiParse();\\n                    }\\n                  }}\\n                  placeholder={t(\'debts.aiParsePlaceholder\')}\\n                  className=\\\"flex-1 min-w-0 min-h-[40px] rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={aiParsing || !aiText.trim()}\\n                  onClick={() => void handleAiParse()}\\n                  className=\\\"min-h-[40px] rounded-lg bg-[var(--accent)] px-3.5 py-1.5 text-xs font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50 whitespace-nowrap shrink-0\\\"\\n                >\\n                  {aiParsing ? \'...\' : t(\'debts.aiParseBtn\')}\\n                </button>\\n              </div>\\n              {aiNotice && (\\n                <p className=\\\"text-xs text-[var(--accent)] font-medium\\\">{aiNotice}</p>\\n              )}\\n              {aiError && (\\n                <p className=\\\"flex items-start gap-1.5 text-xs text-amber-700 dark:text-amber-300\\\">\\n                  <ShieldAlert className=\\\"h-3.5 w-3.5 shrink-0 mt-0.5\\\" />\\n                  <span>{aiError}</span>\\n                </p>\\n              )}\\n            </div>\\n          )}\\n\\n          <form onSubmit={(e) => void handleSubmit(e)} className=\\\"space-y-4\\\">\\n            {/* Direction Segmented Control */}\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1.5\\\">\\n                {t(\'debts.direction\')}\\n              </label>\\n              <div className=\\\"grid grid-cols-2 gap-1.5 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n                {([\'owed_to_me\', \'i_owe\'] as DebtDirection[]).map((dir) => (\\n                  <button\\n                    key={dir}\\n                    type=\\\"button\\\"\\n                    disabled={isEditing}\\n                    onClick={() => setDirection(dir)}\\n                    className={`min-h-[40px] rounded-lg text-xs font-semibold transition-colors disabled:opacity-70 ${\\n                      direction === dir\\n                        ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                        : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                    }`}\\n                  >\\n                    {dir === \'owed_to_me\' ? t(\'debts.owedToMe\') : t(\'debts.iOwe\')}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Person & Phone */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.personName\')}\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  maxLength={120}\\n                  value={personName}\\n                  onChange={(e) => setPersonName(e.target.value)}\\n                  placeholder=\\\"Omar Ali / \330\271\331\205\330\261 \330\271\331\204\331\212\\\"\\n                  className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.personPhone\')}\\n                </label>\\n                <input\\n                  type=\\\"tel\\\"\\n                  maxLength={32}\\n                  value={personPhone}\\n                  onChange={(e) => setPersonPhone(e.target.value)}\\n                  placeholder=\\\"+964 770 000 0000\\\"\\n                  className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {/* Amount & Currency */}\\n            <div className=\\\"grid grid-cols-3 gap-3\\\">\\n              <div className=\\\"col-span-2\\\">\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.amount\')}\\n                </label>\\n                <input\\n                  type=\\\"number\\\"\\n                  step={currency === \'IQD\' ? \'1\' : \'0.01\'}\\n                  min=\\\"0\\\"\\n                  required\\n                  disabled={isEditing}\\n                  value={amountInput}\\n                  onChange={(e) => setAmountInput(e.target.value)}\\n                  placeholder={currency === \'IQD\' ? \'250000\' : \'150.00\'}\\n                  className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] disabled:opacity-60 focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.currency\')}\\n                </label>\\n                <select\\n                  disabled={isEditing}\\n                  value={currency}\\n                  onChange={(e) => setCurrency(e.target.value as CurrencyCode)}\\n                  className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] disabled:opacity-60 focus:outline-none focus:border-[var(--accent)]\\\"\\n                >\\n                  <option value=\\\"IQD\\\">IQD</option>\\n                  <option value=\\\"USD\\\">USD</option>\\n                  <option value=\\\"EUR\\\">EUR</option>\\n                </select>\\n              </div>\\n            </div>\\n\\n            {/* Category, Due Date, APR */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.category\')}\\n                </label>\\n                <select\\n                  value={category}\\n                  onChange={(e) => setCategory(e.target.value as DebtCategory)}\\n                  className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                >\\n                  {CATEGORIES.map((c) => (\\n                    <option key={c} value={c}>\\n                      {c.replace(\'_\', \' \')}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.dueDate\')}\\n                </label>\\n                <input\\n                  type=\\\"date\\\"\\n                  value={dueDate}\\n                  onChange={(e) => setDueDate(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                  {t(\'debts.aprLabel\')}\\n                </label>\\n                <input\\n                  type=\\\"number\\\"\\n                  step=\\\"0.1\\\"\\n                  min=\\\"0\\\"\\n                  max=\\\"100\\\"\\n                  value={aprInput}\\n                  onChange={(e) => setAprInput(e.target.value)}\\n                  className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {/* Notes */}\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'debts.notesLabel\')}\\n              </label>\\n              <textarea\\n                rows={2}\\n                maxLength={2000}\\n                value={notes}\\n                onChange={(e) => setNotes(e.target.value)}\\n                placeholder=\\\"Context, agreement terms, or installment reference...\\\"\\n                className=\\\"w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n\\n            {formError && (\\n              <p className=\\\"text-xs font-medium text-red-600 dark:text-red-400\\\">{formError}</p>\\n            )}\\n\\n            <div className=\\\"flex items-center justify-end gap-2.5 pt-2 border-t border-[var(--border-hairline)]\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onClose}\\n                className=\\\"min-h-[42px] rounded-xl border border-[var(--border-hairline)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]\\\"\\n              >\\n                {t(\'common.cancel\')}\\n              </button>\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={saving}\\n                className=\\\"min-h-[42px] rounded-xl bg-[var(--accent)] px-5 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50\\\"\\n              >\\n                {saving ? \'...\' : isEditing ? t(\'debts.saveChanges\') : t(\'debts.saveDebt\')}\\n              </button>\\n            </div>\\n          </form>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DebtFormModal with integer minor-unit conversion and confirmation-gated AI natural-language parser.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/debts/ui/DebtFormModal.tsx\", \"toolAction\":\"Creating DebtFormModal component\", \"toolSummary\":\"Create DebtFormModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12466507482178940875"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { CheckCircle2, X } from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { formatMoney, fromMinorUnits, toMinorUnits } from \'../../../core/currency/currency\';\\nimport { getTodayYmd } from \'../../../core/debts/debtEngine\';\\nimport type { DebtRecord, PaymentMethod, RecordPaymentInput } from \'../../../core/debts/debtSchemas\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\n\\ninterface DebtPaymentModalProps {\\n  debt: DebtRecord | null;\\n  onClose: () => void;\\n  onRecordPayment: (debt: DebtRecord, input: RecordPaymentInput) => Promise<void>;\\n}\\n\\nconst METHODS: { id: PaymentMethod; label: string }[] = [\\n  { id: \'cash\', label: \'Cash\' },\\n  { id: \'bank_transfer\', label: \'Bank Transfer\' },\\n  { id: \'zaincash\', label: \'ZainCash\' },\\n  { id: \'fib\', label: \'FIB\' },\\n  { id: \'fastpay\', label: \'FastPay\' },\\n  { id: \'other\', label: \'Other\' },\\n];\\n\\nexport const DebtPaymentModal: React.FC<DebtPaymentModalProps> = ({\\n  debt,\\n  onClose,\\n  onRecordPayment,\\n}) => {\\n  const { t } = useTranslation();\\n  const locale = useUIStore((s) => s.profile.locale);\\n\\n  const [amountInput, setAmountInput] = useState(\'\');\\n  const [paidOn, setPaidOn] = useState(getTodayYmd());\\n  const [method, setMethod] = useState<PaymentMethod>(\'cash\');\\n  const [note, setNote] = useState(\'\');\\n  const [saving, setSaving] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    if (!debt) return;\\n    setAmountInput(String(fromMinorUnits(debt.remainingMinor, debt.currency)));\\n    setPaidOn(getTodayYmd());\\n    setMethod(\'cash\');\\n    setNote(\'\');\\n    setError(null);\\n  }, [debt]);\\n\\n  if (!debt) return null;\\n\\n  const parsedMajor = Number(amountInput.replace(/,/g, \'\'));\\n  const candidateMinor =\\n    Number.isFinite(parsedMajor) && parsedMajor > 0 ? toMinorUnits(parsedMajor, debt.currency) : 0;\\n  const nextRemaining = Math.max(0, debt.remainingMinor - candidateMinor);\\n  const isOverpay = candidateMinor > debt.remainingMinor;\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n    if (candidateMinor <= 0) {\\n      setError(\'Enter a payment amount greater than zero.\');\\n      return;\\n    }\\n    if (isOverpay) {\\n      setError(\'Payment exceeds remaining debt balance.\');\\n      return;\\n    }\\n\\n    setSaving(true);\\n    try {\\n      await onRecordPayment(debt, {\\n        debtId: debt.id,\\n        amountMinor: candidateMinor,\\n        paidOn,\\n        method,\\n        note: note.trim() || undefined,\\n      });\\n      onClose();\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Failed to record payment.\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={t(\'debts.logPayment\')}\\n      className=\\\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-950/60 backdrop-blur-xs p-0 sm:p-4\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"w-full sm:max-w-md rounded-t-3xl sm:rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] shadow-xl overflow-hidden\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"flex items-center justify-between border-b border-[var(--border-hairline)] px-5 py-4\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">{t(\'debts.logPayment\')}</h2>\\n            <p className=\\\"text-xs text-[var(--text-muted)] truncate\\\">\\n              {debt.personName} \302\267 {t(\'debts.remaining\')}:{\' \'}\\n              <span className=\\\"font-numeric font-medium text-[var(--text-primary)]\\\">\\n                {formatMoney(debt.remainingMinor, debt.currency, locale)}\\n              </span>\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={t(\'common.close\')}\\n            onClick={onClose}\\n            className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]\\\"\\n          >\\n            <X className=\\\"h-4 w-4\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={(e) => void handleSubmit(e)} className=\\\"p-5 space-y-4\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between mb-1\\\">\\n              <label className=\\\"text-xs font-medium text-[var(--text-secondary)]\\\">\\n                {t(\'debts.amount\')} ({debt.currency})\\n              </label>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setAmountInput(String(fromMinorUnits(debt.remainingMinor, debt.currency)))}\\n                className=\\\"text-xs font-medium text-[var(--accent)] hover:underline\\\"\\n              >\\n                {t(\'debts.payFullBtn\')}\\n              </button>\\n            </div>\\n            <input\\n              type=\\\"number\\\"\\n              step={debt.currency === \'IQD\' ? \'1\' : \'0.01\'}\\n              min=\\\"0\\\"\\n              required\\n              value={amountInput}\\n              onChange={(e) => setAmountInput(e.target.value)}\\n              className=\\\"w-full min-h-[44px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 text-base font-semibold text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'debts.paymentMethod\')}\\n              </label>\\n              <select\\n                value={method}\\n                onChange={(e) => setMethod(e.target.value as PaymentMethod)}\\n                className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              >\\n                {METHODS.map((m) => (\\n                  <option key={m.id} value={m.id}>\\n                    {m.label}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n            <div>\\n              <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n                {t(\'debts.paymentDate\')}\\n              </label>\\n              <input\\n                type=\\\"date\\\"\\n                required\\n                value={paidOn}\\n                onChange={(e) => setPaidOn(e.target.value)}\\n                className=\\\"w-full min-h-[42px] font-numeric rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1\\\">\\n              {t(\'debts.notesLabel\')}\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              maxLength={500}\\n              value={note}\\n              onChange={(e) => setNote(e.target.value)}\\n              placeholder=\\\"Receipt number or transfer reference...\\\"\\n              className=\\\"w-full min-h-[42px] rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n            />\\n          </div>\\n\\n          {/* Deterministic Preview Strip */}\\n          <div className=\\\"rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-3 flex items-center justify-between text-xs\\\">\\n            <span className=\\\"text-[var(--text-secondary)]\\\">New remaining balance</span>\\n            <span\\n              className={`font-numeric font-semibold ${\\n                isOverpay\\n                  ? \'text-red-600 dark:text-red-400\'\\n                  : nextRemaining === 0\\n                    ? \'text-[var(--accent)]\'\\n                    : \'text-[var(--text-primary)]\'\\n              }`}\\n            >\\n              {isOverpay\\n                ? \'Exceeds balance\'\\n                : nextRemaining === 0\\n                  ? `${formatMoney(0, debt.currency, locale)} \302\267 Settled`\\n                  : formatMoney(nextRemaining, debt.currency, locale)}\\n            </span>\\n          </div>\\n\\n          {error && <p className=\\\"text-xs font-medium text-red-600 dark:text-red-400\\\">{error}</p>}\\n\\n          <div className=\\\"flex items-center justify-end gap-2.5 pt-2 border-t border-[var(--border-hairline)]\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"min-h-[42px] rounded-xl border border-[var(--border-hairline)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]\\\"\\n            >\\n              {t(\'common.cancel\')}\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={saving || isOverpay || candidateMinor <= 0}\\n              className=\\\"inline-flex min-h-[42px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-5 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50\\\"\\n            >\\n              <CheckCircle2 className=\\\"h-4 w-4\\\" />\\n              <span>{saving ? \'...\' : t(\'debts.confirmPayment\')}</span>\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DebtPaymentModal supporting partial payments, full settlement, Iraq/Kurdistan payment methods, and live deterministic balance preview.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/debts/ui/DebtPaymentModal.tsx\", \"toolAction\":\"Creating DebtPaymentModal component\", \"toolSummary\":\"Create DebtPaymentModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12466507482178938306"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Check, Copy, ExternalLink, Sparkles, X } from \'lucide-react\';\\nimport { useTranslation } from \'react-i18next\';\\nimport { formatMoney, type SupportedLocale } from \'../../../core/currency/currency\';\\nimport { computeDaysOverdue } from \'../../../core/debts/debtEngine\';\\nimport type { DebtRecord } from \'../../../core/debts/debtSchemas\';\\nimport { draftDebtReminderMessage } from \'../../../core/ai/debtsAiClient\';\\nimport { evaluateDailyAiQuota, getTodayDayKey } from \'../../../core/entitlements/entitlements\';\\nimport { aiUsageRepository } from \'../../../data/repositories/firebaseWebAdapter\';\\nimport { useUIStore } from \'../../../state/useUIStore\';\\n\\ninterface DebtReminderModalProps {\\n  debt: DebtRecord | null;\\n  onClose: () => void;\\n}\\n\\ntype ReminderTone = \'gentle\' | \'firm\' | \'formal\';\\n\\nexport const DebtReminderModal: React.FC<DebtReminderModalProps> = ({ debt, onClose }) => {\\n  const { t } = useTranslation();\\n  const profile = useUIStore((s) => s.profile);\\n  const authUser = useUIStore((s) => s.authUser);\\n  const entitlements = useUIStore((s) => s.entitlements);\\n  const todayAiUsage = useUIStore((s) => s.todayAiUsage);\\n  const incrementLocalAiUsage = useUIStore((s) => s.incrementLocalAiUsage);\\n  const showToast = useUIStore((s) => s.showToast);\\n\\n  const [language, setLanguage] = useState<SupportedLocale>(profile.locale);\\n  const [tone, setTone] = useState<ReminderTone>(\'gentle\');\\n  const [subject, setSubject] = useState(\'\');\\n  const [message, setMessage] = useState(\'\');\\n  const [metaText, setMetaText] = useState<string | null>(null);\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n  const [copied, setCopied] = useState(false);\\n\\n  useEffect(() => {\\n    if (!debt) return;\\n    setLanguage(profile.locale);\\n    setTone(computeDaysOverdue(debt) > 14 ? \'firm\' : \'gentle\');\\n    setSubject(\'\');\\n    setMessage(\'\');\\n    setMetaText(null);\\n    setError(null);\\n    setCopied(false);\\n  }, [debt, profile.locale]);\\n\\n  if (!debt) return null;\\n\\n  const formattedAmount = formatMoney(debt.remainingMinor, debt.currency, language);\\n  const daysOverdue = computeDaysOverdue(debt);\\n  const aiAllowedForDebts = profile.aiGlobalEnabled && (profile.aiModuleToggles?.debts ?? true);\\n\\n  const handleGenerate = async () => {\\n    if (!aiAllowedForDebts) {\\n      setError(t(\'assistant.disabledNotice\'));\\n      return;\\n    }\\n\\n    const dayKey = getTodayDayKey();\\n    const usedToday = todayAiUsage.dayKey === dayKey ? todayAiUsage.requestCount : 0;\\n    const quota = evaluateDailyAiQuota(usedToday, entitlements);\\n    if (!quota.allowed) {\\n      setError(`Daily AI quota reached (${quota.usedToday}/${quota.dailyLimit}).`);\\n      return;\\n    }\\n\\n    setLoading(true);\\n    setError(null);\\n\\n    const res = await draftDebtReminderMessage({\\n      personName: debt.personName,\\n      formattedAmount,\\n      direction: debt.direction,\\n      dueDate: debt.dueDate ?? null,\\n      daysOverdue,\\n      tone,\\n      language,\\n      contextNote: debt.notes?.slice(0, 200),\\n      freeTier: entitlements.plan === \'free\',\\n    });\\n\\n    setLoading(false);\\n\\n    if (!res.ok) {\\n      setError(res.error);\\n      return;\\n    }\\n\\n    setSubject(res.data.shortSubject);\\n    setMessage(res.data.message);\\n    setMetaText(`${res.meta.modelUsed} \302\267 ${res.meta.latencyMs}ms`);\\n\\n    incrementLocalAiUsage(dayKey, res.meta.inputTokensEst, res.meta.outputTokensEst);\\n    if (authUser) {\\n      void aiUsageRepository.recordUsage(\\n        authUser.uid,\\n        dayKey,\\n        todayAiUsage.dayKey === dayKey ? todayAiUsage : null,\\n        res.meta.inputTokensEst,\\n        res.meta.outputTokensEst\\n      );\\n    }\\n  };\\n\\n  const handleCopy = async () => {\\n    if (!message.trim()) return;\\n    try {\\n      await navigator.clipboard.writeText(message);\\n      setCopied(true);\\n      showToast(\'Reminder copied to clipboard.\');\\n      window.setTimeout(() => setCopied(false), 2000);\\n    } catch {\\n      showToast(\'Could not access clipboard.\');\\n    }\\n  };\\n\\n  const cleanPhone = (debt.personPhone ?? \'\').replace(/[^\\\\d]/g, \'\');\\n  const whatsAppHref = cleanPhone\\n    ? `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`\\n    : `https://wa.me/?text=${encodeURIComponent(message)}`;\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label={t(\'debts.reminderTitle\')}\\n      className=\\\"fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-950/60 backdrop-blur-xs p-0 sm:p-4\\\"\\n      onClick={onClose}\\n    >\\n      <div\\n        className=\\\"w-full sm:max-w-lg rounded-t-3xl sm:rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] shadow-xl overflow-hidden\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        <div className=\\\"flex items-center justify-between border-b border-[var(--border-hairline)] px-5 py-4\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <h2 className=\\\"text-base font-semibold text-[var(--text-primary)]\\\">\\n              {t(\'debts.reminderTitle\')}\\n            </h2>\\n            <p className=\\\"text-xs text-[var(--text-muted)] truncate\\\">\\n              {debt.personName} \302\267 <span className=\\\"font-numeric\\\">{formattedAmount}</span>\\n              {daysOverdue > 0 && ` \302\267 ${t(\'debts.overdueDays\', { count: daysOverdue })}`}\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            aria-label={t(\'common.close\')}\\n            onClick={onClose}\\n            className=\\\"inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-muted)] hover:bg-[var(--bg-subtle)]\\\"\\n          >\\n            <X className=\\\"h-4 w-4\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"p-5 space-y-4\\\">\\n          {/* Language & Tone Controls */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n            <div>\\n              <span className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1.5\\\">\\n                Message Language\\n              </span>\\n              <div className=\\\"grid grid-cols-3 gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n                {(\\n                  [\\n                    { id: \'en\', label: \'EN\' },\\n                    { id: \'ar\', label: \'\330\271\330\261\330\250\331\212\' },\\n                    { id: \'ckb\', label: \'\332\251\331\210\330\261\330\257\333\214\' },\\n                  ] as const\\n                ).map((lang) => (\\n                  <button\\n                    key={lang.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setLanguage(lang.id)}\\n                    className={`min-h-[36px] rounded-lg text-xs font-medium transition-colors ${\\n                      language === lang.id\\n                        ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                        : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                    }`}\\n                  >\\n                    {lang.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            <div>\\n              <span className=\\\"block text-xs font-medium text-[var(--text-secondary)] mb-1.5\\\">\\n                Tone\\n              </span>\\n              <div className=\\\"grid grid-cols-3 gap-1 p-1 rounded-xl bg-[var(--bg-subtle)]\\\">\\n                {(\\n                  [\\n                    { id: \'gentle\', label: t(\'debts.toneGentle\') },\\n                    { id: \'firm\', label: t(\'debts.toneFirm\') },\\n                    { id: \'formal\', label: t(\'debts.toneFormal\') },\\n                  ] as const\\n                ).map((item) => (\\n                  <button\\n                    key={item.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setTone(item.id)}\\n                    className={`min-h-[36px] rounded-lg text-xs font-medium transition-colors truncate px-1 ${\\n                      tone === item.id\\n                        ? \'bg-[var(--bg-surface)] text-[var(--text-primary)] shadow-xs\'\\n                        : \'text-[var(--text-muted)] hover:text-[var(--text-primary)]\'\\n                    }`}\\n                  >\\n                    {item.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            disabled={loading}\\n            onClick={() => void handleGenerate()}\\n            className=\\\"w-full min-h-[42px] inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white hover:bg-[var(--accent-hover)] disabled:opacity-50\\\"\\n          >\\n            <Sparkles className=\\\"h-4 w-4\\\" />\\n            <span>{loading ? \'Drafting...\' : t(\'debts.generateDraft\')}</span>\\n          </button>\\n\\n          {error && <p className=\\\"text-xs text-amber-700 dark:text-amber-300\\\">{error}</p>}\\n\\n          <div>\\n            {subject && (\\n              <div className=\\\"mb-1.5 text-xs font-medium text-[var(--text-muted)]\\\">\\n                {subject}\\n                {metaText && <span className=\\\"font-numeric\\\"> \302\267 {metaText}</span>}\\n              </div>\\n            )}\\n            <textarea\\n              dir={language === \'en\' ? \'ltr\' : \'rtl\'}\\n              rows={5}\\n              value={message}\\n              onChange={(e) => setMessage(e.target.value)}\\n              placeholder=\\\"Click Generate Draft above, or write your custom reminder message here...\\\"\\n              className=\\\"w-full rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-3 text-sm leading-relaxed text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent)]\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center justify-end gap-2.5 pt-2 border-t border-[var(--border-hairline)]\\\">\\n            <button\\n              type=\\\"button\\\"\\n              disabled={!message.trim()}\\n              onClick={() => void handleCopy()}\\n              className=\\\"inline-flex min-h-[40px] items-center gap-1.5 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] disabled:opacity-50\\\"\\n            >\\n              {copied ? <Check className=\\\"h-3.5 w-3.5 text-[var(--accent)]\\\" /> : <Copy className=\\\"h-3.5 w-3.5\\\" />}\\n              <span>{t(\'debts.copyMessage\')}</span>\\n            </button>\\n\\n            <a\\n              href={message.trim() ? whatsAppHref : undefined}\\n              target=\\\"_blank\\\"\\n              rel=\\\"noopener noreferrer\\\"\\n              aria-disabled={!message.trim()}\\n              className={`inline-flex min-h-[40px] items-center gap-1.5 rounded-xl bg-[var(--accent)] px-4 py-2 text-xs font-medium text-white transition-colors ${\\n                message.trim() ? \'hover:bg-[var(--accent-hover)]\' : \'opacity-50 pointer-events-none\'\\n              }`}\\n            >\\n              <ExternalLink className=\\\"h-3.5 w-3.5\\\" />\\n              <span>{t(\'debts.openWhatsApp\')}</span>\\n            </a>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DebtReminderModal supporting EN/AR/Kurdish Sorani tone-controlled AI message drafting, editing, clipboard copy, and WhatsApp share link.\", \"Overwrite\":true, \"TargetFile\":\"/src/features/debts/ui/DebtReminderModal.tsx\", \"toolAction\":\"Creating DebtReminderModal component\", \"toolSummary\":\"Create DebtReminderModal.tsx\"}"
      original_name: "write_to_file"
    }
