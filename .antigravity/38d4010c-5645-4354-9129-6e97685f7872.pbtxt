            lines {
              text: "export function buildExpiryReminderInput("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  doc: VaultDocumentMeta,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
