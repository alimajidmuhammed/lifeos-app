      thinking_signature: "\022\200\024\n\375\023\001i\024}\023Y\251K\360\337\241ze\023R\301\345xm+\215x\030\312;/#\022\2530k\364\236\027\333\026\324\331\t\001\377\330\'\343+I\022\265\312\227w\202\244\004c\037Y~j\236&PX\2320\221\"\023\315\375\270}\2357t\364\377\320\003\366\343\341_z\333\2775\257\222\232\327\373\320i\024d\f\345g\255\205\342\223>Z\325\340\364\342)\313\307\317\245.\234D\307:\210dB\212cuk\303\304\372$\216\257\033\311\225\264\312\224n\270\217\024\346_y\305a\315\205\f\\\326%CN\337\244e\034\036\241z\311\214\352+l4\003h\035\201lB\330/<\361\206O\237\350\206<\344,\251n\024\020\336V\254\25484\364hGO\257\252\321\300\331\255\304\201\024\276\000%\2040B\360\032\240^\261\236@\315Y\206KY\224\030\320\270]\240\245\201\210~$\\\230\207\334\'{\215=3\006\3174\254b\360t\024k\372\rk\355\314\317\302\030\337}\235\360\303\\\2657\n46\256\247\330o\030\223\271\\\247.\366\255\334MV$\036\300\227?\352\303\355J\216S\266u^\324M\215\333g\374\307_k\356\332\304z\316\347Bs&q8q\022\000\355@\377ET\230\214;A..\364k\230\223\210U\234\024\377\342O9\345v\325\352\335\240[@\016c^{\263\254\232\364\267\304|\316\t\313\323\376G;\330\216\373\264\222\325\361$\220\277\356\3735\334hl\244\212\231\216\235,E\365\353\026\235\240\031C\276\'}\236\367W\330<\017!\365\303O\262\366\344\314\372\"k\357Tz\307\235\354&Q\2323MI\034Wu;\343\332\304\f^\356RK\342n\366\364\374\v{\206\016vI\352W\357\355\247\311\235H\274\367\f\003c\236f\247%\310~\336\225g\3127\273k\263\363\253\242\246 zm\006\315\000I.t\3642\214z\026\356\230}\266,bd\366\257\206\202\3763\330\374\244\2136\035\337\365\2616\330\374\326\026\331\342D\271x\206\327@\366\033\265\207H\006D\227\327\0206\357\031v&)\3343J\f\303+\265\313\f\2215\301\003\f\261\316\305c*\307\241\336\303]@7\216[%\246\306H\316\016\v\257\261uY\320\376M\227\\\233\004\344\2014\177\367&\307\350\375\220W+\n\001\306\'\342\204\204\276\334\250\340\306\353\023\347%\305\037\271\031{\002\334~\301K\304\256\211\341\340\030\305\334Y\206_\275f3\257K\271\212/O\244\306\373\306&\317\222\311A\033LT\242*\266\241*\23