      thinking_signature: "\022\273\032\n\270\032\001i\024}\023$:}\003:\324\250\2645V\230\377N4e3>\'\341\257Hh?\000\301W/\247\311x6\250\200\351\265Y\3435u\234\236\346of\016\321`\322\215\241\222\375X\330\027\263R&\217\245\223zB\004\326uI(G\257@\371\264\3139\016\323\346\314\225\327\005S\377V\034\001\327\b?\250\212\031\276*\'\351}\346\263\334\005xW\2062\'\t\347\221\224\326\356\235$jj\313aN\003>m\352\336$\317L\265w\005\001\310x\3716\274\341=\334\aA\323\231\t\221y\\\367\365JX\r\366U\234\024\\tF\233\305;g\005#\200V\"\240\241H9\210ZKo\251G;=\253\031\311\372\277K\022z]\203\244\255GO\376\320\314\260\302tk\222\006\373\300\303JM\203\034Y\\6$D)\244T\234\365w\324\340\254\230\25485\253\'bd\022\232\270N\032;\200e\2766\242\250\021\302`\232\002\200\244S\277\345\340SF\321\033\2270\021\'\"\025IB\317ct`rqGY\335\352\235\371\357b*\330\351\264\002\023\332\be\353\006_<Q\262EdS\212D\370\306\256\2723\214!\274\342c+j\3453\305\025\241t\320%\254\310\371hL9P,j\223\v\037\001\376\334\205\037\343F\267DFG|\276[q1\022\213\264[\005,\201\336\v\310\343\270lSp\026\334i\362\272\037\353g\322\na\230F:p\336_v,1\006v\035WNIm\314\323\327\305\354v\316$\353!\262|\255]\002/\214mA\353\360\360c\337\340\360\000\315\244\331b}\371\326O\353\350\316(w\233JO\033\n}\314\253=\234O\247\270\322b\341\353\220M\004\314\275g+\234\375\301\236j\311S\033n\031\370\302\346\230\200\265\352\204DF\r\325pCS\003s\bz\305\177\327\255Z\225\r\260\026\034e\177\350f<\f\232\315\303\330\300\020F\034T\242v\260\001\375\204\231\262$\320*\356b\374\001\307\261#\225$=q\326\335\271\003\t\237\322G\255\377\"+h\256\326\347F\203\244ZZ\203\352\306\r+\b\032\2050\'\317\334\240J\344\324\342\352\216\371\263\237v\373u\272\220\345\020\246\233,p\365\v\347\230\217O\273\223\265\224\005\033\371YQb4X\204l4\360\333\364\004\025\311M\242[\211\225\331\321\363j\025\325\374\000\024\240b\260\312\271\024\365\227\b\006\033\2451?#=\021,\270g\036V!\311/p\204T\274\202\323\356W\370\304\005\342A>\336\325\\\213\253\024\335\354`8\250\313\375\017\370\374\210sc\\\177\177/\266+\f\022\231