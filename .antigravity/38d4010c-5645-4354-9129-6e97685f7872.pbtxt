      thinking_signature: "\022\222\004\n\217\004\001i\024}\023t\245\3516\317E2\020Qo\372\nE\261S\353\210\242\211\203Bn\215\020\277bs\322\341Ow\350\212hV\222\206\373:S\"\204\210\t\243F\316\233\207\270\267\237@\247\255k\255\251\343\'\210\323\377+U\003\361S\213U4\241\271\312\233U\251\251\036\207J\366G\222`\\-\311k\024\027\334\3135\272JS\306\241h\r\006>=\005\235\276\370\v\260\202P\326QW\256EW\307rf\016\240\002J\302\006\274M\034l\351\003\234\"Vx{x\245\360\230\b\356d\r\272d\303\344\221\234\005\232o\377M\200S*\336\027C\312\336\336\265\301h\240*[\002 \230u.\270\004@\303\254\272\316\3333mO\317\332CM6\207lF\020\343X(|\321\022\344\313\035\305\302\272D\023\213\200&|?=\264\345tYHZ\225\3459\374\372B*r\304\333a\303\357\264\303i\315A\255?\324\320\361\200\207&\'|\350\351\025\3573\274\312/\037.\365\327\301\356\n\3171\2649\vy\330\020\005;X\220\311\302\376\334\235\271\365\032\177\227\216\334\223\230:\351\363K\311\\\035\020\231\365\252{\363\272 4X\226\031E\323\300\236\216\271\325\313\230uPi\vj3\353\345a\232\266w\245\351\364\312\327+\230\262\226m\326,v\247e\272\356\f}\270\005\333s\240\206\036\274\344t\201\225kL\270V\003a\325^O\306R\370\3342\024\366v\366\254\'!B\344\221\334\317\276N\033\354\313\nU\277a\323\nB@\002p\364\323\354\000/9D\003\344\226\232\205\237S\226f\316\221\027L\364%\252%o\264\371\261\037D\030x\217W\270\aM\213\017\021\035\315;\374\311rq@\246\273\236\210\301\037\277o>\250\216Jn\005U\374\242\335\310\262+\371\333\\\323_\334\277Scgi3d\0375\326\016L+,\267\274\364\340\266\016\320\365\352\251g\213\251\261u\000\303\022s\365\267\317\303\250\000d;\016\261"
