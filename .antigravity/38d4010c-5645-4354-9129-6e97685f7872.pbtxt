            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Data Model & State (Phase 1 Core + Blueprinted Module Paths)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Root User Profile (`users/{uid}`)**: Display identity, locale (`en` | `ar` | `ckb`), theme (`light` | `dark` | `amoled`), default currencies (`IQD`, `USD`, `EUR`), global & per-module AI consent toggles, quiet hours, E2E vault salt/verifier metadata (never the raw key), `createdAt`, `updatedAt`, `version`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Entitlements (`users/{uid}/entitlements/current`)**: Server-managed plan tier (`free` | `pro` | `family`), daily AI quota limit, vault limits, E2E entitlement flag. Client has read-only access; writes are strictly denied by Security Rules."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **AI Quota & Cache (`users/{uid}/aiUsage/{yyyy_mm_dd}`, `users/{uid}/aiCache/{hashKey}`)**: Daily request counter + token metadata (never logs prompt content) and deterministic hash cache to reduce latency and quota burn."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Module Subcollections (Blueprinted & Rule-Protected from Phase 1)**: `debts`, `debtLedgers`, `reminders`, `taskLists`, `tasks`, `noteFolders`, `notes`, `vaultFolders`, `documents`, `habits`, `habitLogs`, `transactions`, `subscriptions` \342\200\224 all strictly scoped under `users/{uid}/...` with soft-delete tombstones (`deletedAt`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Interactive Component & State Mapping (Phase 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Authentication Gate & Session Manager**: Signs in via Google popup, observes `onAuthStateChanged`, validates Firestore connectivity on boot, provisions default `users/{uid}` document on first sign-in, supports clean sign-out and session lock without losing cached offline preferences."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Theme & RTL Controller**: Mutates root `<html>` class (`light` / `dark` / `amoled`) and `dir` (`ltr` / `rtl`) + `lang` attribute instantaneously, persisting selections both locally (instant zero-flash boot) and to `users/{uid}` in Firestore."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **App Lock & Opt-In E2E Setup Modal**: Lets user configure a local PIN lock with auto-lock timer, and test/initialize their opt-in AES-256-GCM Vault passphrase with deterministic Recovery Key generation and verification check."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **AI Command Palette & Privacy Gate Inspector**: Accepts natural-language test queries, displays exact text about to be sent, enforces the `free_tier = true` sensitivity filter (blocking simulated/marked vault or locked payloads with an actionable notice), tracks remaining daily quota, calls `/api/ai/complete` with Flash -> Flash-Lite fallback, validates structured JSON via Zod, and requires explicit user confirmation before applying any mutating suggestion."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **PWA Install & Offline Banner**: Captures `beforeinstallprompt` (and shows iOS Safari \"Add to Home Screen\" instructions on iOS), hides when already `standalone`, and reacts to `online`/`offline` events cleanly."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Key Sequences & Phased Verification Plan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Phase 1 Acceptance & Unit Tests (`node:test` via `tsx`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. Pure currency minor-unit math & IQD/USD formatting tests."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. AI Privacy Gate tests (proving `free_tier = true` blocks vault images, IDs, passports, locked/E2E items while allowing minimal explicit text)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. AES-256-GCM E2E encrypt/decrypt + recovery key round-trip tests."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. Entitlement & daily quota evaluator tests."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  5. Hardened `firestore.rules` ESLint check (`@firebase/eslint-plugin-security-rules`) + Dirty Dozen security test spec."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  6. Live browser verification across Desktop (`1440x900`) and Mobile (`390x844`), covering Light/Dark/AMOLED switching, EN/AR/KU RTL mirroring, Privacy Gate enforcement, and PWA manifest/installability."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Subsequent Phases (Paused for Approval After Each Phase)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Phase 2**: Debts Manager (+ deterministic repayment probability, snowball/avalanche planner, cash-flow forecast, multilingual AI reminder drafter & NL entry)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Phase 3**: Smart Reminders (+ RRULE engine, 8 categories, quiet hours, unit-tested rolling 64-notification scheduler & AI NL scheduling)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Phase 4**: To-Do/Planner (fractional-index drag-and-drop, unified calendar) & Rich Markdown Notes (+ E2E locked notes, versions, AI rewrite/extract)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Phase 5**: Document Vault (camera/file capture, crop/enhance/PDF pipeline, nested folders, expiry reminders, Local-Only & E2E encryption, on-device OCR, gated Document AI)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Phase 6**: Habits (monthly bucketed logs, streaks, heatmaps), Finance (transactions, budgets, subscriptions, CSV import/export), Global AI Tool-Calling Assistant & Search."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Phase 7**: Monetization/Paywall scaffolding, GDPR ZIP export & account purge, accessibility/performance hardening & Upgrade AI Provider runbook."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///.aistudio/artifacts/brain/38d4010c-5645-4354-9129-6e97685f7872/implementation_plan.md"
        create_file: true
      }
    }
